# Framework Layer Configuration
# This file defines configuration options for all framework components

menu "Framework Configuration"

#-----------------------------------------------------------------------------
# Core Framework Components
#-----------------------------------------------------------------------------

config FRAMEWORK_LOG
    bool "Enable Log Framework"
    default y
    help
      Enable the logging framework for system-wide logging support.
      Provides formatted logging with multiple log levels and output backends.

config FRAMEWORK_SHELL
    bool "Enable Shell Framework"
    default y
    depends on FRAMEWORK_LOG
    help
      Enable the command-line shell framework.
      Provides an interactive command-line interface for debugging and control.

config FRAMEWORK_CONFIG
    bool "Enable Config Manager Framework"
    default y
    depends on SERVICE_STORAGE && SERVICE_SECURITY
    help
      Enable the configuration manager framework.
      Provides runtime configuration management with persistence support.

config FRAMEWORK_INIT
    bool "Enable Init Framework"
    default y
    help
      Enable the system initialization framework.
      Provides ordered initialization of system components.

#-----------------------------------------------------------------------------
# Optional Framework Components
#-----------------------------------------------------------------------------

config FRAMEWORK_EVENT
    bool "Enable Event Framework"
    default n
    help
      Enable the event framework for event-driven programming.
      Provides publish-subscribe event handling mechanism.

config FRAMEWORK_STATE_MACHINE
    bool "Enable State Machine Framework"
    default n
    help
      Enable the state machine framework.
      Provides hierarchical state machine implementation.

endmenu

menu "Bounded parameter storage"
    depends on FRAMEWORK_CONFIG
config MANAGER_KEY_LIMIT
    int "Maximum stored keys (static capacity)"
    default 256 if PLATFORM_NATIVE
    default 32
    range 32 256
config MANAGER_DEFAULT_KEYS
    int "Default runtime key capacity"
    default 64 if PLATFORM_NATIVE
    default 32
    range 32 MANAGER_KEY_LIMIT
config MANAGER_KEY_LENGTH
    int "Maximum key length in bytes"
    default 64 if PLATFORM_NATIVE
    default 32
    range 16 64
config MANAGER_VALUE_SIZE
    int "Maximum parameter value in bytes"
    default 1024 if PLATFORM_NATIVE
    default 256
    range 64 1024
config MANAGER_DEFAULT_VALUE_SIZE
    int "Default runtime value capacity"
    default 256
    range 64 MANAGER_VALUE_SIZE
config MANAGER_PERSISTENCE_BUFFER
    int "Snapshot scratch buffer in bytes"
    default 524288 if PLATFORM_NATIVE
    default 16384
    range 1024 524288
endmenu
