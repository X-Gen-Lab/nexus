    range 0 4096

config STM32_UART1_RX_BUFFER_SIZE
    int "UART1 RX event ring capacity"
    default STM32_UART_DEFAULT_RX_BUFFER_SIZE
    range 0 4096

config STM32_UART1_USE_DMA
    bool "UART1 use DMA"
    default STM32_UART_USE_DMA
    depends on STM32_UART_USE_DMA

endif # INSTANCE_STM32_UART_1

