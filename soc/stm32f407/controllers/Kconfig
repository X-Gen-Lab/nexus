menu "STM32F407 Controllers"

menuconfig STM32_GPIO_ENABLE
    bool "GPIO provider"
    default y
if STM32_GPIO_ENABLE
rsource "gpio/Kconfig"
endif

menuconfig STM32_UART_ENABLE
    bool "Interrupt-driven UART provider"
    default y
    help
      Maintained TX completion, RX event ring and finite ownership contracts.
      UART DMA is unavailable and explicit DMA requests are rejected.
if STM32_UART_ENABLE
rsource "uart/Kconfig"
endif

menuconfig STM32_SPI_ENABLE
    bool "SPI transaction provider"
    default n
    help
      Polling transactions and optional Board-bound SPI DMA.
      Each enabled physical bus requires a reviewed Board binding.
if STM32_SPI_ENABLE
rsource "spi/Kconfig"
endif

endmenu

# Vendor dependencies are implementation details, not peripheral capabilities.
config HAL_GPIO_MODULE
    bool
    default y
config HAL_RCC_MODULE
    bool
    default y
config HAL_CORTEX_MODULE
    bool
    default y
config HAL_FLASH_MODULE
    bool
    default y
config HAL_PWR_MODULE
    bool
    default y
config HAL_UART_MODULE
    bool
    default y if STM32_UART_ENABLE
config HAL_SPI_MODULE
    bool
    default y if STM32_SPI_ENABLE
config HAL_DMA_MODULE
    bool
    default y if STM32_UART_ENABLE || STM32_SPI_ENABLE
    help
      The vendor UART/SPI modules depend on HAL DMA functions and types.
      This does not advertise Nexus UART DMA support.
