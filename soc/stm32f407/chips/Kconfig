# The implementation is STM32F407; other STM32 families are not selectable.
config STM32F4
    bool
    default y

config STM32F407
    bool
    default y

config STM32_SERIES
    string
    default "stm32f4"

config STM32_CHIP_NAME
    string
    default "STM32F407xx"

config STM32_HAS_FPU
    bool
    default y

config STM32_HAS_MPU
    bool
    default y
    help
      Silicon feature only. Nexus does not currently configure MPU regions.

config STM32_HAS_ICACHE
    bool
    default n
    help
      The Cortex-M4 has no CPU I-cache. Flash acceleration is separate.

config STM32_HAS_DCACHE
    bool
    default n
    help
      The Cortex-M4 has no CPU D-cache. Flash acceleration is separate.

config STM32_HAS_TRUSTZONE
    bool
    default n

choice
    prompt "STM32F407 part"
    default STM32F407VG

config STM32F407VG
    bool "STM32F407VGT6 (1 MiB Flash, LQFP100)"
config STM32F407ZG
    bool "STM32F407ZGT6 (1 MiB Flash, LQFP144)"
config STM32F407VE
    bool "STM32F407VET6 (512 KiB Flash, LQFP100)"

endchoice

config STM32_PART_NAME
    string
    default "STM32F407VGT6" if STM32F407VG
    default "STM32F407ZGT6" if STM32F407ZG
    default "STM32F407VET6" if STM32F407VE

config STM32_FLASH_SIZE
    hex
    default 0x80000 if STM32F407VE
    default 0x100000

config STM32_SRAM_SIZE
    hex
    default 0x30000
    help
      Total physical SRAM: 128 KiB main SRAM and 64 KiB non-DMA CCM.
      The maintained linker uses main SRAM; it does not allocate CCM.

# Physical main-memory identity consumed by the external linker-layout parser.
config LINKER_RAM_START
    hex
    default 0x20000000
config LINKER_RAM_SIZE
    hex
    default 0x20000
config LINKER_FLASH_START
    hex
    default 0x08000000
config LINKER_FLASH_SIZE
    hex
    default STM32_FLASH_SIZE
