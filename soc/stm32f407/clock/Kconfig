menu "STM32F407 Clock"

config STM32_HSE_ENABLE
    bool "Use board HSE crystal as PLL input"
    default y
    help
      Clock initialization fails if the selected oscillator cannot start.
      Disabling this selects the fixed 16 MHz HSI input.

config STM32_HSE_VALUE
    int "Board HSE frequency (Hz)"
    default 8000000
    range 4000000 26000000
    help
      Must match the selected Board package, even when HSI is selected.

config STM32_HSE_STARTUP_TIMEOUT
    int "Vendor HSE startup timeout (ms)"
    default 100
    range 10 1000

config STM32_HSI_VALUE
    int
    default 16000000

config STM32_SYSCLK_FREQ
    int "Target system clock frequency (Hz)"
    default 168000000
    range 24000000 168000000
    help
      The F407 PLL calculation and initialization validate this request.
      The target cannot exceed the silicon maximum of 168 MHz.

endmenu
