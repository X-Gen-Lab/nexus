{
  "schema_version": 1,
  "bindings": [
    {
      "kind": "capture",
      "controllers": ["DCMI"],
      "implementation": "capture",
      "static_recipe": {
        "state_type": "nx_stm32_capture_state_t",
        "ops": "nx_stm32_capture_ops",
        "declarations": [
          {
            "role": "av_saved",
            "type": "uint16_t",
            "const": false,
            "count": {"length": "selected.pads", "limit": 32}
          },
          {
            "role": "av_pins",
            "type": "nx_stm32_av_pin_t",
            "const": true,
            "value": {
              "map": {
                "source": "selected.pads",
                "limit": 32,
                "value": {
                  "record": [
                    ["registers", {"source": "entry.registers", "as": "symbol"}],
                    [
                      "snapshot",
                      {
                        "ref": "av_saved",
                        "as": "address",
                        "index": {"source": "index", "as": "u32"}
                      }
                    ],
                    ["bank", {"source": "entry.port_index"}],
                    ["pin", {"source": "entry.number"}],
                    ["af", {"source": "entry.alternate"}]
                  ]
                }
              }
            },
            "count": {"length": "selected.pads", "limit": 32}
          },
          {
            "role": "dma_regions",
            "type": "nx_dma_memory_region_t",
            "const": true,
            "value": {
              "map": {
                "source": "selected.memory_regions",
                "limit": 16,
                "value": {
                  "record": [
                    ["begin", {"source": "entry.begin"}],
                    ["size", {"source": "entry.size"}],
                    ["permissions", {"source": "entry.permissions", "as": "static"}]
                  ]
                }
              }
            },
            "count": {"length": "selected.memory_regions", "limit": 16}
          },
          {
            "role": "config",
            "type": "nx_stm32_capture_config_t",
            "const": true,
            "value": {
              "record": [
                [
                  "common",
                  {
                    "record": [
                      ["pins", {"ref": "av_pins", "as": "symbol"}],
                      ["pin_count", {"length": "selected.pads", "limit": 32}],
                      ["regions", {"ref": "dma_regions", "as": "symbol"}],
                      ["region_count", {"length": "selected.memory_regions", "limit": 16}],
                      ["poll_limit", {"source": "item.options.poll_limit"}],
                      ["priority", {"source": "item.options.irq.priority"}]
                    ]
                  }
                ],
                ["hclk_hz", {"symbol": "NEXUS_CORE_HZ"}],
                ["registers", {"symbol": "DCMI"}],
                [
                  "memory",
                  {
                    "record": [
                      ["dma", {"source": "selected.dma_bindings.0.registers", "as": "symbol"}],
                      ["stream", {"source": "selected.dma_bindings.0.stream", "as": "symbol"}],
                      ["irq", {"source": "selected.dma_bindings.0.irq", "as": "symbol"}],
                      ["lane", {"source": "selected.dma_bindings.0.lane"}],
                      ["channel", {"source": "selected.dma_bindings.0.request"}]
                    ]
                  }
                ],
                ["pixel_clock_hz", {"source": "item.options.pixel_clock_hz"}],
                ["max_service_gap_us", {"source": "item.options.max_service_gap_us"}],
                ["bits", {"source": "item.options.bits"}],
                ["frame_divisor", {"source": "item.options.frame_divisor"}],
                ["embedded", {"source": "item.options.embedded"}],
                ["pclk_falling", {"source": "item.options.pclk_falling"}],
                ["hsync_high", {"source": "item.options.hsync_high"}],
                ["vsync_high", {"source": "item.options.vsync_high"}],
                [
                  "codes",
                  {
                    "map": {"source": "item.options.codes", "limit": 4, "value": {"source": "entry"}}
                  }
                ],
                [
                  "jpeg",
                  {"source": "item.mode", "values": {"snapshot-raw": false, "snapshot-jpeg": true}}
                ],
                ["continuous", false],
                [
                  "crop",
                  {
                    "optional": "item.options.crop",
                    "value": {
                      "record": [
                        ["x_clocks", {"source": "item.options.crop.x_clocks"}],
                        ["y_lines", {"source": "item.options.crop.y_lines"}],
                        ["width_clocks", {"source": "item.options.crop.width_clocks"}],
                        ["height_lines", {"source": "item.options.crop.height_lines"}],
                        ["enabled", true]
                      ]
                    },
                    "default": {"record": []}
                  }
                ]
              ]
            }
          }
        ],
        "calls": {
          "prepare": {
            "function": "nx_stm32_capture_prepare",
            "args": [{"ref": "port", "as": "address"}, {"ref": "config", "as": "address"}]
          },
          "close": [{"function": "nx_stm32_capture_close", "args": [{"ref": "port", "as": "address"}]}],
          "admit": [
            {
              "function": "nx_stm32_capture_admit",
              "args": [{"ref": "port", "as": "address"}, {"ref": "config", "as": "address"}]
            }
          ]
        },
        "irq": [
          {
            "name": {"source": "selected.vector_bindings.0.handler", "as": "symbol"},
            "calls": [{"function": "nx_stm32_capture_irq", "args": [{"ref": "port", "as": "address"}]}],
            "barrier": "nx_arch_dsb"
          },
          {
            "name": {"source": "selected.dma_bindings.0.handler", "as": "symbol"},
            "calls": [{"function": "nx_stm32_capture_dma_irq", "args": [{"ref": "port", "as": "address"}]}],
            "barrier": "nx_arch_dsb"
          }
        ],
        "retain_on_failed_init": true,
        "pin_snapshots": {"source": "selected.pads", "key": "entry.identity", "array_role": "av_saved", "limit": 32}
      },
      "modes": ["snapshot-raw", "snapshot-jpeg"],
      "headers": ["stm32f407_capture.h"]
    },
