{
  "schema_version": 1,
  "bindings": [
    {
      "kind": "can",
      "mode": "classic-irq",
      "implementation": "can",
      "static_recipe": {
        "state_type": "nx_can_controller_t",
        "declarations": [
          {
            "role": "can_events",
            "type": "nx_can_event_t",
            "const": false,
            "count": {
              "source": "item.options.event_capacity"
            }
          },
          {
            "role": "can_pin_snapshots",
            "type": "uint16_t",
            "const": false,
            "count": 2
          },
          {
            "role": "can_pin_leases",
            "type": "uint8_t",
            "const": false
          },
          {
            "role": "can_pins",
            "type": "nx_stm32_platform_pin_config_t",
            "const": true,
            "count": 2,
            "value": {
              "map": {
                "source": "selected.pads",
                "limit": 2,
                "value": {
                  "record": [
                    [
                      "registers",
                      {
                        "source": "entry.registers",
                        "as": "symbol"
                      }
                    ],
                    [
                      "snapshot",
                      {
                        "ref": "can_pin_snapshots",
                        "as": "address",
                        "index": {
                          "source": "index",
                          "as": "u32"
                        }
                      }
                    ],
                    [
                      "port_index",
                      {
                        "source": "entry.port_index"
                      }
                    ],
                    [
                      "pin",
                      {
                        "source": "entry.number"
                      }
                    ]
                  ]
                }
              }
            }
          },
          {
            "role": "can_config",
            "type": "nx_stm32_can_config_t",
            "const": true,
            "value": {
              "record": [
                [
                  "domain",
                  {
                    "address": "s_nx_can_domain"
                  }
                ],
                [
                  "events",
                  {
                    "ref": "can_events",
                    "as": "symbol"
                  }
                ],
                [
                  "pins",
                  {
                    "ref": "can_pins",
                    "as": "symbol"
                  }
                ],
                [
                  "capacity",
                  {
                    "source": "item.options.event_capacity"
                  }
                ],
                [
                  "timing",
                  {
                    "record": [
                      [
                        "bitrate",
                        {
                          "source": "item.options.bitrate"
                        }
                      ],
                      [
                        "prescaler",
                        {
                          "source": "item.options.timing.prescaler"
                        }
                      ],
                      [
                        "segment1",
                        {
                          "source": "item.options.timing.segment1"
                        }
                      ],
                      [
                        "segment2",
                        {
                          "source": "item.options.timing.segment2"
                        }
                      ],
                      [
                        "sjw",
                        {
                          "source": "item.options.timing.sjw"
                        }
                      ]
                    ]
                  }
                ],
                [
                  "irq_policy",
                  {
                    "record": [
                      [
                        "kernel",
                        {
                          "source": "selected.kernel_policy",
                          "as": "symbol"
                        }
                      ],
                      [
                        "external_irq_count",
                        {
                          "source": "selected.irq_profile.external_count"
                        }
                      ],
                      [
                        "priority_bits",
                        {
                          "source": "selected.irq_profile.priority_bits"
                        }
                      ],
                      [
                        "syscall_ceiling",
                        {
                          "source": "selected.irq_profile.syscall_priority",
                          "default": 0
                        }
                      ]
                    ]
                  }
                ],
                [
                  "drain_timeout_us",
                  {
                    "source": "item.options.drain_timeout_us"
                  }
                ],
                [
                  "poll_limit",
                  {
                    "source": "item.options.poll_limit"
                  }
                ],
                [
                  "mode",
                  {
                    "source": "item.options.operation",
                    "as": "symbol",
                    "values": {
                      "normal": "NX_CAN_NORMAL",
                      "loopback": "NX_CAN_LOOPBACK",
                      "silent-loopback": "NX_CAN_SILENT_LOOPBACK"
                    }
                  }
                ],
                [
                  "index",
                  {
                    "source": "selected.constants.controller_index"
                  }
                ],
                [
                  "priority",
                  {
                    "source": "item.options.irq.priority"
                  }
                ],
                [
                  "fifo_order",
                  {
                    "source": "item.options.fifo_order"
                  }
                ]
              ]
            }
          }
        ],
        "calls": {
          "prepare": {
            "function": "nx_stm32_can_prepare",
            "args": [
              {
                "ref": "port",
                "as": "address"
              },
              {
                "ref": "can_config",
                "as": "address"
              },
              {
                "ref": "can_pin_leases",
                "as": "address"
              }
            ]
          },
          "close": [
            {
              "function": "nx_stm32_can_close",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                },
                {
                  "ref": "can_config",
                  "as": "address"
                },
                {
                  "ref": "can_pin_leases",
                  "as": "address"
                }
              ]
            }
          ]
        },
        "irq": [
          {
            "map": {
              "source": "selected.vector_bindings",
              "limit": 4,
              "value": {
                "name": {
                  "source": "entry.handler",
                  "as": "symbol"
                },
                "calls": [
                  {
                    "function": "nx_can_controller_irq",
                    "args": [
                      {
                        "ref": "port",
                        "as": "address"
                      }
                    ]
                  }
                ],
                "barrier": "nx_arch_dsb"
              }
            }
          }
        ],
        "pin_snapshots": {
          "source": "selected.pads",
          "key": "entry.identity",
          "array_role": "can_pin_snapshots",
          "limit": 2
        },
        "retain_on_failed_init": true,
        "ops": "nx_classic_can_ops"
      },
      "headers": [
        "stm32f407_can_cold.h"
      ]
    }
  ]
}
