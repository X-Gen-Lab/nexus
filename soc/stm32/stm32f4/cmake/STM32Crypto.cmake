# Each selected basic crypto engine has one official transport object.
include_guard(GLOBAL)
function(nexus_stm32f4_crypto_hal target)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/STM32Official.cmake")
    nexus_stm32f4_device_definition("${target}" device)
    get_filename_component(source
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../.." ABSOLUTE)
    set(sources)
    set(dma OFF)
    foreach(kind cipher hash)
        nexus_controller_modes(modes "${kind}")
        if("dma-blocks" IN_LIST modes)
            string(TOUPPER "${kind}" upper_kind)
            target_compile_definitions("${target}" PRIVATE
                "NEXUS_STM32_${upper_kind}_DMA=1")
            set(dma ON)
        endif()
    endforeach()
    if(dma)
        target_compile_definitions("${target}" PRIVATE NEXUS_STM32_CRYPTO_DMA=1)
        target_link_libraries("${target}" PRIVATE Nexus::IODMA)
        nexus_stm32f4_dma_hal("${target}")
    endif()
    if("cipher" IN_LIST NEXUS_SELECTED_KINDS)
        list(APPEND sources
            "${source}/vendors/st/stm32f4_hal/Src/stm32f4xx_hal_cryp.c")
    endif()
    if("hash" IN_LIST NEXUS_SELECTED_KINDS)
        list(APPEND sources
            "${source}/vendors/st/stm32f4_hal/Src/stm32f4xx_hal_hash.c")
    endif()
    if(NOT sources)
        message(FATAL_ERROR "Crypto HAL requires a selected engine")
    endif()
    set(vendor "${target}_crypto_hal")
    add_library("${vendor}" OBJECT ${sources})
    nexus_stm32f4_official("${vendor}")
    target_compile_features("${vendor}" PRIVATE c_std_11)
    set_target_properties("${vendor}" PROPERTIES C_EXTENSIONS OFF)
    target_compile_definitions("${vendor}" PRIVATE "${device}")
    if(dma)
        target_compile_definitions("${vendor}" PRIVATE NEXUS_STM32_CRYPTO_DMA=1)
    endif()
    target_include_directories("${vendor}" PRIVATE
        "${source}/soc/stm32/stm32f4/private/crypto_hal")
    target_include_directories("${vendor}" SYSTEM PRIVATE
        "${source}/vendors/st/cmsis_device_f4/Include")
    include("${source}/cmake/platform/CMSISCore.cmake")
    nexus_use_cmsis_core("${vendor}")
    target_link_libraries("${vendor}" PRIVATE nexus_build_options Nexus::Arch)
    target_compile_options("${vendor}" PRIVATE
        -ffunction-sections -fdata-sections)
    target_sources("${target}" PRIVATE "$<TARGET_OBJECTS:${vendor}>")
endfunction()
