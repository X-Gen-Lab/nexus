{
  "schema_version": 1,
  "bindings": [
    {
      "kind": "gpio",
      "modes": [
        "input",
        "output"
      ],
      "implementation": "gpio",
      "headers": [
        "drivers/gpio/instance.h"
      ],
      "static_recipe": {
        "state_type": "nx_stm32f1_gpio_t",
        "declarations": [
          {
            "role": "gpio_config",
            "type": "nx_stm32f1_gpio_config_t",
            "const": true,
            "value": {
              "record": [
                [
                  "registers",
                  {
                    "source": "item.controller",
                    "as": "symbol"
                  }
                ],
                [
                  "mask",
                  {
                    "source": "item.route_mask",
                    "default": {
                      "source": "item.options.mask"
                    }
                  }
                ],
                [
                  "initial",
                  {
                    "source": "item.route_initial",
                    "default": {
                      "source": "item.options.initial"
                    }
                  }
                ],
                [
                  "output",
                  {
                    "source": "item.mode",
                    "values": {
                      "input": false,
                      "output": true
                    }
                  }
                ],
                [
                  "pull",
                  {
                    "source": "item.options.pull",
                    "values": {
                      "none": 0,
                      "up": 1,
                      "down": 2
                    }
                  }
                ],
                [
                  "output_type",
                  {
                    "source": "item.options.output_type",
                    "values": {
                      "push-pull": 0,
                      "open-drain": 1
                    }
                  }
                ],
                [
                  "speed",
                  {
                    "source": "item.options.speed",
                    "values": {
                      "preserve": 0,
                      "low": 1,
                      "medium": 2,
                      "high": 3
                    }
                  }
                ]
              ]
            }
          }
        ],
        "calls": {
          "admit": [
            {
              "function": "nx_stm32f1_gpio_admit",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                },
                {
                  "ref": "gpio_config",
                  "as": "address"
                }
              ]
            }
          ],
          "prepare": {
            "function": "nx_stm32f1_gpio_prepare",
            "args": [
              {
                "ref": "port",
                "as": "address"
              },
              {
                "ref": "gpio_config",
                "as": "address"
              }
            ]
          },
          "close": [
            {
              "function": "nx_stm32f1_gpio_close",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                }
              ]
            }
          ]
        },
        "ops": "nx_stm32f1_gpio_ops",
        "retain_on_failed_init": true
      }
    }
  ]
}
