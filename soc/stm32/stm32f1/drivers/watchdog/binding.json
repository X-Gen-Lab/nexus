{
  "schema_version": 1,
  "bindings": [
    {
      "kind": "watchdog",
      "mode": "independent",
      "implementation": "watchdog",
      "headers": [
        "drivers/watchdog/instance.h"
      ],
      "static_recipe": {
        "state_type": "nx_stm32f1_watchdog_state_t",
        "ops": "nx_stm32f1_watchdog_ops",
        "declarations": [],
        "calls": {
          "prepare": {
            "function": "nx_stm32f1_watchdog_prepare",
            "args": [
              {
                "ref": "port",
                "as": "address"
              }
            ]
          },
          "close": [
            {
              "function": "nx_stm32f1_watchdog_close",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                }
              ]
            }
          ]
        },
        "retain_on_failed_init": false
      }
    },
    {
      "kind": "watchdog",
      "mode": "window",
      "implementation": "window_watchdog",
      "static_recipe": {
        "state_type": "nx_stm32f1_wwdg_t",
        "ops": "nx_stm32f1_wwdg_ops",
        "declarations": [],
        "calls": {
          "admit": [
            {
              "function": "nx_stm32f1_wwdg_admit",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                },
                {
                  "source": "item.options.window_ticks"
                }
              ]
            }
          ],
          "prepare": {
            "function": "nx_stm32f1_wwdg_prepare",
            "args": [
              {
                "ref": "port",
                "as": "address"
              },
              {
                "source": "item.options.window_ticks"
              }
            ]
          },
          "close": [
            {
              "function": "nx_stm32f1_wwdg_close",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                }
              ]
            }
          ]
        },
        "retain_on_failed_init": true
      },
      "headers": [
        "drivers/watchdog/window_watchdog.h"
      ]
    }
  ]
}
