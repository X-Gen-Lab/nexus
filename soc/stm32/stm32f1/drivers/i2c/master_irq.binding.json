{
  "schema_version": 1,
  "bindings": [
    {
      "kind": "i2c",
      "mode": "irq-write-messages",
      "controllers": [
        "I2C1"
      ],
      "implementation": "i2c_irq_writer",
      "headers": [
        "drivers/i2c/master_irq.h"
      ],
      "limits": {
        "max_hz": [
          80000,
          80000
        ],
        "irq_priority": [
          0,
          0
        ]
      },
      "static_recipe": {
        "state_type": "nx_i2c_v1_state_t",
        "ops": "nx_i2c_v1_async_ops",
        "declarations": [
          {
            "role": "cold",
            "type": "nx_stm32f1_i2c_irq_cold_t",
            "const": false
          }
        ],
        "calls": {
          "prepare": {
            "function": "nx_stm32f1_i2c_irq_open",
            "args": [
              {
                "ref": "port",
                "as": "address"
              },
              {
                "ref": "cold",
                "as": "address"
              }
            ]
          },
          "close": [
            {
              "function": "nx_stm32f1_i2c_irq_close",
              "args": [
                {
                  "ref": "port",
                  "as": "address"
                },
                {
                  "ref": "cold",
                  "as": "address"
                }
              ]
            }
          ]
        },
        "retain_on_failed_init": true,
        "child_groups": {
          "limit": 64,
          "cases": {
            "i2c-endpoint": {
              "parents": {
                "parent_port": "port"
              },
              "declarations": [
                {
                  "role": "endpoint",
                  "type": "nx_i2c_v1_endpoint_t",
                  "const": false,
                  "value": {
                    "record": [
                      [
                        "port",
                        {
                          "ref": "parent_port",
                          "as": "address"
                        }
                      ],
                      [
                        "address",
                        {
                          "source": "item.child.options.address",
                          "as": "u32"
                        }
                      ],
                      [
                        "address_bits",
                        {
                          "source": "item.child.options.address_bits",
                          "as": "u32"
                        }
                      ]
                    ]
                  }
                }
              ],
              "calls": {
                "prepare": [],
                "close": []
              },
              "face": {
                "type": "nx_i2c_endpoint_t",
                "ops": "nx_i2c_v1_async_endpoint_ops",
                "context": {
                  "ref": "endpoint",
                  "as": "address"
                }
              }
            }
          }
        },
        "irq": [
          {
            "map": {
              "source": "selected.vector_bindings",
              "limit": 2,
              "value": {
                "name": {
                  "source": "entry.handler",
                  "as": "symbol"
                },
                "calls": [
                  {
                    "function": "nx_i2c_v1_irq",
                    "args": [
                      {
                        "ref": "port",
                        "as": "address"
                      }
                    ]
                  }
                ],
                "barrier": "nx_arch_dsb"
              }
            }
          }
        ]
      }
    }
  ]
}
