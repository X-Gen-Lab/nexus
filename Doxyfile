# Current public C contracts; vendor/private/history inputs are excluded.
PROJECT_NAME           = "Nexus Embedded Platform"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Statically assembled reusable embedded mechanisms"
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO
JAVADOC_AUTOBRIEF      = NO
TAB_SIZE               = 4
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"
QUIET                  = YES
INPUT                  = core/include/nexus arch/include/nexus io/include/nexus os/include/nexus os/native/include/nexus os/freertos/include/nexus components/bus_owner/include/nexus components/bmp280/include/nexus components/modbus/include/nexus components/storage/include/nexus components/log/include/nexus
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */private/* */vendors/* */build/* */docs/archive/*
STRIP_FROM_PATH        = .
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = NO
HAVE_DOT               = NO
