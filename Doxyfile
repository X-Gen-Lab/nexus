# Current public C contracts; vendor/private/history inputs are excluded.
PROJECT_NAME           = "Nexus Embedded Platform"
# The maintained docs CLI derives the release number from the compatibility JSON.
PROJECT_NUMBER         = "source-preview"
PROJECT_BRIEF          = "Statically assembled reusable embedded mechanisms"
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO
JAVADOC_AUTOBRIEF      = NO
TAB_SIZE               = 4
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"
QUIET                  = YES
INPUT                  = core/include/nexus arch/include/nexus io/include/nexus os/include/nexus os/native/include/nexus os/freertos/include/nexus components/runtime/bus_owner/include/nexus components/devices/bmp280/include/nexus components/protocols/modbus/include/nexus components/services/storage/include/nexus components/services/settings/include/nexus components/services/log/include/nexus os/threadx/include/nexus components/runtime/user_io_broker/include/nexus components/devices/dp83848/include/nexus components/runtime/clock_domain/include/nexus components/runtime/owner_observer/include/nexus components/protocols/usb_control/include/nexus components/services/mapped_storage/include/nexus components/runtime/amp_ipc/include/nexus components/buses/i3c_controller/include/nexus
INPUT                  += soc/stm32/stm32f4/include/nexus
INPUT                  += components/protocols/network/include/nexus
INPUT                  += components/protocols/tls/include/nexus
INPUT                  += components/protocols/mqtt/include/nexus
INPUT                  += components/devices/tmp117/include/nexus
INPUT                  += components/protocols/mcuboot/include/nexus
INPUT                  += components/devices/at24c02/include/nexus
INPUT                  += components/buses/software_i2c/include/nexus
INPUT                  += components/buses/smbus/include/nexus
INPUT                  += components/buses/software_spi/include/nexus
INPUT                  += components/devices/w25/include/nexus
INPUT                  += components/devices/ili9341/include/nexus
INPUT                  += components/devices/xpt2046/include/nexus
INPUT                  += components/buses/onewire/include/nexus
INPUT                  += components/devices/ds18b20/include/nexus
INPUT                  += components/devices/infrared/include/nexus
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */private/* */vendors/* */build/* */docs/archive/*
STRIP_FROM_PATH        = .
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            = "PRIVILEGED_FUNCTION=" \
                        "NX_FREERTOS_USER_CODE="
SEARCH_INCLUDES        = NO
HAVE_DOT               = NO
