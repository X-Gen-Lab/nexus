# Current public C contracts; vendor/private/history inputs are excluded.
PROJECT_NAME           = "Nexus Embedded Platform"
# The maintained docs CLI derives the release number from the compatibility JSON.
PROJECT_NUMBER         = "source-preview"
PROJECT_BRIEF          = "Statically assembled reusable embedded mechanisms"
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO
JAVADOC_AUTOBRIEF      = NO
TAB_SIZE               = 4
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"
QUIET                  = YES
INPUT                  = core/include/nexus arch/include/nexus io/include/nexus os/include/nexus os/native/include/nexus os/freertos/include/nexus components/bus_owner/include/nexus components/bmp280/include/nexus components/modbus/include/nexus components/storage/include/nexus components/log/include/nexus os/threadx/include/nexus components/user_io_broker/include/nexus components/dp83848/include/nexus components/clock_domain/include/nexus components/owner_observer/include/nexus components/usb_control/include/nexus components/mapped_storage/include/nexus components/amp_ipc/include/nexus components/stm32f407_handoff/include/nexus components/frame_dma2d/include/nexus
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */private/* */vendors/* */build/* */docs/archive/*
STRIP_FROM_PATH        = .
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            = "PRIVILEGED_FUNCTION=" \
                        "NX_FREERTOS_USER_CODE="
SEARCH_INCLUDES        = NO
HAVE_DOT               = NO
