msgid "无注册查找/通用ref/OS锁，使用授权 mask，支持同port batch"
msgstr ""
"No registry lookup/generic refs/OS locks; authorized masks and same-port "
"batches."

#: ../../../workspace/nexus-build-system-20261012/docs/design/next-generation-platform.md:0
msgid "反汇编＋DWT/logic analyzer"
msgstr "Disassembly + DWT/logic analyzer."

#: ../../../workspace/nexus-build-system-20261012/docs/design/next-generation-platform.md:0
msgid "request admission"
msgstr "request admission"

#: ../../../workspace/nexus-build-system-20261012/docs/design/next-generation-platform.md:0
msgid "O(1)或明确固定队列上界；无payload复制/分配/名称查找"
msgstr ""
"O(1) or explicit fixed queue bounds; no payload copy, allocation or name "
