msgstr "SAI1 A, AF6"

msgid "PE4 FS_A、PE5 SCK_A、PE6 SD_A"
msgstr "PE4 FS_A, PE5 SCK_A, PE6 SD_A"

msgid "duplex 接 PE3 SD_B；PE2 MCLK_A"
msgstr "PE3 SD_B for duplex; PE2 MCLK_A"

