msgid "旧版用户"
msgstr "Legacy user"

#: ../../../workspace/nexus-build-system-20261012/docs/design/documentation-system.md:0
msgid "配置迁移 → 接口迁移 → 所有权变化 → 重验证"
msgstr ""
"Configuration migration → interface migration → ownership changes → "
