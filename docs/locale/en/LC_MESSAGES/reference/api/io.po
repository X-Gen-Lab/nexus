msgid "wake.h"
msgstr "wake.h"

msgid "Explicit borrowed IRQ wake target and syscall-ceiling check."
msgstr "Explicit borrowed IRQ wake target and syscall-ceiling check."

msgid "Explicit kernel interrupt-mask policy, independent of any RTOS."
msgstr "Explicit kernel interrupt-mask policy, independent of any RTOS."

msgid "Validate actual IRQ facts against an explicit kernel policy."
msgstr "Validate actual IRQ facts against an explicit kernel policy."

msgid ""
"Cold check without attachment or callback effects. No kernel target is "
"accepted by NONE. PRIMASK permits every valid configurable IRQ with its "
"fixed zero priority group. Kernel-calling BASEPRI targets require the "
"maintained preemption grouping and a numerical priority at least the "
"ceiling. Nonkernel hints do not impose kernel grouping. Binding does not "
"authorize future CPU-context violations."
msgstr ""
"Cold check without attachment or callback effects. No kernel target is "
"accepted by NONE. PRIMASK permits every valid configurable IRQ with its "
"fixed zero priority group. Kernel-calling BASEPRI targets require the "
"maintained preemption grouping and a numerical priority at least the "
"ceiling. Nonkernel hints do not impose kernel grouping. Binding does not "
"authorize future CPU-context violations."

msgid "[in] Optional immutable target; NULL disables notification."
msgstr "[in] Optional immutable target; NULL disables notification."

msgid "[in] Immutable validated CPU and kernel configuration."
msgstr "[in] Immutable validated CPU and kernel configuration."

msgid "[in] External IRQ number, unshifted priority and group."
msgstr "[in] External IRQ number, unshifted priority and group."

msgid ""
"Success, INVALID for malformed facts/target, PERMISSION for a kernel-calling"
" target in an unsafe interrupt domain."
msgstr ""
"Success, INVALID for malformed facts/target, PERMISSION for a kernel-calling"
" target in an unsafe interrupt domain."

msgid "Deliver one bounded hint after authoritative state is latched."
msgstr "Deliver one bounded hint after authoritative state is latched."

