msgstr "[inout] Separate aligned 24-byte SRAM4 LLI workspace."

msgid "[in] Absolute microseconds in that domain, or NEVER."
msgstr "[in] Absolute microseconds in that domain, or NEVER."

msgid "Latch cancellation of the exact active identity without release."
msgstr "Latch cancellation of the exact active identity without release."

msgid "Late cancellation after observed channel completion rejects STATE. Cancellation before unobserved completion fixes the first failure. DMA drain alone cannot release an AlarmA/WUT/clock restoration loan."
msgstr "Late cancellation after observed channel completion rejects STATE. Cancellation before unobserved completion fixes the first failure. DMA drain alone cannot release an AlarmA/WUT/clock restoration loan."

msgid "[in] Immutable face of the initialized physical receiver."
msgstr "[in] Immutable face of the initialized physical receiver."

