msgstr "24 KiB"

msgid "Vectors, ordinary code/rodata, kernel, public I/O helpers and concrete provider; user execution forbidden"
msgstr "向量、普通 code/rodata、kernel、公共 I/O helper 及具体 provider；禁止 user 执行"

