msgstr "真实 wire TC 或已审 reset abort、TX IRQ 撤销及已捕获 wake join"

msgid "UART IRQ blocks"
msgstr "UART IRQ 数据块"

msgid "One hardware byte per IRQ; block acquisition/release is explicit"
msgstr "每 IRQ 一个硬件字节；block acquire/release 显式"

msgid ""
