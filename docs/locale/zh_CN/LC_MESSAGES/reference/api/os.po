msgid "diagnostic.h"
msgstr "diagnostic.h"

#: ../../../../docs/reference/api/os.md:72
msgid "Bounded diagnostics with explicit caller-owned ring storage."
msgstr "使用调用者显式环形存储的有界诊断。"

