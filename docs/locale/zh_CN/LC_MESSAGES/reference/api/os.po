#: ../../../../tmp/nexus-quality-20261019/docs/reference/api/os.md:90
msgid "[inout] Live queue"
msgstr "[inout] 存活队列"

#: ../../../../tmp/nexus-quality-20261019/docs/reference/api/os.md:34
msgid "[in] At least configured item bytes; not retained afterward"
msgstr "[in] 至少为已配置条目字节数；返回后不再保留"

#: ../../../../tmp/nexus-quality-20261019/docs/reference/api/os.md:34
msgid "[in] Explicit relative wait; portMAX_DELAY prohibited"
msgstr "[in] 显式相对等待；禁止 portMAX_DELAY"

#: ../../../../tmp/nexus-quality-20261019/docs/reference/api/os.md:34
msgid "SUCCESS, TIMEOUT, INVALID or CONTEXT"
msgstr "SUCCESS、TIMEOUT、INVALID 或 CONTEXT"

#: ../../../../tmp/nexus-quality-20261019/docs/reference/api/os.md:34
msgid "Receive one byte-copy item."
msgstr "接收一个字节复制条目。"

#: ../../../../tmp/nexus-quality-20261019/docs/reference/api/os.md:34
