#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Validate complete writable regions without reserving any storage."
msgstr "校验完整可写区域，不预留任何存储。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"Task-only metadata check. Same-provider regions must not overlap. Provider "
"aliases sharing one context are treated as the same device."
msgstr "仅 task 的 metadata 检查。同提供者区域不得重叠。共享一个 context 的提供者别名视为同一设备。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Stable product-owned region array, or NULL when empty."
msgstr "[in] 稳定的产品区域数组；空数组时可为 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Exact number of region descriptors."
msgstr "[in] 精确区域描述符数量。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "SUCCESS; INVALID or PERMISSION for bounds, geometry or overlap."
msgstr "SUCCESS；边界、几何或重叠错误返回 INVALID 或 PERMISSION。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Bind one explicit uniformly erasable writable region."
msgstr "绑定一个显式、均一可擦除的可写区域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"Task-only. Fresh-erase-only media need a separately qualified profile and "
"are rejected here. No initialization, probe or hardware access."
msgstr "仅 task。要求全新擦除的介质需要单独取得资格的 profile，在此拒绝。不执行初始化、探测或硬件访问。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[out] Unused or quiesced caller-owned state."
msgstr "[out] 未使用或已静默的调用方状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Exact sector-aligned product selection, copied on success."
msgstr "[in] 产品选择的精确扇区对齐区域，成功时复制。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Finite monotonic clock in the provider's deadline domain."
msgstr "[in] 提供者截止时间域中的有限单调时钟。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "SUCCESS, INVALID, PERMISSION or UNSUPPORTED; failure changes nothing."
msgstr "SUCCESS、INVALID、PERMISSION 或 UNSUPPORTED；失败时不改任何内容。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Begin one externally serialized operation with a shared deadline."
msgstr "开始一次外部串行化操作，共享同一截止时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"Does not acquire a lock. All database and filesystem users of the same "
"physical provider must share the product's execution serialization."
msgstr "不获取锁。同一物理提供者的所有数据库和文件系统使用者，必须共享产品的执行串行化机制。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[inout] Bound idle bridge, same physical execution owner."
msgstr "[inout] 已绑定的空闲 bridge，由同一物理执行 owner 驱动。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Finite absolute deadline covering the entire operation."
msgstr "[in] 覆盖整个操作的有限绝对截止时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "SUCCESS, BUSY, STATE, INVALID or TIMEOUT without hardware effects."
msgstr "SUCCESS、BUSY、STATE、INVALID 或 TIMEOUT；没有硬件效果。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "End an operation after every synchronous callback has returned."
msgstr "全部同步回调返回后结束操作。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"An error never implies rollback. Mutating failures require recovery before "
"another begin; no caller buffer remains borrowed on return."
msgstr "错误从不表示回滚。修改失败要求先恢复再进行另一次 begin；返回时不再借用调用方 buffer。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[inout] Active serialized bridge."
msgstr "[inout] 活跃且串行化的 bridge。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "First latched error or SUCCESS; STATE for an inactive bridge."
msgstr "首个锁存错误或 SUCCESS；bridge 未活跃时为 STATE。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Read within the selected region and transaction budget."
msgstr "在选定区域及事务预算内读取。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[inout] Active bridge; same owner throughout this call."
msgstr "[inout] 活跃 bridge；整个调用由同一 owner 执行。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Region-relative byte offset."
msgstr "[in] 相对于区域的字节偏移。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[out] Writable bytes borrowed until return only."
msgstr "[out] 可写字节，仅借用到返回。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Positive representable byte count."
msgstr "[in] 可表示的正字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Exactly bytes on success, negative on failure; never a short success."
msgstr "成功时恰为 bytes，失败时为负数；从不将短读报告为成功。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Program complete aligned units and settle the current hardware pulse."
msgstr "编程完整对齐单元，并结清当前硬件脉冲。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "No retry or read-modify-write is hidden in this adapter."
msgstr "此适配器不隐藏重试或读改写。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[inout] Active bridge with admitted non-ECC profile."
msgstr "[inout] 活跃 bridge，使用已准入的非 ECC profile。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Region-relative aligned byte offset."
msgstr "[in] 区域内相对对齐字节偏移。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Immutable input borrowed until return only."
msgstr "[in] 不可变输入，仅借用到返回。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"[in] Positive byte count in complete program-unit multiples, at most "
"INT_MAX."
msgstr "[in] 正数字节数，必须为完整 program-unit 的整数倍，至多 INT_MAX。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Exactly bytes on success, negative on failure; partial effects remain."
msgstr "成功时恰为 bytes，失败时为负数；可能保留部分效果。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Erase only complete region-contained physical sectors."
msgstr "仅擦除完全位于区域内的完整物理扇区。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Region-relative exact sector boundary."
msgstr "[in] 区域内相对精确扇区边界。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[in] Positive complete-sector byte count, at most INT_MAX."
msgstr "[in] 正的完整扇区字节数，最多 INT_MAX。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Exactly bytes on success, negative on failure; no outward rounding."
msgstr "成功时恰为 bytes，失败时为负数；不向外取整。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Retry physical cleanup without replaying any database mutation."
msgstr "重试物理清理，不重放任何数据库修改。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"Recovery never upgrades the original operation or proves its contents. A "
"clock epoch loss requires external recovery, not deadline renewal."
msgstr "恢复不提升原操作结果，也不证明其内容。时钟代次丢失需要外部恢复，不能通过续期截止时间处理。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "[inout] Inactive failed bridge retained by the same owner."
msgstr "[inout] 同一 owner 保留的非活跃失败 bridge。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Underlying recovery result; SUCCESS permits logical reopen only."
msgstr "底层恢复结果；SUCCESS 仅允许重新打开逻辑层。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid "Caller-owned bridge; fields are private after successful binding."
msgstr "调用方拥有的 bridge；成功绑定后字段为私有状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:179
msgid ""
"No hardware owner, partition registry, heap or hidden lock. The exact "
"provider, region and clock remain live until all consumers have joined."
msgstr "不创建硬件 owner、分区注册表、堆或隐藏锁。精确提供者、区域和时钟须保持存活，直到全部消费者退出。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:183
msgid "flashdb.h"
msgstr "flashdb.h"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Caller-owned KVDB and TSDB over explicit Flash regions."
msgstr "基于显式 Flash 区域、由调用方拥有的 KVDB 和 TSDB。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:281
msgid "Typedefs"
msgstr "类型定义"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Return true to stop traversal; no recursive database operations."
msgstr "返回 true 停止遍历；禁止递归数据库操作。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Explicit algorithm selection; Settings snapshot semantics differ."
msgstr "显式算法选择；不同于 Settings 快照语义。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Unknown or damaged existing media is never implicitly reformatted."
msgstr "未知或损坏的已有介质从不隐式重新格式化。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "TS status advances only; local commit never implies remote ACK."
msgstr "TS 状态只能前进；本地提交从不表示远端 ACK。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Supply the product's explicitly active database operation."
msgstr "提供产品显式激活的数据库操作。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"Implemented by the consumer, without a library global device registry. No "
"ISR use. A getter must not acquire hardware or recurse into this API."
msgstr "由消费者实现，不使用库级全局设备注册表。禁止 ISR 使用。getter 不得获取硬件资源或递归进入此 API。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Exact operation passed to the current API, or NULL outside a call."
msgstr "传入当前 API 的精确 operation；调用之外为 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Query exact private workspace size for this fixed build profile."
msgstr "查询此固定构建 profile 的精确私有工作区大小。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"No allocation or initialization. The profile uses 32-bit program granularity"
" and disabled dynamic read/KV caches, not every ECC device."
msgstr "不分配内存或初始化。profile 采用 32-bit 编程粒度，禁用动态 read/KV cache；并非适用于所有 ECC 设备。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Nonzero bytes; alignment is reported separately."
msgstr "非零字节数；对齐单独报告。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Return required workspace alignment without accessing hardware."
msgstr "返回所需工作区对齐，不访问硬件。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Initialize metadata without reading, writing or formatting media."
msgstr "初始化 metadata，不读取、写入或格式化介质。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[out] Unused caller state, disjoint from workspace."
msgstr "[out] 未使用的调用方状态，与工作区不重叠。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[inout] Bound same-owner non-ECC region, retained until close."
msgstr "[inout] 已绑定、同 owner 的非 ECC 区域，保留到 close。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] KVDB or TSDB algorithm selection."
msgstr "[in] KVDB 或 TSDB 算法选择。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[inout] Aligned caller bytes, retained until close."
msgstr "[inout] 调用方对齐字节存储，保留到 close。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:203
msgid "[in] At least the exact reported requirement."
msgstr "[in] 至少达到精确报告的需求。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Positive TS record bound; ignored for KVDB."
msgstr "[in] 正的 TS 记录上限；KVDB 忽略此项。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS, INVALID or UNSUPPORTED; rejection changes no state."
msgstr "SUCCESS、INVALID 或 UNSUPPORTED；拒绝时不改状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Open existing data or explicitly initialize a wholly erased region."
msgstr "打开已有数据，或显式初始化完全已擦除的区域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"Existing corruption is never treated as empty. Firmware/library format "
"migrations, authentication, defaults and power-loss policy are external. "
"First opens across instances are serialized before publishing users; "
"upstream initialization includes a shared logging flag."
msgstr ""
"已有损坏从不视为空。固件／库格式迁移、认证、默认值和掉电策略由外部负责。各实例首次 open 须在发布使用者前串行执行；上游初始化包含共享 "
"logging flag。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Exact active product scope, finite whole-call deadline."
msgstr "[in] 精确活跃产品作用域，采用有限整调用截止时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Existing-only or permission to create on erased media."
msgstr "[in] 仅使用已有介质，或允许在已擦除介质上创建。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS, EMPTY, IO or underlying bridge error; no implicit repair."
msgstr "SUCCESS、EMPTY、IO 或底层 bridge 错误；不隐式修复。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Explicitly erase an entire closed database region."
msgstr "显式擦除整个已关闭数据库区域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"Destructive product decision. No ordinary open or failed read calls it."
msgstr "破坏性产品决策。普通 open 或失败 read 从不调用它。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Active scope for a closed initialized database."
msgstr "[in] 已关闭且已初始化数据库的活跃作用域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS or a retained mutation error; no automatic reopen."
msgstr "SUCCESS 或保留的修改错误；不自动 reopen。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Release only quiesced logical database state, without committing."
msgstr "仅释放已静默的逻辑数据库状态，不提交。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Close does not stop hardware or clear the bridge's recovery duty."
msgstr "Close 不停止硬件，也不清除 bridge 的恢复责任。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[inout] Serialized initialized state, or NULL."
msgstr "[inout] 串行化的已初始化状态，或 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS, BUSY or INVALID; physical failed ownership stays retained."
msgstr "SUCCESS、BUSY 或 INVALID；失败的物理所有权仍保留。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Persist one copied KV value with upstream GC and recovery semantics."
msgstr "持久化一个复制的 KV 值，采用上游 GC 与恢复语义。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "This writes immediately. It is not Settings set-plus-commit staging."
msgstr "立即写入，不是 Settings 的 set 后 commit 暂存。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Active open KVDB scope."
msgstr "[in] 活跃且已打开的 KVDB 作用域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Nonempty NUL-terminated key shorter than 64 bytes."
msgstr "[in] 非空 NUL 结尾 key，短于 64 bytes。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Immutable bytes borrowed until return; NULL only if empty."
msgstr "[in] 不可变字节，借用到返回；仅空数据允许 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Value length within the selected database capacity."
msgstr "[in] 所选数据库容量内的值长度。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"SUCCESS, EXHAUSTED, INVALID or error; failure may already have effects."
msgstr "SUCCESS、EXHAUSTED、INVALID 或错误；失败可能已经产生效果。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Copy one KV value without exposing retained vendor pointers."
msgstr "复制一个 KV 值，不公开保留的供应商指针。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Exact bounded key."
msgstr "[in] 精确有界 key。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[out] Disjoint output or NULL to query required bytes."
msgstr "[out] 不重叠的输出；查询所需字节时为 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[inout] Capacity on input, required bytes on success/EXHAUSTED."
msgstr "[inout] 输入为容量，success/EXHAUSTED 时为所需字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS, EMPTY, EXHAUSTED or error; no read truncation success."
msgstr "SUCCESS、EMPTY、EXHAUSTED 或错误；截断读取不算成功。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Persist deletion of one key, independently of any other key."
msgstr "持久化删除一个 key，与其他 key 相互独立。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS, EMPTY or error; no multi-key snapshot promise."
msgstr "SUCCESS、EMPTY 或错误；不承诺多 key 快照。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Append one timestamped TS record without implying business delivery."
msgstr "追加带时间戳的 TS 记录，不表示业务交付。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"Rollover is disabled by this profile. Full media requires an explicit "
"product retention/reclamation decision; no reliable outbox is implied."
msgstr "此 profile 禁用 rollover。介质满时须由产品显式决定保留／回收策略；不隐含可靠 outbox。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Active open TSDB scope."
msgstr "[in] 活跃且已打开的 TSDB 作用域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Nonnegative strictly increasing selected 64-bit time."
msgstr "[in] 所选非负且严格递增的 64-bit 时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Borrowed immutable record bytes."
msgstr "[in] 借用的不可变记录字节。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Positive bytes at most the configured maximum."
msgstr "[in] 正字节数，不超过配置上限。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS, EXHAUSTED, INVALID or error; never silently rolls over."
msgstr "SUCCESS、EXHAUSTED、INVALID 或错误；从不静默 rollover。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Visit committed TS records using caller-provided scratch bytes."
msgstr "使用调用方 scratch 字节访问已提交的 TS 记录。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Active open TSDB scope, retained through all callbacks."
msgstr "[in] 活跃且已打开的 TSDB 作用域，保留到全部回调结束。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[inout] Disjoint caller buffer valid during this call only."
msgstr "[inout] 不重叠的调用方 buffer，仅在本次调用期间有效。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] At least the configured maximum record length."
msgstr "[in] 至少为配置的最大记录长度。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Bounded callback; cannot retain data or reenter database."
msgstr "[in] 有界回调；不能保留数据或重入数据库。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Caller callback context."
msgstr "[in] 调用方回调上下文。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "SUCCESS or error; callback observes only complete copied records."
msgstr "SUCCESS 或错误；回调只观察完整复制的记录。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Advance a still-existing record status without repeating its pulse."
msgstr "推进仍存在记录的状态，不重复其编程脉冲。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"An uncertain write closes admission; no retry infers fresh erase from 0xff. "
"Status is local product metadata, not remote acknowledgement."
msgstr "不确定的写入关闭准入；任何重试都不能从 0xff 推断全新擦除。状态是本地产品 metadata，不是远端确认。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Active TSDB scope, serialized with all traversal."
msgstr "[in] 活跃 TSDB 作用域，与所有遍历串行执行。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Record index obtained from this database's visitor."
msgstr "[in] 从此数据库 visitor 获得的记录索引。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "[in] Same or later user status; backward transitions reject."
msgstr "[in] 相同或更晚的用户状态；拒绝后退转换。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"SUCCESS, EMPTY, INVALID or retained error; same status causes no program "
"pulse."
msgstr "SUCCESS、EMPTY、INVALID 或保留的错误；相同 status 不产生 program pulse。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Caller metadata; workspace and Flash binding outlive every call."
msgstr "调用方 metadata；工作区和 Flash 绑定须存活到每次调用结束。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Product-selected immutable scope for one complete upstream call."
msgstr "一次完整上游调用使用的产品选定不可变作用域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid ""
"Getter and scope belong to the product's same-owner serialization. Keep the "
"exact pointer active through callbacks and all error returns."
msgstr "getter 和作用域属于产品的同 owner 串行化机制。精确指针须在回调及所有错误返回期间保持活跃。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:185
msgid "Borrowed record description valid only during its visitor callback."
msgstr "借用的记录描述，仅在其 visitor 回调期间有效。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:189
msgid "persistent_record.h"
msgstr "persistent_record.h"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "Versioned byte records with explicit schema and checksum."
msgstr "带显式 schema 与校验和的版本化字节记录。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "Encode one explicitly identified little-endian record, without I/O."
msgstr "编码一条显式标识的 little-endian 记录，不执行 I/O。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid ""
"CRC32 detects damage, not authentication. A record ID does not create "
"reliable delivery; ACK, retention and retries remain product policy."
msgstr "CRC32 检测损坏，不提供认证。记录 ID 不建立可靠交付；ACK、保留和重试仍是产品策略。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Product-defined data schema identity."
msgstr "[in] 产品定义的数据 schema 身份。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Nonzero product-generated deduplication identity."
msgstr "[in] 产品生成的非零去重身份。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Immutable bytes, NULL permitted only when empty."
msgstr "[in] 不可变字节；仅为空时允许 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Exact payload length, representable in uint32_t."
msgstr "[in] 精确 payload 长度，须能用 uint32_t 表示。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[out] Disjoint output or NULL for a required-size query."
msgstr "[out] 不重叠输出；查询所需大小时可为 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[inout] Capacity on entry, required bytes on success/full."
msgstr "[inout] 进入时为容量，success/full 时为所需字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "SUCCESS, INVALID or EXHAUSTED; rejected capacity changes no image."
msgstr "SUCCESS、INVALID 或 EXHAUSTED；容量被拒绝时不改镜像。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid ""
"Validate exact format/schema/checksum before publishing a payload view."
msgstr "发布 payload 视图前校验精确格式／schema／校验和。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid ""
"No allocation or retained library pointer. The caller owns backing image "
"lifetime while using its returned view. No Flash access occurs."
msgstr "不分配内存，也不保留库级指针。使用返回视图期间，调用方负责底层镜像的存活期。不访问 Flash。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Exact expected product schema, never implicitly migrated."
msgstr "[in] 精确的预期产品 schema，不隐式迁移。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Stable immutable complete record bytes."
msgstr "[in] 稳定不可变的完整记录字节。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[in] Exact encoded length; trailing bytes are rejected."
msgstr "[in] 精确编码长度；拒绝尾随字节。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "[out] Disjoint output, unchanged on any failure."
msgstr "[out] 不重叠输出，任何失败时均不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "SUCCESS, INVALID, UNSUPPORTED format/schema or IO for damaged data."
msgstr "SUCCESS、INVALID，格式／schema 不支持时为 UNSUPPORTED，数据损坏时为 IO。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:191
msgid "Validated borrowed view; backing image remains caller-owned."
msgstr "已校验的借用视图；底层镜像仍由调用方拥有。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:195
msgid "littlefs.h"
msgstr "littlefs.h"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "LittleFS over caller-selected Flash regions and workspaces."
msgstr "基于调用方选定 Flash 区域和工作区的 LittleFS。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Exact fixed-profile workspace size, including every cache buffer."
msgstr "固定 profile 的精确工作区大小，包括全部 cache buffer。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Required alignment for the caller-provided workspace."
msgstr "调用方工作区所需对齐。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Bind metadata without touching or formatting Flash."
msgstr "绑定 metadata，不接触或格式化 Flash。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid ""
"Task-only, same physical owner; no heap, VFS, worker or hidden lock. The "
"fixed cache is 256 bytes; program units must divide that size."
msgstr ""
"仅 task，由同一物理 owner 执行；不提供堆、VFS、worker 或隐藏锁。固定 cache 为 256 "
"bytes；编程单元必须能整除该大小。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:203
msgid "[out] Unused caller metadata."
msgstr "[out] 未使用的调用方 metadata。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[inout] Stable uniform region bridge, retained until unmount."
msgstr "[inout] 稳定均一区域 bridge，保留到 unmount。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[inout] Disjoint aligned caller storage for vendor state."
msgstr "[inout] 不重叠的对齐调用方存储，用于供应商状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[in] At least the reported exact workspace requirement."
msgstr "[in] 至少达到报告的精确工作区需求。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "SUCCESS, INVALID or UNSUPPORTED without I/O on rejection."
msgstr "SUCCESS、INVALID 或 UNSUPPORTED；拒绝时不执行 I/O。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Explicitly format an unmounted selected region."
msgstr "显式格式化尚未挂载的选定区域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Product authorizes this call. Mount failures never invoke format."
msgstr "此调用由产品授权。mount 失败从不调用 format。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[inout] Initialized exclusive metadata and live workspace."
msgstr "[inout] 已初始化的独占 metadata 及活跃工作区。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[in] Finite whole-operation absolute deadline."
msgstr "[in] 有限的整个操作绝对截止时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "SUCCESS or error; partial destructive effects may remain on failure."
msgstr "SUCCESS 或错误；失败可能保留部分破坏性效果。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Mount existing media without formatting it on failure."
msgstr "挂载已有介质，失败时不格式化。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[inout] Initialized unmounted state and stable binding."
msgstr "[inout] 已初始化且未挂载的状态及稳定绑定。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[in] One finite deadline shared by all Flash callbacks."
msgstr "[in] 所有 Flash 回调共享的一个有限截止时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "SUCCESS or checked error; failed media is never treated as empty."
msgstr "SUCCESS 或检查所得错误；失败介质从不视为空。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Unmount after every user has joined; do not stop the physical owner."
msgstr "全部使用者退出后 unmount；不停止物理 owner。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[inout] Mounted exclusive metadata."
