#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "SUCCESS or retained error; caller workspace stays live until return."
msgstr "SUCCESS 或保留错误；调用方工作区须保持存活到返回。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "Replace one file and close its borrowed handle within this call."
msgstr "替换一个文件，并在本次调用内关闭其借用 handle。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[inout] Mounted same-owner state, externally serialized."
msgstr "[inout] 已挂载、同 owner 的状态，由外部串行化。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
msgid "[in] Relative bounded file path, at most 127 bytes."
msgstr "[in] 相对有界文件路径，最多 127 bytes。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/services.md:197
