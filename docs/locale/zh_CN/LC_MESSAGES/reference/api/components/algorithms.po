msgid "crc.h"
msgstr "crc.h"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "Streaming software CRC with explicit catalogue parameters."
msgstr "具有显式 catalogue 参数的流式软件 CRC。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "Fold bytes into an unfinalized register."
msgstr "将字节折叠到尚未 finalize 的寄存器。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "[in] Immutable valid model, borrowed until return."
msgstr "[in] 不可变有效模型，借用到返回。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "[in] Readable length bytes; NULL only when length is zero."
msgstr "[in] length 个可读字节；仅 length 为零时允许 NULL。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "[in] Number of bytes to consume."
msgstr "[in] 要消费的字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid ""
"[inout] Register initialized to model.initial; separate from model/data. "
"Unchanged on argument failure."
msgstr "[inout] 初始化为 model.initial 的寄存器，与 model／data 分离。参数失败时保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "SUCCESS or INVALID; bounded by length*width, no heap/OS."
msgstr "SUCCESS 或 INVALID；工作量受 length*width 约束，无 heap／OS。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "Finalize a register without changing streaming state."
msgstr "finalize 寄存器，不改变流式状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "[in] Same immutable model used for update."
msgstr "[in] 与 update 使用的同一不可变模型。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "[in] Unfinalized register within the selected width."
msgstr "[in] 选定 width 范围内尚未 finalize 的寄存器。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "[out] Distinct result, unchanged on failure."
msgstr "[out] 独立结果，失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "SUCCESS or INVALID; no allocation or retained references."
msgstr "SUCCESS 或 INVALID；无分配或保留引用。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "Variables"
msgstr "变量"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "CRC-32/ISO-HDLC model; immutable shared data."
msgstr "CRC-32/ISO-HDLC 模型；共享不可变数据。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "CRC-16/MODBUS model; immutable shared data."
msgstr "CRC-16/MODBUS 模型；共享不可变数据。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "CRC-8/SMBUS model; immutable shared data."
msgstr "CRC-8/SMBUS 模型；共享不可变数据。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid "Width 8..32, normal polynomial without its leading x^width term."
msgstr "Width 为 8..32，普通多项式不包含最高 x^width 项。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:67
msgid ""
"initial/xor_out must fit width. reflect_input reverses each input byte; "
"reflect_output reverses the register before xor_out. This is byte-oriented "
"software math, not an MCU hardware CRC word contract."
msgstr ""
"initial／xor_out 必须适合 width。reflect_input 按位反转每个输入字节；reflect_output 在执行 "
"xor_out 前按位反转寄存器。这是面向字节的软件数学，不是 MCU 硬件 CRC word 合同。"

