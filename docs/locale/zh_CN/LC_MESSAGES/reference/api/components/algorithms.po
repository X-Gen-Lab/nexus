#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:61
msgid "[out] Distinct caller result, unchanged on failure."
msgstr "[out] 独立调用者结果，失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/algorithms.md:61
msgid "SUCCESS or INVALID; no clock, allocation or retained state."
