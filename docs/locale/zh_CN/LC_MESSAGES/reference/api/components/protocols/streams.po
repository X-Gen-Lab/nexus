msgstr "wall_clock.h"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Explicit UTC quality independent of monotonic deadlines."
msgstr "独立于单调 deadline 的显式 UTC 质量。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:155
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:167
msgid "Enums"
msgstr "枚举"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Time quality; plain SNTP is a measurement, never authentication."
msgstr "时间质量；普通 SNTP 是测量，不是认证。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:155
#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:167
msgid "Values:"
msgstr "取值："

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Admit an explicit UTC measurement and expiry."
msgstr "准入显式 UTC 测量和到期时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid ""
"Task-only serialized operation; no I/O, heap or clock read. Product "
"determines trust. UTC updates never modify deadlines."
msgstr "仅 task 上下文串行操作；无 I/O、heap 或 clock read。产品判定信任，UTC 更新不修改 deadline。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[inout] Caller-owned state in one live monotonic domain."
msgstr "[inout] 位于同一 live 单调域内的调用者状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] UTC/uncertainty/quality and finite observation time."
msgstr "[in] UTC／不确定度／质量及有限观测时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Finite absolute expiry after observation."
msgstr "[in] 观测之后的有限绝对到期时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Upper oscillator drift bound, at most 1000000."
msgstr "[in] oscillator drift 上界，至多 1000000。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "SUCCESS or INVALID; unchanged on failure."
msgstr "SUCCESS 或 INVALID；失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Project UTC and bounded uncertainty at a monotonic snapshot."
msgstr "在单调时间快照处投影 UTC 与有界不确定度。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid ""
"Task-only, caller serializes updates. Trusted TLS consumers explicitly "
"require quality TRUSTED; MEASURED is insufficient."
msgstr "仅 task 上下文，由调用者串行化更新。可信 TLS consumer 显式要求 TRUSTED 质量；MEASURED 不足。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Stable bridge, same live monotonic domain."
msgstr "[in] 稳定 bridge，同一 live 单调域。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Finite monotonic time, not before observation."
msgstr "[in] 不早于观测的有限单调时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[out] Distinct value output, unchanged on failure."
msgstr "[out] 独立值输出，失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid ""
"SUCCESS, STATE for unknown/rollback, TIMEOUT at expiry, or OVERFLOW; no "
"hidden refresh or trust upgrade."
msgstr "SUCCESS，unknown／rollback 时 STATE，到期时 TIMEOUT，或 OVERFLOW；不隐式刷新或升级信任。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Validate one server reply and derive an SNTP observation."
msgstr "验证一个 server reply，并导出 SNTP 观测。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid ""
"Task-only bounded pure parsing. Caller verifies source IP, port and "
"outstanding request identity. SNTP has no peer authentication; request "
"matching does not establish trust."
msgstr ""
"仅 task 上下文的有界纯解析。调用者验证 source IP、port 和 outstanding request 身份。SNTP 无 peer "
"认证；request 匹配不建立信任。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Exactly 48 bytes, not retained."
msgstr "[in] 恰好 48 字节，不保留。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Must be 48 (extension/auth formats are unselected)."
msgstr "[in] 必须为 48（不选择 extension／auth 格式）。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Eight unpredictable transmitted timestamp bytes."
msgstr "[in] 已发送的八字节不可预测 timestamp。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Finite request send time in monotonic domain."
msgstr "[in] 单调域内的有限 request 发送时间。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Same-domain receive snapshot, not before send."
msgstr "[in] 同域接收快照，不早于发送。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[in] Explicit NTP era, zero or one; no 2036 guess."
msgstr "[in] 显式 NTP era，零或一；不猜测 2036。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "[out] Distinct output, unchanged on failure."
msgstr "[out] 独立输出，失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid ""
"SUCCESS, INVALID for bad mode/stratum/leap/originate, or OVERFLOW; output "
"quality always MEASURED."
msgstr ""
"SUCCESS，mode／stratum／leap／originate 错误时 INVALID，或 OVERFLOW；输出质量始终为 MEASURED。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Caller-owned immutable observation returned as a value."
msgstr "以值返回的调用者不可变观测。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:143
msgid "Serialized affine bridge; initialize to zero, treat fields private."
msgstr "串行 affine bridge；初始化为零，字段视作私有。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:147
msgid "xmodem.h"
msgstr "xmodem.h"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Caller-driven XMODEM CRC-128 receive state machine."
msgstr "调用者推进的 XMODEM CRC-128 接收状态机。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Typedefs"
msgstr "类型定义"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Bounded block acceptance; SUCCESS means copied/committed locally."
msgstr "有界 block 接纳；SUCCESS 表示本地已复制／提交。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Start CRC-128 receive and queue initial 'C' handshake."
msgstr "开始 CRC-128 接收并将初始 'C' 握手字符入队。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid ""
"Packet blocks are always 128 bytes, including sender padding. Product owns "
"exact length, authorization, staging and erase."
msgstr "packet block 始终为含发送方 padding 的 128 字节。精确长度、授权、staging 和 erase 归产品负责。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[out] Unused or quiescent caller storage."
msgstr "[out] 未使用或没有在途调用的调用者存储。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Bounded task callback, no reentry, retains no data."
msgstr "[in] 有界 task callback，不重入，不保留数据。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Stable callback state until receive completion."
msgstr "[in] 稳定 callback 状态，保留到接收结束。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Finite monotonic start snapshot."
msgstr "[in] 有限单调起始快照。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Finite whole-transfer deadline after now."
msgstr "[in] 晚于 now 的有限整次传输 deadline。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Nonzero bounded packet interval."
msgstr "[in] 非零有界 packet 间隔。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Nonzero maximum consecutive corrupt/timeouts."
msgstr "[in] 非零的连续损坏／超时次数上限。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "SUCCESS or INVALID; no transport I/O or allocation."
msgstr "SUCCESS 或 INVALID；不执行 transport I/O 或分配。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Consume one received byte under finite session time."
msgstr "在有限 session 时间内消费一个接收字节。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid ""
"Valid new blocks call write exactly once; duplicate previous blocks only "
"ACK. CRC is corruption detection, not signature."
msgstr "合法新 block 恰好调用一次 write；重复的上一 block 仅 ACK。CRC 检测损坏，不是签名。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[inout] Serialized active state."
msgstr "[inout] 串行 active 状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Next wire byte."
msgstr "[in] 下一个 wire byte。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Same-domain nondecreasing finite snapshot."
msgstr "[in] 同域、非递减的有限快照。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid ""
"SUCCESS for progress/completion, BUSY when an outgoing control byte is "
"pending (input not consumed), or failure."
msgstr "推进／完成返回 SUCCESS，有待发 control byte 时返回 BUSY（不消费输入），或失败。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Advance timeout/retry without receiving data."
msgstr "无接收数据时推进 timeout／retry。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid ""
"Caller explicitly schedules progress and transmits queued controls; no "
"hidden timer, retransmission task or worker."
msgstr "调用者显式调度推进并发送已入队 control；无隐藏 timer、重传 task 或 worker。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[inout] Serialized initialized state."
msgstr "[inout] 已初始化的串行状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[in] Same-domain finite monotonic snapshot."
msgstr "[in] 同域有限单调快照。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "SUCCESS, BUSY for active transfer, or latched failure."
msgstr "SUCCESS、active transfer 时 BUSY，或锁存的失败。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Take one queued control byte for copying into transport."
msgstr "取出一个已入队 control byte，供复制到 transport。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[out] Distinct output byte, unchanged if no control."
msgstr "[out] 独立字节输出，无 control 时保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid ""
"SUCCESS, EMPTY or INVALID; caller retains copied byte until transport "
"accepts it. This call has no transport effects."
msgstr "SUCCESS、EMPTY 或 INVALID；调用者保留复制字节直到 transport 接纳。本调用无 transport 效果。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Cancel local transfer after joining all calls/callbacks."
msgstr "所有调用／callback 已 join 后取消本地传输。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Product may send CAN bytes explicitly, then settle transport."
msgstr "产品可显式发送 CAN 取消控制字符，随后结清 transport。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "[inout] Initialized serialized state."
msgstr "[inout] 已初始化的串行状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "CANCELLED, or INVALID; does not undo accepted blocks."
msgstr "CANCELLED 或 INVALID；不撤销已接纳 block。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:149
msgid "Caller-owned CRC-128 receiver, no UART, files or firmware policy."
