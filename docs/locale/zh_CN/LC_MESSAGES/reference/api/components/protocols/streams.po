#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Encode one COBS packet including its zero delimiter."
msgstr "编码一个 COBS packet，包含结尾零 delimiter。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid ""
"COBS provides framing, not integrity or authentication. Add the selected CRC"
" before encoding and verify after decoding."
msgstr "COBS 提供分帧，不提供完整性或认证。在编码前添加选定 CRC，解码后验证。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:0
msgid "Parameters"
msgstr "参数"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Input bytes, NULL only for zero size; not retained."
msgstr "[in] 输入字节，仅 size 为零时允许 NULL；不保留。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Input byte count."
msgstr "[in] 输入字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Disjoint caller-owned encoded storage."
msgstr "[out] 独立的调用者编码存储。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Writable output extent."
msgstr "[in] 可写输出范围。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Distinct encoded byte count, unchanged on failure."
msgstr "[out] 独立编码字节数，失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:0
msgid "Returns"
msgstr "返回值"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid ""
"SUCCESS, INVALID, OVERFLOW or EXHAUSTED; no partial output on capacity "
"failure. Task/IRQ pure bounded-by-size operation."
msgstr ""
"SUCCESS、INVALID、OVERFLOW 或 EXHAUSTED；容量失败无部分输出。Task／IRQ 纯操作，工作量受 size 约束。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Decode one COBS packet without its zero delimiter."
msgstr "解码一个不含零 delimiter 的 COBS packet。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Encoded input, nonzero size, readable until return."
msgstr "[in] 编码输入，size 非零，可读到返回。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Bytes excluding the delimiter."
msgstr "[in] 不含 delimiter 的字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Disjoint buffer or exactly data for in-place decode."
msgstr "[out] 独立 buffer，或与 data 精确同址以原地解码。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Distinct decoded byte count, unchanged on failure."
msgstr "[out] 独立解码字节数，失败保持不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid ""
"SUCCESS, INVALID or EXHAUSTED; malformed/capacity checks precede output "
"mutation. No allocation, time or I/O."
msgstr "SUCCESS、INVALID 或 EXHAUSTED；先完成畸形／容量检查再修改输出。不分配、不读时间或执行 I/O。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Initialize a bounded COBS receive accumulator."
msgstr "初始化有界 COBS 接收累积器。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Unused or quiesced metadata."
msgstr "[out] 未使用，或已完成退出会合且没有在途调用的 metadata。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[inout] Nonempty disjoint buffer, retained until join."
msgstr "[inout] 非空独立 buffer，保留到 join。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Maximum encoded packet bytes, without delimiter."
msgstr "[in] 不含 delimiter 的最大编码 packet 字节数。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "SUCCESS or INVALID; no I/O or implicit queue/worker."
msgstr "SUCCESS 或 INVALID；不执行 I/O，不隐式建立 queue／worker。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Feed one byte in a serialized execution context."
msgstr "在串行执行上下文 feed 一个字节。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "No time/I/O/retained input; BUSY while ready consumes no byte."
msgstr "不读时间／执行 I/O／保留输入；ready 时 BUSY 不消费字节。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[inout] Initialized caller-owned state."
msgstr "[inout] 已初始化的调用者状态。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Wire byte; zero terminates a packet."
msgstr "[in] wire byte；零结束一个 packet。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid ""
"SUCCESS for a complete decoded packet; BUSY for partial packet or a still-"
"borrowed previous packet; OVERFLOW closes admission until next zero; INVALID"
" rejects malformed packet."
msgstr ""
"完整 decoded packet 返回 SUCCESS；partial packet 或前一 packet 仍被借用返回 BUSY；OVERFLOW "
"关闭准入直到下一个零；INVALID 拒绝畸形 packet。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Borrow the current decoded packet until release."
msgstr "借用当前 decoded packet，直到 release。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[in] Initialized serialized decoder."
msgstr "[in] 已初始化的串行 decoder。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Distinct pointer to retained caller storage."
msgstr "[out] 指向所保留调用者存储的独立指针输出。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[out] Distinct payload byte count; empty packet is valid."
msgstr "[out] 独立 payload 字节数；空 packet 有效。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "SUCCESS, EMPTY or INVALID; failure leaves outputs unchanged."
msgstr "SUCCESS、EMPTY 或 INVALID；失败保持输出不变。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Release the decoded packet after all borrowers have joined."
msgstr "所有借用者 join 后释放 decoded packet。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "[inout] Initialized serialized decoder."
msgstr "[inout] 已初始化的串行 decoder。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "SUCCESS, EMPTY or INVALID; no hardware effects."
msgstr "SUCCESS、EMPTY 或 INVALID；无硬件效果。"

#: ../../../../../../../../workspace/nexus/docs/reference/api/components/protocols/streams.md:137
msgid "Serialized stream accumulator; initialize once, then keep private."
msgstr "串行 stream 累积器；初始化一次后保持其私有。"

