msgstr "`boards/` 的维护中直接子目录；必须恰好选择一个 Board"

#: docs/reference/configuration/assembly.md:29
msgid "`board_package`"
msgstr "`board_package`"

#: docs/reference/configuration/assembly.md:29
msgid "External package path relative to the assembly; alternative to `board`"
msgstr "相对装配定位的外部包路径；与 `board` 二选一"

#: docs/reference/configuration/assembly.md:29
msgid "`backend`"
msgstr "`backend`"

#: docs/reference/configuration/assembly.md:29
msgid ""
"Explicit `native`, `baremetal`, `freertos` or supported `threadx` subset"
msgstr "显式 `native`、`baremetal`、`freertos` 或受支持 `threadx` 子集"

#: docs/reference/configuration/assembly.md:29
msgid "`clock`"
msgstr "`clock`"

#: docs/reference/configuration/assembly.md:29
