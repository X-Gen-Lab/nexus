// Current scoped view. Build-time arrows and runtime calls are labeled explicitly.
// Code basis: cmake/package/package_source_sdk.py; cmake/platform/SDK.cmake; tools/dev/projects.py; cmake/package/verify_consumers.py
digraph SourceSdkConsumer {
    graph [label="FIG-10 Source SDK 独立消费\n构建期流程；Native 运行与 ARM 链接分别验证", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    source [label="clean Git source／锁定依赖／许可\n开发 fixture 必须显式选择", fillcolor="#f8fafc"];
    scope [label="所选 profile.packages 与包导出归属\n不从单个 ELF 推导全部 SDK"];
    package [label="打包完整 prefix；只读 verify 身份／字节\nmanifest schema3：source_exports／profile"];
    move [label="移动完整 prefix 到独立路径\n不只移动源码子目录"];
    creator [label="可选 create --public\n复制 canonical GPIO 工程与显式 assembly"];
    consumer [label="外部 consumer 源码与独立 build\nfind_package(Nexus CONFIG REQUIRED)\n可显式约束 NEXUS_EXPECTED_SOURCE_REVISION"];
    verify [label="每个公共入口验证 SDK 身份与字节\nsource／锁／成员范围／hash"];
    target [label="nexus_add_firmware() 与包内 CMake\n唯一编译目标图；私有 SDK 头不泄漏"];
    native [label="显式 host-support consumer\n实际 configure／build／run", fillcolor="#f0fdf4"];
    arm [label="精确 MCU consumer\nstartup／linker／ELF／BIN／map／资源", fillcolor="#f0fdf4"];
    reject [label="身份陈旧、字节变化、缺成员或错 prefix\n拒绝，不继续使用旧输出", fillcolor="#fff7ed"];
    reports [label="实际 consumer 原始记录与产物身份\n不建立物理 HIL 或软件候选资格", fillcolor="#fefce8"];
    source -> scope [label="选择包与依赖"];
    source -> package [label="冻结源码输入"];
    scope -> package [label="导出归属，不是编译源图"];
    package -> move [label="完整包"];
    move -> creator [label="新建公开首工程"];
    creator -> consumer [label="可检查的源码与命令"];
    move -> consumer [label="已有外部工程直接消费"];
    consumer -> verify [label="加载公共入口"];
    verify -> target [label="身份与边界通过"];
    verify -> reject [label="验证失败"];
    target -> native [label="显式选中 host support"];
    target -> arm [label="所选 MCU 装配"];
    native -> reports [label="实际运行结果"];
    arm -> reports [label="实际链接与资源结果"];
}
