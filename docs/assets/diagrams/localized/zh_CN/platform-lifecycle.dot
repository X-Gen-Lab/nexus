// Current scoped view. Build-time arrows and runtime calls are labeled explicitly.
// Code basis: core/private/platform_lifecycle_impl.h; tools/configure/bindings.py; soc/stm32/stm32f4/private/stm32f4_platform_lifecycle_impl.h
digraph PlatformLifecycle {
    graph [label="FIG-05 静态连接调用共享 C 生命周期\n外部 privileged task owner 串行推进", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    cold [label="冷对象：无成功运行许可", fillcolor="#f8fafc"];
    context [label="检查调用上下文和已有状态\nISR／mask／privilege／started"];
    admit [label="全部 controller 的纯 C 准入\n先于 System／资源取得与控制器写入"];
    system [label="System start\n返回 primary／cleanup／remaining effects"];
    resources [label="取得共享平台资源"];
    instances [label="按声明次序 prepare 实例\n失败但留效的实例计入 cleanup"];
    running [label="start primary=SUCCESS\n外部才开展业务；不启动 scheduler", fillcolor="#f0fdf4"];
    quiesce [label="产品关闭 producers／direct writers\n继续 drain，join 用户与 observers"];
    reverse [label="逆序释放已取得的实例\n仅成功后减少保留前缀"];
    releaseResources [label="释放共享平台资源"];
    releaseSystem [label="释放所拥有的 System 效果\n保持具体 owner 收条"];
    released [label="stop=SUCCESS：可释放效果已清理\n不保证继续主动驱动安全电平", fillcolor="#f0fdf4"];
    primary [label="保留 primary\nCore 执行逆序 rollback 并收集 cleanup", fillcolor="#fff7ed"];
    retained [label="保留未清理 leases 与存储\n继续必要 service，再重试 stop", fillcolor="#fff7ed"];
    rejected [label="拒绝：不准入新业务\n保留原生命周期与效果", fillcolor="#fff7ed"];
    cold -> context [label="显式 start"];
    context -> rejected [label="上下文／STATE 错误"];
    context -> admit [label="上下文有效且为冷态"];
    admit -> rejected [label="准入失败，无新硬件效果"];
    admit -> system [label="全部准入通过"];
    system -> resources [label="System 成功"];
    system -> retained [label="启动失败且留有效果"];
    system -> cold [label="启动失败且未留新效果", constraint=false];
    resources -> instances [label="资源取得成功"];
    resources -> primary [label="共享资源取得失败"];
    instances -> running [label="全部成功"];
    instances -> primary [label="实例取得失败"];
    primary -> reverse [label="逆序 rollback"];
    running -> quiesce [label="产品决定停止"];
    quiesce -> reverse [label="已满足 stop 调用前提"];
    reverse -> releaseResources [label="实例全部释放"];
    releaseResources -> releaseSystem [label="共享资源全部释放"];
    releaseSystem -> released [label="观测清理成功"];
    reverse -> retained [label="首个实例释放失败"];
    releaseResources -> retained [label="共享资源释放失败"];
    releaseSystem -> retained [label="System 释放失败"];
    retained -> reverse [label="按保留阶段重试；不强制回收", constraint=false];
    released -> cold [label="新生命周期", constraint=false];
}
