// FIG-12: current independent documentation, SDK and HIL boundaries.
// Code basis: cc4619261fc1cc6c07de0fe266703d6297062aa8.
digraph ValidationBoundaries {
    graph [rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.42,
           ranksep=0.58, fontname="Noto Sans CJK SC", fontsize=15];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontname="Noto Sans CJK SC", fontsize=13];
    edge [color="#475569", fontname="Noto Sans CJK SC", fontsize=11];
    graph [label="FIG-12 文档、SDK 与实板验证边界"];
    source [label="精确源码、配置与锁定依赖"];
    docs [label="cli.py check / test / build\n当前正文、翻译、图与 API"];
    html [label="严格双语 HTML 与实际构建报告\n只建立文档构建结果"];
    sdk [label="package_source_sdk.py\n完整 prefix、依赖与许可证"];
    consumers [label="verify_consumers.py\n独立配置、编译、运行或链接"];
    image [label="真实 ARM 镜像与配置身份"];
    station [label="HIL 工装与真实 station\nPCB、探针、串口与供电"];
    hardware [label="实际刷写与测量才建立物理结果\n未接入设备：not_executed"];
    records [label="分别保留原始命令、退出码和报告\n无自动部署、候选封存或产品发布"];
    source -> docs [label="文档输入"];
    docs -> html [label="实际构建"];
    source -> sdk [label="所选源码闭包"];
    sdk -> consumers [label="完整性核验后的消费"];
    consumers -> image [label="实际生成的镜像"];
    image -> station [label="同一镜像与配置"];
    station -> hardware [label="需要设备实际执行"];
    html -> records [label="文档记录"];
    consumers -> records [label="SDK 消费记录"];
    hardware -> records [label="实板记录"];
    { rank=same; docs; sdk; }
}
