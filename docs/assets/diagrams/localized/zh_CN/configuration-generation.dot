digraph ConfigurationGeneration {
    graph [label="FIG-03 当前配置与原子生成：仅构建期数据流", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    assembly [label="一份 authored TOML", fillcolor="#f8fafc"];
    package [label="package.json\n事实、binding_files 与构建入口", fillcolor="#f8fafc"];
    socFacts [label="SoC／CPU／route／审核资料", fillcolor="#f8fafc"];
    boardFacts [label="Board 接线与电气授权", fillcolor="#f8fafc"];
    authored [label="严格字段检查\n冻结 AuthoredAssembly"];
    reader [label="所选输入：同一受控快照\n字节身份与发布前复核"];
    policies [label="通用 DataProvider／领域与 IP 政策\nBindingPolicy 与私有 schema"];
    resolver [label="通用解析与资源决策\n模式、引用、冲突、预算"];
    typedIr [label="不可变具名 IR\n共享 canonical 引用"];
    construction [label="有限静态装配\n对象、引用、固定调用与薄 IRQ"];
    bundle [label="事务生成与原子发布"];
    outputs [label="静态 C／factory／配置／内存计划\nresolved.json：单向审计投影"];
    targets [label="包内 CMake：唯一 C 源码目标图"];
    ninja [label="Ninja：编译、链接与资源检查"];
    firmware [label="本次 ELF／BIN／map／资源报告", fillcolor="#f0fdf4"];
    rejected [label="输入、解析、生成或发布失败", fillcolor="#fff7ed"];
    invalidated [label="仅使拥有的 bundle 失效\n不继续使用旧输出或半成品", fillcolor="#fff7ed"];
    assembly -> authored [label="唯一装配入口"];
    package -> reader [label="显式所选文件"];
    socFacts -> reader [label="声明的事实"];
    boardFacts -> reader [label="授权条件"];
    reader -> policies [label="同一代 binding 与事实"];
    reader -> resolver [label="精确器件与 Board 事实"];
    authored -> resolver [label="冻结用户选择"];
    policies -> resolver [label="已维护政策"];
    resolver -> typedIr [label="验证通过"];
    typedIr -> construction [label="具名字段与固定引用"];
    policies -> construction [label="所选 recipe／fragments"];
    construction -> bundle [label="生成静态连接 C"];
    typedIr -> bundle [label="单向配置与审计投影"];
    bundle -> outputs [label="成功发布"];
    outputs -> targets [label="生成配置与源"];
    package -> targets [label="仅选择构建入口；不另列 .c 图", style=dashed];
    targets -> ninja [label="执行唯一目标图"];
    ninja -> firmware [label="实际产物"];
    authored -> rejected [label="非法字段"];
    reader -> rejected [label="非法或变化的输入"];
    resolver -> rejected [label="非法模式或冲突"];
    construction -> rejected [label="非法静态连接"];
    bundle -> rejected [label="生成或发布失败"];
    rejected -> invalidated [label="清理本次拥有的输出"];
