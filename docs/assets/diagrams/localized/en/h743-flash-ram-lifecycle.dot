// FIG-18: actual selected C / assembly protocol; not a public request enum.
// All returning C paths converge on the independent assembly gate.
// Protected r8-r11 survive C; a single embedded ledger tracks selector effects.
// Original complete IO-24 exit / candidate qualification open; physical HIL not executed.
digraph h743FlashRamLifecycle {
    graph [label="FIG-18 Target RAM maintenance settlement\nSelected V / Cache off; timeout retains responsibility", fontname="Noto Sans CJK SC", fontsize=15, labelloc=t, rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.40, ranksep=0.50, newrank=true];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=9, arrowsize=0.8];
    admission [label="Ordinary provider admission\nValidate fixed binding, input, deadline, layout and context"];
    reject [label="Return rejection\nNo retained temporary effects or physical trigger", fillcolor="#f8fafc"];
    bridge [label="Assembly entry: preserve caller CPU state\nPrivate MSP; MPU CTRL / RNR / RBAR / RASR in r8-r11"];
    vectors [label="C RAM phase publishes private VTOR\nProve readback before installing MPU guard"];
    scan [label="C RAM phase: scan all 16 RASR.EN\nSave selected guard state; track every selector effect"];
    guard [label="Install / prove Code-domain MPU guard\nXN + Strongly-ordered + AP001; CTRL7; DSB / ISB"];
    rollback [label="Before trigger: prove both banks idle\nRestore / read back every acquired MPU / selector effect"];
    trigger [label="Issue at most one validated physical pulse\nEight staged word reads / stores, or erase START"];
    drain [label="C RAM phase retains guard and workspace\nPoll both-bank BSY / QW / WBNE with valid TIM2 epoch"];
    expiry [label="Latch TIMEOUT after trigger\nDo not cancel, clear busy or return"];
    lock [label="Both banks actually idle\nProve target LOCK and required barriers"];
    restoreMpu [label="C RAM phase restores / reads back MPU\nRetain private VTOR and private MSP"];
    returnGate [label="Independent assembly gate: every returning C path\nRead back idle banks, zero effects, exact saved CR | LOCK\nProve MPU against protected r8-r11 captures"];
    restoreVectors [label="Assembly gate restores linker-known g_pfnVectors\nDSB / ISB; prove exact VTOR readback"];
    restoreCpu [label="Assembly bridge restores exact caller state\nMSP / PSP / CONTROL / PRIMASK and callee registers"];
    result [label="Return settled result to ordinary code\nIO; else latched TIMEOUT; else SUCCESS", fillcolor="#f8fafc"];
    ledger [label="Selector ledger: entry, C phase and assembly gate\nSet before RNR write; clear after exact restore / readback", shape=note, fillcolor="#f8fafc"];
    failstop [label="Nonreturning RAM terminal\nRetain unproved responsibility; no hidden reset / watchdog feed", style="rounded,bold,filled", fillcolor="#fff7ed"];
    admission -> reject [label="invalid; no acquired effects"];
    admission -> bridge [label="admitted and command staged"];
    bridge -> vectors [label="capture / selector restoration proved"];
    bridge -> failstop [label="capture or selector restore refused"];
    vectors -> scan [label="private VTOR read back"];
    vectors -> returnGate [label="pre-trigger publication refused"];
    scan -> guard [label="supported disabled MPU; no enabled foreign region"];
    scan -> rollback [label="pre-trigger refusal after selector effect"];
    guard -> trigger [label="guard and final pre-issue deadline proved"];
    guard -> rollback [label="guard / deadline refused"];
    rollback -> returnGate [label="rollback and idle proved; rejection result"];
    rollback -> failstop [label="rollback or idle unproved"];
    trigger -> drain [label="pulse may be active; latch errors"];
    drain -> drain [label="any busy bit remains; including permanent busy"];
    drain -> expiry [label="absolute deadline expires"];
    expiry -> drain [label="continue real polling"];
    drain -> failstop [label="epoch lost / exhausted or proof unavailable"];
    drain -> lock [label="all actual busy bits withdrawn"];
    lock -> restoreMpu [label="LOCK and time observations proved"];
    lock -> failstop [label="LOCK unproved"];
    restoreMpu -> returnGate [label="exact guard withdrawal proved"];
    restoreMpu -> failstop [label="restoration unproved"];
    returnGate -> restoreVectors [label="independent hardware checks proved"];
    returnGate -> failstop [label="any return condition unproved"];
    restoreVectors -> restoreCpu [label="exact fixed VTOR read back"];
    restoreVectors -> failstop [label="VTOR restoration unproved"];
    restoreCpu -> result [label="post-pulse settlement proved"];
    restoreCpu -> reject [label="pre-trigger rollback / restoration proved"];
    ledger -> scan [label="one embedded ledger, no second owner", style=dotted, arrowhead=none];
    // failstop deliberately has no outgoing edge; no timeout releases ownership.
}
