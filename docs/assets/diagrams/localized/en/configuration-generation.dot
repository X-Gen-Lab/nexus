// Current scoped view. Build-time arrows and runtime calls are labeled explicitly.
// Code basis: tools/configure/packages.py; data_provider.py; domain_policies.py; package_policy.py; ir.py; static_recipe.py; bundle.py; cmake/platform/Configure.cmake
digraph ConfigurationGeneration {
    graph [label="FIG-03 Current configuration and generation: build-time data flow only", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    assembly [label="One authored TOML assembly", fillcolor="#f8fafc"];
    package [label="package.json\nFacts, binding_files and build entry", fillcolor="#f8fafc"];
    socFacts [label="SoC / CPU / routes / review facts", fillcolor="#f8fafc"];
    boardFacts [label="Board wiring and electrical authorization", fillcolor="#f8fafc"];
    authored [label="Strict field checks\nFrozen AuthoredAssembly"];
    reader [label="One controlled snapshot of selected inputs\nByte identities and pre-publication recheck"];
    policies [label="Generic DataProvider / domain and IP policies\nBindingPolicy and private schemas"];
    resolver [label="Generic resolution and resource decisions\nModes, references, conflicts, budgets"];
    typedIr [label="Immutable named IR\nShared canonical references"];
    construction [label="Bounded static assembly\nObjects, references, fixed calls and thin IRQ entries"];
    bundle [label="Transactional generation and atomic publication"];
    outputs [label="Static C / factory / config / memory plan\nresolved.json: one-way audit projection"];
    targets [label="Package CMake: the sole C source target graph"];
    ninja [label="Ninja: compilation, linking and resource checks"];
    firmware [label="This execution: ELF / BIN / map / resource reports", fillcolor="#f0fdf4"];
    rejected [label="Input, resolution, generation or publication failure", fillcolor="#fff7ed"];
    invalidated [label="Invalidate only the owned bundle\nDo not reuse stale or partial output", fillcolor="#fff7ed"];
    assembly -> authored [label="Sole assembly input"];
    package -> reader [label="Explicit selected files"];
    socFacts -> reader [label="Declared facts"];
    boardFacts -> reader [label="Authorization conditions"];
    reader -> policies [label="Bindings and facts from one generation"];
    reader -> resolver [label="Exact device and Board facts"];
    authored -> resolver [label="Frozen user selections"];
    policies -> resolver [label="Maintained policies"];
    resolver -> typedIr [label="Validated"];
    typedIr -> construction [label="Named fields and fixed references"];
    policies -> construction [label="Selected recipes / fragments"];
    construction -> bundle [label="Render static connection C"];
    typedIr -> bundle [label="One-way configuration and audit projections"];
    bundle -> outputs [label="Successful publication"];
    outputs -> targets [label="Generated configuration and sources"];
    package -> targets [label="Select build entry; no second .c graph", style=dashed];
    targets -> ninja [label="Execute the sole target graph"];
    ninja -> firmware [label="Actual artifacts"];
    authored -> rejected [label="Invalid fields"];
    reader -> rejected [label="Invalid or changed input"];
    resolver -> rejected [label="Invalid mode or conflict"];
    construction -> rejected [label="Invalid static connection"];
    bundle -> rejected [label="Generation or publication failure"];
    rejected -> invalidated [label="Invalidate this attempt's owned output"];
}
