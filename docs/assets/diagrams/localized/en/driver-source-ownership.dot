// FIG-31 current: maintenance decisions, not runtime calls or qualification.
// Source basis: 7b985c4c source layout and docs/guides/provider-porting.md.
digraph DriverSourceOwnership {
    graph [label="FIG-31 Shared IP or exact SoC ownership",
           rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35,
           ranksep=0.45, fontname="Noto Sans CJK SC", fontsize=15,
           labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC",
          fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a",
          fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];

    work [label="Private controller work", fillcolor="#f8fafc"];
    protocol [label="Owns register-protocol sequencing?", shape=diamond,
              fillcolor="#fefce8"];
    reviewed [label="Layout / flags / order / reset compatibility reviewed;\nevery chip erratum explicitly handled?",
              shape=diamond, fillcolor="#fefce8"];
    integration [label="Keep exact SoC integration\nfacts / clock / reset / pins / IRQ / DMA\nor a narrowly scoped collaboration helper"];
    shared [label="drivers/<kind>/<ip>/\nReviewed shared algorithm"];
    exact [label="soc/<vendor>/<family>/drivers/\nExact or not-yet-reviewed protocol"];

    work -> protocol [label="Classify responsibility"];
    protocol -> integration [label="No"];
    protocol -> reviewed [label="Yes"];
    reviewed -> shared [label="Yes: reviewed compatibility"];
    reviewed -> exact [label="No: retain exact scope"];
}
