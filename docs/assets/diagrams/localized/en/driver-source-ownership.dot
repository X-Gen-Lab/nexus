// FIG-31 current: F4 source ownership; labels distinguish calls and build inputs.
digraph F4SourceOwnership {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t, label="FIG-31 F4 source ownership and interface boundaries\nEach edge states compilation or calls; no software or HIL qualification"];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
  edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11];
  io [label="io/\nPublic types, requests and borrow contracts"];
  f4 [label="soc/stm32/stm32f4/\nResources, lifecycle and official-library adaptation"];
  ip [label="F4 drivers/ip/\nRetained private hardware implementations"];
  vendor [label="vendors/st/ F4 HAL / Device\nKeep all inventoried sources; consume selected inputs"];
  host [label="tests/support/native/\nExplicit test scope, not a production SoC"];
  components [label="components/\nILI9341 / XPT2046 / W25 and peers"];
  config [label="Board JSON + TOML\nFacts, modes and instance selection"];
  io -> f4 [label="Runtime: ops(context)"];
  f4 -> ip [label="Build: selected private sources", style=dashed];
  f4 -> vendor [label="Build: private include / link", style=dashed];
  host -> ip [label="Test: execute actual IP sources", style=dashed];
  components -> io [label="Runtime: public narrow ports"];
  config -> f4 [label="Build: generate static connections", style=dashed];
}
