// FIG-17: target IO-24; selected operand / assembly protocol proof implemented.
// Original complete exit and candidate qualification remain open; no physical execution.
// One generated physical owner; caller preconditions remain in the linked contract.
digraph h743FlashRamArchitecture {
    graph [label="FIG-17 Target H743 Flash RAM boundary\nSelected V / three Cache-off profiles; physical HIL not executed", fontname="Noto Sans CJK SC", fontsize=15, labelloc=t, rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.40, ranksep=0.50, newrank=true];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=9, arrowsize=0.8];
    build [label="One authored TOML + reviewed facts\nImmutable IR; selected-only static objects"];
    app [label="External maintenance caller\nSchedule, join other bus masters, own recovery", fillcolor="#f8fafc"];
    factory [label="Cold typed factory\nReturn the existing immutable Flash face"];
    face [label="Flash face\nShared read-only ops + private context"];
    lifecycle [label="Explicit Platform start / stop\nPrepare bytes; retain failed cleanup"];
    subgraph clusterOwner {
        label="One physical Flash owner / fixed generated workspace"; color="#64748b"; fontname="Noto Sans CJK SC";
    provider [label="Cold provider admission\nExact binding, input, layout and caller context"];
    prepare [label="Cold RAM preparation\nValidate LOAD / RUN; copy and prove readiness"];
    bridge [label="Assembly entry on private MSP\nSave CPU state; protect MPU captures in r8-r11"];
    pod [label="C RAM phase: fixed workspace / MMIO\nPublish private VTOR; guard; pulse; drain; restore MPU"];
    gate [label="Independent assembly return gate\nRead back idle / LOCK / effects / captured MPU\nRestore linker-known VTOR; prove readback"];
    restore [label="Assembly bridge restores caller CPU state\nOnly after the return gate succeeds"];
    ledger [label="One embedded selector-effect ledger\nSet before RNR write; clear after exact restore / readback", fillcolor="#f8fafc"];
    terminal [label="Nonreturning RAM terminal\nAny unproved capture, cleanup or return condition", fillcolor="#fff7ed"];
    prepare -> bridge [label="supplies admitted code / vectors / private stack"];
    provider -> bridge [label="direct call after final admission"];
    bridge -> pod [label="protected captures; private MSP established"];
    pod -> gate [label="every returning C path; private VTOR retained"];
    gate -> restore [label="all hardware return checks proved"];
    bridge -> ledger [label="records selector effects", style=dotted, arrowhead=none];
    gate -> ledger [label="checks and balances selector effects", style=dotted, arrowhead=none];
    bridge -> terminal [label="capture cannot be proved"];
    pod -> terminal [label="settlement cannot be proved"];
    gate -> terminal [label="return condition cannot be proved"];
    }
    hardware [label="Fixed FLASH / SCB / MPU registers\nBoth banks idle; LOCK; vector and MPU readback", fillcolor="#f8fafc"];
    time [label="Existing System TIM2 domain / epoch\nDeadline observations require valid time", fillcolor="#f8fafc"];
    build -> lifecycle [label="emits selected preparation / cleanup"];
    build -> face [label="emits face and shared ops reference"];
    app -> factory [label="typed identity lookup"];
    factory -> face [label="existing reference; no preparation"];
    app -> lifecycle [label="explicit lifecycle call"];
    lifecycle -> prepare [label="prepare before use"];
    app -> face [label="direct synchronous I/O call"];
    face -> provider [label="ops(context, ...) call"];
    app -> provider [label="caller preconditions: masters joined; stack reserve", style=dashed];
    pod -> hardware [label="physical pulse / status / guard / private VTOR", dir=both];
    gate -> hardware [label="independent readback; fixed VTOR restore", dir=both];
    pod -> time [label="same-domain deadline and epoch observations", dir=both];
    // Terminal has no outgoing edge; FIG-18 expands guarded settlement.
}
