// FIG-12: current independent documentation, SDK and HIL boundaries.
// Code basis: cc4619261fc1cc6c07de0fe266703d6297062aa8.
digraph ValidationBoundaries {
    graph [rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.42,
           ranksep=0.58, fontname="Noto Sans CJK SC", fontsize=15];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontname="Noto Sans CJK SC", fontsize=13];
    edge [color="#475569", fontname="Noto Sans CJK SC", fontsize=11];
    graph [label="FIG-12 Documentation, SDK and physical validation boundaries"];
    source [label="Exact source, configuration and locked dependencies"];
    docs [label="cli.py check / test / build\nCurrent prose, translations, diagrams and API"];
    html [label="Strict bilingual HTML and actual build report\nDocumentation build scope only"];
    sdk [label="package_source_sdk.py\nComplete prefix, dependencies and licenses"];
    consumers [label="verify_consumers.py\nIndependent configure, build, execution or linking"];
    image [label="Actual ARM image and configuration identity"];
    station [label="HIL tooling and an actual station\nPCB, probe, serial and power"];
    hardware [label="Physical results require actual flashing and measurement\nEquipment unavailable: not_executed"];
    records [label="Retain actual commands, exit codes and reports separately\nNo automatic deployment, candidate sealing or product release"];
    source -> docs [label="Documentation inputs"];
    docs -> html [label="Actual build"];
    source -> sdk [label="Selected source closure"];
    sdk -> consumers [label="Consume after integrity verification"];
    consumers -> image [label="Actually linked image"];
    image -> station [label="Same image and configuration"];
    station -> hardware [label="Requires equipment execution"];
    html -> records [label="Documentation record"];
    consumers -> records [label="SDK consumer record"];
    hardware -> records [label="Physical record"];
    { rank=same; docs; sdk; }
}
