// Current scoped view. Build-time arrows and runtime calls are labeled explicitly.
// Code basis: core/private/platform_lifecycle_impl.h; tools/configure/bindings.py; soc/stm32/stm32f4/private/stm32f4_platform_lifecycle_impl.h
digraph PlatformLifecycle {
    graph [label="FIG-05 Static connections call the shared C lifecycle\nOne external privileged task owner advances serially", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    cold [label="Cold objects: no permission for normal operation", fillcolor="#f8fafc"];
    context [label="Check call context and existing state\nISR / mask / privilege / started"];
    admit [label="Pure C admission of every controller\nBefore System/resource acquisition or controller writes"];
    system [label="System start\nReturn primary / cleanup / remaining effects"];
    resources [label="Acquire shared platform resources"];
    instances [label="Prepare instances in declaration order\nInclude a failed instance in cleanup if it retained effects"];
    running [label="start primary=SUCCESS\nExternal application may operate; no scheduler start", fillcolor="#f0fdf4"];
    quiesce [label="Product closes producers / direct writers\nContinue draining; join users and observers"];
    reverse [label="Release acquired instances in reverse order\nShrink the retained prefix only after success"];
    releaseResources [label="Release shared platform resources"];
    releaseSystem [label="Release owned System effects\nPreserve each owner's receipts"];
    released [label="stop=SUCCESS: releasable effects are withdrawn\nNo promise to keep actively driving safe levels", fillcolor="#f0fdf4"];
    primary [label="Preserve primary\nCore rolls back in reverse order and collects cleanup", fillcolor="#fff7ed"];
    retained [label="Retain uncleaned leases and storage\nContinue required service, then retry stop", fillcolor="#fff7ed"];
    rejected [label="Reject new operation\nPreserve the original lifecycle and effects", fillcolor="#fff7ed"];
    cold -> context [label="Explicit start"];
    context -> rejected [label="Context / STATE error"];
    context -> admit [label="Valid context and cold state"];
    admit -> rejected [label="Admission failed; no new hardware effects"];
    admit -> system [label="All admission passed"];
    system -> resources [label="System succeeded"];
    system -> retained [label="Startup failed with effects retained"];
    system -> cold [label="Startup failed with no new effects retained", constraint=false];
    resources -> instances [label="Resources acquired"];
    resources -> primary [label="Shared-resource acquisition failed"];
    instances -> running [label="All succeeded"];
    instances -> primary [label="Instance acquisition failed"];
    primary -> reverse [label="Reverse rollback"];
    running -> quiesce [label="Product decides to stop"];
    quiesce -> reverse [label="Stop preconditions satisfied"];
    reverse -> releaseResources [label="All instances released"];
    releaseResources -> releaseSystem [label="All shared resources released"];
    releaseSystem -> released [label="Withdrawal observed complete"];
    reverse -> retained [label="First instance release failed"];
    releaseResources -> retained [label="Shared-resource release failed"];
    releaseSystem -> retained [label="System release failed"];
    retained -> reverse [label="Retry retained stages; no forced reclamation", constraint=false];
    released -> cold [label="New lifecycle", constraint=false];
}
