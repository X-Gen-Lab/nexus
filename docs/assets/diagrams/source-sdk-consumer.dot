// Current scoped view. Build-time arrows and runtime calls are labeled explicitly.
// Code basis: cmake/package/package_source_sdk.py; cmake/platform/SDK.cmake; tools/dev/projects.py; cmake/package/verify_consumers.py
digraph SourceSdkConsumer {
    graph [label="FIG-10 Source SDK 独立消费\n构建期流程；Native 运行与 ARM 链接分别验证\nFIG-10 Independent Source SDK consumption\nBuild-time flow; Native execution and ARM linking are separate", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    source [label="clean Git source／锁定依赖／许可\n开发 fixture 必须显式选择\nClean Git source / locked dependencies / licenses\nDevelopment fixtures require explicit selection", fillcolor="#f8fafc"];
    scope [label="所选 profile.packages 与包导出归属\n不从单个 ELF 推导全部 SDK\nSelected profile.packages and package export ownership\nOne ELF does not define the complete SDK"];
    package [label="打包完整 prefix；只读 verify 身份／字节\nmanifest schema3：source_exports／profile\nPackage a complete prefix; verify identity/bytes read-only\nManifest schema3: source_exports / profile"];
    move [label="移动完整 prefix 到独立路径\n不只移动源码子目录\nRelocate the complete prefix\nDo not move only its source subtree"];
    creator [label="可选 create --public\n复制 canonical GPIO 工程与显式 assembly\nOptional create --public\nCopy canonical GPIO project and explicit assembly"];
    consumer [label="外部 consumer 源码与独立 build\nfind_package(Nexus CONFIG REQUIRED)\n可显式约束 NEXUS_EXPECTED_SOURCE_REVISION\nExternal consumer source and separate build\nfind_package(Nexus CONFIG REQUIRED)\nOptional NEXUS_EXPECTED_SOURCE_REVISION"];
    verify [label="每个公共入口验证 SDK 身份与字节\nsource／锁／成员范围／hash\nVerify SDK identity and bytes at every public boundary\nSource / locks / member scope / hashes"];
    target [label="nexus_add_firmware() 与包内 CMake\n唯一编译目标图；私有 SDK 头不泄漏\nnexus_add_firmware() and package CMake\nSole compile target graph; private SDK headers stay private"];
    native [label="显式 host-support consumer\n实际 configure／build／run\nExplicit host-support consumer\nActual configure / build / run", fillcolor="#f0fdf4"];
    arm [label="精确 MCU consumer\nstartup／linker／ELF／BIN／map／资源\nExact MCU consumer\nStartup / linker / ELF / BIN / map / resources", fillcolor="#f0fdf4"];
    reject [label="身份陈旧、字节变化、缺成员或错 prefix\n拒绝，不继续使用旧输出\nStale identity, changed bytes, missing members or wrong prefix\nReject without reusing stale output", fillcolor="#fff7ed"];
    reports [label="实际 consumer 原始记录与产物身份\n不建立物理 HIL 或软件候选资格\nActual consumer records and artifact identities\nNo physical HIL or software-candidate qualification", fillcolor="#fefce8"];
    source -> scope [label="选择包与依赖\nSelect packages and dependencies"];
    source -> package [label="冻结源码输入\nFrozen source inputs"];
    scope -> package [label="导出归属，不是编译源图\nExport ownership, not a compile source graph"];
    package -> move [label="完整包\nComplete package"];
    move -> creator [label="新建公开首工程\nCreate a public starter"];
    creator -> consumer [label="可检查的源码与命令\nReviewable source and commands"];
    move -> consumer [label="已有外部工程直接消费\nExisting external project consumes directly"];
    consumer -> verify [label="加载公共入口\nLoad public entry"];
    verify -> target [label="身份与边界通过\nIdentity and boundaries accepted"];
    verify -> reject [label="验证失败\nVerification failed"];
    target -> native [label="显式选中 host support\nHost support explicitly selected"];
    target -> arm [label="所选 MCU 装配\nSelected MCU assembly"];
    native -> reports [label="实际运行结果\nActual execution results"];
    arm -> reports [label="实际链接与资源结果\nActual link and resource results"];
}
