// Current scoped view. Build-time arrows and runtime calls are labeled explicitly.
// Code basis: core/private/platform_lifecycle_impl.h; tools/configure/bindings.py; soc/stm32/stm32f4/private/stm32f4_platform_lifecycle_impl.h
digraph PlatformLifecycle {
    graph [label="FIG-05 静态连接调用共享 C 生命周期\n外部 privileged task owner 串行推进\nFIG-05 Static connections call the shared C lifecycle\nOne external privileged task owner advances serially", rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.52, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    cold [label="冷对象：无成功运行许可\nCold objects: no permission for normal operation", fillcolor="#f8fafc"];
    context [label="检查调用上下文和已有状态\nISR／mask／privilege／started\nCheck call context and existing state\nISR / mask / privilege / started"];
    admit [label="全部 controller 的纯 C 准入\n先于 System／资源取得与控制器写入\nPure C admission of every controller\nBefore System/resource acquisition or controller writes"];
    system [label="System start\n返回 primary／cleanup／remaining effects\nSystem start\nReturn primary / cleanup / remaining effects"];
    resources [label="取得共享平台资源\nAcquire shared platform resources"];
    instances [label="按声明次序 prepare 实例\n失败但留效的实例计入 cleanup\nPrepare instances in declaration order\nInclude a failed instance in cleanup if it retained effects"];
    running [label="start primary=SUCCESS\n外部才开展业务；不启动 scheduler\nstart primary=SUCCESS\nExternal application may operate; no scheduler start", fillcolor="#f0fdf4"];
    quiesce [label="产品关闭 producers／direct writers\n继续 drain，join 用户与 observers\nProduct closes producers / direct writers\nContinue draining; join users and observers"];
    reverse [label="逆序释放已取得的实例\n仅成功后减少保留前缀\nRelease acquired instances in reverse order\nShrink the retained prefix only after success"];
    releaseResources [label="释放共享平台资源\nRelease shared platform resources"];
    releaseSystem [label="释放所拥有的 System 效果\n保持具体 owner 收条\nRelease owned System effects\nPreserve each owner's receipts"];
    released [label="stop=SUCCESS：可释放效果已清理\n不保证继续主动驱动安全电平\nstop=SUCCESS: releasable effects are withdrawn\nNo promise to keep actively driving safe levels", fillcolor="#f0fdf4"];
    primary [label="保留 primary\nCore 执行逆序 rollback 并收集 cleanup\nPreserve primary\nCore rolls back in reverse order and collects cleanup", fillcolor="#fff7ed"];
    retained [label="保留未清理 leases 与存储\n继续必要 service，再重试 stop\nRetain uncleaned leases and storage\nContinue required service, then retry stop", fillcolor="#fff7ed"];
    rejected [label="拒绝：不准入新业务\n保留原生命周期与效果\nReject new operation\nPreserve the original lifecycle and effects", fillcolor="#fff7ed"];
    cold -> context [label="显式 start\nExplicit start"];
    context -> rejected [label="上下文／STATE 错误\nContext / STATE error"];
    context -> admit [label="上下文有效且为冷态\nValid context and cold state"];
    admit -> rejected [label="准入失败，无新硬件效果\nAdmission failed; no new hardware effects"];
    admit -> system [label="全部准入通过\nAll admission passed"];
    system -> resources [label="System 成功\nSystem succeeded"];
    system -> retained [label="启动失败且留有效果\nStartup failed with effects retained"];
    system -> cold [label="启动失败且未留新效果\nStartup failed with no new effects retained", constraint=false];
    resources -> instances [label="资源取得成功\nResources acquired"];
    resources -> primary [label="共享资源取得失败\nShared-resource acquisition failed"];
    instances -> running [label="全部成功\nAll succeeded"];
    instances -> primary [label="实例取得失败\nInstance acquisition failed"];
    primary -> reverse [label="逆序 rollback\nReverse rollback"];
    running -> quiesce [label="产品决定停止\nProduct decides to stop"];
    quiesce -> reverse [label="已满足 stop 调用前提\nStop preconditions satisfied"];
    reverse -> releaseResources [label="实例全部释放\nAll instances released"];
    releaseResources -> releaseSystem [label="共享资源全部释放\nAll shared resources released"];
    releaseSystem -> released [label="观测清理成功\nWithdrawal observed complete"];
    reverse -> retained [label="首个实例释放失败\nFirst instance release failed"];
    releaseResources -> retained [label="共享资源释放失败\nShared-resource release failed"];
    releaseSystem -> retained [label="System 释放失败\nSystem release failed"];
    retained -> reverse [label="按保留阶段重试；不强制回收\nRetry retained stages; no forced reclamation", constraint=false];
    released -> cold [label="新生命周期\nNew lifecycle", constraint=false];
}
