// FIG-31 current: F4 source ownership; labels distinguish calls and build inputs.
digraph F4SourceOwnership {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.5, fontname="Noto Sans CJK SC", fontsize=15, labelloc=t, label="FIG-31 F4 源码归属与接口边界\n逐边说明编译或调用；不建立软件／实板资格"];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.10"];
  edge [color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC", fontsize=11];
  io [label="io/\n公共类型、请求与借用合同"];
  f4 [label="soc/stm32/stm32f4/\n资源、生命周期与官方库适配"];
  ip [label="F4 drivers/ip/\n仍使用的私有硬件实现"];
  vendor [label="vendors/st/ F4 HAL / Device\n全部库存来源保留，按选择消费"];
  host [label="tests/support/native/\n显式测试 scope，不是生产 SoC"];
  components [label="components/\nILI9341 / XPT2046 / W25 等"];
  config [label="Board JSON + TOML\n事实、模式与实例选择"];
  io -> f4 [label="运行：ops(context)"];
  f4 -> ip [label="构建：私有源码选编", style=dashed];
  f4 -> vendor [label="构建：私有 include / link", style=dashed];
  host -> ip [label="测试：执行真实 IP 源码", style=dashed];
  components -> io [label="运行：公共窄端口"];
  config -> f4 [label="构建：生成静态连接", style=dashed];
}
