// FIG-06 current: Core request helper transitions and ownership conditions.
// Code basis: 0111c8d3b9c7b37d258b9c401070305b13b6f3a1.
// REJECTED and ACCEPTED are admission results, not request enum states.
digraph requestLifecycle {
    graph [label="FIG-06 当前Core请求状态与借用\nFIG-06 Current Core request and borrow states", fontname="Noto Sans CJK SC", fontsize=15, labelloc=t, rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.55, ranksep=0.70];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC",
          fontsize=13, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a",
          fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    fresh [shape=point, label="", fillcolor="#0f172a"];
    ready [label="READY：无 provider 借用\nREADY: no provider borrow", fillcolor="#f8fafc"];
    settled [label="SETTLED：provider 最终访问后发布\nSETTLED: published after final provider access", fillcolor="#f0fdf4"];
    subgraph clusterBorrowed {
        label="provider 借用保持\nprovider borrow remains valid"; color="#64748b"; fontname="Noto Sans CJK SC";
        queued [label="QUEUED"];
        active [label="ACTIVE"];
        draining [label="DRAINING"];
        quarantined [label="QUARANTINED：责任保留\nQUARANTINED: storage and responsibility retained", fillcolor="#fff7ed"];
        { rank=same; queued; active; }
        { rank=same; draining; quarantined; }
    }
    fresh -> ready [label="fresh initialize"];
    ready:w -> ready:w [label="REJECTED / 无借用 prepare：无残留引用或效果\nREJECTED / unborrowed prepare: no retained refs"];
    ready -> queued [label="适配器 ACCEPTED\nadapter ACCEPTED"];
    ready -> active [label="直接 provider ACCEPTED\ndirect provider ACCEPTED"];
    queued -> active [label="执行推进\nexecutor progress", constraint=false];
    queued -> draining [label="取消 / 停机推进\ncancel / shutdown progress"];
    active -> draining [label="完成 / cancel / deadline\ncompletion / cancel / deadline"];
    active -> quarantined [label="不能安全排空\nsafe drain not established"];
    draining -> quarantined [label="排空失败\ndrain failure", constraint=false];
    queued -> settled [label="队列等引用已排空\nqueue and related references drained"];
    active -> settled [label="全部必要引用已排空\nall necessary references drained"];
    draining -> settled [label="排空后 release 发布\ndrain then release-publish"];
    quarantined -> settled [label="仅实际恢复和排空证明成立\nonly after proven recovery and drain"];
    settled:e -> ready:e [label="消费结果和观察者退出后 prepare\nconsume and join observers, then prepare",
                          constraint=false];
}
