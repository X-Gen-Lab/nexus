{
    "version": 6,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "stm32-qiming-baremetal",
            "cacheVariables": {
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/qiming-baremetal.toml"
            },
            "inherits": "nexus-arm"
        },
        {
            "name": "stm32-qiming-freertos",
            "cacheVariables": {
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/qiming-freertos.toml"
            },
            "inherits": "nexus-arm"
        },
        {
            "name": "stm32-sky-baremetal",
            "cacheVariables": {
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/sky-baremetal.toml"
            },
            "inherits": "nexus-arm"
        },
        {
            "name": "stm32-sky-freertos",
            "cacheVariables": {
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/sky-freertos.toml"
            },
            "inherits": "nexus-arm"
        }
    ],
    "buildPresets": [
        {
            "name": "stm32-qiming-baremetal",
            "configurePreset": "stm32-qiming-baremetal"
        },
        {
            "name": "stm32-qiming-freertos",
            "configurePreset": "stm32-qiming-freertos"
        },
        {
            "name": "stm32-sky-baremetal",
            "configurePreset": "stm32-sky-baremetal"
        },
        {
            "name": "stm32-sky-freertos",
            "configurePreset": "stm32-sky-freertos"
        }
    ]
}
