# Register exact resolver inputs for a real generated host/model assembly.
include_guard(GLOBAL)

function(nexus_google_configuration_inputs bundle)
    foreach(catalog input_paths configuration_code_paths)
        file(READ "${bundle}/${catalog}.json" inputs)
        string(JSON kind TYPE "${inputs}")
        if(NOT kind STREQUAL "OBJECT")
            message(FATAL_ERROR "Configuration input catalog must be an object: ${catalog}")
        endif()
        string(JSON count LENGTH "${inputs}")
        if(count EQUAL 0)
            message(FATAL_ERROR "Configuration input catalog must be nonempty: ${catalog}")
        endif()
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON label MEMBER "${inputs}" ${index})
            string(JSON kind TYPE "${inputs}" "${label}")
            if(NOT kind STREQUAL "STRING")
                message(FATAL_ERROR "Configuration input path must be a string: ${label}")
            endif()
            string(JSON path GET "${inputs}" "${label}")
            if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
                message(FATAL_ERROR "Configuration input must be an existing absolute file: ${path}")
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        endforeach()
    endforeach()
endfunction()
