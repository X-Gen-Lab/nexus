# Relocatable source SDK: ABI/configuration/toolchain are consumer-owned.
get_filename_component(_nexus_sdk_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_nexus_sdk_source "${_nexus_sdk_prefix}/share/nexus/src")
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" -B
    "${_nexus_sdk_source}/cmake/package/package_source_sdk.py" --verify "${_nexus_sdk_source}"
    RESULT_VARIABLE _nexus_sdk_result OUTPUT_VARIABLE _nexus_sdk_output ERROR_VARIABLE _nexus_sdk_error)
if(NOT _nexus_sdk_result EQUAL 0)
    message(FATAL_ERROR "Installed Nexus source SDK identity rejected:\n${_nexus_sdk_output}${_nexus_sdk_error}")
endif()
file(READ "${_nexus_sdk_source}/.nexus-source-sdk.json" _nexus_sdk_identity)
string(JSON _nexus_sdk_publishable GET "${_nexus_sdk_identity}" publishable)
string(JSON _nexus_sdk_revision GET "${_nexus_sdk_identity}" source_revision)
if(NOT _nexus_sdk_publishable AND NOT NEXUS_ALLOW_SOURCE_SDK_FIXTURE)
    message(FATAL_ERROR "This source SDK is a nonpublishable development fixture; explicitly set NEXUS_ALLOW_SOURCE_SDK_FIXTURE=ON for a development consumer")
endif()
if(NEXUS_EXPECTED_SOURCE_REVISION AND NOT NEXUS_EXPECTED_SOURCE_REVISION STREQUAL _nexus_sdk_revision)
    message(FATAL_ERROR "Installed Nexus source revision differs from the consumer's expected revision")
endif()
if(NEXUS_BUILD_TESTS OR NEXUS_BUILD_WORKLOAD)
    message(FATAL_ERROR "The installed source SDK excludes development tests/contracts and their dependencies; validate the complete pinned checkout separately")
endif()
set(NEXUS_BUILD_TESTS OFF CACHE BOOL "Build Nexus host tests")
set(NEXUS_BUILD_WORKLOAD OFF CACHE BOOL "Build Nexus developer workloads")
set(Nexus_SOURCE_DIR "${_nexus_sdk_source}")
set(Nexus_SOURCE_REVISION "${_nexus_sdk_revision}")
set(Nexus_VERSION "@NEXUS_SDK_VERSION@")
set(Nexus_TOOLCHAIN_DIR "${_nexus_sdk_source}/cmake/toolchains")
set(_nexus_sdk_mode "platform")
if(Nexus_FIND_COMPONENTS)
    if(NOT Nexus_FIND_COMPONENTS STREQUAL "Runtime")
        message(FATAL_ERROR "The only optional Nexus package component is Runtime")
    endif()
    set(_nexus_sdk_mode "runtime")
endif()
get_property(_nexus_existing_mode GLOBAL PROPERTY NEXUS_SOURCE_SDK_MODE)
if(_nexus_existing_mode AND NOT _nexus_existing_mode STREQUAL _nexus_sdk_mode)
    message(FATAL_ERROR "One build cannot mix Nexus Runtime and Platform package modes")
endif()
get_property(_nexus_existing_source GLOBAL PROPERTY NEXUS_SOURCE_SDK_SOURCE)
if(_nexus_existing_source AND NOT _nexus_existing_source STREQUAL _nexus_sdk_source)
    message(FATAL_ERROR "One build may contain only one resolved Nexus source SDK")
endif()
set_property(GLOBAL PROPERTY NEXUS_SOURCE_SDK_MODE "${_nexus_sdk_mode}")
set_property(GLOBAL PROPERTY NEXUS_SOURCE_SDK_SOURCE "${_nexus_sdk_source}")
if(TARGET Nexus::Config)
    get_target_property(_nexus_existing_source Nexus::Config NEXUS_SOURCE_DIR)
    if(NOT _nexus_existing_source STREQUAL _nexus_sdk_source)
        message(FATAL_ERROR "One build may contain only one resolved Nexus source SDK")
    endif()
    if(_nexus_sdk_mode STREQUAL "runtime")
        set(Nexus_Runtime_FOUND TRUE)
    endif()
    set(Nexus_FOUND TRUE)
    return()
endif()
if(_nexus_sdk_mode STREQUAL "runtime")
    include("${_nexus_sdk_source}/cmake/platform/Runtime.cmake")
    set(Nexus_Runtime_FOUND TRUE)
    set(Nexus_FOUND TRUE)
    return()
endif()
add_subdirectory("${_nexus_sdk_source}" "${CMAKE_CURRENT_BINARY_DIR}/nexus-sdk" EXCLUDE_FROM_ALL)
set(Nexus_FOUND TRUE)
