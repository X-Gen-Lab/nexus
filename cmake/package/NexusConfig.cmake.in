# Relocatable source SDK: ABI/configuration/toolchain are consumer-owned.
get_filename_component(
    _nexus_sdk_prefix
    "${CMAKE_CURRENT_LIST_DIR}/../../.."
    ABSOLUTE
)
set(_nexus_sdk_source "${_nexus_sdk_prefix}/share/nexus/src")
find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
execute_process(
    COMMAND
        "${Python3_EXECUTABLE}" -B
        "${_nexus_sdk_source}/cmake/package/package_source_sdk.py" --verify
        "${_nexus_sdk_source}"
    RESULT_VARIABLE _nexus_sdk_result
    OUTPUT_VARIABLE _nexus_sdk_output
    ERROR_VARIABLE _nexus_sdk_error
)
if(NOT _nexus_sdk_result EQUAL 0)
    message(
        FATAL_ERROR
        "Installed Nexus source SDK identity rejected:\n${_nexus_sdk_output}${_nexus_sdk_error}"
    )
endif()
# Consume the result of this actual complete verification, not a second read
# of the mutable manifest. Every new find_package call verifies bytes again.
string(JSON _nexus_sdk_publishable GET "${_nexus_sdk_output}" publishable)
string(JSON _nexus_sdk_revision GET "${_nexus_sdk_output}" source_revision)
if(NOT _nexus_sdk_publishable AND NOT NEXUS_ALLOW_SOURCE_SDK_FIXTURE)
    message(
        FATAL_ERROR
        "This source SDK is a nonpublishable development fixture; explicitly set NEXUS_ALLOW_SOURCE_SDK_FIXTURE=ON for a development consumer"
    )
endif()
if(
    NEXUS_EXPECTED_SOURCE_REVISION
    AND NOT NEXUS_EXPECTED_SOURCE_REVISION STREQUAL _nexus_sdk_revision
)
    message(
        FATAL_ERROR
        "Installed Nexus source revision differs from the consumer's expected revision"
    )
endif()
if(NEXUS_BUILD_TESTS OR NEXUS_BUILD_WORKLOAD)
    message(
        FATAL_ERROR
        "The installed source SDK excludes development tests/contracts and their dependencies; validate the complete pinned checkout separately"
    )
endif()
set(Nexus_SOURCE_DIR "${_nexus_sdk_source}")
set(Nexus_SOURCE_REVISION "${_nexus_sdk_revision}")
set(Nexus_VERSION "@NEXUS_SDK_VERSION@")
set(Nexus_TOOLCHAIN_DIR "${_nexus_sdk_source}/cmake/toolchains")
get_property(_nexus_existing_source GLOBAL PROPERTY NEXUS_SOURCE_SDK_SOURCE)
if(
    _nexus_existing_source
    AND NOT _nexus_existing_source STREQUAL _nexus_sdk_source
)
    message(
        FATAL_ERROR
        "One build may contain only one resolved Nexus source SDK"
    )
endif()
set_property(GLOBAL PROPERTY NEXUS_SOURCE_SDK_SOURCE "${_nexus_sdk_source}")
get_property(_nexus_existing_package GLOBAL PROPERTY NEXUS_PACKAGE_SOURCE)
if(
    _nexus_existing_package
    AND NOT _nexus_existing_package STREQUAL _nexus_sdk_source
)
    message(
        FATAL_ERROR
        "One build may contain only one resolved Nexus source SDK"
    )
endif()
set_property(GLOBAL PROPERTY NEXUS_PACKAGE_SOURCE "${_nexus_sdk_source}")
if(Nexus_FIND_COMPONENTS)
    if(NOT Nexus_FIND_COMPONENTS STREQUAL "Runtime")
        message(
            FATAL_ERROR
            "The only optional Nexus package component is Runtime"
        )
    endif()
    set(Nexus_Runtime_FOUND TRUE)
endif()
include("${_nexus_sdk_source}/cmake/Nexus.cmake")
set(Nexus_FOUND TRUE)
