{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Native",
            "type": "process",
            "command": "python",
            "args": [
                "tools/dev/dev.py",
                "configure",
                "--preset",
                "native-debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Native",
            "type": "process",
            "command": "python",
            "args": [
                "tools/dev/dev.py",
                "build",
                "--preset",
                "native-debug",
                "--parallel",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "Configure Native"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
