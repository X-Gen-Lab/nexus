{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "NEXUS_BUILD_TESTS": "ON",
                "NEXUS_BUILD_EXAMPLES": "ON",
                "NEXUS_PLATFORM": "native"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Debug",
            "description": "Windows build with MSVC compiler (Debug)",
            "inherits": "windows-base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Release",
            "description": "Windows build with MSVC compiler (Release)",
            "inherits": "windows-msvc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-gcc-debug",
            "displayName": "Windows GCC Debug (MinGW)",
            "description": "Windows build with GCC compiler (Debug)",
            "inherits": "windows-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "windows-gcc-release",
            "displayName": "Windows GCC Release (MinGW)",
            "description": "Windows build with GCC compiler (Release)",
            "inherits": "windows-gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-clang-debug",
            "displayName": "Windows Clang Debug",
            "description": "Windows build with Clang compiler (Debug)",
            "inherits": "windows-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "windows-clang-release",
            "displayName": "Windows Clang Release",
            "description": "Windows build with Clang compiler (Release)",
            "inherits": "windows-clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "description": "Linux build with GCC compiler (Debug)",
            "inherits": "linux-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux GCC Release",
            "description": "Linux build with GCC compiler (Release)",
            "inherits": "linux-gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-gcc-coverage",
            "displayName": "Linux GCC Coverage",
            "description": "Linux build with GCC and coverage enabled",
            "inherits": "linux-gcc-debug",
            "cacheVariables": {
                "NEXUS_ENABLE_COVERAGE": "ON"
            }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "description": "Linux build with Clang compiler (Debug)",
            "inherits": "linux-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release",
            "description": "Linux build with Clang compiler (Release)",
            "inherits": "linux-clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-clang-debug",
            "displayName": "macOS Clang Debug",
            "description": "macOS build with Clang compiler (Debug)",
            "inherits": "macos-base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "macos-clang-release",
            "displayName": "macOS Clang Release",
            "description": "macOS build with Clang compiler (Release)",
            "inherits": "macos-clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "stm32-armgcc-debug",
            "displayName": "STM32 ARM GCC Debug",
            "description": "STM32 build with ARM GCC (arm-none-eabi-gcc) - Debug",
            "inherits": "base",
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEXUS_PLATFORM": "stm32",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_EXAMPLES": "ON",
                "NEXUS_CPU_ARCH": "cortex-m4",
                "NEXUS_FPU_TYPE": "fpv4-sp-d16",
                "NEXUS_FLOAT_ABI": "hard"
            }
        },
        {
            "name": "stm32-armgcc-release",
            "displayName": "STM32 ARM GCC Release",
            "description": "STM32 build with ARM GCC (arm-none-eabi-gcc) - Release",
            "inherits": "stm32-armgcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "stm32-armgcc-minsizerel",
            "displayName": "STM32 ARM GCC MinSizeRel",
            "description": "STM32 build with ARM GCC (arm-none-eabi-gcc) - Minimum Size Release",
            "inherits": "stm32-armgcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "stm32-armclang-debug",
            "displayName": "STM32 ARM Clang Debug",
            "description": "STM32 build with ARM Clang (armclang) - Debug",
            "inherits": "base",
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/cmake/toolchains/armclang.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEXUS_PLATFORM": "stm32",
                "NEXUS_BUILD_TESTS": "OFF",
                "NEXUS_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "stm32-armclang-release",
            "displayName": "STM32 ARM Clang Release",
            "description": "STM32 build with ARM Clang (armclang) - Release",
            "inherits": "stm32-armclang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "stm32-armclang-minsizerel",
            "displayName": "STM32 ARM Clang MinSizeRel",
            "description": "STM32 build with ARM Clang (armclang) - Minimum Size Release",
            "inherits": "stm32-armclang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "windows-stm32-armclang-debug",
            "displayName": "Windows → STM32 ARM Clang Debug",
            "description": "Windows host, STM32 target with ARM Clang (armclang) - Debug",
            "inherits": [
                "windows-base",
                "stm32-armclang-debug"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-stm32-armclang-release",
            "displayName": "Windows → STM32 ARM Clang Release",
            "description": "Windows host, STM32 target with ARM Clang (armclang) - Release",
            "inherits": "windows-stm32-armclang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-stm32-armclang-debug",
            "displayName": "Linux → STM32 ARM Clang Debug",
            "description": "Linux host, STM32 target with ARM Clang (armclang) - Debug",
            "inherits": [
                "linux-base",
                "stm32-armclang-debug"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-stm32-armclang-release",
            "displayName": "Linux → STM32 ARM Clang Release",
            "description": "Linux host, STM32 target with ARM Clang (armclang) - Release",
            "inherits": "linux-stm32-armclang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-stm32-armgcc-debug",
            "displayName": "Windows → STM32 ARM GCC Debug",
            "description": "Windows host, STM32 target with ARM GCC (arm-none-eabi-gcc) - Debug",
            "inherits": [
                "windows-base",
                "stm32-armgcc-debug"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-stm32-armgcc-release",
            "displayName": "Windows → STM32 ARM GCC Release",
            "description": "Windows host, STM32 target with ARM GCC (arm-none-eabi-gcc) - Release",
            "inherits": "windows-stm32-armgcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-stm32-armgcc-debug",
            "displayName": "Linux → STM32 ARM GCC Debug",
            "description": "Linux host, STM32 target with ARM GCC (arm-none-eabi-gcc) - Debug",
            "inherits": [
                "linux-base",
                "stm32-armgcc-debug"
            ],
            "condition": {
                "type": "equals",
