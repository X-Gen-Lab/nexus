            "description": "Linux host, STM32 target with ARM GCC (arm-none-eabi-gcc) - Release",
            "inherits": "linux-stm32-armgcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
