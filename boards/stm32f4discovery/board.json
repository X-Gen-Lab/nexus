{
  "schema": 1,
  "id": "stm32f4discovery-mb997",
  "soc": "stm32f407vg",
  "hse_hz": 8000000,
  "interface_target": "board_stm32f4discovery",
  "object_targets": [
    "board_stm32f4discovery_wiring"
  ],
  "inputs": [
    "CMakeLists.txt",
    "nexus_board.h",
    "uart.c",
    "spi.c"
  ],
  "resources": [
    {
      "id": "status-led",
      "kind": "gpio",
      "when": "CONFIG_STM32_GPIO_ENABLE",
      "pins": [
        {
          "port": "D",
          "pin": 12,
          "af": 0,
          "signal": "led",
          "initial": 0
        }
      ]
    },
    {
      "id": "console",
      "kind": "uart",
      "instance": 1,
      "when": "CONFIG_STM32_UART_ENABLE",
      "clock": "USART2",
      "irq": 38,
      "priority": 5,
      "pins": [
        {
          "port": "A",
          "pin": 2,
          "af": 7,
          "signal": "tx"
        },
        {
          "port": "A",
          "pin": 3,
          "af": 7,
          "signal": "rx"
        }
      ]
    },
    {
      "id": "spi-fixture",
      "kind": "spi",
      "instance": 1,
      "when": "CONFIG_STM32_SPI_ENABLE",
      "clock": "SPI1",
      "irq": 35,
      "priority": 5,
      "pins": [
        {
          "port": "A",
          "pin": 5,
          "af": 5,
          "signal": "sck"
        },
        {
          "port": "A",
          "pin": 6,
          "af": 5,
          "signal": "miso"
        },
        {
          "port": "A",
          "pin": 7,
          "af": 5,
          "signal": "mosi"
        },
        {
          "port": "B",
          "pin": 0,
          "af": 0,
          "signal": "cs0",
          "initial": 1
        },
        {
          "port": "B",
          "pin": 1,
          "af": 0,
          "signal": "cs1",
          "initial": 1
        }
      ],
      "dma": [
        {
          "direction": "tx",
          "controller": "DMA2",
          "stream": 3,
          "channel": 3,
          "irq": 59
        },
        {
          "direction": "rx",
          "controller": "DMA2",
          "stream": 0,
          "channel": 3,
          "irq": 56
        }
      ]
    }
  ]
}
