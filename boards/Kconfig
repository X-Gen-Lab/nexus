choice
    prompt "Reference board"
    default BOARD_NATIVE_REFERENCE if PLATFORM_NATIVE
    default BOARD_STM32F4DISCOVERY if PLATFORM_STM32 && STM32F407VG
    default BOARD_STM32F407_QIMING_V31 if PLATFORM_STM32 && STM32F407ZG
    default BOARD_STM32F407VE_SKY_QINGCHUN if PLATFORM_STM32 && STM32F407VE
    default BOARD_GD32F470_LIANGSHAN if PLATFORM_GD32F470 && GD32F470ZG
config BOARD_EXTERNAL
    bool "External board package (NEXUS_BOARD_DIR required)"
config BOARD_NATIVE_REFERENCE
    bool "Native simulation"
    depends on PLATFORM_NATIVE
config BOARD_STM32F4DISCOVERY
    bool "STM32F4DISCOVERY MB997 (hardware verification pending)"
    depends on PLATFORM_STM32 && STM32F407VG
config BOARD_STM32F407_QIMING_V31
    bool "Qiming Xinxin STM32F407ZGT6 high-spec V3.1"
    depends on PLATFORM_STM32 && STM32F407ZG
config BOARD_STM32F407VE_SKY_QINGCHUN
    bool "Sky youth STM32F407VET6"
    depends on PLATFORM_STM32 && STM32F407VE
config BOARD_GD32F470_LIANGSHAN
    bool "Liangshan GD32F470ZGT6 (physical verification pending)"
    depends on PLATFORM_GD32F470 && GD32F470ZG
endchoice
config BOARD_NAME
    string
    default "$(NEXUS_EXTERNAL_BOARD_NAME)" if BOARD_EXTERNAL
    default "native-reference" if BOARD_NATIVE_REFERENCE
    default "stm32f4discovery-mb997" if BOARD_STM32F4DISCOVERY
    default "stm32f407zg-qiming-v31" if BOARD_STM32F407_QIMING_V31
    default "stm32f407ve-sky-qingchun" if BOARD_STM32F407VE_SKY_QINGCHUN
    default "gd32f470zg-liangshan" if BOARD_GD32F470_LIANGSHAN
