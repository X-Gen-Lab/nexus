{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/X-Gen-Lab/nexus/blob/main/scripts/hil/fixtures/fixture.schema.json",
  "title": "Nexus reference Board HIL fixture",
  "type": "object",
  "required": ["schema", "kind", "hardware_verified", "board_id", "soc", "board_manifest", "chip_part", "flash_base", "flash_size", "debug", "console", "led", "electrical_notes", "required_tests", "pending_qualification"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "board_fixture_template"},
    "hardware_verified": {"const": false},
    "board_id": {"type": "string", "minLength": 1},
    "soc": {"enum": ["stm32f407vg", "stm32f407zg", "stm32f407ve", "gd32f470zg"]},
    "board_manifest": {"type": "string", "minLength": 1},
    "chip_part": {"enum": ["STM32F407VGT6", "STM32F407ZGT6", "STM32F407VET6", "GD32F470ZGT6"]},
    "flash_base": {"const": 134217728},
    "flash_size": {"enum": [524288, 1048576]},
    "debug": {"type": "object", "required": ["transport", "reference_probe", "allowed_interfaces", "openocd_target_hint", "adapter_clock_khz"]},
    "console": {"type": "object", "required": ["controller", "tx", "rx", "baudrate", "frame", "mcu_voltage_mv", "host_rx_to", "host_tx_to", "common_ground"]},
    "led": {"type": "object", "required": ["pin", "active_level"]},
    "electrical_notes": {"type": "string"},
    "required_tests": {"const": ["probe_identity", "flash_readback", "reset", "uart_echo"]},
    "pending_qualification": {"type": "array", "items": {"type": "object", "required": ["id", "fixture", "budget", "unit"], "properties": {"budget": {"type": "null"}}}}
  }
}
