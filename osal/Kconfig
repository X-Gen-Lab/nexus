# osal/Kconfig - Operating System Abstraction Layer configuration

menu "Operating System Abstraction Layer"

choice
    prompt "OSAL Backend"
    default OSAL_NATIVE if PLATFORM_NATIVE
    default OSAL_BAREMETAL
    help
      Select the operating system backend for OSAL.

      Available backends:
      - Bare-metal: Control loop and hardware ISRs, no task scheduler
      - FreeRTOS: Popular real-time operating system
      - Native: PC simulation backend

config OSAL_BAREMETAL
    bool "Bare-metal (No OS)"
    help
      Bare-metal implementation without RTOS.
      Provides bounded synchronization for one control thread and hardware
      ISRs. Tasks, a dynamic OSAL heap and software timers are unsupported.

config OSAL_FREERTOS
    bool "FreeRTOS Cortex-M4F port"
    depends on PLATFORM_STM32 || PLATFORM_GD32F470
    help
      FreeRTOS real-time operating system.
      Industry-standard RTOS with wide platform support.

config OSAL_NATIVE
    bool "Native host backend"
    depends on PLATFORM_NATIVE
    help
      Native PC simulation backend.
      For development and testing on PC.

endchoice

# OSAL backend name string
config OSAL_BACKEND_NAME
    string
    default "baremetal" if OSAL_BAREMETAL
    default "freertos" if OSAL_FREERTOS
    default "native" if OSAL_NATIVE

# System parameters configuration
menu "System Parameters"

config OSAL_MAX_TASKS
    int "Maximum task handles"
    default 16 if PLATFORM_NATIVE
    default 8
    range 1 64

config OSAL_MAX_MUTEXES
    int "Maximum mutex handles"
    default 16 if PLATFORM_NATIVE
    default 8
    range 1 64

config OSAL_MAX_SEMS
    int "Maximum semaphore handles"
    default 16 if PLATFORM_NATIVE
    default 8
    range 1 64

config OSAL_MAX_QUEUES
    int "Maximum queue handles"
    default 8 if PLATFORM_NATIVE
    default 4
    range 1 32

config OSAL_MAX_EVENTS
    int "Maximum event handles"
    default 8 if PLATFORM_NATIVE
    default 4
    range 1 32

config OSAL_MAX_TIMERS
    int "Maximum software timer handles"
    default 8 if PLATFORM_NATIVE
    default 4
    range 1 32

config OSAL_MAX_QUEUE_ITEM_SIZE
    int "Maximum queue item size (bytes)"
    default 1024
    range 16 4096
    help
      Bound each queue copy. The default includes the asynchronous logging
      entry and its metadata; oversized items fail before allocation.

config OSAL_MAX_QUEUE_BYTES
    int "Maximum allocation for one queue (bytes)"
    default 65536 if PLATFORM_NATIVE
    default 8192
    range 256 1048576
    help
      Product memory budget, independently checked before multiplication.

config OSAL_TICK_RATE_HZ
    int "System tick rate (Hz)" if OSAL_FREERTOS
    default 1000 if OSAL_FREERTOS
    default 1000
    range 1000 1000 if PLATFORM_NATIVE || ((PLATFORM_STM32 || PLATFORM_GD32F470) && OSAL_FREERTOS)
    range 100 10000
    help
      System tick rate in Hz.
      Higher rates provide better timing resolution but increase overhead.
      The F407 reference shares the 1 ms HAL time base and currently requires
      exactly 1,000 Hz. Other rates require an independent HAL time base.

config OSAL_HEAP_SIZE
    int "FreeRTOS heap size (bytes)"
    depends on OSAL_FREERTOS
    default 32768 if OSAL_FREERTOS
    default 65536
    range 4096 1048576
    help
      Total heap size in bytes.
      Used for dynamic memory allocation.

config OSAL_MAX_PRIORITIES
    int "Maximum priority levels"
    default 32 if OSAL_FREERTOS
    default 16
    range 8 32
    depends on OSAL_FREERTOS
    help
      Maximum number of priority levels.
      More levels provide finer control but increase overhead.

endmenu

# Include backend-specific configuration files
# Baremetal has no scheduler configuration or software task limits.
rsource "adapters/freertos/Kconfig"

endmenu
