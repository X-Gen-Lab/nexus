+/* Published only after the real recursive mutex is initialized.
+   Before then the supported caller is the single bootstrap thread. */
+static _Atomic unsigned int _nx_linux_mutex_ready;
+
+unsigned int nx_threadx_linux_system_state(void)
+{
+    unsigned int state;
+    if (!atomic_load_explicit(&_nx_linux_mutex_ready, memory_order_acquire))
+        return (unsigned int)_tx_thread_system_state;
+    tx_linux_mutex_lock(_tx_linux_mutex);
+    state = (unsigned int)_tx_thread_system_state;
+    tx_linux_mutex_unlock(_tx_linux_mutex);
+    return state;
+}
+
+unsigned int nx_threadx_linux_return_flags(void)
+{
+    unsigned int flags;
+    if (!atomic_load_explicit(&_nx_linux_mutex_ready, memory_order_acquire))
+        return (unsigned int)(_tx_thread_system_state | _tx_thread_preempt_disable);
+    tx_linux_mutex_lock(_tx_linux_mutex);
+    flags = (unsigned int)(_tx_thread_system_state | _tx_thread_preempt_disable);
+    tx_linux_mutex_unlock(_tx_linux_mutex);
+    return flags;
+}
+
+struct TX_THREAD_STRUCT *nx_threadx_linux_current(void)
+{
+    TX_THREAD *current;
+    if (!atomic_load_explicit(&_nx_linux_mutex_ready, memory_order_acquire))
+        return _tx_thread_current_ptr;
+    tx_linux_mutex_lock(_tx_linux_mutex);
+    current = _tx_thread_current_ptr;
+    tx_linux_mutex_unlock(_tx_linux_mutex);
+    return current;
+}
+
 static sigset_t     _tx_linux_thread_wait_mask;
+
