#-----------------------------------------------------------------------------
# Applications Configuration
#-----------------------------------------------------------------------------
# This file defines configuration options for example applications.
# Generic applications can also execute against the Native reference board.
#-----------------------------------------------------------------------------


menu "Example Applications"

config BUILD_APP_BLINKY
    bool "Build Blinky Example"
    default y
    help
      Basic LED blinky example demonstrating GPIO control.

      Features:
        - GPIO initialization and control
        - Basic delay functions
        - Minimal resource usage

      Suitable for: All platforms
      Requirements: GPIO peripheral

config BUILD_APP_SHELL_DEMO
    bool "Build Shell Demo"
    default y
    depends on PLATFORM_NATIVE && FRAMEWORK_SHELL
    help
      Native standard-stream console with a real Shell framework backend,
      one board LED, checked command outcomes and a finite --smoke mode.
      MCU consoles require an explicit product transport binding and are
      not provided by this reference application.

config BUILD_APP_CONFIG_DEMO
    bool "Build Config Demo"
    depends on FRAMEWORK_CONFIG
    default y
    help
      Finite checked volatile parameter-store demonstration: typed values,
      namespace isolation, JSON and binary v2 round trips and explicit error
      outcomes. Persistence requires a separate backend and is not claimed.

config BUILD_APP_STM32_BLINKY
    bool "Build STM32 Minimal Blinky"
    default y if PLATFORM_STM32
    depends on PLATFORM_STM32
    help
      Direct ST HAL GPIO demonstration for the STM32F4DISCOVERY PD12 LED.
      This uses the selected SDK, startup, clock and board wiring. Build
      evidence does not establish boot or timing on a physical board.

config BUILD_APP_STM32_CONFIG_TEST
    bool "Build STM32 Configuration Test"
    default y if PLATFORM_STM32
    depends on PLATFORM_STM32
    help
      Read-only STM32F407 diagnostics using shared platform startup:
      effective configuration, observed clock/identity, NVIC and heartbeat.
      The product must provide a printf transport; no Flash erase/program
      or peripheral qualification is performed by this application.

config BUILD_APP_FREERTOS_DEMO
    bool "Build FreeRTOS Demo"
    default y if OSAL_FREERTOS
    depends on OSAL_FREERTOS || OSAL_NATIVE
    help
      OSAL adapter demonstration with tasks and bounded resources.

      Features:
        - Multi-task creation and management
        - Mutex for resource protection
        - Semaphore for task synchronization
        - Message queue for inter-task communication

      Requires Native or FreeRTOS OSAL; baremetal tasks are unsupported.

#-----------------------------------------------------------------------------
# Application Common Settings
#-----------------------------------------------------------------------------

menu "Application Common Settings"

config APP_STACK_SIZE
    hex "Application stack size"
    default 0x1000
    range 0x400 0x10000
    help
      Linker reservation for the CPU main/exception stack, in bytes.
      OSAL task stacks use their independently bounded backend pools.

      Recommended values:
        - Simple applications: 0x400 (1KB)
        - Standard applications: 0x1000 (4KB)
        - Complex applications: 0x2000 (8KB)

config APP_HEAP_SIZE
    hex "Application heap size"
    default 0x2000
    range 0x200 0x100000
    help
      Linker reservation for the C runtime heap, in bytes. FreeRTOS's
      management heap and static OSAL object pools have separate budgets.

      Recommended values:
        - Minimal: 0x200 (512B)
        - Standard: 0x2000 (8KB)
        - Large: 0x10000 (64KB)

endmenu

#-----------------------------------------------------------------------------
# Post-Build Options
#-----------------------------------------------------------------------------

menu "Post-Build Options"

config APP_GENERATE_BIN
    bool "Generate binary (.bin) files"
    default y
    help
      Generate binary files for flashing.
      Uses objcopy to create .bin files from ELF.

config APP_GENERATE_HEX
    bool "Generate Intel HEX (.hex) files"
    default y
    help
      Generate Intel HEX files for flashing.
      Uses objcopy to create .hex files from ELF.

config APP_GENERATE_MAP
    bool
    default y
    help
      A detailed linker map is mandatory firmware evidence. It records
      memory usage and symbol locations for each application.

config APP_PRINT_SIZE
    bool "Print size information"
    default y
    help
      Print memory usage information after build.
      Shows text, data, and bss section sizes.

config APP_PRINT_MEMORY_USAGE
    bool "Print detailed memory usage"
    default y
    help
      Print detailed memory region usage.
      Shows usage of FLASH, RAM, and other memory regions.

endmenu

endmenu
