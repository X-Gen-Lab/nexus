# Sky youth STM32F407VET6: LED PB2 high=on; physical verification pending.
# Official board material binds 8 MHz HSE and USART1 PA9 TX / PA10 RX.
# SPI remains disabled until its physical resource binding is qualified.
CONFIG_STM32F407VE=y
CONFIG_BOARD_STM32F407VE_SKY_QINGCHUN=y
CONFIG_INSTANCE_STM32_GPIOB_PIN2=y
CONFIG_GPIO_B2_RW_MODE_READWRITE=y
CONFIG_GPIO_B2_MODE_OUTPUT_PP=y
CONFIG_GPIO_B2_INIT_VALUE=0
CONFIG_STM32_UART_ENABLE=y
CONFIG_INSTANCE_STM32_UART_0=y
CONFIG_INSTANCE_STM32_UART_1=n
CONFIG_INSTANCE_STM32_UART_2=n
CONFIG_PLATFORM_STM32=y
CONFIG_CPU_CORTEX_M4=y
CONFIG_FPU_FPV4_SP=y
CONFIG_FLOAT_ABI_HARD=y
CONFIG_STM32_HSE_ENABLE=y
CONFIG_STM32_HSE_VALUE=8000000
CONFIG_STM32_SYSCLK_FREQ=168000000
CONFIG_STM32_GPIO_ENABLE=y
CONFIG_STM32_SPI_ENABLE=n
CONFIG_STM32_UART_USE_DMA=n
CONFIG_SERVICE_STORAGE=y
CONFIG_SERVICE_SECURITY=n
CONFIG_SERVICE_UPDATE=n
CONFIG_SERVICE_PROTOCOLS=y
CONFIG_SERVICE_INDUSTRIAL=y
CONFIG_FRAMEWORK_CONFIG=n
CONFIG_FRAMEWORK_LOG=n
CONFIG_FRAMEWORK_SHELL=n
CONFIG_FRAMEWORK_INIT=n
CONFIG_FIRMWARE_MAIN_STACK_SIZE=0x800
CONFIG_FIRMWARE_LIBC_HEAP_SIZE=0x800
CONFIG_OSAL_MAX_TASKS=4
CONFIG_OSAL_MAX_MUTEXES=4
CONFIG_OSAL_MAX_SEMS=4
CONFIG_OSAL_MAX_QUEUES=2
CONFIG_OSAL_MAX_EVENTS=2
CONFIG_OSAL_MAX_TIMERS=2
CONFIG_OSAL_MAX_QUEUE_ITEM_SIZE=256
CONFIG_OSAL_MAX_QUEUE_BYTES=1024
CONFIG_OSAL_FREERTOS=y
CONFIG_OSAL_HEAP_SIZE=16384
