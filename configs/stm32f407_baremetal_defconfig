# STM32F407 reference build (electrical behavior requires HIL evidence).
CONFIG_PLATFORM_STM32=y
CONFIG_OSAL_BAREMETAL=y
CONFIG_BOARD_STM32F4DISCOVERY=y
CONFIG_INSTANCE_STM32_GPIOD_PIN12=y
CONFIG_GPIO_D12_RW_MODE_READWRITE=y
CONFIG_GPIO_D12_MODE_OUTPUT_PP=y
CONFIG_GPIO_D12_INIT_VALUE=0
CONFIG_STM32_SPI_ENABLE=y
CONFIG_STM32_SPI1_ENABLE=y
CONFIG_STM32_SPI_USE_DMA=y
CONFIG_INSTANCE_STM32_UART_0=n
CONFIG_INSTANCE_STM32_UART_1=y
CONFIG_STM32_UART_USE_DMA=n
