# CONFIG_GPIO_A0_MODE_AF_PP is not set
# CONFIG_GPIO_A0_MODE_AF_OD is not set
# CONFIG_GPIO_A0_MODE_ANALOG is not set
CONFIG_GPIO_A0_MODE=0x00000001
CONFIG_GPIO_A0_PULL_NONE=y
# CONFIG_GPIO_A0_PULL_UP is not set
# CONFIG_GPIO_A0_PULL_DOWN is not set
CONFIG_GPIO_A0_PULL=0x00000000
# CONFIG_GPIO_A0_SPEED_LOW is not set
CONFIG_GPIO_A0_SPEED_MEDIUM=y
# CONFIG_GPIO_A0_SPEED_HIGH is not set
# CONFIG_GPIO_A0_SPEED_VERY_HIGH is not set
CONFIG_GPIO_A0_SPEED=0x00000001
CONFIG_GPIO_A0_INIT_VALUE=0
