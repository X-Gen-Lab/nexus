
#
# Build Configuration
#
CONFIG_BUILD_TYPE_DEBUG=y
# CONFIG_BUILD_TYPE_RELEASE is not set
# CONFIG_BUILD_TYPE_MINSIZEREL is not set
# CONFIG_BUILD_TYPE_RELWITHDEBINFO is not set
CONFIG_BUILD_TYPE="Debug"
CONFIG_BUILD_EXAMPLES=y
# end of Build Configuration

#
# Toolchain Configuration
#
# CONFIG_TOOLCHAIN_ARM_GCC is not set
CONFIG_TOOLCHAIN_ARM_CLANG=y
# CONFIG_TOOLCHAIN_IAR is not set
CONFIG_TOOLCHAIN_NAME="armclang"
CONFIG_TOOLCHAIN_FILE="cmake/toolchains/armclang.cmake"

#
# ARM CPU Configuration
#
# CONFIG_CPU_CORTEX_M0 is not set
# CONFIG_CPU_CORTEX_M0PLUS is not set
# CONFIG_CPU_CORTEX_M3 is not set
CONFIG_CPU_CORTEX_M4=y
# CONFIG_CPU_CORTEX_M7 is not set
# CONFIG_CPU_CORTEX_M33 is not set
CONFIG_CPU_ARCH="cortex-m4"
# CONFIG_FPU_NONE is not set
CONFIG_FPU_FPV4_SP=y
CONFIG_FPU_TYPE="fpv4-sp-d16"
# CONFIG_FLOAT_ABI_SOFT is not set
# CONFIG_FLOAT_ABI_SOFTFP is not set
CONFIG_FLOAT_ABI_HARD=y
CONFIG_FLOAT_ABI="hard"
# end of ARM CPU Configuration

#
# Linker Configuration
#
CONFIG_LINKER_SCRIPT=""
CONFIG_STACK_SIZE=0x400
CONFIG_HEAP_SIZE=0x200
# end of Linker Configuration
# end of Toolchain Configuration

#
# Platform Configuration
#
# CONFIG_PLATFORM_NATIVE is not set
CONFIG_PLATFORM_STM32=y
# CONFIG_PLATFORM_GD32 is not set
# CONFIG_PLATFORM_ESP32 is not set
# CONFIG_PLATFORM_NRF52 is not set
CONFIG_PLATFORM_NAME="stm32"
CONFIG_STM32_PLATFORM_NAME="STM32 Platform"
CONFIG_STM32_PLATFORM_VERSION="2.0.0"
# CONFIG_STM32F0 is not set
# CONFIG_STM32F1 is not set
# CONFIG_STM32F2 is not set
# CONFIG_STM32F3 is not set
CONFIG_STM32F4=y
# CONFIG_STM32F7 is not set
# CONFIG_STM32H5 is not set
# CONFIG_STM32H7 is not set
# CONFIG_STM32L0 is not set
# CONFIG_STM32L1 is not set
# CONFIG_STM32L4 is not set
# CONFIG_STM32L5 is not set
# CONFIG_STM32U0 is not set
# CONFIG_STM32U3 is not set
# CONFIG_STM32U5 is not set
# CONFIG_STM32WB is not set
# CONFIG_STM32WL is not set
# CONFIG_STM32G0 is not set
# CONFIG_STM32G4 is not set
# CONFIG_STM32C0 is not set
CONFIG_STM32_SERIES="stm32f4"
CONFIG_STM32_HAS_MPU=y
CONFIG_STM32_HAS_FPU=y
CONFIG_STM32_CHIP_NAME="STM32F407xx"
CONFIG_STM32_FLASH_SIZE=0x100000
CONFIG_STM32_SRAM_SIZE=0x30000
# CONFIG_STM32F401xB is not set
# CONFIG_STM32F401xC is not set
# CONFIG_STM32F401xD is not set
# CONFIG_STM32F401xE is not set
# CONFIG_STM32F405 is not set
CONFIG_STM32F407=y
# CONFIG_STM32F410Tx is not set
# CONFIG_STM32F410Cx is not set
# CONFIG_STM32F410Rx is not set
# CONFIG_STM32F411xC is not set
# CONFIG_STM32F411xE is not set
# CONFIG_STM32F412Cx is not set
# CONFIG_STM32F412Rx is not set
# CONFIG_STM32F412Vx is not set
# CONFIG_STM32F412Zx is not set
# CONFIG_STM32F413xx is not set
# CONFIG_STM32F423xx is not set
# CONFIG_STM32F427 is not set
# CONFIG_STM32F437 is not set
# CONFIG_STM32F429 is not set
# CONFIG_STM32F439 is not set
# CONFIG_STM32F446 is not set
# CONFIG_STM32F469 is not set
# CONFIG_STM32F479 is not set
CONFIG_STM32F4_HAS_ETHERNET=y

#
# Clock Configuration
#
CONFIG_STM32_HSE_ENABLE=y
CONFIG_STM32_HSE_VALUE=8000000
CONFIG_STM32_HSE_STARTUP_TIMEOUT=100
CONFIG_STM32_HSI_VALUE=16000000
# CONFIG_STM32_LSE_ENABLE is not set
CONFIG_STM32_LSI_VALUE=32000
CONFIG_STM32_SYSCLK_FREQ=168000000
# end of Clock Configuration

#
# Boot Configuration
#
CONFIG_STM32_ENABLE_FPU=y
CONFIG_STM32_STACK_SIZE=0x1000
CONFIG_STM32_HEAP_SIZE=0x1000
CONFIG_STM32_VTOR_OFFSET=0x00000000
CONFIG_STM32_BOOT_TIMEOUT=100
# CONFIG_STM32_ENABLE_BOOT_LOGGING is not set
# end of Boot Configuration

#
# Interrupt Configuration
#
CONFIG_STM32_NVIC_PRIORITY_GROUP=4
# CONFIG_STM32_ENABLE_FAULT_HANDLERS is not set
CONFIG_STM32_SYSTICK_PRIORITY=15
CONFIG_STM32_PENDSV_PRIORITY=15
# end of Interrupt Configuration

#
# Peripheral Configuration
#
CONFIG_STM32_UART_ENABLE=y
# end of Peripheral Configuration

#
# System Configuration
#
CONFIG_STM32_VDD_VALUE=3300
CONFIG_STM32_TICK_INT_PRIORITY=0x0F
# CONFIG_STM32_USE_RTOS is not set
CONFIG_STM32_PREFETCH_ENABLE=y
CONFIG_STM32_INSTRUCTION_CACHE_ENABLE=y
CONFIG_STM32_DATA_CACHE_ENABLE=y
# CONFIG_STM32_USE_FULL_ASSERT is not set
# end of System Configuration

#
# STM32 Platform Settings
#
CONFIG_STM32_ENABLE_LOGGING=y
CONFIG_STM32_LOG_LEVEL=3
# CONFIG_STM32_ENABLE_STATISTICS is not set
CONFIG_STM32_BUFFER_ALIGNMENT=4
# end of STM32 Platform Settings

#
# Resource Managers
#
CONFIG_STM32_DMA_CHANNELS=8
CONFIG_STM32_ISR_SLOTS=64
CONFIG_STM32_GPIO_PORTS=9
# end of Resource Managers

#
# Advanced Features
#
CONFIG_STM32_USE_HAL_DRIVER=y
# CONFIG_STM32_USE_LL_DRIVER is not set
# CONFIG_STM32_ENABLE_RTOS_SUPPORT is not set
CONFIG_STM32_HAL_TIMEOUT_VALUE=1000
# end of Advanced Features
# end of Platform Configuration

#
# Hardware Abstraction Layer
#
CONFIG_HAL_ENABLE=y

#
# Debug Configuration
#
# CONFIG_HAL_DEBUG_ENABLE is not set
CONFIG_HAL_ASSERT_ENABLE=y
# end of Debug Configuration

#
# Statistics Configuration
#
CONFIG_HAL_STATISTICS_ENABLE=y
CONFIG_HAL_STATISTICS_BUFFER_SIZE=256
# end of Statistics Configuration

#
# Timeout Configuration
#
CONFIG_HAL_DEFAULT_TIMEOUT_MS=1000
CONFIG_HAL_INIT_TIMEOUT_MS=5000
# end of Timeout Configuration

#
# Memory Configuration
#
CONFIG_HAL_MEM_MODE_STATIC=y
# CONFIG_HAL_MEM_MODE_DYNAMIC is not set
CONFIG_HAL_MEM_POOL_SIZE=4096
# end of Memory Configuration

#
# Thread Safety
#
# end of Thread Safety
# end of Hardware Abstraction Layer

#
# Operating System Abstraction Layer
#
CONFIG_OSAL_BAREMETAL=y
# CONFIG_OSAL_FREERTOS is not set
# CONFIG_OSAL_RTTHREAD is not set
# CONFIG_OSAL_ZEPHYR is not set
# CONFIG_OSAL_LINUX is not set
# CONFIG_OSAL_NATIVE is not set
CONFIG_OSAL_BACKEND_NAME="baremetal"

#
# System Parameters
#
CONFIG_OSAL_TICK_RATE_HZ=1000
CONFIG_OSAL_HEAP_SIZE=16384
CONFIG_OSAL_MAIN_STACK_SIZE=4096
# end of System Parameters

#
# Linker Script Configuration
#
CONFIG_LINKER_RAM_START=0x20000000
CONFIG_LINKER_RAM_SIZE=0x00020000
CONFIG_LINKER_FLASH_START=0x08000000
CONFIG_LINKER_FLASH_SIZE=0x00100000
# end of Linker Script Configuration

#
# Bare-metal Configuration
#
CONFIG_BAREMETAL_SIMPLE_SCHEDULER=y
CONFIG_BAREMETAL_MAX_TASKS=8
# end of Bare-metal Configuration
# end of Operating System Abstraction Layer

#
# Framework Configuration
#
# CONFIG_FRAMEWORK_LOG is not set
# CONFIG_FRAMEWORK_CONFIG is not set
# CONFIG_FRAMEWORK_INIT is not set
# CONFIG_FRAMEWORK_EVENT is not set
# CONFIG_FRAMEWORK_STATE_MACHINE is not set
# end of Framework Configuration

#
# Example Applications
#
# CONFIG_BUILD_APP_BLINKY is not set
# CONFIG_BUILD_APP_CONFIG_DEMO is not set
CONFIG_BUILD_APP_STM32_BLINKY=y

#
# Application Common Settings
#
CONFIG_APP_VERSION_MAJOR=1
CONFIG_APP_VERSION_MINOR=0
CONFIG_APP_VERSION_PATCH=0
CONFIG_APP_ENABLE_VERSION_INFO=y
CONFIG_APP_ENABLE_DEBUG_OUTPUT=y
CONFIG_APP_STACK_SIZE=0x1000
CONFIG_APP_HEAP_SIZE=0x2000
# end of Application Common Settings

#
# Post-Build Options
#
CONFIG_APP_GENERATE_BIN=y
CONFIG_APP_GENERATE_HEX=y
CONFIG_APP_GENERATE_MAP=y
CONFIG_APP_PRINT_SIZE=y
CONFIG_APP_PRINT_MEMORY_USAGE=y
# end of Post-Build Options
# end of Example Applications
