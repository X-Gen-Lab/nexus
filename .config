CONFIG_HAL_UART_MODULE=y
CONFIG_HAL_USART_MODULE=y
CONFIG_HAL_GPIO_MODULE=y
CONFIG_HAL_RCC_MODULE=y
CONFIG_HAL_CORTEX_MODULE=y
CONFIG_HAL_UART_TX_COMPLETE_CALLBACK=y
CONFIG_HAL_UART_RX_COMPLETE_CALLBACK=y
CONFIG_HAL_UART_ERROR_CALLBACK=y

#
# System Configuration
#
CONFIG_STM32_VDD_VALUE=3300
CONFIG_STM32_TICK_INT_PRIORITY=0x0F
# CONFIG_STM32_USE_RTOS is not set
CONFIG_STM32_PREFETCH_ENABLE=y
CONFIG_STM32_INSTRUCTION_CACHE_ENABLE=y
CONFIG_STM32_DATA_CACHE_ENABLE=y
# CONFIG_STM32_USE_FULL_ASSERT is not set
CONFIG_STM32_ENABLE_PERFORMANCE_MEASUREMENT=y
CONFIG_STM32_BOOT_TIME_MEASUREMENT=y
CONFIG_STM32_CODE_SIZE_REPORTING=y
# CONFIG_STM32_ENABLE_PROFILING is not set
# end of System Configuration

#
# STM32 Platform Settings
#
CONFIG_STM32_ENABLE_LOGGING=y
CONFIG_STM32_LOG_LEVEL=3
# CONFIG_STM32_ENABLE_STATISTICS is not set
CONFIG_STM32_BUFFER_ALIGNMENT=4
# end of STM32 Platform Settings

#
# Resource Managers
#
CONFIG_STM32_DMA_CHANNELS=8
CONFIG_STM32_ISR_SLOTS=64
CONFIG_STM32_GPIO_PORTS=9
# end of Resource Managers

#
# Advanced Features
#
CONFIG_STM32_USE_HAL_DRIVER=y
# CONFIG_STM32_USE_LL_DRIVER is not set
# CONFIG_STM32_ENABLE_RTOS_SUPPORT is not set
CONFIG_STM32_HAL_TIMEOUT_VALUE=1000
# CONFIG_EXPERT_MODE is not set
# end of Advanced Features
# end of Platform Configuration

#
# Hardware Abstraction Layer
#
CONFIG_HAL_ENABLE=y

#
# Debug Configuration
#
# CONFIG_HAL_DEBUG_ENABLE is not set
CONFIG_HAL_ASSERT_ENABLE=y
# end of Debug Configuration

#
# Statistics Configuration
#
CONFIG_HAL_STATISTICS_ENABLE=y
CONFIG_HAL_STATISTICS_BUFFER_SIZE=256
# end of Statistics Configuration

#
# Timeout Configuration
#
CONFIG_HAL_DEFAULT_TIMEOUT_MS=1000
CONFIG_HAL_INIT_TIMEOUT_MS=5000
# end of Timeout Configuration

#
# Memory Configuration
#
CONFIG_HAL_MEM_MODE_STATIC=y
# CONFIG_HAL_MEM_MODE_DYNAMIC is not set
CONFIG_HAL_MEM_POOL_SIZE=4096
# end of Memory Configuration

#
# Thread Safety
#
# end of Thread Safety
# end of Hardware Abstraction Layer

#
# Operating System Abstraction Layer
#
CONFIG_OSAL_BAREMETAL=y
# CONFIG_OSAL_FREERTOS is not set
# CONFIG_OSAL_RTTHREAD is not set
# CONFIG_OSAL_ZEPHYR is not set
# CONFIG_OSAL_LINUX is not set
# CONFIG_OSAL_NATIVE is not set
CONFIG_OSAL_BACKEND_NAME="baremetal"

#
# System Parameters
#
CONFIG_OSAL_TICK_RATE_HZ=1000
CONFIG_OSAL_HEAP_SIZE=16384
CONFIG_OSAL_MAIN_STACK_SIZE=4096
# end of System Parameters

#
# Linker Script Configuration
#
CONFIG_LINKER_RAM_START=0x20000000
CONFIG_LINKER_RAM_SIZE=0x00020000
CONFIG_LINKER_FLASH_START=0x08000000
CONFIG_LINKER_FLASH_SIZE=0x00100000
# end of Linker Script Configuration

#
# Bare-metal Configuration
#
CONFIG_BAREMETAL_SIMPLE_SCHEDULER=y
CONFIG_BAREMETAL_MAX_TASKS=8
# end of Bare-metal Configuration
# end of Operating System Abstraction Layer

#
# Framework Configuration
#
CONFIG_FRAMEWORK_LOG=y
CONFIG_FRAMEWORK_SHELL=y
CONFIG_FRAMEWORK_CONFIG=y
CONFIG_FRAMEWORK_INIT=y
# CONFIG_FRAMEWORK_EVENT is not set
# CONFIG_FRAMEWORK_STATE_MACHINE is not set
# CONFIG_FRAMEWORK_DEBUG is not set
# end of Framework Configuration

#
# Example Applications
#
CONFIG_BUILD_APP_BLINKY=y
CONFIG_BUILD_APP_SHELL_DEMO=y
CONFIG_BUILD_APP_CONFIG_DEMO=y
CONFIG_BUILD_APP_STM32_BLINKY=y
CONFIG_BUILD_APP_STM32_CONFIG_TEST=y

#
# Application Common Settings
#
CONFIG_APP_VERSION_MAJOR=1
CONFIG_APP_VERSION_MINOR=0
CONFIG_APP_VERSION_PATCH=0
CONFIG_APP_ENABLE_VERSION_INFO=y
CONFIG_APP_ENABLE_DEBUG_OUTPUT=y
CONFIG_APP_STACK_SIZE=0x1000
CONFIG_APP_HEAP_SIZE=0x2000
# end of Application Common Settings

#
# Post-Build Options
#
CONFIG_APP_GENERATE_BIN=y
CONFIG_APP_GENERATE_HEX=y
CONFIG_APP_GENERATE_MAP=y
CONFIG_APP_PRINT_SIZE=y
CONFIG_APP_PRINT_MEMORY_USAGE=y
# end of Post-Build Options
# end of Example Applications
