"""Retain exact authored bytes and explicitly relocate evidence-only targets."""
from pathlib import Path
import hashlib
import json

OUT = Path(__file__).resolve().parent
AUTHOR = Path('/dev/shm/nexus-h743-d3-catalogue-amendment-20261018-r1')
PREFIX = 'tests/evidence/io-evolution/h743-spi-dma-catalogue-correction-20261018-r1/'
OLD = 'docs/delivery/evidence/h743-spi-dma-canonical-sdk-catalogue-amendment-20261018-r1/'
SOURCE = {'tools/configure/assemblies/catalogue.json', 'tools/configure/test_matrix.py'}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


source_map = AUTHOR / 'normalized-transport-r1.json'
assert sha(source_map.read_bytes()) == '5f2277262d8fd8b720c335828fce055da83db60ccf52404bc75fb5a61aba5b9b'
original = json.loads(source_map.read_text())
rows = []
for entry in original['files']:
    row = dict(entry)
    raw = Path(row['durable_source']).read_bytes()
    assert len(raw) == row['bytes'] and sha(raw) == row['sha256']
    row['original_author_target'] = row['path']
    if row['path'] not in SOURCE:
        assert row['path'].startswith(OLD)
        row['path'] = PREFIX + 'author/' + row['path'][len(OLD):]
    rows.append(row)
extras = [
    ('root/original-author-transport.json', source_map),
    ('root/final-source-independent-review.json', Path('/dev/shm/nexus-h743-d3-catalogue-amendment-independent-review-20261018-r1.json')),
    ('root/failed-full-hook-and-parent-ci.zip', OUT / 'failed-full-hook-and-parent-ci.zip'),
    ('root/failed-full-hook-members.json', OUT / 'failed-full-hook-members.json'),
    ('root/completed-parent-ci-run.json', Path('/dev/shm/nexus-remote-ci-dd839d29-completed-20261018-r1/run-completed.json')),
    ('root/original-failure-audit.json', Path('/dev/shm/nexus-h743-d3-configure-failure-audit-20261018-r1/report.json')),
    ('root/helper-independent-review-original-blocked.json', Path('/dev/shm/nexus-d3-catalogue-amendment-helper-independent-review-20261018-r1.json')),
    ('root/helper-independent-review-r4-pass.json', Path('/dev/shm/nexus-d3-catalogue-amendment-helper-independent-review-20261018-r2.json')),
    ('root/root-normalizer.py.raw', Path(__file__).resolve()),
]
extras += [('root/append-reviewed-catalogue-r%d.py.raw' % i,
            OUT / ('append-reviewed-catalogue-r%d.py' % i)) for i in range(1, 5)]
for name, path in extras:
    assert path.is_file() and not any(p.is_symlink() for p in (path, *path.parents))
    raw = path.read_bytes()
    rows.append({'path': PREFIX + name, 'durable_source': str(path), 'bytes': len(raw),
                 'sha256': sha(raw), 'origin': 'Immutable original failure, review or root adaptation evidence'})
assert len(rows) == 28
assert len({row['path'] for row in rows}) == len(rows)
assert len({row['path'].casefold() for row in rows}) == len(rows)
assert {row['path'] for row in rows if not row['path'].startswith(PREFIX)} == SOURCE
result = {'kind': 'reviewed-catalogue-correction-on-exact-existing-D3-staged-inputs',
    'base_head': 'dd839d29f6ad43267fc8d77bdd0b8e5e03e4d211',
    'original_staged_tree': '486d32f18033cc1ef4c25cc2715636d36df6b91e',
    'source_count': 2, 'file_count': len(rows), 'files': rows,
    'original_author_map_sha256': sha(source_map.read_bytes()),
    'explicit_evidence_only_prefix_relocation': {'from': OLD, 'to': PREFIX + 'author/'},
    'scope': 'Two exact authored source additions to original unchanged 33; fresh whole ordinary hooks pending.'}
output = OUT / 'normalized-amendment.json'
with output.open('x') as stream:
    json.dump(result, stream, indent=2); stream.write('\n')
print(json.dumps({'path': str(output), 'sha256': sha(output.read_bytes()),
    'files': len(rows), 'source_count': 2, 'bytes': sum(row['bytes'] for row in rows)}), flush=True)
