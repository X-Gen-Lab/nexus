"""Root-only exact addition to an unchanged, failed-gate D3 staged tree."""
from pathlib import Path, PurePosixPath
import argparse
import gzip
import hashlib
import json
import os
import subprocess
import sys

ROOT = Path('/tmp/nexus-io-validation-20261018')
BASE_HEAD = 'dd839d29f6ad43267fc8d77bdd0b8e5e03e4d211'
BASE_TREE = '486d32f18033cc1ef4c25cc2715636d36df6b91e'
BASE_MANIFEST_SHA = 'b0bdaa42c2ef9200e11b8258192e6f5f27e7e55541a1891ab5f30f0b60161852'
BASE_MANIFEST = Path('/dev/shm/nexus-d3-main-integration-20261018-r1/complete-inputs.json')
SOURCE = {'tools/configure/assemblies/catalogue.json', 'tools/configure/test_matrix.py'}
PREFIX = 'tests/evidence/io-evolution/h743-spi-dma-catalogue-correction-20261018-r1/'
p = argparse.ArgumentParser()
p.add_argument('--manifest', type=Path, required=True)
p.add_argument('--manifest-sha', required=True)
p.add_argument('--review', type=Path, required=True)
p.add_argument('--review-sha', required=True)
p.add_argument('--output', type=Path, required=True)
a = p.parse_args()


def sha(data):
    return hashlib.sha256(data).hexdigest()


def git(*args):
    return subprocess.check_output(['git', '--no-optional-locks', '-c', 'gc.auto=0',
        '-c', 'maintenance.auto=false', '-C', str(ROOT), *args])


def names(raw):
    return set(raw.decode().split('\0')) - {''}


def verified(path, row):
    assert path.is_absolute() and path.is_file()
    assert not any(item.is_symlink() for item in (path, *path.parents))
    raw = path.read_bytes()
    assert len(raw) == row['bytes'] and sha(raw) == row['sha256'], path
    return raw


if sys.flags.optimize or os.environ.get('PYTHONOPTIMIZE'):
    raise RuntimeError('Optimized Python cannot execute assertion-based integration guards')
assert {key for key in os.environ if key.startswith('GIT_')} <= {'GIT_PAGER'}
assert a.output == Path('/dev/shm/nexus-d3-catalogue-amendment-integration-20261018-r1')
assert a.output.is_absolute() and a.output.resolve(strict=False) == a.output
assert not any(item.is_symlink() for item in a.output.parents)
assert not a.output.exists()
assert not a.output.is_relative_to(ROOT) and not ROOT.is_relative_to(a.output)
gitdir = Path(git('rev-parse', '--absolute-git-dir').decode().strip()).resolve()
assert not a.output.is_relative_to(gitdir) and not gitdir.is_relative_to(a.output)
assert sha(BASE_MANIFEST.read_bytes()) == BASE_MANIFEST_SHA
assert git('rev-parse', 'HEAD').decode().strip() == BASE_HEAD
assert git('write-tree').decode().strip() == BASE_TREE
assert not git('diff', '--name-only')
assert not git('ls-files', '--others', '--exclude-standard', '-z')
base = json.loads(BASE_MANIFEST.read_text())
assert base['source_count'] == 33 and base['file_count'] == 392
oldrows, deleted = base['files'], base['deleted_files']
assert names(git('diff', '--cached', '--no-renames', '--name-only', '-z')) == {
    row['path'] for row in oldrows + deleted}
for row in oldrows:
    assert git('show', ':' + row['path']) == verified(ROOT / row['path'], row)
for row in deleted:
    assert not (ROOT / row['path']).exists()
    assert not git('ls-files', '-z', '--', row['path'])
    raw = git('show', 'HEAD:' + row['path'])
    assert len(raw) == row['bytes'] and sha(raw) == row['sha256']
assert sha(a.manifest.read_bytes()) == a.manifest_sha
assert sha(a.review.read_bytes()) == a.review_sha
amendment = json.loads(a.manifest.read_text())
assert amendment['base_head'] == BASE_HEAD and amendment['source_count'] == 2
rows = [dict(row) for row in amendment['files']]
for path, name in ((a.manifest, PREFIX + 'normalized-amendment.json'),
                   (a.review, PREFIX + 'independent-review.json')):
    raw = path.read_bytes()
    rows.append({'path': name, 'durable_source': str(path), 'bytes': len(raw),
                 'sha256': sha(raw), 'origin': 'Exact reviewed amendment metadata'})
assert len({row['path'] for row in rows}) == len(rows)
assert len({row['path'].casefold() for row in rows}) == len(rows)
assert {row['path'] for row in rows if not row['path'].startswith(PREFIX)} == SOURCE
assert not ({row['path'] for row in rows} & {row['path'] for row in oldrows + deleted})
all_names = [row['path'] for row in oldrows + deleted + rows]
assert len(all_names) == len(set(all_names)) == len({name.casefold() for name in all_names})
for path in [a.manifest, a.review, *(Path(row['durable_source']) for row in rows)]:
    assert path.is_absolute() and path.resolve(strict=False) == path
    assert not path.is_relative_to(a.output) and not a.output.is_relative_to(path)
preimages = []
cached = {}
for row in rows:
    name = PurePosixPath(row['path'])
    assert not name.is_absolute() and '..' not in name.parts
    assert str(name) == row['path'] and '.git' not in name.parts
    assert row['path'] in SOURCE or row['path'].startswith(PREFIX)
    cached[row['path']] = verified(Path(row['durable_source']), row)
    target = ROOT / row['path']
    assert not any(item.is_symlink() for item in (target, *target.parents))
    if row['path'] in SOURCE:
        original = target.read_bytes()
        assert original == git('show', 'HEAD:' + row['path']) == git('show', ':' + row['path'])
        assert original != Path(row['durable_source']).read_bytes()
        preimages.append({'path': row['path'], 'bytes': len(original), 'sha256': sha(original)})
    else:
        assert not target.exists()
index = Path(git('rev-parse', '--git-path', 'index').decode().strip())
if not index.is_absolute():
    index = ROOT / index
index_raw = index.read_bytes()
a.output.mkdir(exist_ok=False)
backup = a.output / 'before-index.gz'
backup.write_bytes(gzip.compress(index_raw, mtime=0))
assert gzip.decompress(backup.read_bytes()) == index_raw
for row in preimages:
    target = a.output / 'before-main' / row['path']
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open('xb') as stream:
        stream.write(verified(ROOT / row['path'], row)); stream.flush(); os.fsync(stream.fileno())
(a.output / 'before-main.json').write_text(json.dumps({
    'head': BASE_HEAD, 'tree': BASE_TREE, 'index_sha256': sha(index_raw),
    'files': preimages}, indent=2) + '\n')
assert index.read_bytes() == index_raw
for row in rows:
    target = ROOT / row['path']
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open('xb' if not target.exists() else 'wb') as stream:
        stream.write(cached[row['path']]); stream.flush(); os.fsync(stream.fileno())
subprocess.run(['git', '-c', 'gc.auto=0', '-c', 'maintenance.auto=false', '-C',
    str(ROOT), 'add', '-f', '--', *(row['path'] for row in rows)], check=True)
allrows = oldrows + rows
assert names(git('diff', '--cached', '--no-renames', '--name-only', '-z')) == {
    row['path'] for row in allrows + deleted}
assert not git('diff', '--name-only') and not git('ls-files', '--others', '--exclude-standard', '-z')
for row in allrows:
    assert git('show', ':' + row['path']) == verified(ROOT / row['path'], row)
for row in deleted:
    assert not (ROOT / row['path']).exists() and not git('ls-files', '-z', '--', row['path'])
tree = git('write-tree').decode().strip()
complete = dict(base)
complete.update(files=allrows, file_count=len(allrows) + len(deleted),
    source_count=35, written_source_count=32,
    amendment_manifest_sha256=a.manifest_sha, amendment_review_sha256=a.review_sha,
    qualification='Fresh complete ordinary hooks pending; r1 failed and retained')
manifest_path = a.output / 'complete-inputs.json'
manifest_path.write_text(json.dumps(complete, indent=2) + '\n')
applied = {'kind': 'exact-all-staged-reviewed-catalogue-correction',
    'head': BASE_HEAD, 'tree': tree, 'source_files': 35,
    'staged_files': len(allrows) + len(deleted), 'deleted_files': len(deleted),
    'complete_manifest_sha256': sha(manifest_path.read_bytes()),
    'previous_all392_inputs_preserved': True, 'normal_gate': 'pending'}
(a.output / 'complete-main-applied.json').write_text(json.dumps(applied, indent=2) + '\n')
print(json.dumps(applied), flush=True)
