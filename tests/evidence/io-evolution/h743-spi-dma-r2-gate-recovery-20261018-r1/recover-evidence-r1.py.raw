"""Repair one evidence representation; retain every original staged source."""
from pathlib import Path
import gzip
import hashlib
import json
import os
import subprocess
import sys

ROOT = Path('/tmp/nexus-io-validation-20261018')
HERE = Path(__file__).resolve().parent
OUT = Path('/dev/shm/nexus-d3-r2-gate-recovery-integration-20261018-r1')
BASE = Path('/dev/shm/nexus-d3-catalogue-amendment-integration-20261018-r1/complete-inputs.json')
BASE_SHA = '5d9c63f8a29014b705f1c068630e96d49246d5354d4f0699f3307b374e9d6842'
BASE_TREE = 'be47b2e55a32ea43960daf71220320af7ddeba10'
HEAD = 'dd839d29f6ad43267fc8d77bdd0b8e5e03e4d211'
REPLACED = 'tests/evidence/io-evolution/h743-spi-dma-catalogue-correction-20261018-r1/root/completed-parent-ci-run.json'
PREFIX = 'tests/evidence/io-evolution/h743-spi-dma-r2-gate-recovery-20261018-r1/'


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def git(*args):
    return subprocess.check_output(['git', '--no-optional-locks', '-c', 'gc.auto=0',
        '-c', 'maintenance.auto=false', '-C', str(ROOT), *args])


def names(raw):
    return set(raw.decode().split('\0')) - {''}


def read(path, row):
    assert path.is_absolute() and path.is_file()
    assert not any(p.is_symlink() for p in (path, *path.parents))
    raw = path.read_bytes()
    assert len(raw) == row['bytes'] and sha(raw) == row['sha256']
    return raw


if sys.flags.optimize or os.environ.get('PYTHONOPTIMIZE'):
    raise RuntimeError('Optimized Python cannot execute assertion-based guards')
assert {key for key in os.environ if key.startswith('GIT_')} <= {'GIT_PAGER'}
assert not OUT.exists() and OUT.resolve() == OUT
assert not any(p.is_symlink() for p in OUT.parents)
assert HERE.resolve() == HERE and not HERE.is_relative_to(ROOT)
assert not OUT.is_relative_to(ROOT) and not ROOT.is_relative_to(OUT)
assert sha(BASE.read_bytes()) == BASE_SHA
base = json.loads(BASE.read_text())
assert base['file_count'] == 422 and base['source_count'] == 35
assert git('rev-parse', 'HEAD').decode().strip() == HEAD
assert git('write-tree').decode().strip() == BASE_TREE
assert not git('diff', '--name-only') and not git('ls-files', '--others', '--exclude-standard', '-z')
rows, deleted = base['files'], base['deleted_files']
assert names(git('diff', '--cached', '--no-renames', '--name-only', '-z')) == {r['path'] for r in rows + deleted}
for row in rows:
    assert git('show', ':' + row['path']) == read(ROOT / row['path'], row)
assert len(deleted) == 3
for row in deleted:
    assert not (ROOT / row['path']).exists() and not git('ls-files', '-z', '--', row['path'])
    raw = git('show', 'HEAD:' + row['path'])
    assert len(raw) == row['bytes'] and sha(raw) == row['sha256']
patch_map = HERE / 'reviewed-recovery-map.json'
review = HERE / 'independent-review.json'
assert len(sys.argv) == 3
assert sha(patch_map.read_bytes()) == sys.argv[1]
assert sha(review.read_bytes()) == sys.argv[2]
package = json.loads(patch_map.read_text())
assert package['base_manifest_sha256'] == BASE_SHA
assert package['source_files_changed'] == 0
patches = [dict(row) for row in package['files']]
assert {row['path'] for row in patches if not row['path'].startswith(PREFIX)} == {REPLACED}
for file, name in ((patch_map, 'reviewed-recovery-map.json'), (review, 'independent-review.json')):
    raw = file.read_bytes()
    patches.append({'path': PREFIX + name, 'durable_source': str(file),
                    'bytes': len(raw), 'sha256': sha(raw)})
cached = {}
old_names = {row['path'] for row in rows}
for row in patches:
    assert row['path'] == REPLACED or row['path'].startswith(PREFIX)
    assert '..' not in Path(row['path']).parts and not Path(row['path']).is_absolute()
    cached[row['path']] = read(Path(row['durable_source']), row)
    target = ROOT / row['path']
    assert not any(p.is_symlink() for p in (target, *target.parents))
    assert row['path'] == REPLACED or (row['path'] not in old_names and not target.exists())
assert len(cached) == len(patches)
replacement = cached[REPLACED]
original = (ROOT / REPLACED).read_bytes()
assert replacement.endswith(b'\n') and json.loads(replacement) == json.loads(original)
assert cached[PREFIX + 'original-parent-ci-run.json.raw'] == original
final_rows = [row for row in rows if row['path'] != REPLACED] + patches
final_names = [row['path'] for row in final_rows + deleted]
assert len(final_names) == len(set(final_names)) == len({name.casefold() for name in final_names})
index = Path(git('rev-parse', '--git-path', 'index').decode().strip())
if not index.is_absolute():
    index = ROOT / index
index_raw = index.read_bytes()
OUT.mkdir()
backup = OUT / 'before-index.gz'
backup.write_bytes(gzip.compress(index_raw, mtime=0))
assert gzip.decompress(backup.read_bytes()) == index_raw
(OUT / 'before-parent-ci-run.json.raw').write_bytes(original)
assert (OUT / 'before-parent-ci-run.json.raw').read_bytes() == original
assert index.read_bytes() == index_raw
for row in patches:
    target = ROOT / row['path']
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open('wb' if row['path'] == REPLACED else 'xb') as stream:
        stream.write(cached[row['path']]); stream.flush(); os.fsync(stream.fileno())
subprocess.run(['git', '-c', 'gc.auto=0', '-c', 'maintenance.auto=false', '-C',
    str(ROOT), 'add', '-f', '--', *(row['path'] for row in patches)], check=True)
assert names(git('diff', '--cached', '--no-renames', '--name-only', '-z')) == set(final_names)
assert not git('diff', '--name-only') and not git('ls-files', '--others', '--exclude-standard', '-z')
for row in final_rows:
    assert git('show', ':' + row['path']) == read(ROOT / row['path'], row)
for row in deleted:
    assert not (ROOT / row['path']).exists() and not git('ls-files', '-z', '--', row['path'])
tree = git('write-tree').decode().strip()
complete = dict(base)
complete.update(files=final_rows, file_count=len(final_rows) + len(deleted),
    recovery_map_sha256=sha(patch_map.read_bytes()), recovery_review_sha256=sha(review.read_bytes()),
    qualification='Fresh complete ordinary hooks pending; both failed rounds retained')
p = OUT / 'complete-inputs.json'
p.write_text(json.dumps(complete, indent=2) + '\n')
result = {'head': HEAD, 'tree': tree, 'source_files': 35,
    'staged_files': complete['file_count'], 'deleted_files': 3,
    'complete_manifest_sha256': sha(p.read_bytes()),
    'all_canonical35_bytes_unchanged': True, 'full_normal_gate': 'pending'}
(OUT / 'complete-main-applied.json').write_text(json.dumps(result, indent=2) + '\n')
print(json.dumps(result), flush=True)
