"""Root-only frozen UART transport; canonical10 and all three evidence parts."""
from pathlib import Path,PurePosixPath
import hashlib,json,zipfile
out=Path(__file__).resolve().parent;b=Path('/dev/shm/nexus-h743-uart-runtime-feature-20261018-r1');freeze=b/'lifecycle-r2/source-freeze-final.json'
def sha(p):
 with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
assert sha(freeze)=='d2565120f5cb2d470f1fccfff5cefb46c66f81dd43f64ba0ffc9278bbf1ebe4e'
f=json.loads(freeze.read_text());assert len(f['source10'])==10;rows=[]
for r in f['source10']:
 p=Path(r['snapshot']);assert p.is_file() and p.stat().st_size==r['bytes'] and sha(p)==r['sha256']
 rows.append({'path':r['path'],'durable_source':str(p),'bytes':r['bytes'],'sha256':r['sha256'],'origin':'Exact final source10/d256 runtime-domain/initialization/stop ownership contract; all existing ordinary IRQ/state preserved as reviewed.'})
prefix='tests/evidence/io-evolution/h743-uart-runtime-domain-20261018-r1'
inputs=[(freeze,'final-source10-freeze.json'),(b/'completed-handoff-r1.json','original-r1-handoff.json'),(b/'final-delivery-r1.json','original-r1-summary.json'),(b/'final-leaf-inventory-r1.json','original-r1-inventory.json'),(b/'delivery-evidence-r1.zip','original-r1-evidence.zip'),(b/'lifecycle-r2/completed-handoff-r2.json','original-r2-handoff.json'),(b/'lifecycle-r2/final-delivery-r2.json','original-r2-summary.json'),(b/'lifecycle-r2/delivery-delta-r2.zip','original-r2-evidence.zip')]
supp=b/'lifecycle-r2/runtime-receipts-supplement-r1'
inputs += [(supp/'completed-bridge.json','runtime-completion-bridge.json'),(supp/'manifest.json','runtime-completion-manifest.json'),(supp/'original-runtime-receipts.zip','runtime-completion-evidence.zip'),(Path('/dev/shm/nexus-h743-uart-runtime-independent-review-20261018-r1/final-source-and-evidence-review-r2.json'),'original-independent-final-review.json'),(Path('/dev/shm/nexus-h743-uart-runtime-independent-review-20261018-r1/early-candidate-review-r1.json'),'original-independent-early-withheld-review.json'),(out/'normalize.py','root-normalizer.py.raw')]
for p,name in inputs:
 assert p.is_file() and not any(q.is_symlink() for q in (p,*p.parents))
 if p.suffix=='.zip':
  with zipfile.ZipFile(p) as z:assert z.testzip() is None
 rows.append({'path':prefix+'/'+name,'durable_source':str(p),'bytes':p.stat().st_size,'sha256':sha(p),'origin':'Original completed r1/r2/supplement bytes and independent review. Consume all3 archives together; r1 source71e25e/408 does not qualify final d256/420.'})
names=[r['path'] for r in rows];assert len(names)==len(set(n.casefold() for n in names))
for n in names:
 p=PurePosixPath(n);assert not p.is_absolute() and '..' not in p.parts and '.git' not in p.parts and str(p)==n
assert sum(not r['path'].startswith('tests/evidence/') for r in rows)==10
j={'kind':'complete-root-normalized-UART10-delivery','source_count':10,'files':rows,'file_count':len(rows),'final_source_freeze_sha256':sha(freeze),'required_three_evidence_parts':['original-r1-evidence.zip','original-r2-evidence.zip','runtime-completion-evidence.zip'],'final_independent_review_sha256':'8b840adc5cd1dbb84512d6c0871f9b4dc6fba3cac9b295fabf731c4a01d90e71','scope':'Final developer9whole420(276Debug/144ASAN), real stop/init RED6 closure and firstGREEN nonreturn-oracle strengthening, all original receipts preserved via3combined archives. Fresh full Main gates/ARM/SDK remain pending. No completeIO27/physicalHIL/candidate claim.'}
p=out/'normalized-inputs.json';p.write_text(json.dumps(j,indent=2)+'\n');print(json.dumps({'path':str(p),'sha256':sha(p),'files':len(rows),'source_count':10,'bytes':sum(r['bytes'] for r in rows)}))
