def diffs(a,z,path=''):
 if type(a)!=type(z):return [path]
 if isinstance(a,dict):return sum((diffs(a.get(k),z.get(k),path+'.'+k) for k in sorted(a.keys()|z.keys())),[])
 if isinstance(a,list):
  if len(a)!=len(z):return [path+'.length']
  return sum((diffs(x,y,path+'['+str(i)+']') for i,(x,y) in enumerate(zip(a,z))),[])
 return [] if a==z else [path]
