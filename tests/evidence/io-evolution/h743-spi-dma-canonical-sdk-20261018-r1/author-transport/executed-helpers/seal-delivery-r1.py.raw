b=Path('/dev/shm/nexus-h743-spi-dma-d3-20261018-r1');docs=Path('/dev/shm/nexus-h743-spi-dma-d3-docs-20261018-r1');work=Path('/dev/shm/nexus-h743-spi-dma-d3-work-20261018-r1')
def sha(p):
 with Path(p).open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def allocated():return sum(p.lstat().st_blocks*512 for prefix in (b,docs) for p in prefix.rglob('*'))
