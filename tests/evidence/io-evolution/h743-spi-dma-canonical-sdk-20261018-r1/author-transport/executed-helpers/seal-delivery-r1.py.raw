def append(target,p,role):
 q=PurePosixPath(target);assert q.as_posix()==target and not q.is_absolute() and '..' not in q.parts and target not in targets,target
 p=Path(p);assert p.is_file() and not p.is_symlink(),str(p);s=p.stat();files.append({'target':target,'durable_source':str(p),'bytes':s.st_size,'sha256':sha(p),'mode':stat.S_IMODE(s.st_mode),'role':role});targets.add(target)
