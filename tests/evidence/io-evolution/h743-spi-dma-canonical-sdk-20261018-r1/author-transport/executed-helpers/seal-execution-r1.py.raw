from pathlib import Path,PurePosixPath
import hashlib,io,json,os,stat,zipfile
feature=Path('/dev/shm/nexus-h743-spi-dma-d3-20261018-r1');docs=Path('/dev/shm/nexus-h743-spi-dma-d3-docs-20261018-r1');native=Path('/dev/shm/nexus-h743-spi-dma-d3-native-20261018-r1');arm=Path('/dev/shm/nexus-h743-spi-dma-d3-arm-20261018-r3');work=Path('/dev/shm/nexus-h743-spi-dma-d3-work-20261018-r1')
def allocated():return sum(p.lstat().st_blocks*512 for prefix in (feature,docs) for p in prefix.rglob('*'))
def sha(p):
 with Path(p).open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
entries={}
def add(name,path):
 parsed=PurePosixPath(name);assert not parsed.is_absolute() and '..' not in parsed.parts and parsed.as_posix()==name and name not in entries,name
 path=Path(path);assert path.is_file() and not path.is_symlink(),str(path);entries[name]=path
for p in native.rglob('*'):
 if not p.is_file():continue
 rel=p.relative_to(native);parts=rel.parts
 if parts[0] in ('native-debug','native-asan'):
  if rel.name in ('compile_commands.json','CMakeCache.txt','build.ninja','.ninja_log','.ninja_deps') and len(parts)==2:add('native/'+rel.as_posix(),p)
  elif len(parts)>3 and parts[1:3]==('tests','google') and parts[3] in ('h743-spi-dma-factory','h743-spi-dma-uart-tx-factory','h743-spi-dma-uart-rx-factory'):add('native/'+rel.as_posix(),p)
 elif parts[0]!='tmp':add('native/'+rel.as_posix(),p)
report=json.loads((arm/'matrix/report.json').read_text())
for p in arm.rglob('*'):
 if not p.is_file():continue
 rel=p.relative_to(arm)
 if rel.parts[0]!='matrix' and rel.parts[0]!='tmp':add('arm-r3/'+rel.as_posix(),p)
 elif len(rel.parts)>=2 and rel.parts[1]=='commands':add('arm-r3/'+rel.as_posix(),p)
add('arm-r3/matrix/report.json',arm/'matrix/report.json')
for row in report['fixtures']:
 for item in row['artifacts'].values():
  p=Path(item['path']);name='arm-r3/'+p.relative_to(arm).as_posix()
  if name not in entries:add(name,p)
 build=Path(row['artifacts']['compile_commands']['path']).parent
 for name in ('CMakeCache.txt','build.ninja','.ninja_log','.ninja_deps'):
  p=build/name
  if p.exists():add('arm-r3/'+p.relative_to(arm).as_posix(),p)
 generated=Path(row['artifacts']['resolved']['path']).parent
 for p in generated.rglob('*'):
  name='arm-r3/'+p.relative_to(arm).as_posix()
  if p.is_file() and name not in entries:add(name,p)
for label in ('r1','r2'):
 prefix=Path('/dev/shm/nexus-h743-spi-dma-d3-arm-20261018-'+label)
 for p in prefix.rglob('*'):
  if p.is_file() and 'tmp' not in p.relative_to(prefix).parts:add('arm-'+label+'-failed/'+p.relative_to(prefix).as_posix(),p)
for name in ('run_whole.py','execute.py','execute-source-bound-r1.py','execute-source-bound-r2.py','execute-source-bound-r3.py','run-final-python-modules-r1.py','run-native-r1.py','run-arm-r1.py','run-arm-r2.py','run-arm-r3.py','development-style-fresh-r1.py','text-content30.py'):
 add('executed-helpers/'+name,work/name)
reg=Path('/dev/shm/nexus-h743-d3-submodule-registration-20261018-r3/result.json');add('external-registration/result.json',reg)
rows=[];maximum=min(1400*1024,8388608-allocated()-200*1024)
assert maximum>0,allocated()
class Limited(io.BytesIO):
 def write(self,data):
  if self.tell()+len(data)>maximum:raise RuntimeError('sealed execution ZIP forecast exceeds remaining aggregate budget')
  return super().write(data)
output=Limited()
with zipfile.ZipFile(output,'w',compression=zipfile.ZIP_DEFLATED,compresslevel=9) as archive:
 for name,p in sorted(entries.items()):
  s=p.stat();data=p.read_bytes();identity=hashlib.sha256(data).hexdigest();z=zipfile.ZipInfo.from_file(p,name);z.compress_type=zipfile.ZIP_DEFLATED;z.create_system=3;z.external_attr=(stat.S_IFREG|stat.S_IMODE(s.st_mode))<<16
  archive.writestr(z,data,compress_type=zipfile.ZIP_DEFLATED,compresslevel=9)
  assert p.stat().st_size==len(data) and sha(p)==identity
  rows.append({'name':name,'source':str(p),'bytes':len(data),'sha256':identity,'mode':stat.S_IMODE(s.st_mode),'mtime_ns':s.st_mtime_ns})
blob=output.getvalue()
with zipfile.ZipFile(io.BytesIO(blob)) as archive:
 assert archive.testzip() is None and len(archive.infolist())==len(rows)
 for row in rows:
  i=archive.getinfo(row['name']);data=archive.read(i);assert i.file_size==row['bytes'] and hashlib.sha256(data).hexdigest()==row['sha256'] and stat.S_IMODE(i.external_attr>>16)==row['mode']
p=feature/'execution-evidence-final-r1.zip';assert not p.exists();p.write_bytes(blob)
manifest={'archive':{'path':str(p),'bytes':len(blob),'sha256':sha(p)},'members':rows,'members_count':len(rows),'all_member_crc_sha_size_mode_verified':True,'preservation':'Original raw/execution domains remain at original paths; Native8 ELF bytes retained in original192MiB domain, identities in native/execution.json, not duplicated into this small ZIP. ARM3 ELF/BIN/map bytes included.','qualification':False}
p=feature/'execution-evidence-final-r1-map.json';p.write_text(json.dumps(manifest,indent=2)+'\n');print('EXECUTION_ZIP',len(blob),'MEMBERS',len(rows),'MAP',p.stat().st_size,'AGGREGATE_ALLOCATED',allocated());assert allocated()<8388608
