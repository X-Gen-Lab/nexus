  "closed_findings": [
    {
      "actual_old_behavior": "Complete58 old-body RED: destination4097>declared1, growing-reader destination131072>declared1, and empty-declared destination3>0.",
      "defect": "shutil.copyfileobj copied until arbitrary EOF before declared size/hash rejection, allowing oversized/growing input to exceed retained-data budget.",
      "fix": "_copy_retained reads/writes at most validated row[size], then one-byte EOF observation; streams prefix hash; mode applies only on success. No target overwrite because xb retained.",
      "id": "bounded_retained_copy",
      "r1_anchor": "tools/evidence/u575_pair.py:667-676",
      "tests": "Oversized, growth, size0, exact-copy+mode and wrong-prefix digest. Path.open is the external input port in growth test, not a mocked decision or algorithm."
    },
    {
      "actual_old_behavior": "Coherently reanchored tiny metadata fixture removes only exact NS import LOAD; old build_pair admitted it, actual assertion RED.",
      "defect": "Selected Secure import object was not required among NonSecure map LOAD inputs. ELF/import values alone did not establish this exact retained link-role relation.",
      "fix": "Normalize the selected secure_import identity and require it in links[nonsecure]; old history conflict check remains intact.",
      "id": "exact_nonsecure_import_link_binding",
      "r1_anchor": "build_pair map_inputs/include loop"
    },
    {
      "actual_old_behavior": "Real temporary ordinary sibling and source directories; old extracted decision did not raise; actual assertion RED.",
      "defect": "ordinary sibling/../source/new-output bypassed the original source-tree prefix test.",
      "fix": "Preserve no-symlink and preexisting-output checks, canonicalize output and source root, recheck output existence, then perform overlap checks before directory creation.",
      "id": "output_original_source_alias",
      "r1_anchor": "seal Path.absolute lexical source-root overlap test"
    }
  ],
