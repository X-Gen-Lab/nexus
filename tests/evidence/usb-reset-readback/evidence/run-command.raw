from pathlib import Path
import hashlib, json, os, resource, subprocess, sys, time
root=Path("/tmp/nexus-h743-fixed-hsi-s0-20261018")
out=Path(__file__).resolve().parent
stage=sys.argv[1]
command=sys.argv[2:]
destination=out/stage
destination.mkdir(exist_ok=False)
source=["io/src/usb_device_controller.c","io/native/usb_device.h","io/native/usb_device.c","tests/google/usb_device_test.cpp"]
def hashes():
 return {p:hashlib.sha256((root/p).read_bytes()).hexdigest() for p in source}
env=dict(os.environ)
env["PATH"]="/tmp/nexus-io-validation-20261018/.venv/bin:"+env.get("PATH","")
for name in ("GTEST_FILTER","GTEST_TOTAL_SHARDS","GTEST_SHARD_INDEX","GTEST_OUTPUT","GTEST_REPEAT","GTEST_ALSO_RUN_DISABLED_TESTS"):
 env.pop(name,None)
env.update(NEXUS_BUILD_JOBS="1",CMAKE_BUILD_PARALLEL_LEVEL="1",PYTHONDONTWRITEBYTECODE="1",GIT_OPTIONAL_LOCKS="0")
before=hashes()
start=time.time_ns()
result=subprocess.run(command,cwd=root,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
end=time.time_ns()
(destination/"stdout.txt").write_bytes(result.stdout)
(destination/"stderr.txt").write_bytes(result.stderr)
record={"kind":"focused development; whole selected program where named", "qualification":False,"command":command,"cwd":str(root),"started_ns":start,"ended_ns":end,"exit_code":result.returncode,"source_before":before,"source_after":hashes(),"maxrss_kib":resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,"jobs":1,"environment_selection_cleared":True,"stdout_sha256":hashlib.sha256(result.stdout).hexdigest(),"stderr_sha256":hashlib.sha256(result.stderr).hexdigest()}
if Path(command[0]).is_file():
 record["program_sha256"]=hashlib.sha256(Path(command[0]).read_bytes()).hexdigest()
(destination/"command.json").write_text(json.dumps(record,indent=2)+"\n")
print(json.dumps({"stage":stage,"exit_code":result.returncode,"stdout_bytes":len(result.stdout),"stderr_bytes":len(result.stderr)}),flush=True)
print(result.stdout.decode(errors="replace")[-7000:],end="")
print(result.stderr.decode(errors="replace")[-4000:],end="",file=sys.stderr)
sys.exit(result.returncode)
