"""Prepare the smallest production changes after the complete alias RED."""
import hashlib
import json
from pathlib import Path
import subprocess
import xml.etree.ElementTree as ET
import run_step as h

D = Path(__file__).resolve().parent
red = {}
for family, expected in [('stm', 12), ('gd', 11)]:
    stage = 'red-' + family + '-runtime'
    root = ET.parse(h.TEMP / stage / 'whole.xml').getroot()
    assert int(root.attrib['tests']) == expected
    assert int(root.attrib['failures']) == 5
    assert int(root.attrib['disabled']) == int(root.attrib['errors']) == 0
    red[family] = {'tests': expected, 'failures': 5,
                   'failed_cases': [t.attrib['name'] for t in root.iter('testcase')
                                    if t.find('failure') is not None]}
    result = json.loads((h.TEMP / stage / 'result.json').read_text())
    assert result['exit_code'] == 1
    for p in ('soc/stm32f407/drivers/gpio.c', 'soc/gd32f470/drivers/gpio.c'):
        assert result['before']['source']['sources'][p] == h.identity(D / 'before' / p)
(D / 'actual-red-before-implementation.json').write_text(json.dumps(red, indent=2) + '\n')
h.resources()
h.guard()
paths = ['soc/stm32f407/drivers/gpio.c', 'soc/gd32f470/drivers/gpio.c']
for path in paths:
    before = (D / 'before' / path).read_text()
    stm = 'stm32f407' in path
    condition = ('port == NULL || !port->initialized || value == NULL' if stm
                 else '!port || !value || !port->mask')
    checked = (condition + ' ||\n        port->registers == NULL' if stm
               else condition + ' || port->registers == 0U')
    assert before.count('if (' + condition + ') {') == 1
    changed = before.replace('if (' + condition + ') {', 'if (' + checked + ') {')
    marker = '    *value = ' + ('LL_GPIO_ReadInputPort' if stm else 'GPIO_ISTAT')
    extent = 'sizeof(*port->registers)' if stm else '0x30U'
    note = ('The complete SDK register struct is owned by this binding.' if stm
            else 'The SDK bank includes BC at 0x28 and TG at 0x2c.')
    guard = f'''    /* {note}
     * Reject output aliases before any input observation or output store. */
    const uintptr_t output = (uintptr_t)value;
    const uintptr_t state = (uintptr_t)port;
    const uintptr_t bank = (uintptr_t)port->registers;
    if (output % _Alignof(uint32_t) != 0U ||
        output > UINTPTR_MAX - sizeof(*value) ||
        state > UINTPTR_MAX - sizeof(*port) ||
        bank > UINTPTR_MAX - {extent} ||
        (output < state + sizeof(*port) && state < output + sizeof(*value)) ||
        (output < bank + {extent} && bank < output + sizeof(*value))) {{
        return NX_ERROR_INVALID;
    }}
'''
    assert changed.count(marker) == 1
    changed = changed.replace(marker, guard + marker)
    data = subprocess.check_output([h.ROOT / '.venv/bin/clang-format',
                                    '--assume-filename=' + str(h.ROOT / path)],
                                   input=changed.encode())
    dest = D / 'production' / path
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(data)
manifest = {p: h.identity(D / 'production' / p) for p in paths}
(D / 'production-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
for p in paths:
    assert h.identity(h.ROOT / p) == h.identity(D / 'before' / p)
    (h.ROOT / p).write_bytes((D / 'production' / p).read_bytes())
print(json.dumps(manifest, indent=2))
