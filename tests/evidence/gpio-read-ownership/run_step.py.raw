"""Bounded whole-program executions with original-byte durable checkpoints."""
import hashlib
import json
import os
from pathlib import Path
import resource
import subprocess
import sys
import time
import zipfile

ROOT = Path('/tmp/nexus-io36-native-20261018')
DEST = Path(__file__).resolve().parent
TEMP = Path('/tmp/nexus-gpio-read-runs-20261018')
sys.path.insert(0, str(ROOT))
from tools.dev import process


def identity(path):
    data = path.read_bytes()
    return {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}


def resources():
    stats = os.statvfs('/tmp')
    free = stats.f_bavail * stats.f_frsize
    current = int(Path('/sys/fs/cgroup/memory.current').read_text())
    limit = int(Path('/sys/fs/cgroup/memory.max').read_text())
    events = Path('/sys/fs/cgroup/memory.events').read_text()
    assert free >= 200 * 1024**2, ('tmp free', free)
    assert limit - current >= 600 * 1024**2, ('cgroup headroom', limit-current)
    assert all(int(row.split()[1]) == 0 for row in events.splitlines()
               if row.split()[0].startswith('oom')), events
    return {'tmp_free': free, 'memory_current': current,
            'memory_max': limit, 'events': events}


def guard():
    before = json.loads((DEST / 'baseline.json').read_text())
    git = subprocess.check_output(['git', 'rev-parse', '--git-path', 'index'],
                                  cwd=ROOT, text=True).strip()
    index = Path(git)
    if not index.is_absolute():
        index = ROOT / index
    assert identity(index) == before['index']
    for path, expected in before['protected'].items():
        assert identity(ROOT / path) == expected, path
    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'],
                                   cwd=ROOT, text=True).strip()
    assert head == before['head']
    changed = subprocess.check_output(['git', '--no-optional-locks', 'diff',
                                      '--name-only'], cwd=ROOT, text=True).splitlines()
    assert set(changed).issubset(before['sources']), changed
    return {'head': head, 'index': identity(index), 'changed': changed,
            'sources': {p: identity(ROOT / p) for p in before['sources']}}


if __name__ == '__main__':
    label, *command = sys.argv[1:]
    assert label and command
    work = TEMP / label
    work.mkdir(parents=True, exist_ok=False)
    before = {'source': guard(), 'resources': resources(), 'time_ns': time.time_ns()}
    env = process.execution_environment(os.environ)
    env.update({'PYTHONDONTWRITEBYTECODE': '1', 'GIT_OPTIONAL_LOCKS': '0',
                'NEXUS_BUILD_JOBS': '1', 'CMAKE_BUILD_PARALLEL_LEVEL': '1',
                'PATH': str(ROOT / '.venv/bin') + ':' + env.get('PATH', '')})
    assert not any(key in env for key in ('GTEST_FILTER', 'GTEST_TOTAL_SHARDS',
                                        'GTEST_SHARD_INDEX'))
    result = process.run(command, cwd=ROOT, env=env, log=work / 'command.raw',
                         timeout=1200, stage='gpio-read-' + label)
    after = {'source': guard(), 'resources': resources(), 'time_ns': time.time_ns()}
    assert before['source'] == after['source'], 'source changed during execution'
    record = {'label': label, 'command': command, 'exit_code': result.returncode,
              'before': before, 'after': after,
              'child_maxrss_kib': resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,
              'receipt_path': str(result.receipt_path),
              'classification': 'actual execution; inspect raw and fresh XML'}
    (work / 'result.json').write_text(json.dumps(record, indent=2) + '\n')
    output = DEST / (label + '.zip')
    assert not output.exists()
    files = sorted(p for p in work.rglob('*') if p.is_file())
    with zipfile.ZipFile(output, 'x', compression=zipfile.ZIP_DEFLATED,
                         compresslevel=9) as archive:
        for path in files:
            archive.write(path, path.relative_to(work).as_posix())
    with zipfile.ZipFile(output) as archive:
        assert archive.testzip() is None
        for path in files:
            assert archive.read(path.relative_to(work).as_posix()) == path.read_bytes()
    manifest = {'archive': identity(output), 'members': {
        p.relative_to(work).as_posix(): identity(p) for p in files}}
    (DEST / (label + '-archive.json')).write_text(json.dumps(manifest, indent=2) + '\n')
    print(json.dumps({'label': label, 'exit_code': result.returncode,
                      'child_maxrss_kib': record['child_maxrss_kib'],
                      'resources': after['resources'], 'archive': manifest['archive']}))
    print(result.stdout[-6500:])
    print(result.stderr[-2000:])
    sys.exit(result.returncode)
