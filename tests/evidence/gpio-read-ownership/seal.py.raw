"""Freeze the four-file slice and immutable original-byte transport map."""
import hashlib
import json
import os
from pathlib import Path
import re
import struct
import subprocess
import xml.etree.ElementTree as ET
import zipfile
import run_step as h

D = Path(__file__).resolve().parent
baseline = json.loads((D / 'baseline.json').read_text())
h.resources()
final_guard = h.guard()
assert set(final_guard['changed']) == set(baseline['sources'])
status = subprocess.check_output(['git', '--no-optional-locks', 'status', '--porcelain'],
                                 cwd=h.ROOT, text=True)
assert all(line.startswith(' M ') for line in status.splitlines())


def test_bodies(text):
    cases = {}
    for match in re.finditer(r'TEST_F\(\s*(\w+)\s*,\s*(\w+)\s*\)\s*\{', text):
        cursor, depth = match.end(), 1
        while depth:
            depth += (text[cursor] == '{') - (text[cursor] == '}')
            cursor += 1
        cases['.'.join(match.group(1, 2))] = text[match.start():cursor]
    return cases


preservation = {}
for path in baseline['sources']:
    if path.endswith('.cpp'):
        old = test_bodies((D / 'before' / path).read_text())
        current = test_bodies((h.ROOT / path).read_text())
        assert all(current[name] == body for name, body in old.items())
        preservation[path] = {'old_cases': len(old), 'added_cases': len(current)-len(old),
                              'old_bodies_byte_identical': True,
                              'old_body_sha256': {k: hashlib.sha256(v.encode()).hexdigest()
                                                  for k, v in old.items()}}
assert [p['added_cases'] for p in preservation.values()] == [6, 6]
(D / 'old-case-preservation-corrected-r2.json').write_text(json.dumps({
    'correction': 'The first inventory regex did not count wrapped new TEST_F declarations. '
                  'Its old-body equality result was correct; additions are six per program, '
                  'verified by multiline declarations and actual Google discovery/XML.',
    'files': preservation}, indent=2) + '\n')

executions = {}
for phase in ('red', 'green'):
    for family, target, expected in [('stm', 'nexus_stm32_official_test', 12),
                                     ('gd', 'nexus_gd32_multi_test', 11)]:
        label = phase + '-' + family + '-runtime'
        work = h.TEMP / label
        result = json.loads((work / 'result.json').read_text())
        receipt = json.loads(Path(result['receipt_path']).read_text())
        xml = work / 'whole.xml'
        parsed = ET.parse(xml).getroot()
        cases = list(parsed.iter('testcase'))
        names = [case.attrib['classname'] + '.' + case.attrib['name'] for case in cases]
        assert len(names) == len(set(names)) == expected
        assert int(parsed.attrib['disabled']) == int(parsed.attrib['errors']) == 0
        assert not any(case.find('skipped') is not None or case.attrib.get('status') != 'run'
                       for case in cases)
        failures = [case.attrib['name'] for case in cases if case.find('failure') is not None]
        assert len(failures) == (5 if phase == 'red' else 0)
        assert result['exit_code'] == receipt['exit_code'] == (1 if phase == 'red' else 0)
        assert receipt['withdrawal_complete'] and receipt['withdrawal_stable']
        assert xml.stat().st_mtime_ns >= receipt['started_ns']
        discovery = h.TEMP / ('red-' + family + '-discovery') / 'command.raw'
        discovered, suite = [], ''
        for line in discovery.read_text().splitlines():
            if line.endswith('.') and not line.startswith(' '):
                suite = line.strip()
            elif line.startswith('  '):
                discovered.append(suite + line.strip())
        assert names == discovered
        if phase == 'red':
            assert all(result['before']['source']['sources'][p] == identity
                       for p, identity in baseline['sources'].items() if p.endswith('.c'))
        else:
            assert result['before']['source'] == final_guard
        executions[label] = {'target': target, 'count': expected, 'failures': len(failures),
                             'errors': 0, 'skipped': 0, 'disabled': 0,
                             'exit_code': result['exit_code'], 'cases': names,
                             'failed_cases': failures, 'xml': h.identity(xml),
                             'receipt': h.identity(Path(result['receipt_path'])),
                             'archive': h.identity(D / (label + '.zip')),
                             'fresh_xml_matches_complete_discovery': True}

archives = {}
for archive_path in sorted(D.glob('*.zip')):
    manifest = json.loads(archive_path.with_name(archive_path.stem + '-archive.json').read_text())
    assert h.identity(archive_path) == manifest['archive']
    with zipfile.ZipFile(archive_path) as archive:
        assert archive.testzip() is None
        assert set(archive.namelist()) == set(manifest['members'])
        for name, identity in manifest['members'].items():
            data = archive.read(name)
            assert len(data) == identity['bytes']
            assert hashlib.sha256(data).hexdigest() == identity['sha256']
    archives[archive_path.name] = manifest['archive']

commands = h.ROOT / 'build/native-debug/compile_commands.json'
rows = [row for row in json.loads(commands.read_text())
        if any('/' + target + '.dir/' in row['command'] for target in
               ('nexus_stm32_official_test', 'nexus_gd32_multi_test'))]
assert len(rows) == 9
contracts = h.ROOT / 'build/native-debug/google-contracts.json'
registration = json.loads(contracts.read_text())['executables']
binaries = {}
for target in ('nexus_stm32_official_test', 'nexus_gd32_multi_test'):
    path = h.ROOT / 'build/native-debug/bin' / target
    assert str(path) in registration
    header = path.read_bytes()[:20]
    assert header[:4] == b'\x7fELF' and header[4] == 2
    assert struct.unpack_from('<H', header, 18)[0] == 62
    binaries[target] = {'path': str(path), **h.identity(path),
                        'format': 'actual host ELF64 x86-64; remains TMP; not ARM proof'}
inputs = {row['file']: h.identity(Path(row['file'])) for row in rows}
for relative in ['tests/google/stm32_official_model.h', 'tests/contracts/gd32_model/model.c',
                 'tests/contracts/gd32_model/gd32f470_cpu.h']:
    path = h.ROOT / relative
    if path.exists():
        inputs[str(path)] = h.identity(path)
(D / 'actual-native-inputs.json').write_text(json.dumps({
    'compile_database': h.identity(commands), 'actual_compile_rows': rows,
    'translation_unit_inputs': inputs, 'registration': h.identity(contracts),
    'executables': binaries}, indent=2) + '\n')

diff = subprocess.check_output(['git', '--no-optional-locks', 'diff', '--',
                                *baseline['sources']], cwd=h.ROOT)
(D / 'four-source-diff.raw').write_bytes(diff)
resources = h.resources()
files = {p.relative_to(D).as_posix(): h.identity(p) for p in sorted(D.rglob('*')) if p.is_file()}
allocated = sum(p.stat().st_blocks * 512 for p in D.rglob('*')) + D.stat().st_blocks * 512
assert allocated < 1536 * 1024 - 160 * 1024
freeze = {'schema': 1, 'base_commit': baseline['head'], 'base_tree': baseline['tree'],
          'index_unchanged': final_guard['index'] == baseline['index'],
          'final_guard': final_guard, 'four_source_files_only': True,
          'source_paths': {p: {'durable_source': str(D / ('tests-only' if p.endswith('.cpp')
                                                        else 'production') / p),
                               **h.identity(h.ROOT / p)} for p in baseline['sources']},
          'old_cases_preservation': preservation, 'executions': executions,
          'classifications': {'configure_and_build': 'actual0; no setup failure',
                              'red': 'original production runtime alias/admission defects; '
                                     'SIGSEGV isolated in EXPECT_EXIT, whole JUnit retained',
                              'green': 'same complete tests; only two read admission blocks changed',
                              'read_observation': 'source ordering establishes admission before '
                                  'input MMIO; byte snapshots establish no writes, not zero-read tracing'},
          'scope_limits': ['No API, ops, state layout, constructor, stop, policy, registry changes.',
                           'No arbitrary address accessibility validation or peer-owner registry.',
                           'Owned bank is one complete F407 SDK struct; GD extent0x30 includes BC/TG.',
                           'No ARM objects or firmware link, installed SDK, physical/HIL execution.',
                           'No full repository gate, commit, stage or push by this agent.',
                           'IO31 ledger remains unchanged and pending.'],
          'archives_verified_crc_and_all_member_bytes_sha': archives,
          'resources_final': resources, 'allocated_before_seal': allocated,
          'budgets': {'persistent_bytes': 1572864, 'TMP_new_bytes': 41943040,
                      'minimum_TMP_free': 209715200, 'minimum_cgroup_headroom': 629145600,
                      'all_observed_oom_counters': 0, 'jobs': 1},
          'files': files}
(D / 'source-and-execution-freeze-r1.json').write_text(json.dumps(freeze, indent=2) + '\n')
mapping = []
for path, identity in freeze['source_paths'].items():
    mapping.append({'expected_path': path, **identity, 'kind': 'source'})
for path in sorted(D.rglob('*')):
    if not path.is_file() or path.name == 'transport-map-r1.json':
        continue
    relative = path.relative_to(D).as_posix()
    if path.suffix in ('.py', '.c', '.cpp', '.h', '.txt', '.log'):
        relative += '.raw'
    mapping.append({'expected_path': 'tests/evidence/gpio-read-ownership/' + relative,
                    'durable_source': str(path), 'kind': 'evidence', **h.identity(path)})
assert len({row['expected_path'] for row in mapping}) == len(mapping)
(D / 'transport-map-r1.json').write_text(json.dumps({'schema': 1, 'files': mapping}, indent=2) + '\n')
allocated = sum(p.stat().st_blocks * 512 for p in D.rglob('*')) + D.stat().st_blocks * 512
assert allocated <= 1572864
assert h.guard() == final_guard
assert sum(p.stat().st_size for p in h.TEMP.rglob('*') if p.is_file()) < 2*1024**2
print(json.dumps({'freeze': h.identity(D/'source-and-execution-freeze-r1.json'),
                  'map': h.identity(D/'transport-map-r1.json'), 'allocated': allocated,
                  'transport_paths': len(mapping), 'executions': executions}, indent=2))
