from pathlib import Path
import hashlib
import json
import sys
import urllib.request

sys.path.insert(0, '/dev/shm/nexus-clang14-required-20261018-r1')
from run import PREFIX, guard

kind = sys.argv[1]
if kind == 'pypi':
    url = 'https://pypi.org/pypi/clang-tidy/14.0.6/json'
    with urllib.request.urlopen(url, timeout=60) as response:
        data = response.read(1024 * 1024 + 1)
        observed = {'requested_url': url, 'resolved_url': response.url,
                    'status': response.status}
    assert len(data) <= 1024 * 1024
    info = json.loads(data)
    assert info['info']['version'] == '14.0.6'
    filename = ('clang_tidy-14.0.6-py2.py3-none-manylinux_2_17_x86_64.'
                'manylinux2014_x86_64.whl')
    rows = [row for row in info['urls'] if row['filename'] == filename]
    assert len(rows) == 1
    row = rows[0]
    assert row['size'] == 31382107
    assert row['digests']['sha256'] == (
        'c9ffcb91f17ee920fdd7a83f30484f3cb4c183f7b490d092373e4a6f2c82729d')
    guard('pypi-metadata-write')
    (PREFIX / 'upstream-pypi.json').write_bytes(data)
    result = {**observed, 'name': info['info']['name'],
              'version': info['info']['version'], 'asset': row,
              'raw_metadata_sha256': hashlib.sha256(data).hexdigest()}
else:
    assert kind == 'resource-deb'
    name = 'libclang-common-14-dev_14.0.6-12_all.deb'
    url = 'https://deb.debian.org/debian/pool/main/l/llvm-toolchain-14/' + name
    path = PREFIX / 'downloads' / name
    assert not path.exists()
    guard('resource-deb-download')
    digest = hashlib.sha256()
    total = 0
    with urllib.request.urlopen(url, timeout=60) as response, path.open('xb') as stream:
        observed = {'requested_url': url, 'resolved_url': response.url,
                    'status': response.status}
        while chunk := response.read(65536):
            total += len(chunk)
            assert total <= 889680
            stream.write(chunk)
            digest.update(chunk)
    assert total == 889680
    assert digest.hexdigest() == (
        '838781bfc798bcbdca68516db6546cf83677078efa57851bb957c19e265de7c6')
    result = {**observed, 'bytes': total, 'sha256': digest.hexdigest(),
              'path': str(path)}
(PREFIX / (kind + '-observation.json')).write_text(json.dumps(result, indent=2) + '\n')
print(json.dumps(result))
