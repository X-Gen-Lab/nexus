/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 13u) {
        s_nx_platform_initialized = 12u;
    }
    if (s_nx_platform_initialized >= 12u) {
        nx_result_t status_0 = nx_uart_port_stop(&s_nx_face_link_b);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 11u;
    }
    if (s_nx_platform_initialized >= 11u) {
        nx_result_t status_0 = nx_uart_port_stop(&s_nx_face_link_a);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 10u;
    }
    if (s_nx_platform_initialized >= 10u) {
        nx_result_t status_0 = nx_spi_port_stop(&s_nx_face_bus_spi_b);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 9u;
    }
    if (s_nx_platform_initialized >= 9u) {
        nx_result_t status_0 = nx_spi_port_stop(&s_nx_face_bus_spi_a);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 8u;
    }
    if (s_nx_platform_initialized >= 8u) {
        nx_result_t status_0 = nx_native_pwm_stop_instance(&s_nx_port_pwm0);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 7u;
    }
    if (s_nx_platform_initialized >= 7u) {
        nx_result_t status_0 = nx_native_i2c_stop_instance(&s_nx_port_bus_i2c_b);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 6u;
    }
    if (s_nx_platform_initialized >= 6u) {
        nx_result_t status_0 = nx_native_i2c_stop_instance(&s_nx_port_bus_i2c_a);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 5u;
    }
    if (s_nx_platform_initialized >= 5u) {
        nx_result_t status_0 = nx_native_gpio_stop_instance(&s_nx_port_led_b, 0u);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 4u;
    }
    if (s_nx_platform_initialized >= 4u) {
        nx_result_t status_0 = nx_native_gpio_stop_instance(&s_nx_port_led_a, 0u);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 3u;
    }
    if (s_nx_platform_initialized >= 3u) {
        nx_result_t status_0 = nx_native_flash_stop_instance(&s_nx_port_flash0);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 2u;
    }
    if (s_nx_platform_initialized >= 2u) {
        nx_result_t status_0 = nx_exti_port_stop(&s_nx_face_exti0);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 1u;
    }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = nx_native_adc_stop_instance(&s_nx_port_adc0);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    s_nx_platform_started = true;
    result.primary = nx_native_adc_configure_instance(&s_nx_port_adc0, s_nx_adc_model_adc0, 2u, 12u, 3300u);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    result.primary = nx_native_exti_configure_instance(&s_nx_port_exti0, 6u, NX_EXTI_BOTH, s_nx_events_exti0, 4u);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 2u;
    result.primary = nx_native_flash_initialize_instance(&s_nx_port_flash0, s_nx_model_flash_flash0, &s_nx_geometry_flash0);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 3u;
    result.primary = nx_native_gpio_configure_instance(&s_nx_port_led_a, 1u, 0u, true);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 4u;
    result.primary = nx_native_gpio_configure_instance(&s_nx_port_led_b, 8u, 0u, true);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 5u;
    result.primary = prepare_bus_i2c_a();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 6u;
    result.primary = prepare_bus_i2c_b();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 7u;
    result.primary = prepare_pwm0();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 8u;
    result.primary = prepare_bus_spi_a();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 9u;
    result.primary = prepare_bus_spi_b();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 10u;
    result.primary = nx_native_uart_configure_instance(&s_nx_port_link_a, &s_nx_config_link_a);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 11u;
    result.primary = nx_native_uart_configure_instance(&s_nx_port_link_b, &s_nx_config_link_b);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 12u;
    result.primary = nx_native_watchdog_initialize_instance(&s_nx_port_watchdog0);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 13u;
    return result;
}

/** \brief Pure typed lookup; lifecycle remains explicit. */
const nx_gpio_port_t* nx_factory_gpio(nx_gpio_id_t id) {
    switch (id) {
        case NX_GPIO_ID_LED_A:
            return nx_binding_led_a;
        case NX_GPIO_ID_LED_B:
            return nx_binding_led_b;
        default:
            return NULL;
    }
}
