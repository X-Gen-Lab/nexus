static nx_result_t prepare_primary_i2c(void) {
    nx_result_t status;
    if (s_nx_pair_constructed_primary_i2c || s_nx_pair_vectors_primary_i2c || s_nx_pair_pin_leases_primary_i2c != 0u) { return NX_ERROR_BUSY; }
    if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 2147483648u) != 0u) { return NX_ERROR_BUSY; }
    if (((NVIC->ISER[1] | NVIC->ISPR[1] | NVIC->IABR[1]) & 1u) != 0u) { return NX_ERROR_BUSY; }
    if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 2048u) != 0u) { return NX_ERROR_BUSY; }
    if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 131072u) != 0u) { return NX_ERROR_BUSY; }
