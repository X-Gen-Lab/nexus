    s_nx_pair_clock_added_primary_i2c = ~RCC->APB1ENR & RCC_APB1ENR_I2C1EN;
    NX_PLATFORM_REGISTER_WRITE(RCC->APB1ENR, RCC->APB1ENR | RCC_APB1ENR_I2C1EN);
    nx_arch_dsb();
    if ((RCC->APB1ENR & RCC_APB1ENR_I2C1EN) == 0u) { return NX_ERROR_IO; }
    if ((I2C1->CR1 & 1u) != 0u) { return NX_ERROR_BUSY; }
    s_nx_pair_priorities_primary_i2c[0] = NVIC->IP[31];
    s_nx_pair_priorities_primary_i2c[1] = NVIC->IP[32];
    s_nx_pair_priorities_primary_i2c[2] = NVIC->IP[11];
    s_nx_pair_priorities_primary_i2c[3] = NVIC->IP[17];
    s_nx_pair_vectors_primary_i2c = true;
    status = nx_stm32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_primary_i2c[0] = nx_stm32_pin_capture(GPIOB, 6u);
    s_nx_pair_pin_leases_primary_i2c |= 1u;
    status = nx_stm32_pin_configure(GPIOB, 6u, 2u, 4u, 0u, true);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_primary_i2c[1] = nx_stm32_pin_capture(GPIOB, 7u);
    s_nx_pair_pin_leases_primary_i2c |= 2u;
    status = nx_stm32_pin_configure(GPIOB, 7u, 2u, 4u, 0u, true);
    if (status != NX_SUCCESS) { return status; }
    s_nx_port_primary_i2c.registers = (volatile uint32_t*)I2C1;
    s_nx_port_primary_i2c.line_inputs = &GPIOB->IDR;
    s_nx_port_primary_i2c.line_mask = 192u;
    s_nx_port_primary_i2c.peripheral_mhz = 42u;
    s_nx_port_primary_i2c.dma = &s_nx_pair_dma_primary_i2c;
    status = nx_stm32_i2c_async_initialize(&s_nx_port_primary_i2c, 5u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_constructed_primary_i2c = true;
    s_nx_endpoint_primary_i2c.port = &s_nx_port_primary_i2c;
    s_nx_endpoint_primary_i2c.address = 80u;
    if ((RCC->APB1ENR & RCC_APB1ENR_I2C1EN) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[31], 80u);
    nx_arch_dsb();
    if (NVIC->IP[31] != 80u || (NVIC->ISER[0] & 2147483648u) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[32], 80u);
    nx_arch_dsb();
    if (NVIC->IP[32] != 80u || (NVIC->ISER[1] & 1u) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[11], 80u);
    nx_arch_dsb();
    if (NVIC->IP[11] != 80u || (NVIC->ISER[0] & 2048u) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[17], 80u);
    nx_arch_dsb();
    if (NVIC->IP[17] != 80u || (NVIC->ISER[0] & 131072u) == 0u) { return NX_ERROR_IO; }
    return NX_SUCCESS;
