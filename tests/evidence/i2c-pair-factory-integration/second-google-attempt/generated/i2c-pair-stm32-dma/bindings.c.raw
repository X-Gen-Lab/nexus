        NX_PLATFORM_REGISTER_WRITE(NVIC->ICER[0], 2147483648u);
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 2147483648u);
        nx_arch_dsb();
        if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 2147483648u) != 0u) { return NX_ERROR_BUSY; }
        NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[31], s_nx_pair_priorities_primary_i2c[0]);
        nx_arch_dsb();
        if (NVIC->IP[31] != s_nx_pair_priorities_primary_i2c[0]) { return NX_ERROR_IO; }
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICER[1], 1u);
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[1], 1u);
        nx_arch_dsb();
        if (((NVIC->ISER[1] | NVIC->ISPR[1] | NVIC->IABR[1]) & 1u) != 0u) { return NX_ERROR_BUSY; }
        NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[32], s_nx_pair_priorities_primary_i2c[1]);
        nx_arch_dsb();
        if (NVIC->IP[32] != s_nx_pair_priorities_primary_i2c[1]) { return NX_ERROR_IO; }
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICER[0], 2048u);
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 2048u);
        nx_arch_dsb();
        if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 2048u) != 0u) { return NX_ERROR_BUSY; }
        NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[11], s_nx_pair_priorities_primary_i2c[2]);
        nx_arch_dsb();
        if (NVIC->IP[11] != s_nx_pair_priorities_primary_i2c[2]) { return NX_ERROR_IO; }
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICER[0], 131072u);
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 131072u);
        nx_arch_dsb();
        if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 131072u) != 0u) { return NX_ERROR_BUSY; }
        NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[17], s_nx_pair_priorities_primary_i2c[3]);
        nx_arch_dsb();
        if (NVIC->IP[17] != s_nx_pair_priorities_primary_i2c[3]) { return NX_ERROR_IO; }
        s_nx_pair_vectors_primary_i2c = false;
    }
    if ((s_nx_pair_pin_leases_primary_i2c & 2u) != 0u) {
        nx_stm32_pin_restore(GPIOB, 7u, s_nx_pair_pin_saved_primary_i2c[1]);
        if (nx_stm32_pin_capture(GPIOB, 7u) != s_nx_pair_pin_saved_primary_i2c[1]) { return NX_ERROR_IO; }
        s_nx_pair_pin_leases_primary_i2c &= (uint16_t)~2u;
    }
    if ((s_nx_pair_pin_leases_primary_i2c & 1u) != 0u) {
        nx_stm32_pin_restore(GPIOB, 6u, s_nx_pair_pin_saved_primary_i2c[0]);
        if (nx_stm32_pin_capture(GPIOB, 6u) != s_nx_pair_pin_saved_primary_i2c[0]) { return NX_ERROR_IO; }
        s_nx_pair_pin_leases_primary_i2c &= (uint16_t)~1u;
    }
    if (s_nx_pair_clock_added_primary_i2c != 0u) {
        NX_PLATFORM_REGISTER_WRITE(RCC->APB1ENR, RCC->APB1ENR & ~s_nx_pair_clock_added_primary_i2c);
        nx_arch_dsb();
        if ((RCC->APB1ENR & s_nx_pair_clock_added_primary_i2c) != 0u) { return NX_ERROR_IO; }
