  "official_facts": [
    {
      "reference": "RM0433 Rev9 \u00a750.4.9 p2171; text155148..155151",
      "fact": "AFCNTR drives associated outputs independent of SPE; later CFG1/CFG2 changes can change pin levels."
    },
    {
      "reference": "RM0433 Rev9 \u00a750.4.12 p2177; text155447..155498",
      "fact": "Drain final TXC/EOT or suspended CSTART0; read RXFIFO empty; only then disable. TSIZE>0 EOT/TXC are equal."
    },
    {
      "reference": "RM0433 Rev9 SPI_CR1 p2216; text157951..157969",
      "fact": "CSUSP reads0; accepted request clears CSTART at the end of current frame; SUSP proves end of frame."
    },
    {
      "reference": "RM0433 Rev9 SPI_SR p2225; text158405..158422",
      "fact": "TSIZE>0 TXC copies EOT; clear SUSP before SPE disable."
    },
    {
      "reference": "RM0433 Rev9 SPI_CFG2 AFCNTR; text158207..158215",
      "fact": "AFCNTR0 releases GPIO control at SPE0; AFCNTR1 keeps associated AF outputs at current configured state."
    },
    {
      "reference": "ES0392 Rev15 \u00a72.22.5/6 p46; text2790..2820",
      "fact": "Keep CRCSIZE7 with disabled CRC/nonzeroTSIZE; delay after EOT before disable to avoid trailing SCK truncation."
    },
    {
      "reference": "locked HAL a1996ee SPI Abort lines2605..2647",
      "fact": "Request CSUSP, observe CSTART clear, clear/check SUSP; complete helper disables SPE/IT/DMA. Its timeout fallback is not Nexus borrowed-frame proof."
    },
    {
      "reference": "Zephyr v4.2.0 commit413b789 spi_ll_stm32.c:491..544 and .h:186..238",
      "fact": "Wait actual busy/EOT/TXC then deassert GPIO CS before disabling SPI; FIFO flush/readback helper. No automatic adoption of its unbounded loops or a new reset/pin guarantee."
    }
  ]
