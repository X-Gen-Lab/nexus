#!/usr/bin/env python3
"""Run the maintained five exact D2 ARM assemblies; retain all actual outcomes."""
from pathlib import Path
import hashlib,json,os,resource,shutil,signal,subprocess,time
ROOT=Path('/tmp/nexus-h743-spi-safe-stop-20261018')
BASE=Path('/workspace/nexus-io-recovery-20261018/features/h743-spi-dma-d2')
TOOLS=Path('/tmp/nexus-io-validation-20261018/.venv/bin')
ARM=Path('/tmp/nexus-io-tools-recovery-20261018/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gcc')
OUT=Path('/dev/shm/nexus-h743-spi-dma-d2-arm-r2')
OLD=Path('/dev/shm/nexus-h743-spi-dma-d2-arm-r1')
EVID=ROOT/'build/h743-spi-dma-d2-evidence/final-arm5-r2'
NAMES=json.loads((BASE/'bootstrap.json').read_text())['authorized_paths']
for suffix in ('r1','r2','r3','r4'):
 NAMES+=json.loads((BASE/('scope-extension-'+suffix+'.json')).read_text())['added_authorized_paths']
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def allocated(p):return sum(q.stat().st_blocks*512 for q in p.rglob('*') if q.is_file() and not q.is_symlink()) if p.is_dir() else 0
def state():
 return {'source':{n:sha(ROOT/n) for n in NAMES},'index':sha(ROOT/'.git/index'),'tmp_free':shutil.disk_usage(ROOT).free,'output_free':shutil.disk_usage(OUT.parent).free,'persistent_free':shutil.disk_usage(BASE).free,'build_allocated':allocated(ROOT/'build'),'arm_allocated':allocated(OUT)+allocated(OLD),'fixture_allocated':allocated(Path('/dev/shm/nexus-h743-spi-dma-d2-tmp')),'memory_current':int(Path('/sys/fs/cgroup/memory.current').read_text()),'memory_max':int(Path('/sys/fs/cgroup/memory.max').read_text()),'events':Path('/sys/fs/cgroup/memory.events').read_text()}
baseline=json.loads((BASE/'bootstrap.json').read_text())['build_allocated_baseline']
def reason(s):
 if s['memory_max']-s['memory_current']<600*1024*1024:return 'cgroup headroom below600MiB'
 if min(s['tmp_free'],s['output_free'])<200*1024*1024:return 'output filesystem below200MiB'
 if s['persistent_free']<64*1024*1024:return 'persistent filesystem below64MiB'
 if s['build_allocated']-baseline+s['arm_allocated']+s['fixture_allocated']>=100*1024*1024:return 'D2 new product allocation reached100MiB'
 if any(int(line.split()[1]) for line in s['events'].splitlines() if line.split()[0] in ('oom','oom_kill','oom_group_kill')):return 'OOM event observed'
 return None
before=state();assert reason(before) is None,reason(before);assert not OUT.exists();EVID.mkdir(exist_ok=False)
fixtures=['empty.toml','peripherals.toml','spi-dma.toml','spi-dma-uart-tx.toml','spi-dma-uart-rx.toml']
command=[str(TOOLS/'python'),'scripts/ci/provider_assemblies.py','--root',str(ROOT)]
for name in fixtures:command+=['--fixture','tests/contracts/h743_assembly/'+name]
command+=['--family','stm32h743','--compiler',str(ARM),'--output',str(OUT),'--parallel','1']
env={k:v for k,v in os.environ.items() if not k.startswith(('GIT_','GTEST_','CTEST_'))};env.update(PATH=str(TOOLS)+os.pathsep+str(ARM.parent)+os.pathsep+env.get('PATH',''),PYTHONDONTWRITEBYTECODE='1',CMAKE_BUILD_PARALLEL_LEVEL='1',TMPDIR='/dev/shm/nexus-h743-spi-dma-d2-tmp')
start=time.time_ns();print(json.dumps({'command':command,'before':before}),flush=True);stop=None;peakmem=before['memory_current'];peakallocated=0
with (EVID/'raw.log').open('wb') as raw:
 child=subprocess.Popen(command,cwd=ROOT,env=env,stdout=raw,stderr=subprocess.STDOUT,start_new_session=True)
 while child.poll() is None:
  time.sleep(2);s=state();peakmem=max(peakmem,s['memory_current']);peakallocated=max(peakallocated,s['build_allocated']-baseline+s['arm_allocated']+s['fixture_allocated']);stop=reason(s)
  if time.time_ns()-start>900*10**9:stop='whole gate exceeded900s'
  if stop:
   os.killpg(child.pid,signal.SIGTERM)
   try:child.wait(timeout=5)
   except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL)
   break
 code=child.wait()
after=state();record={'scope':'maintained exact ARM build/resource/retention only; no target execution/installed SDK/HIL','qualification':False,'command':command,'actual_exit':code,'stop_reason':stop,'started_ns':start,'ended_ns':time.time_ns(),'before':before,'after':after,'source_stable':before['source']==after['source'],'index_stable':before['index']==after['index'],'peak_memory_current':peakmem,'peak_new_product_allocated':peakallocated,'children_maxrss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'raw_sha256':sha(EVID/'raw.log')}
if (OUT/'report.json').is_file():
 report=json.loads((OUT/'report.json').read_text());record.update(report_sha256=sha(OUT/'report.json'),gate_status=report.get('status'),fixture_count=len(report.get('fixtures',[])),gate_error=report.get('error'))
(EVID/'receipt.json').write_text(json.dumps(record,indent=2)+'\n');print(json.dumps(record,indent=2),flush=True)
raise SystemExit(code)
