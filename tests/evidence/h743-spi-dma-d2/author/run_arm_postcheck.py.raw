#!/usr/bin/env python3
"""Independently read the exact successful five ARM ELFs and immutable bundles."""
from pathlib import Path
import hashlib,json,shlex,struct,sys
ROOT=Path('/tmp/nexus-h743-spi-safe-stop-20261018');sys.path.insert(0,str(ROOT))
from tools.measurement.elf import Elf32,interval_bytes
BASE=Path('/workspace/nexus-io-recovery-20261018/features/h743-spi-dma-d2')
OUT=Path('/dev/shm/nexus-h743-spi-dma-d2-arm-r2')
def sha(data):return hashlib.sha256(data).hexdigest()
freeze=json.loads((BASE/'source-freeze-r2.json').read_text())
def source():return {x['path']:sha((ROOT/x['path']).read_bytes()) for x in freeze['source']}
before=source();assert before=={x['path']:x['sha256'] for x in freeze['source']}
assert sha((ROOT/'.git/index').read_bytes())==freeze['index_sha256']
report=json.loads((OUT/'report.json').read_text());receipt=json.loads((ROOT/'build/h743-spi-dma-d2-evidence/final-arm5-r2/receipt.json').read_text())
assert receipt['actual_exit']==0 and receipt['stop_reason'] is None and receipt['source_stable'] and receipt['index_stable']
assert report['status']=='passed' and report['fixture_count']==5 and report['source_inputs_stable'] and report['tools_stable']
assert all(x['returncode']==0 for x in report['commands'])
expected=['empty.toml','peripherals.toml','spi-dma.toml','spi-dma-uart-tx.toml','spi-dma-uart-rx.toml']
def artifact(row,label):
 x=row['artifacts'][label];p=Path(x['path']);b=p.read_bytes();assert sha(b)==x['sha256'];return b
def at(elf,address,count):
 for s in elf.sections:
  if s['kind']!=8 and s['address']<=address and address+count<=s['address']+s['size']:
   return elf.data[s['offset']+address-s['address']:s['offset']+address-s['address']+count]
 raise AssertionError('no single file-backed section for requested span')
def writable(elf):return {x['name']:x['size'] for x in elf.defined_symbols if x['type']==1 and 0x20000000<=x['value']<0x40000000}
def independent_metrics(elf,resource):
 flash=interval_bytes([(max(x['physical'],0x08000000),min(x['physical']+x['files'],0x08200000)) for x in elf.loads if x['files'] and x['physical']<0x08200000 and x['physical']+x['files']>0x08000000])
 ram=interval_bytes([(max(x['address'],0x24000000),min(x['address']+x['size'],0x24080000)) for x in elf.sections if x['flags']&2 and x['size'] and x['address']<0x24080000 and x['address']+x['size']>0x24000000])
 assert flash==resource['metrics']['flash']['loaded_bytes'];assert ram==resource['metrics']['ram']['axi-sram']['reserved_bytes']
 assert all(v['reserved_bytes']==0 for k,v in resource['metrics']['ram'].items() if k!='axi-sram')
 return {'flash_load_bytes':flash,'axi_allocated_union_bytes_including_reserved_stack':ram}
rows=[]
for index,row in enumerate(report['fixtures']):
 assert Path(row['assembly']['path'])==ROOT/'tests/contracts/h743_assembly'/expected[index]
 assert sha(Path(row['assembly']['path']).read_bytes())==row['assembly']['sha256']
 assert row['family']=='stm32h743' and row['part']=='STM32H743ZIT6' and row['backend']=='baremetal'
 for key in row['artifacts']:artifact(row,key)
 elf=Elf32(artifact(row,'elf'));syms={x['name']:x for x in elf.defined_symbols};resource=json.loads(artifact(row,'resources'));metric=independent_metrics(elf,resource);resolved=json.loads(artifact(row,'resolved'));assert resolved['clock_profile']=='hsi64-fixed-cache-off'
 db=json.loads(artifact(row,'compile_commands'));files=[str(Path(x['file']).resolve()) for x in db]
 assert all(Path(x).suffix not in ('.cpp','.cc','.cxx') and '/tests/google/' not in x for x in files)
 assert all('NX_H743_MODEL' not in x['command'] and 'h743_spi_dma_factory_model' not in x['command'] for x in db)
 selected=index>=2;spi_dma=str(ROOT/'soc/stm32h743/drivers/spi_dma.c');spi_poll=str(ROOT/'soc/stm32h743/drivers/spi.c');wire=str(ROOT/'soc/stm32h743/drivers/spi_wire.c')
 assert files.count(spi_dma)==int(selected);assert files.count(spi_poll)==int(index==1);assert files.count(wire)==int(index!=0)
 pointers={};vectors={};region=None
 if selected:
  for face,ops,context in [('s_nx_face_bus4','nx_stm32h743_spi_dma_ops','s_nx_port_bus4'),('s_nx_device_face_device4','nx_stm32h743_spi_dma_endpoint_ops','s_nx_endpoint_device4')]:
   symbol=syms[face];assert symbol['size']==8 and 0x08000000<=symbol['value']<0x08200000
   words=struct.unpack('<II',at(elf,symbol['value'],8));assert words==(syms[ops]['value'],syms[context]['value']);pointers[face]={'ops':ops,'context':context,'actual_words':list(words)}
  assert syms['s_nx_port_bus4']['size']==120 and syms['s_nx_endpoint_device4']['size']==32 and syms['s_nx_cs_device4']['size']==12
  assert syms['s_nx_dma_clocks_added']['size']==4
  region=list(struct.unpack('<III',at(elf,syms['s_nx_dma_regions_bus4']['value'],12)));assert region==[0x24000000,0x80000,3]
  claims={13:'DMA1_Stream2_IRQHandler',14:'DMA1_Stream3_IRQHandler',84:'SPI4_IRQHandler'}
  if index in (3,4):claims.update({39:'USART3_IRQHandler',11 if index==3 else 12:'DMA1_Stream0_IRQHandler' if index==3 else 'DMA1_Stream1_IRQHandler'})
  vector=next(x for x in elf.sections if x['name']=='.isr_vector')
  for irq,name in claims.items():
   symbol=syms[name];assert symbol['binding']==1 and symbol['type']==2
   value=struct.unpack('<I',at(elf,vector['address']+(irq+16)*4,4))[0];assert value==symbol['value'] and value&1;vectors[str(irq)]={'handler':name,'word':value}
  assert 'nx_stm32h743_spi_ops' not in syms and 'nx_stm32h743_spi_endpoint_ops' not in syms
 else:
  assert not any('spi_dma' in name for name in syms)
  for n in ('DMA1_Stream2_IRQHandler','DMA1_Stream3_IRQHandler','SPI4_IRQHandler'):assert n not in syms or syms[n]['binding']!=1
  if index==0:assert not any(name.startswith('nx_stm32h743_spi') or name in ('s_nx_port_bus4','s_nx_dma_clocks_added','s_nx_endpoint_device4') for name in syms)
  else:assert syms['s_nx_port_bus4']['size']==32 and syms['s_nx_endpoint_device4']['size']==20
 uart_tx=str(ROOT/'soc/stm32h743/drivers/uart_dma.c');uart_rx=str(ROOT/'soc/stm32h743/drivers/uart_receive.c')
 assert files.count(uart_tx)==int(index==3) and files.count(uart_rx)==int(index==4)
 rows.append({'assembly':row['assembly'],'elf':row['artifacts']['elf'],'metrics':metric,'faces':row['face_count'],'methods':row['method_count'],'driver_translation_units':[x for x in files if '/soc/stm32h743/drivers/' in x],'linked_SPI_faces':pointers,'actual_vector_words':vectors,'linked_AXI_region_words':region,'binding_writable_objects':{x['name']:x['size'] for x in elf.defined_symbols if x['file']=='bindings.c' and x['type']==1 and 0x20000000<=x['value']<0x40000000}})
# A prior exact authored polling/empty link is a bounded ABI/resource comparator,
# never a source-identity substitute for the current five builds.
oldbase=Path('/workspace/nexus-io-recovery-20261018/features/h743-spi-wire-w1');old=json.loads((oldbase/'arm-cost-retention-postcheck.json').read_text());oldgate=json.loads((ROOT/'build/h743-spi-wire-w1-arm-fixed-r2/report.json').read_text());assert oldgate['tools']['gcc']['sha256']==report['tools']['gcc']['sha256'];comparisons=[]
for index,oldindex in [(0,2),(1,0)]:
 baseline=old['rows'][oldindex];assert baseline['assembly']['sha256']==rows[index]['assembly']['sha256'];oldelf=Path(baseline['elf']['path']).read_bytes();assert sha(oldelf)==baseline['elf']['sha256'];current=Elf32(Path(rows[index]['elf']['path']).read_bytes());prior=Elf32(oldelf)
 assert writable(current)==writable(prior)
 comparisons.append({'assembly':expected[index],'baseline_ELF_sha256':sha(oldelf),'same_authored_tuple_and_compiler':True,'all_retained_writable_symbol_names_and_sizes_equal':True,'flash_LOAD_delta':rows[index]['metrics']['flash_load_bytes']-baseline['metrics']['flash_load_bytes'],'AXI_reserved_delta':rows[index]['metrics']['axi_allocated_union_bytes_including_reserved_stack']-baseline['metrics']['axi_allocated_union_bytes']})
assert source()==before and sha((ROOT/'.git/index').read_bytes())==freeze['index_sha256']
result={'kind':'D2 independent successful ARM5 linked-byte postcheck','actual_status':'passed','qualification':False,'source_freeze_sha256':sha((BASE/'source-freeze-r2.json').read_bytes()),'normal_report_sha256':sha((OUT/'report.json').read_bytes()),'normal_commands':len(report['commands']),'rows':rows,'exact_prior_ABI_comparisons':comparisons,'limitations':['ARM link/resource/retention only; no target runtime, HIL, measured cycles or stack high-water','RAM reports allocated/reserved linked intervals including the explicit main stack, not total physical RAM or measured occupancy','Different selected fixtures have different peripherals; differences are not an isolated marginal driver benchmark','Installed clean SDK belongs to separate D3; cold shared reset and TC fixes do not close runtime-domain loss audit']}
p=ROOT/'build/h743-spi-dma-d2-evidence/arm5-independent-postcheck.json';p.write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({'report':str(p),'sha256':sha(p.read_bytes()),'rows':[{k:x[k] for k in ('assembly','metrics','faces','methods')} for x in rows],'prior_comparisons':comparisons},indent=2))
