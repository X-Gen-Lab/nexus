"""Root-only complete staged D2 supplement; preserve failed full attempt."""
from pathlib import Path, PurePosixPath
import argparse, gzip, hashlib, json, os, subprocess
ROOT=Path('/tmp/nexus-io-validation-20261018')
p=argparse.ArgumentParser()
for name in ('manifest','review','before_manifest','before_applied','output'):
    p.add_argument('--'+name.replace('_','-'),type=Path,required=True)
for name in ('manifest_sha','review_sha','before_manifest_sha','review_target','manifest_target'):
    p.add_argument('--'+name.replace('_','-'),required=True)
a=p.parse_args()
def sha(b):return hashlib.sha256(b).hexdigest()
def git(*args):return subprocess.check_output(['git','-c','gc.auto=0','-c','maintenance.auto=false','-C',str(ROOT),*args])
def read(path,row):
    assert path.is_file() and not any(x.is_symlink() for x in (path,*path.parents))
    b=path.read_bytes();assert (len(b),sha(b))==(row['bytes'],row['sha256']),str(path)
    return b
redirected=('GIT_DIR','GIT_COMMON_DIR','GIT_WORK_TREE','GIT_INDEX_FILE','GIT_OBJECT_DIRECTORY','GIT_ALTERNATE_OBJECT_DIRECTORIES','GIT_NAMESPACE')
assert not any(k in os.environ for k in redirected) and not any(k.startswith('GIT_CONFIG') for k in os.environ)
assert a.output.is_absolute() and a.output.resolve()==a.output and not a.output.is_relative_to(ROOT)
assert not a.output.exists() and not any(x.is_symlink() for x in a.output.parents)
assert sha(a.before_manifest.read_bytes())==a.before_manifest_sha
assert sha(a.manifest.read_bytes())==a.manifest_sha
assert sha(a.review.read_bytes())==a.review_sha
before=json.loads(a.before_manifest.read_text());applied=json.loads(a.before_applied.read_text());package=json.loads(a.manifest.read_text())
assert applied['complete_manifest_sha256']==a.before_manifest_sha
assert git('rev-parse','HEAD').decode().strip()==applied['head']=='474b3da3e7e60bf73c573f073465036c8db6437f'
assert git('write-tree').decode().strip()==applied['tree']=='c7dbf82f615e003a3c717230c7f059a2edb0179f'
assert not git('diff','--name-only') and not git('ls-files','--others','--exclude-standard')
old={r['path']:r for r in before['files']};assert len(old)==before['file_count']==190
old_names=set(git('diff','--no-renames','--cached','--name-only','-z').decode().split('\0'))-{''};assert old_names==set(old)
for name,row in old.items():assert git('show',':'+name)==read(ROOT/name,row)
rows=[dict(r) for r in package['files']]
for path,target in [(a.review,a.review_target),(a.manifest,a.manifest_target)]:
    assert target.startswith('tests/evidence/')
    b=path.read_bytes();rows.append({'path':target,'durable_source':str(path),'bytes':len(b),'sha256':sha(b),'origin':'reviewed integration supplement or complete transport map'})
new={r['path']:r for r in rows};assert len(new)==len(rows)==len({r['path'].casefold() for r in rows})
removed=set(old)-set(new);bad='tests/evidence/oci-ca-reader/main-normal-gate/start.json';renamed=bad+'.raw'
assert removed=={bad} and renamed in new
assert (new[renamed]['bytes'],new[renamed]['sha256'])==(old[bad]['bytes'],old[bad]['sha256'])
assert bad not in set(git('ls-tree','-r','--name-only','HEAD').decode().splitlines())
expected_sources={r['path'] for r in before['files'] if not r['path'].startswith('tests/evidence/')}|{'tools/dev/plans/software.json','tools/testing/test_work_packages.py'}
assert len(expected_sources)==31
assert {r['path'] for r in rows if not r['path'].startswith('tests/evidence/')}==expected_sources
assert package['source_count']==31
preimages=[]
for row in rows:
    name=PurePosixPath(row['path']);assert not name.is_absolute() and '..' not in name.parts and str(name)==row['path'] and '.git' not in name.parts and name.parts[0] not in ('build','vendors')
    b=read(Path(row['durable_source']),row);dest=ROOT/row['path']
    assert not any(x.is_symlink() for x in (dest,*dest.parents))
    if dest.exists():
        original=dest.read_bytes()
        if row['path'] in old:assert original==read(dest,old[row['path']])
        else:assert original==git('show','HEAD:'+row['path'])
        if original!=b:preimages.append((row['path'],original))
for name in removed:preimages.append((name,read(ROOT/name,old[name])))
index=Path(git('rev-parse','--git-path','index').decode().strip())
if not index.is_absolute():index=ROOT/index
index_bytes=index.read_bytes()
a.output.mkdir(parents=True,exist_ok=False)
backup=a.output/'before-index.gz';backup.write_bytes(gzip.compress(index_bytes,mtime=0));assert gzip.decompress(backup.read_bytes())==index_bytes
saved=[]
for name,b in preimages:
    target=a.output/'before'/name;target.parent.mkdir(parents=True,exist_ok=True)
    with target.open('xb') as stream:stream.write(b);stream.flush();os.fsync(stream.fileno())
    assert target.read_bytes()==b;saved.append({'path':name,'bytes':len(b),'sha256':sha(b)})
(a.output/'before.json').write_text(json.dumps({'head':applied['head'],'staged_tree':applied['tree'],'index_sha256':sha(index_bytes),'files':saved,'semantics':'Complete before bytes retained; controlled append, not automatic rollback'},indent=2)+'\n')
assert index.read_bytes()==index_bytes and git('write-tree').decode().strip()==applied['tree']
for name,row in old.items():assert git('show',':'+name)==read(ROOT/name,row)
for row in rows:read(Path(row['durable_source']),row)
assert not (ROOT/renamed).exists()
os.rename(ROOT/bad,ROOT/renamed)
for row in rows:
    target=ROOT/row['path'];b=read(Path(row['durable_source']),row)
    if target.exists() and target.read_bytes()==b:continue
    target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(b)
subprocess.run(['git','-c','gc.auto=0','-c','maintenance.auto=false','-C',str(ROOT),'add','-A','-f','--',*(r['path'] for r in rows),*sorted(removed)],check=True)
assert set(git('diff','--no-renames','--cached','--name-only','-z').decode().split('\0'))-{''}==set(new)
assert not git('diff','--name-only') and not git('ls-files','--others','--exclude-standard')
assert not git('diff','--no-renames','--cached','--name-only','--diff-filter=D')
for row in rows:assert git('show',':'+row['path'])==read(ROOT/row['path'],row)
tree=git('write-tree').decode().strip()
complete={'kind':'complete reviewed D2 staged supplement after preserved failed gate','base_head':applied['head'],'file_count':len(rows),'source_count':31,'files':rows,'prior_full_inputs_sha256':a.before_manifest_sha,'review_sha256':a.review_sha,'transport_map_sha256':a.manifest_sha,'qualification':'fresh full normal hooks pending'}
mp=a.output/'complete-inputs.json';mp.write_text(json.dumps(complete,indent=2)+'\n')
result={'kind':'exact-all-staged-main-inputs','head':applied['head'],'tree':tree,'staged_files':len(rows),'source_files':31,'complete_manifest_sha256':sha(mp.read_bytes()),'all_actual_paths_and_bytes_verified':True,'qualification':'fresh full normal hooks pending'}
(a.output/'complete-main-applied.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result),flush=True)
