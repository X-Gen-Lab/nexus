from pathlib import Path
import hashlib,json,os,subprocess,sys,resource
B=Path(__file__).resolve().parent;R=Path('/tmp/nexus-io36-native-20261018');V=Path('/workspace/nexus-build-system-20261012/.venv/bin')
base=json.loads((B/'baseline.json').read_text());phase=sys.argv[1];D=B/'execution'/phase;D.mkdir(parents=True,exist_ok=False)
def ident(p):
 p=Path(p)
 if not p.exists():return None
 a=p.read_bytes();return {'bytes':len(a),'sha256':hashlib.sha256(a).hexdigest()}
def state():
 protected={n:ident(R/n) for n in base['protected']};assert protected==base['protected']
 index=ident(R/'.git/index');assert index==base['index']
 sem=hashlib.sha256(subprocess.check_output(['git','--no-optional-locks','ls-files','--stage','-z'],cwd=R)).hexdigest();assert sem==base['semantic_index_sha256']
 status=subprocess.check_output(['git','--no-optional-locks','status','--porcelain=v1','--untracked-files=all'],cwd=R).decode();
 return {'source':{n:ident(R/n) for n in base['source_paths']},'index':index,'semantic_index_sha256':sem,'protected':protected,'status':status}
before=state();(D/'before.json').write_text(json.dumps(before,indent=2)+'\n')
tmp=Path('/tmp/nexus-remote-software-qualification-r1');tmp.mkdir(exist_ok=True)
env=dict(os.environ,PATH=str(V)+os.pathsep+'/tmp/nexus-io-tools-recovery-20261018/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin'+os.pathsep+os.environ['PATH'],PYTHONPATH=str(R),PYTHONDONTWRITEBYTECODE='1',TMPDIR=str(tmp),GIT_OPTIONAL_LOCKS='0')
sys.path.insert(0,str(R));from tools.dev import process
if phase=='workflows-green-r1':argv=[str(V/'python'),'tools/testing/run_tool_tests.py','--suite','workflows','--report',str(D/'result.json')]
else:argv=[str(V/'python'),str(B/'execute-whole.raw'),str(D/'result.json'),*[str(R/n) for n in sys.argv[2:]]]
r=process.run(argv,cwd=R,env=env,timeout=600,stage=phase,log=D/'command.raw')
after=state();(D/'after.json').write_text(json.dumps(after,indent=2)+'\n');assert before==after
size=sum(p.stat().st_blocks*512 for p in B.rglob('*') if p.is_file());tmpbytes=sum(p.stat().st_blocks*512 for p in tmp.rglob('*') if p.is_file() and not p.is_symlink())
record={'phase':phase,'exit_code':r.returncode,'receipt':str(r.receipt_path),'guards_stable':before==after,'persistent_allocated_bytes':size,'TMP_live_allocated_bytes':tmpbytes,'child_max_rss_KiB':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss}
(D/'summary.json').write_text(json.dumps(record,indent=2)+'\n');print(json.dumps(record));print(r.stdout[-1500:]);print(r.stderr[-7500:],file=sys.stderr)
assert size<=1048576 and tmpbytes<=26214400
raise SystemExit(r.returncode)
