from pathlib import Path
import hashlib,json,os,resource,sys,time
R=Path('/tmp/nexus-io36-native-20261018')
E=Path('/workspace/nexus-io-recovery-20261018/features/sdk-consumer-transport-r1')
T=Path('/tmp/nexus-sdk-consumer-transport-r1')
sys.path.insert(0,str(R))
from tools.dev.process import run
from tools.evidence.identity import observe_git_source
label=sys.argv[1]; args=sys.argv[2:]
out=E/'executions'/label
out.mkdir(exist_ok=False)
before=observe_git_source(R)
env=dict(os.environ,TMPDIR=str(T/'tmp'),PYTHONDONTWRITEBYTECODE='1',NEXUS_BUILD_JOBS='1',CMAKE_BUILD_PARALLEL_LEVEL='1',PRE_COMMIT_HOME='/tmp/nexus-io-precommit-recovery-20261018')
result=run(args,cwd=R,env=env,log=out/'command.raw',timeout=1800,stage=label)
after=observe_git_source(R)
r={'exit_code':result.returncode,'source_before':before,'source_after':after,'source_unchanged':before==after,'max_completed_child_rss_kib':resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss,'oom_after':Path('/sys/fs/cgroup/memory.events').read_text(),'receipt':str(result.receipt_path)}
(out/'result.json').write_text(json.dumps(r,indent=2)+'\n')
print(json.dumps(r))
raise SystemExit(result.returncode if before==after else 125)
