  "gzip_and_TAR_review": {
    "actual_CRC_ISIZE_truncation_RED": true,
    "bounded_gzip": "zlib single-member reader uses65536-byte compressed chunks and65536 max output per iteration; expanded bytes <=MAX_BYTES+(MAX_FILES+1)*4096; validates actual CRC/ISIZE/trailer EOF and rejects unused_data or subsequent compressed bytes. No unbounded whole archive decompression in production.",
    "TAR_inventory": "Existing bounded complete safe regular-member inventory compares sizes/SHA/file modes; no extraction or execution of payload.",
    "TAR_tail": "After iteration seek(archive.offset) rewinds to last valid member end, including a malformed/truncated header that TarFile.next may already have consumed as EOF. Remaining reads are bounded65536 and must all be zero padding.",
    "closed_R3_blocker": "Actual whole42 admitted bad512B end-header and short nonzero end-header under r2: two subtest failures, zero fixture errors. Minimal seek/comment change closes this in same42 plus final24/19.",
    "other_adversarial_coverage": "RehashedCRC/ISIZE/truncation; compressed garbage/concatenation; same-member nonzero tail/second TAR; legal zero padding; bounded expansion. Gzip compressed trailing/concat originally already rejected by first fix and is coverage, not fabricated RED.",
    "generic_store_limit": "No claim to change or broadly qualify tools/evidence/store.py; this is the selected consumer transport boundary."
  },
