#!/usr/bin/env python3
"""Read actual linked ARM bytes and compare the exact committed S0 fixtures."""
from pathlib import Path
import hashlib,json,shlex,sys,zipfile
ROOT=Path('/tmp/nexus-h743-spi-safe-stop-20261018');sys.path.insert(0,str(ROOT))
from tools.measurement.elf import Elf32,interval_bytes
BASE=Path('/workspace/nexus-io-recovery-20261018/features/h743-spi-wire-w1')
ZIP=Path('/workspace/nexus-io-recovery-20261018/validation/h743-spi-s0-arm-r1/complete.zip')
sha=lambda b:hashlib.sha256(b).hexdigest()
assert sha(ZIP.read_bytes())=='5b29c8c79759ebe4eb8bd30264b2214aa7f876a4e87350073e6a7ba65415257c'
current_path=ROOT/'build/h743-spi-wire-w1-arm-fixed-r2/report.json';current=json.loads(current_path.read_text())
assert current['status']=='passed' and current['fixture_count']==3 and current['source_inputs_stable'] and current['tools_stable']
APIS=['clock_ready','divider','quiet_us','pins_ready','cs_driven','sck_alternate','sck_idle','suspend_once','stopped','disable','release_cs','reset']
expected={'nx_stm32h743_spi_wire_'+n for n in APIS}
def read_artifact(row,label):
 meta=row['artifacts'][label];data=Path(meta['path']).read_bytes();assert sha(data)==meta['sha256'];return data

def independent_metrics(elf,metrics):
 flash=interval_bytes([(max(x['physical'],0x08000000),min(x['physical']+x['files'],0x08200000)) for x in elf.loads if x['files'] and x['physical']<0x08200000 and x['physical']+x['files']>0x08000000])
 ram=interval_bytes([(max(x['address'],0x24000000),min(x['address']+x['size'],0x24080000)) for x in elf.sections if x['flags']&2 and x['size'] and x['address']<0x24080000 and x['address']+x['size']>0x24000000])
 assert flash==metrics['flash']['loaded_bytes']
 assert ram==metrics['ram']['axi-sram']['reserved_bytes']
 return {'flash_load_bytes':flash,'axi_allocated_union_bytes':ram}

def writable_objects(elf):
 return {x['name']:x['size'] for x in elf.defined_symbols if x['type']==1 and 0x20000000<=x['value']<0x40000000}

def command(db,root,build):
 row=[x for x in db if x['file']==str(Path(root)/'soc/stm32h743/drivers/spi.c')];assert len(row)==1
 values=shlex.split(row[0]['command']);return [v.replace(build,'<BUILD>').replace(root,'<ROOT>') for v in values]

rows=[]
with zipfile.ZipFile(ZIP) as archive:
 prefix='build/qualification/h743-spi-s0-fixed-arm-r1/'
 baseline=json.loads(archive.read(prefix+'report.json'))
 assert baseline['status']=='passed' and baseline['source_before']['commit']=='df2835f59ba6cb76afe3536e3da9bdfca090cc21' and not baseline['source_before']['dirty']
 assert current['tools']['gcc']['sha256']==baseline['tools']['gcc']['sha256']
 oldroot=baseline['source_before']['root']
 for index,row in enumerate(current['fixtures']):
  elf=Elf32(read_artifact(row,'elf'));resource=json.loads(read_artifact(row,'resources'));metrics=independent_metrics(elf,resource['metrics'])
  helpers=sorted(x['name'] for x in elf.defined_symbols if x['type']==2 and x['name'].startswith('nx_stm32h743_spi_wire_'))
  objects=writable_objects(elf)
  selected=index<2
  database=json.loads(read_artifact(row,'compile_commands'))
  private_sources=[x['file'] for x in database if '/soc/stm32h743/drivers/spi' in x['file']]
  if selected:
   assert set(helpers)==expected and len(helpers)==12
   assert not any(x['type']==1 and x.get('file')=='spi_wire.c' for x in elf.defined_symbols)
   old=baseline['fixtures'][index];assert row['assembly']['sha256']==old['assembly']['sha256']
   assert row['configuration_sha256']==old['configuration_sha256']
   assert row['artifacts']['bindings']['sha256']==old['artifacts']['bindings']['sha256']
   def old_bytes(label):
    m=old['artifacts'][label];data=archive.read(str(Path(m['path']).relative_to(oldroot)));assert sha(data)==m['sha256'];return data
   oldelf=Elf32(old_bytes('elf'));oldmetrics=json.loads(old_bytes('resources'))['metrics'];oldvalues=independent_metrics(oldelf,oldmetrics)
   assert writable_objects(oldelf)==objects
   assert [x['file'] for x in database if x['file']==str(ROOT/'soc/stm32h743/drivers/spi_wire.c')]
   olddb=json.loads(old_bytes('compile_commands'));newbuild=str(Path(row['artifacts']['compile_commands']['path']).parent);oldbuild=str(Path(old['artifacts']['compile_commands']['path']).parent)
   assert command(database,str(ROOT),newbuild)==command(olddb,oldroot,oldbuild)
   cost={'baseline_elf_sha256':old['artifacts']['elf']['sha256'],'baseline_metrics':oldvalues,'flash_load_delta':metrics['flash_load_bytes']-oldvalues['flash_load_bytes'],'ram_delta':metrics['axi_allocated_union_bytes']-oldvalues['axi_allocated_union_bytes'],'same_authored_inputs':True,'same_resolved_configuration':True,'same_generated_bindings':True,'same_compiler_sha256':True,'same_polling_driver_compile_tokens_after_path_normalization':True,'writable_object_names_and_sizes_equal':True,'spi_port_state_bytes':objects['s_nx_port_bus4'],'spi_endpoint_state_bytes':objects['s_nx_endpoint_device4'],'spi_cs_state_bytes':objects['s_nx_cs_device4']}
  else:
   assert not helpers and not private_sources
   assert not any('spi_wire' in x['name'] or (x['binding']==1 and x['name'].startswith('nx_stm32h743_spi')) for x in elf.defined_symbols)
   assert not any('spi' in name for name in objects)
   cost={'baseline_empty_not_in_supplied_S0_zip':True,'strong_spi_driver_and_wire_symbols_absent':True,'private_spi_translation_units_not_selected':True,'spi_objects_absent':True}
  rows.append({'assembly':row['assembly'],'elf':row['artifacts']['elf'],'metrics':metrics,'selected_wire_helpers':helpers,'writable_object_bytes':objects,'comparison':cost,'gate_face_count':row['face_count'],'gate_method_count':row['method_count']})
 # The fourth profile uses the existing normal preset, not an invented owned fixture.
 high=ROOT/'build/fixture-io-evolution-h743-high-peripherals';elfpath=high/'bin/io_evolution_fixture.elf';elf=Elf32(elfpath.read_bytes());respath=elfpath.with_suffix('.resources.json');resource=json.loads(respath.read_text());assert resource['status']=='passed' and resource['violations']==[] and resource['elf']['sha256']==sha(elfpath.read_bytes())
 metric=independent_metrics(elf,resource['metrics']);oldelfdata=archive.read('build/fixture-io-evolution-h743-high-peripherals/bin/io_evolution_fixture.elf');oldelf=Elf32(oldelfdata);oldresource=json.loads(archive.read('build/fixture-io-evolution-h743-high-peripherals/bin/io_evolution_fixture.resources.json'));oldmetric=independent_metrics(oldelf,oldresource['metrics']);assert oldresource['elf']['sha256']==sha(oldelfdata)
 olddb=json.loads(archive.read('build/fixture-io-evolution-h743-high-peripherals/compile_commands.json'));newdb=json.loads((high/'compile_commands.json').read_text());assert command(newdb,str(ROOT),str(high))==command(olddb,oldroot,oldroot+'/build/fixture-io-evolution-h743-high-peripherals')
 assert writable_objects(elf)==writable_objects(oldelf)
 helpers=sorted(x['name'] for x in elf.defined_symbols if x['type']==2 and x['name'].startswith('nx_stm32h743_spi_wire_'));assert set(helpers)==expected
 for m in resource['configuration_inputs']:
  rel=m['label'];oldm=[x for x in oldresource['configuration_inputs'] if x['label']==rel];assert len(oldm)==1 and oldm[0]['file']['sha256']==m['file']['sha256']
 rows.append({'assembly':'cmake/package/verification/io_evolution/h743-high-peripherals.toml','preset':'fixture-io-evolution-h743-high-peripherals','elf':{'path':str(elfpath),'sha256':sha(elfpath.read_bytes()),'bytes':len(elfpath.read_bytes())},'metrics':metric,'selected_wire_helpers':helpers,'comparison':{'baseline_elf_sha256':sha(oldelfdata),'baseline_metrics':oldmetric,'flash_load_delta':metric['flash_load_bytes']-oldmetric['flash_load_bytes'],'ram_delta':metric['axi_allocated_union_bytes']-oldmetric['axi_allocated_union_bytes'],'same_authored_inputs':True,'same_polling_driver_compile_tokens_after_path_normalization':True,'writable_object_names_and_sizes_equal':True}})
result={'kind':'W1 independent linked-byte/cost postcheck','actual_status':'passed','qualification':False,'limitations':['ARM link/resource/retention only; binaries not run on target','No measured cycles, latency, stack high-water or electrical HIL','Installed clean SDK not executed by this feature','The added helper has a small measured Flash cost; no additional static RAM in these fixtures'],'baseline_zip_sha256':sha(ZIP.read_bytes()),'normal_fixed3_report_sha256':sha(current_path.read_bytes()),'rows':rows}
path=BASE/'arm-cost-retention-postcheck.json';path.write_text(json.dumps(result,indent=2)+'\n');print(json.dumps({'report':str(path),'sha256':sha(path.read_bytes()),'rows':[{k:x[k] for k in ('assembly','metrics','comparison')} for x in rows]},indent=2))
