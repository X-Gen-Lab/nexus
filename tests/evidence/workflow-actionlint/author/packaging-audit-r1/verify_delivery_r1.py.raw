from pathlib import Path
import gzip, hashlib, json, shutil, sys
sys.path.insert(0, '/tmp/nexus-workflow-actionlint-20261018-r1')
from author import ROOT, TMP, OUT, guard
sha = lambda data: hashlib.sha256(data).hexdigest()
state = guard()
freeze = json.loads((OUT / 'source-freeze-r3.json').read_text())
baseline = json.loads((OUT / 'baseline.json').read_text())
for row in freeze['sources']:
    data = (ROOT / row['path']).read_bytes()
    assert sha(data) == row['after']['sha256']
    assert len(data) == row['after']['bytes']
    assert (OUT / row['transport']).read_bytes() == data
    before = row['before']
    if not before.get('absent'):
        original = gzip.decompress((OUT / 'before' / (row['path'] + '.gz')).read_bytes())
        assert sha(original) == before['sha256'] and len(original) == before['bytes']
index = (ROOT / '.git/index').read_bytes()
assert sha(index) == baseline['index_sha256']
assert index == gzip.decompress((OUT / 'before/index.gz').read_bytes())
for row in baseline['unrelated_untracked']:
    data = (ROOT / row['path']).read_bytes()
    assert sha(data) == row['sha256'] and len(data) == row['bytes']
for name, expected in {
    'execution-evidence-r1.tar.gz': '2c39919f4522220935bead3a6653176b94dda6168488aed806ba22d3dbef3a7e',
    'execution-evidence-map-r1.json.gz': 'f3c6b92be0193b78e96395837e8ecf6a630588da87c08df4b36d8204141ecd20',
}.items():
    assert sha((OUT / name).read_bytes()) == expected
receipt = json.loads((TMP / 'runs/package-execution-r1.command.json').read_text())
assert receipt['exit_code'] == receipt['child_returncode'] == 1
assert receipt['outcome'] == 'completed' and receipt['withdrawal_complete']
for field in ('stdout', 'stderr'):
    row = receipt[field]
    data = Path(row['path']).read_bytes()
    assert sha(data) == row['sha256'] and len(data) == row['bytes']
assert b"'persistent_free': 66297856" in Path(receipt['stderr']['path']).read_bytes()
assert sum(p.stat().st_blocks * 512 for p in OUT.rglob('*') if p.is_file()) <= 6 * 1024**2
print(json.dumps({'kind': 'read_only_delivery_verification', 'source_count': len(freeze['sources']), 'source_freeze_sha256': sha((OUT / 'source-freeze-r3.json').read_bytes()), 'index_sha256': sha(index), 'unrelated_count': len(baseline['unrelated_untracked']), 'existing_archive_hash_verified': True, 'original_packaging_actual_exit': receipt['exit_code'], 'revised_feature_cap_bytes': 6 * 1024**2, 'guards': state}))
