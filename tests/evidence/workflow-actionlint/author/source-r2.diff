+            archive_root.mkdir(parents=True, exist_ok=True)
+            identity = str(time.time_ns()) + "-" + uuid.uuid4().hex
+            archive = archive_root / (identity + ".tar.gz")
+            with tarfile.open(archive, "w:gz") as content:
