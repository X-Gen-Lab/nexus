+                (asset["notice"], "LICENSE.txt", 0o644)):
+            fields(record, {"member", "bytes", "sha256", "mode"})
+            if record["member"] != member or record["mode"] != mode:
+                raise EvidenceError("invalid actionlint member or mode")
