  "architecture_findings": [
    {
      "area": "Authored configuration and immutable IR",
      "conclusion": "Ordinary rtc/lptim controller sections use the existing ControllerIR, claims graph, board/SoC route facts and resolver. RTC uses NoOptions; LPTIM adds a frozen LptimOptions(tick_hz). No parallel device namespace, registry or configuration authority was introduced. Schema semantic comparison shows only rtc/lptim properties added; all prior schema content is equal after ignoring object-key order."
    },
    {
      "area": "Rate and identity validation",
      "conclusion": "tick_hz is required and accepted only when type(value) is int and 1 <= value <= UINT32_MAX. Thus bool, float, negative, zero, overflow and strings are rejected. Kind/mode/platform/binding and duplicate physical controller claims are checked. Clock, RTC calendar and LPTIM counter are distinct domains; rates are explicit reference-model facts."
    },
    {
      "area": "Cold factory and generated lifecycle",
      "conclusion": "Existing pure class-local factory getters return static const faces with shared canonical ops and exact private state. Lookup never constructs, starts, advances time or allocates. Generated lifecycle constructs each state once then reopens through private start; prior accepted devices stop in reverse order. A failed stop returns before decrementing the retained initialization count, blocks start, and preserves cleanup duty until retry. No extra Native System was added."
    },
    {
      "area": "Conditional selection and empty cost",
      "conclusion": "Only selected RTC/LPTIM instances emit private state, const faces/ops and the private selected Core-time adapter. Empty assembly emits none of these symbols. The empty consumer still uses existing Core time/platform state; selected-zero does not mean total firmware RAM is zero."
    },
    {
      "area": "Capability units",
      "conclusion": "RTC uses occurrences (maximum 1); LPTIM uses ticks (maximum 65536), with no fixed byte width. MODEL is explicit and physical_qualified is false. No byte-count interpretation or real-time/low-power/MCU qualification is inferred."
    },
    {
      "area": "SDK mandatory closure",
      "conclusion": "Native descriptor owns all 13 required public/private/provider/Core-span/board/canonical TOML/C payloads. Explicit SDK namespace allowlist covers the four new canonical TOML/C inputs. Rehashed omission tests reject removed mandatory payloads rather than accepting a self-consistently edited SDK manifest."
    },
    {
      "area": "Unified Native versus ARM dispatch",
      "conclusion": "Preparation reads the authored backend to omit the ARM toolchain for Native; checking branches on resolved backend and also verifies Native SoC/CPU facts. Native requires a real host ELF and actual execution/nm observations. The ARM branch retains resources, ELF/BIN/map and existing retention validation. No fake ARM sidecars or ELF32 parser are applied to host ELF64."
    },
    {
      "area": "Actual table calls and read-only storage",
      "conclusion": "Linux canonical pair checks complete face and ops spans against /proc/self/maps, requiring readable/non-writable mappings. Independent bounded objdump inspection of the actual installed pair found nx_rtc_port_read at 0x349e ending in indirect jmp *%rax at 0x34db and nx_lptim_port_submit at 0x37ae ending in indirect jmp *%rax at 0x37e7. This supports actual ABI table dispatch, while /proc evidence is Linux-host specific."
    }
  ],
  "actual_scenarios_reviewed": {
    "pair": [
      "Two RTC and two LPTIM controllers; class-local getters, distinct state and shared ops identity; invalid IDs return NULL.",
      "RTC initially unset; explicit set and leap-day transition; independent calendars.",
      "Counter rates 32768 and 1000; full 65536-tick request; final progress and request settlement.",
      "Held stop retains quarantine and rejects reopen; real source advance and service permit cancellation settlement and cleanup retry.",
      "Reopen preserves date/rate/identity, rejects stale request epochs, then accepts explicitly prepared new requests.",
      "Finite deadline through explicit Core model clock; accepted requests settle before final stop and model clock withdrawal."
    ],
    "empty": [
      "No RTC/LPTIM selected capabilities, faces, private state, ops or selected clock adapter.",
      "Real zero-selection Platform start/stop/reopen path; existing Core clock remains the explicit unrelated time source."
    ],
