#!/usr/bin/env python3
"""Development-only actual G474 factory execution capture, never source mutation."""
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

ROOT = Path('/workspace/nexus')
OUT = Path('/workspace/nexus-g474-iteration-evidence')
BUILD = OUT / 'host-build'

def ident(path):
    path = Path(path)
    raw = path.read_bytes()
    return {'path': str(path), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}

def write(path, value):
    Path(path).write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')

def snapshot():
    paths = {ROOT/'CMakeLists.txt', ROOT/'tests/google/CMakeLists.txt',
             ROOT/'tests/google/g474_factory.cmake', ROOT/'tests/google/g474_factory_test.cpp',
             ROOT/'tests/google/g474_factory_model.h', ROOT/'tests/contracts/g474_model.h',
             ROOT/'tests/contracts/g474_model.c'}
    for rel in ('core','arch','io','os/freertos','soc/stm32g474','boards/stm32g474re_hse24_reference',
                'tests/contracts/g474_assembly','tools/configure','tools/measurement','cmake'):
        for p in (ROOT/rel).rglob('*'):
            if p.is_file() and p.suffix in {'.c','.h','.S','.s','.cmake','.json','.toml','.py','.txt'} and '__pycache__' not in p.parts and not p.name.startswith('test_'):
                paths.add(p)
    paths.update((ROOT/'dependencies').glob('*.json'))
    paths.add(ROOT/'tools/maintenance/stm32g4_lock.py')
    paths.add(ROOT/'dependencies/source/googletest-1.16.0.tar.gz')
    paths = {p for p in paths if p.is_file()}
    return [ident(p) for p in sorted(paths)]

def main():
    phase = sys.argv[1]
    destination = OUT / phase
    destination.mkdir(exist_ok=False)
    before = snapshot()
    write(destination/'source-before.json', before)
    env = {k:v for k,v in os.environ.items() if not k.startswith('GTEST_')}
    env['PATH'] = str(ROOT/'.venv/bin') + os.pathsep + env.get('PATH','')
    commands = []
    report = {'schema_version':1,'kind':'g474-factory-development-execution',
              'scope':'Actual production factory/system/provider host execution. Scoped dirty development input capture, not complete clean software candidate or physical qualification.',
              'physical_status':'not_executed','status':'failed','commands':commands,
              'driver':ident(__file__),'source_before':ident(destination/'source-before.json')}
    def run(name, argv):
        started = time.time_ns()
        log = destination/(name+'.output')
        with log.open('xb') as stream:
            result = subprocess.run(argv,cwd=ROOT,env=env,stdout=stream,stderr=subprocess.STDOUT,timeout=180)
        command={'argv':argv,'return_code':result.returncode,'started_ns':started,
                 'completed_ns':time.time_ns(),'output':ident(log)}
        commands.append(command)
        write(destination/'commands.json',commands)
        return command
    try:
        result = run('build',[str(ROOT/'.venv/bin/cmake'),'--build',str(BUILD),'--target','nexus_g474_factory_test','--parallel','1'])
        if result['return_code']:
            raise ValueError('Actual build failed')
        binary = BUILD/'bin/nexus_g474_factory_test'
        report['executable'] = ident(binary)
        result = run('discovery',[str(binary),'--gtest_filter=*','--gtest_list_tests'])
        if result['return_code']:
            raise ValueError('Actual discovery failed')
        expected=[]
        suite=None
        for line in Path(result['output']['path']).read_text().splitlines():
            if line and not line.startswith(' ') and line.endswith('.'):
                suite=line.strip()
            elif suite and line.startswith('  '):
                expected.append(suite+line.strip())
        if not expected:
            raise ValueError('Zero Google cases')
        report['discovered_cases']=expected
        xml=destination/'google.xml'
        result=run('execution',[str(binary),'--gtest_filter=*','--gtest_repeat=1','--gtest_also_run_disabled_tests','--gtest_output=xml:'+str(xml)])
        report['xml']=ident(xml)
        tree=ET.parse(xml).getroot()
        cases=list(tree.iter('testcase'))
        actual=[c.attrib['classname']+'.'+c.attrib['name'] for c in cases]
        if actual!=expected or any(c.get('status')!='run' or c.get('result')!='completed' for c in cases):
            raise ValueError('Actual full Google case execution differs from discovery')
        report['google']={key:int(tree.get(key,'0')) for key in ('tests','failures','disabled','errors')}
        report['google']['skipped']=sum(1 for c in cases if c.find('skipped') is not None)
        if result['return_code'] or report['google']['failures'] or report['google']['errors'] or report['google']['skipped']:
            raise ValueError('Actual Google behavior failed')
        report['status']='passed'
    except (ValueError,OSError,subprocess.TimeoutExpired) as error:
        report['error']=str(error)
    after=snapshot()
    write(destination/'source-after.json',after)
    report['source_after']=ident(destination/'source-after.json')
    report['source_unchanged']=before==after
    if not report['source_unchanged']:
        report['status']='failed'
        report['source_change_error']='Scoped captured inputs changed during execution'
    write(destination/'manifest.json',report)
    print(json.dumps({'status':report['status'],'source_unchanged':report['source_unchanged'],'google':report.get('google'),'manifest':str(destination/'manifest.json')}))
    return 0 if report['status']=='passed' else 1

if __name__=='__main__':
    raise SystemExit(main())
