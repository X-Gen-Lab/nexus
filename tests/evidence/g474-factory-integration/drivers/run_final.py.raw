#!/usr/bin/env python3
"""Fresh final-scope G474 Google execution; historical captures stay unchanged."""
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

spec=importlib.util.spec_from_file_location('g4_capture', '/workspace/nexus-g474-iteration-evidence/run_phase.py')
helper=importlib.util.module_from_spec(spec)
spec.loader.exec_module(helper)
ROOT=helper.ROOT
OUT=helper.OUT


def main():
    phase=sys.argv[1]
    sanitized=sys.argv[2]=='sanitizer'
    destination=OUT/phase
    destination.mkdir(exist_ok=False)
    build=OUT/('host-asan-build' if sanitized else 'host-build')
    targets=['nexus_g474_factory_test'] if sanitized else ['nexus_g474_factory_test','nexus_g474_system_test','nexus_g474_provider_test']
    def snapshot():
        existing={entry['path'] for entry in helper.snapshot()}
        existing.update(str(ROOT/'tests/google'/name) for name in ('g474.cmake','g474_system_test.cpp','g474_provider_test.cpp'))
        lock=json.loads((ROOT/'dependencies/stm32g4.lock.json').read_text())
        existing.update(str(ROOT/'vendors/st/cmsis_device_g4'/name) for name in lock['files'])
        existing.update(str(p) for p in (ROOT/'vendors/arm/CMSIS_5/CMSIS/Core/Include').rglob('*.h'))
        return [helper.ident(p) for p in sorted(existing)]
    before=snapshot()
    helper.write(destination/'source-before.json',before)
    env={k:v for k,v in os.environ.items() if not k.startswith('GTEST_')}
    env['PATH']=str(ROOT/'.venv/bin')+os.pathsep+env.get('PATH','')
    commands=[]
    report={'schema_version':1,'kind':'g474-final-google-development-execution','status':'failed',
            'scope':'Fresh actual factory/system/provider Google execution on scoped stable dirty development inputs. Host sanitizers do not establish ARM execution or physical hardware timing.',
            'sanitizer':sanitized,'physical_status':'not_executed','commands':commands,'rows':[],
            'driver':helper.ident(__file__),'helper':helper.ident(helper.__file__),
            'source_before':helper.ident(destination/'source-before.json')}
    def run(name,argv):
        log=destination/(name+'.output')
        started=time.time_ns()
        with log.open('xb') as stream:
            result=subprocess.run(argv,cwd=ROOT,env=env,stdout=stream,stderr=subprocess.STDOUT,timeout=180)
        item={'argv':argv,'return_code':result.returncode,'started_ns':started,'completed_ns':time.time_ns(),'output':helper.ident(log)}
        commands.append(item)
        helper.write(destination/'commands.json',commands)
        if result.returncode:
            raise ValueError('Actual command failed: '+str(log))
        return item
    try:
        run('build',[str(ROOT/'.venv/bin/cmake'),'--build',str(build),'--target',*targets,'--parallel','1'])
        for target in targets:
            binary=build/'bin'/target
            saved=destination/(target+'.executable')
            shutil.copyfile(binary,saved)
            if helper.ident(saved)['sha256']!=helper.ident(binary)['sha256']:
                raise ValueError('Preserved executable differs before actual execution')
            row={'target':target,'executable':helper.ident(saved),'executed_path':str(binary)}
            report['rows'].append(row)
            discovery=run(target+'-discovery',[str(binary),'--gtest_filter=*','--gtest_list_tests'])
            expected=[]
            suite=None
            for line in Path(discovery['output']['path']).read_text().splitlines():
                if line and not line.startswith(' ') and line.endswith('.'):
                    suite=line.strip()
                elif suite and line.startswith('  '):
                    expected.append(suite+line.strip())
            if not expected:
                raise ValueError('No Google cases discovered')
            row['discovered_cases']=expected
            xml=destination/(target+'.xml')
            run(target+'-execution',[str(binary),'--gtest_filter=*','--gtest_repeat=1','--gtest_also_run_disabled_tests','--gtest_output=xml:'+str(xml)])
            row['xml']=helper.ident(xml)
            root=ET.parse(xml).getroot()
            cases=list(root.iter('testcase'))
            actual=[c.attrib['classname']+'.'+c.attrib['name'] for c in cases]
            if actual!=expected or any(c.get('status')!='run' or c.get('result')!='completed' or c.find('skipped') is not None or c.find('failure') is not None for c in cases):
                raise ValueError('Complete fresh Google execution did not match discovery')
            row['google']={key:int(root.get(key,'0')) for key in ('tests','failures','disabled','errors')}
            row['google']['skipped']=0
            if row['google']['tests']!=len(expected) or any(row['google'][key] for key in ('failures','errors','skipped')):
                raise ValueError('Nonzero Google failure/skip or wrong count')
            row['status']='passed'
        generated=build/'tests/contracts/google/g474-factory'
        saved=destination/'generated'
        shutil.copytree(generated,saved)
        report['generated_bundle']=[helper.ident(p) for p in sorted(saved.rglob('*')) if p.is_file()]
        report['status']='passed'
    except (ValueError,OSError,subprocess.TimeoutExpired) as error:
        report['error']=str(error)
    after=snapshot()
    helper.write(destination/'source-after.json',after)
    report['source_after']=helper.ident(destination/'source-after.json')
    report['source_unchanged']=before==after
    if before!=after:
        report['status']='failed'
        report['source_change_error']='Scoped captured inputs changed during actual execution'
    helper.write(destination/'manifest.json',report)
    print(json.dumps({'status':report['status'],'source_unchanged':report['source_unchanged'],'rows':[(r['target'],r.get('google')) for r in report['rows']],'manifest':str(destination/'manifest.json')}))
    return 0 if report['status']=='passed' else 1

if __name__=='__main__':
    raise SystemExit(main())
