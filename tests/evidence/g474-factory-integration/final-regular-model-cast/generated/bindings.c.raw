#include "nexus_config.h"
#include "nexus/arch/arch.h"
#ifndef NX_PLATFORM_REGISTER_WRITE
#define NX_PLATFORM_REGISTER_WRITE(reg, value) ((reg) = (uint32_t)(value))
#endif
#ifndef NX_PLATFORM_PRIORITY_WRITE
#define NX_PLATFORM_PRIORITY_WRITE(reg, value) ((reg) = (uint8_t)(value))
#endif
#include "stm32g474_provider.h"
void _init(void);
void _fini(void);
/** \brief C runtime hooks; constructors use .init_array. */
void _init(void) {}
void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static uint32_t s_nx_platform_gpio_clocks_added;
static struct {
    uint32_t mode, type, speed, pull, af, odr;
    bool captured;
 } s_nx_gpioa_lease;
static uint32_t s_nx_platform_uart_clocks_added;
static nx_result_t restore_gpioa(void) {
    if (!s_nx_gpioa_lease.captured) { return NX_SUCCESS; }
    NX_G474_WRITE(&GPIOA->MODER, (NX_G474_READ(&GPIOA->MODER) & ~3312u) | 3312u);
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->MODER) & 3312u) != 3312u) { return NX_ERROR_IO; }
    NX_G474_WRITE(&GPIOA->BSRR, s_nx_gpioa_lease.odr | ((44u & ~s_nx_gpioa_lease.odr) << 16u));
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->ODR) & 44u) != s_nx_gpioa_lease.odr) { return NX_ERROR_IO; }
    NX_G474_WRITE(&GPIOA->AFR[0], (NX_G474_READ(&GPIOA->AFR[0]) & ~15793920u) | s_nx_gpioa_lease.af);
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->AFR[0]) & 15793920u) != s_nx_gpioa_lease.af) { return NX_ERROR_IO; }
    NX_G474_WRITE(&GPIOA->OTYPER, (NX_G474_READ(&GPIOA->OTYPER) & ~44u) | s_nx_gpioa_lease.type);
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->OTYPER) & 44u) != s_nx_gpioa_lease.type) { return NX_ERROR_IO; }
    NX_G474_WRITE(&GPIOA->OSPEEDR, (NX_G474_READ(&GPIOA->OSPEEDR) & ~3312u) | s_nx_gpioa_lease.speed);
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->OSPEEDR) & 3312u) != s_nx_gpioa_lease.speed) { return NX_ERROR_IO; }
    NX_G474_WRITE(&GPIOA->PUPDR, (NX_G474_READ(&GPIOA->PUPDR) & ~3312u) | s_nx_gpioa_lease.pull);
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->PUPDR) & 3312u) != s_nx_gpioa_lease.pull) { return NX_ERROR_IO; }
    NX_G474_WRITE(&GPIOA->MODER, (NX_G474_READ(&GPIOA->MODER) & ~3312u) | s_nx_gpioa_lease.mode);
    nx_arch_dsb();
    if ((NX_G474_READ(&GPIOA->MODER) & 3312u) != s_nx_gpioa_lease.mode) { return NX_ERROR_IO; }
    s_nx_gpioa_lease.captured = false;
    return NX_SUCCESS;
}
static nx_stm32g474_gpio_state_t s_nx_port_led;
static const nx_gpio_port_t s_nx_face_led = {
    &nx_stm32g474_gpio_ops, &s_nx_port_led
};
const nx_gpio_port_t* const nx_binding_led = &s_nx_face_led;
static nx_result_t prepare_led(void) {
    if (s_nx_port_led.retained || s_nx_port_led.initialized) { return NX_ERROR_BUSY; }
    s_nx_port_led.registers = GPIOA;
    s_nx_port_led.mask = 32u;
    s_nx_port_led.output = true;
    return nx_stm32g474_gpio_initialize(&s_nx_port_led, 0u);
}
static nx_stm32g474_uart_state_t s_nx_port_console;
static const nx_uart_port_t s_nx_face_console = {
    &nx_stm32g474_uart_ops, &s_nx_port_console
};
const nx_uart_port_t* const nx_binding_console = &s_nx_face_console;
static uint8_t s_nx_rx_console[64];
static nx_result_t prepare_console(void) {
    if (s_nx_port_console.retained || s_nx_port_console.initialized || s_nx_port_console.active != NULL || s_nx_port_console.wake != NULL || s_nx_port_console.wake_publishers != 0u) { return NX_ERROR_BUSY; }
    s_nx_port_console.registers = LPUART1;
    s_nx_port_console.rx_storage = s_nx_rx_console;
    s_nx_port_console.rx_capacity = 64u;
    s_nx_port_console.baud = 115200u;
    s_nx_port_console.irq = LPUART1_IRQn;
    s_nx_port_console.profile = NX_UART_RX_BYTES;
    s_nx_port_console.irq_policy = (nx_irq_policy_t){ NX_IRQ_KERNEL_NONE, 102u, 4u, 0u };
    nx_result_t status = nx_stm32g474_lpuart1_pins_prepare();
    if (status != NX_SUCCESS) { return status; }
    return nx_stm32g474_uart_initialize(&s_nx_port_console, 170000000u, 1000000u);
}
void LPUART1_IRQHandler(void);
/** \brief One selected controller, at most one TX/RX byte. */
void LPUART1_IRQHandler(void) { nx_stm32g474_uart_irq(&s_nx_port_console); }
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 2u) {
        nx_result_t status_0 = nx_uart_port_stop(&s_nx_face_console);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 1u;
    }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = nx_stm32g474_gpio_stop(&s_nx_port_led, 0u);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started) {
        nx_result_t restored = restore_gpioa();
        if (restored != NX_SUCCESS) { return restored; }
        NX_G474_WRITE(&RCC->APB1ENR2, NX_G474_READ(&RCC->APB1ENR2) & ~s_nx_platform_uart_clocks_added);
        nx_arch_dsb();
        if ((NX_G474_READ(&RCC->APB1ENR2) & s_nx_platform_uart_clocks_added) != 0u) { return NX_ERROR_IO; }
        s_nx_platform_uart_clocks_added = 0u;
        NX_G474_WRITE(&RCC->AHB2ENR, NX_G474_READ(&RCC->AHB2ENR) & ~s_nx_platform_gpio_clocks_added);
        nx_arch_dsb();
        if ((NX_G474_READ(&RCC->AHB2ENR) & s_nx_platform_gpio_clocks_added) != 0u) { return NX_ERROR_IO; }
        s_nx_platform_gpio_clocks_added = 0u;
    }
    if (s_nx_platform_started) {
        nx_result_t system = nx_stm32g474_system_stop(&g_nx_stm32g474_system, 1000000u);
        if (system != NX_SUCCESS) { return system; }
    }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    if (!nx_arch_is_privileged()) { result.primary = NX_ERROR_CONTEXT; return result; }
    if ((NX_G474_READ(&RCC->APB1ENR2) & RCC_APB1ENR2_LPUART1EN) != 0u && (NX_G474_READ(&LPUART1->CR1) != 0u || NX_G474_READ(&LPUART1->CR3) != 0u)) {
        result.primary = NX_ERROR_BUSY; return result;
    }
    result.primary = nx_stm32g474_validate_identity();
    if (result.primary != NX_SUCCESS) { return result; }
    nx_stm32g474_start_result_t system = nx_stm32g474_system_start(&g_nx_stm32g474_system, 1000000u);
    if (system.primary != NX_SUCCESS) {
        result.primary = system.primary;
        result.cleanup = system.cleanup;
        result.remaining_effects = system.remaining_effects;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    s_nx_gpioa_lease.captured = false;
    s_nx_platform_gpio_clocks_added = ~NX_G474_READ(&RCC->AHB2ENR) & RCC_AHB2ENR_GPIOAEN;
    s_nx_platform_uart_clocks_added = ~NX_G474_READ(&RCC->APB1ENR2) & RCC_APB1ENR2_LPUART1EN;
    result.primary = nx_stm32g474_gpio_clock_enable(0u);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_gpioa_lease.mode = NX_G474_READ(&GPIOA->MODER) & 3312u;
    s_nx_gpioa_lease.type = NX_G474_READ(&GPIOA->OTYPER) & 44u;
    s_nx_gpioa_lease.speed = NX_G474_READ(&GPIOA->OSPEEDR) & 3312u;
    s_nx_gpioa_lease.pull = NX_G474_READ(&GPIOA->PUPDR) & 3312u;
    s_nx_gpioa_lease.af = NX_G474_READ(&GPIOA->AFR[0]) & 15793920u;
    s_nx_gpioa_lease.odr = NX_G474_READ(&GPIOA->ODR) & 44u;
    s_nx_gpioa_lease.captured = true;
    s_nx_platform_initialized = 1u;
    result.primary = prepare_led();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    s_nx_platform_initialized = 2u;
    result.primary = prepare_console();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 2u;
    return result;
}

/** \brief Pure typed lookup; lifecycle remains explicit. */
const nx_gpio_port_t* nx_factory_gpio(nx_gpio_id_t id) {
    switch (id) {
        case NX_GPIO_ID_LED:
            return nx_binding_led;
        default:
            return NULL;
    }
}
