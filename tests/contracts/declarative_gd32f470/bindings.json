{
  "schema_version": 1,
  "custom_clock_profile": "custom",
  "system": {
    "oscillator_resources": {},
    "timebase": {
      "timer": "TIMER1",
      "irq": "TIMER1_IRQn",
      "gate": "RCU_APB1EN_TIMER1EN",
      "reset": "RCU_APB1RST_TIMER1RST",
      "handler": "TIMER1_IRQHandler",
      "clock_domain": "apb1_timer",
      "counter_bits": 32
    }
  },
  "mode_exclusions": [],
  "software": {
    "enum_abi": "short-enums",
    "backends": [
      "baremetal"
    ],
    "headers": [
      "gd32_reference.h"
    ],
    "bindings": [
      {
        "kind": "gpio",
        "mode": "output",
        "implementation": "gpio",
        "state_type": "nx_gd32_gpio_state_t",
        "config_type": "nx_gd32_gpio_config_t",
        "ops": "nx_gd32_gpio_ops",
        "prepare": "nx_gd32_gpio_prepare",
        "close": "nx_gd32_gpio_close",
        "fields": [
          {
            "name": "registers",
            "source": "controller",
            "type": "symbol"
          },
          {
            "name": "mask",
            "source": "options.mask",
            "type": "u32"
          },
          {
            "name": "initial",
            "source": "options.initial",
            "type": "u32"
          }
        ],
        "admit": "nx_gd32_gpio_admit"
      },
      {
        "kind": "uart",
        "mode": "irq-byte-event",
        "implementation": "uart",
        "state_type": "nx_gd32_uart_state_t",
        "config_type": "nx_gd32_uart_config_t",
        "ops": "nx_gd32_uart_ops",
        "prepare": "nx_gd32_uart_prepare",
        "close": "nx_gd32_uart_close",
        "irq": "nx_gd32_uart_irq",
        "validator": "nx_gd32_uart_validate",
        "storage": [
          {
            "name": "rx",
            "type": "nx_uart_rx_event_t",
            "count": "options.rx_capacity"
          }
        ],
        "fields": [
          {
            "name": "registers",
            "source": "controller",
            "type": "symbol"
          },
          {
            "name": "baud",
            "source": "options.baud",
            "type": "u32"
          },
          {
            "name": "rx_storage",
            "source": "storage.rx",
            "type": "symbol"
          },
          {
            "name": "rx_capacity",
            "source": "options.rx_capacity",
            "type": "u32"
          },
          {
            "name": "priority",
            "source": "options.irq.priority",
            "type": "u32"
          }
        ],
        "admit": "nx_gd32_uart_admit",
        "limits": {
          "baud": [
            1200,
            1000000
          ]
        }
      }
    ],
    "platform": {
      "system_start": "nx_gd32_system_start",
      "resources_acquire": "nx_gd32_resources_acquire",
      "resources_resume": "nx_gd32_resources_acquire",
      "resources_release": "nx_gd32_resources_release",
      "system_release": "nx_gd32_system_release"
    }
  },
