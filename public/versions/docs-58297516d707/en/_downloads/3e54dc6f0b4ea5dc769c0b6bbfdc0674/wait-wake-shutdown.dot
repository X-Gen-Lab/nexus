// FIG-08 current: source-backed, scoped engineering view.
// Code basis: 0111c8d3b9c7b37d258b9c401070305b13b6f3a1.
// Relations and qualification limits are documented in README.md.
digraph WaitWakeShutdown {
    graph [newrank=true, rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.42,
           ranksep=0.66, fontname="Noto Sans CJK SC", fontsize=15,
           labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC",
          fontsize=13, margin="0.18,0.12"];
    edge [color="#475569", fontcolor="#0f172a",
          fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];

    graph [label="FIG-08 Predicate wait 与外部 shutdown 责任
通知只提示重查；等待本身不推进硬件\nFIG-08 Predicate wait and external shutdown\na notification is a hint, not hardware progress"];
    subgraph clusterWait {
        label="nx_wait_until：Task / 单 waiter\nnx_wait_until: task, one waiter"; color="#64748b";
        ready1 [label="ready(context) 权威谓词\nready(context): authoritative predicate"];
        arm [label="port.arm() 捕获 sequence\nport.arm(): capture notification sequence"];
        ready2 [label="再次 ready(context)\nready(context): recheck after arm"];
        wait [label="port.wait(sequence, absolute deadline)
后端检查 sequence / deadline\nbackend checks sequence / absolute deadline"];
        ready3 [label="wait error / TIMEOUT 后最终 ready\nfinal ready check after error / TIMEOUT"];
        success [label="谓词 true → SUCCESS\npredicate true -> SUCCESS", fillcolor="#f0fdf4"];
        error [label="谓词仍 false → 真实 port error\npredicate false -> actual port error", fillcolor="#fff7ed"];
        ready1 -> success [label="true"];
        ready1 -> arm [label="false"];
        arm -> ready2 [label="已 arm\narmed"];
        ready2 -> success [label="true"];
        ready2 -> wait [label="false"];
        wait -> ready1 [label="SUCCESS hint：循环重查\nSUCCESS hint: repeat predicate check", constraint=false];
        wait -> ready3 [label="error / TIMEOUT"];
        ready3 -> success [label="并发完成已可见\nconcurrent completion visible"];
        ready3 -> error [label="仍未完成\ncompletion not observed"];
    }
    executor [label="唯一 executor：service / drain
IRQ：latched facts + wake hint\none executor: service / drain\nIRQ: latched facts and wake hint", fillcolor="#fefce8"];
    executor -> wait [label="wake(sequence) 提示\nwake(sequence): hint", style=dashed];
    executor -> ready1 [label="release publication → acquire observation", style=dashed];
    subgraph clusterShutdown {
        label="应用拥有的退出顺序（不是 wait 隐式行为）\napplication-owned shutdown, not implicit wait"; color="#64748b";
        close [label="1 关闭 producer admission\nowner stop 请求已接受操作取消\n1 close admission; owner stop requests cancellation"];
        drain [label="2 保持 owner / IRQ service 与 drain\nproducer / observer 仅 acquire 观察 SETTLED\n2 keep owner / IRQ service and drain progressing\nproducer / observer only acquire-observe SETTLED"];
        producerJoin [label="3 producer 借用已结清后 join\n相关 observers 最终访问另需退出\n3 join producer after its borrow drains\nrelated observers must finish their final access"];
        join [label="4 确认 owner idle 含 publication 退出\n请求 owner 执行者结束并 join\n4 prove owner idle including publication exit\nrequest executor to finish, then join"];
        hardware [label="5 硬件 RX / IRQ publishers quiescent\ndetach wake，再 join 其他发布者\n5 prove hardware RX / IRQ publishers quiescent\ndetach wake, then join other publishers"];
        stop [label="6 最后销毁 notification / queue / guard\n仍运行内核保留 platform clock / Tick\n6 finally destroy notification / queue / guard\nretain platform clock / Tick for a running kernel"];
        keep [label="drain / join / quiesce 失败：存储责任保留\n外部政策决定升级；不强制释放\nfailed drain / join / quiesce retains storage\nexternal escalation, no forced reclaim", fillcolor="#fff7ed"];
        close -> drain [label="不再产生新工作\nno new producer work"];
        drain -> producerJoin [label="实际 SETTLED 与 observer 退出\nactual settlement and observer exit"];
        producerJoin -> join [label="producer 最终访问结束\nproducer final access ended"];
        join -> hardware [label="owner execution 已退出\nowner executor has exited"];
        hardware -> stop [label="publishers 全部退出\nall publishers have exited"];
        drain -> keep [label="未排空\nnot drained"];
        join -> keep [label="未 join\nnot joined"];
        hardware -> keep [label="仍有 publisher\npublisher remains active"];
    }
    executor -> drain [label="继续推进\nkeep executing", style=dashed];
}
