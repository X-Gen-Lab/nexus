// FIG-03 current: build-time inputs and artifacts.
// Code basis: 0111c8d3b9c7b37d258b9c401070305b13b6f3a1.
// Edges denote configuration/production flow, not runtime I/O.
digraph configurationGeneration {
    graph [label="FIG-03 当前配置与原子生成\nFIG-03 Current configuration and generation", fontname="Noto Sans CJK SC", fontsize=15, labelloc=t, rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.30, ranksep=0.50];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC",
          fontsize=13, margin="0.16,0.10"];
    edge [color="#475569", fontcolor="#0f172a",
          fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
    assembly [label="一份 authored TOML\none authored TOML assembly", fillcolor="#f8fafc"];
    socFacts [label="SoC / CPU / routes 事实\nSoC / CPU / route facts", fillcolor="#f8fafc"];
    boardFacts [label="Board 接线与来源事实\nBoard wiring and provenance", fillcolor="#f8fafc"];
    resolver [label="严格解析：字段、模式、资源、输入身份\nstrict field / mode / resource / identity checks"];
    typedIr [label="不可变 typed IR\nimmutable typed IR"];
    bundle [label="事务生成与原子发布\ntransactional generation and atomic publish"];
    outputs [label="静态实例 / factory / 配置 / 内存预算\nstatic instances / factory / config / budgets"];
    targets [label="CMake：唯一软件目标图\nCMake: sole software target graph"];
    ninja [label="Ninja：编译、链接、资源检查\nNinja: compile / link / resource checks"];
    firmware [label="ELF / BIN / map / 资源报告\nELF / BIN / map / resource reports", fillcolor="#f0fdf4"];
    rejected [label="拒绝 / 生成失败\nrejected input or generation failure", fillcolor="#fff7ed"];
    invalidated [label="owned bundle 失效，不暴露半成品\ninvalidate owned bundle, no partial outputs", fillcolor="#fff7ed"];
    assembly -> resolver [label="产品选择\nproduct selection"];
    socFacts -> resolver [label="芯片能力\nsilicon capability"];
    boardFacts -> resolver [label="Board 授权\nBoard authorization"];
    resolver -> typedIr [label="验证通过\nvalidated"];
    typedIr -> bundle [label="生成选定内容\ngenerate selected content"];
    bundle -> outputs [label="成功发布\natomic publish"];
    outputs -> targets [label="配置与生成源\nconfiguration and generated sources"];
    targets -> ninja [label="执行目标图\nexecute target graph"];
    ninja -> firmware [label="本次实际产物\nactual artifacts of this execution"];
    resolver -> rejected [label="非法 / 冲突 / 变化\ninvalid / conflict / input changed"];
    bundle -> rejected [label="生成或发布失败\ngeneration or publish failure"];
    rejected -> invalidated [label="仅清理拥有的输出\ninvalidate owned outputs only"];
}
