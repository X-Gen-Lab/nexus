// FIG-04 reference: source-backed, scoped engineering view.
// Code basis: 0111c8d3b9c7b37d258b9c401070305b13b6f3a1.
// Relations and qualification limits are documented in README.md.
digraph FactoryInstances {
    graph [newrank=true, rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.42,
           ranksep=0.66, fontname="Noto Sans CJK SC", fontsize=15,
           labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC",
          fontsize=13, margin="0.18,0.12"];
    edge [color="#475569", fontcolor="#0f172a",
          fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];

    graph [label="FIG-04 静态实例与共享多态表
示例结构：两个同类实例 + controller / endpoint 分离\nFIG-04 Static instances and shared ops\nreference layout; controller != endpoint"];
    caller [label="应用：assembly-local typed ID\napplication: assembly-local typed ID", fillcolor="#f8fafc"];
    factory [label="typed factory
有界 switch → 既有 const face
非法 ID → NULL；不初始化、不分配\nbounded lookup of an existing readonly face\ninvalid ID -> NULL; no allocation or startup"];
    subgraph clusterUart {
        label="按配置选入的 UART 实例\nUART instances selected by assembly"; color="#64748b";
        faceA [label="const UART face A
ops* + context*"];
        faceB [label="const UART face B
ops* + context*"];
        ops [label="const 同模式 UART ops
同 provider 共享一份\none shared ops table per provider / mode", fillcolor="#fefce8"];
        stateA [label="私有 state A
独立 active 引用 / RX storage\nprivate state A: own active ref / RX storage"];
        stateB [label="私有 state B
独立 active 引用 / RX storage\nprivate state B: own active ref / RX storage"];
        { rank=same; faceA; faceB; }
        { rank=same; stateA; stateB; }
    }
    subgraph clusterBus {
        label="总线身份：独立 factory 类与命名空间\nseparate controller and endpoint namespaces"; color="#64748b";
        controller [label="SPI controller face
真正控制器状态 / recovery\nreal controller state and recovery"];
        endpoint [label="SPI device endpoint face
CS / mode / 频率 + controller 引用\nCS / mode / frequency / controller reference"];
        i2c [label="I2C 同样分开
controller 与 address endpoint\nI2C: controller != address endpoint"];
    }
    caller -> factory [label="查找（不是热路径每次调用）\nlookup, outside ordinary I/O hot path"];
    factory -> faceA [label="返回既有引用\nexisting face reference"];
    factory -> faceB [label="返回既有引用\nexisting face reference"];
    faceA -> ops [label="只读 ops 引用\nreadonly ops reference"];
    faceB -> ops [label="只读 ops 引用\nreadonly ops reference"];
    faceA -> stateA [label="独立 context 引用\nper-instance context"];
    faceB -> stateB [label="独立 context 引用\nper-instance context"];
    ops -> stateA [label="方法接收本次 context\nmethod receives this context", style=dashed];
    ops -> stateB [label="方法接收本次 context\nmethod receives this context", style=dashed];
    factory -> controller [label="controller ID"];
    factory -> endpoint [label="device ID"];
    endpoint -> controller [label="实际总线引用 / admission\nactual controller reference / admission"];
    endpoint -> i2c [style=invis];
}
