// FIG-10 current: source-backed, scoped engineering view.
// Code basis: 0111c8d3b9c7b37d258b9c401070305b13b6f3a1.
// Relations and qualification limits are documented in README.md.
digraph SourceSdkConsumer {
    graph [newrank=true, rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.42,
           ranksep=0.66, fontname="Noto Sans CJK SC", fontsize=15,
           labelloc=t];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontcolor="#0f172a", fontname="Noto Sans CJK SC",
          fontsize=13, margin="0.18,0.12"];
    edge [color="#475569", fontcolor="#0f172a",
          fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];

    graph [label="FIG-10 Source SDK 独立消费\n搬移完整 prefix；Native 运行与 ARM 链接分别验证"];
    source [label="clean Git source + 锁定依赖 / 许可\n开发 fixture 必须显式 opt-in", fillcolor="#f8fafc"];
    package [label="package_source_sdk.prepare / verify\n安装 prefix + manifest + 必需文件闭包"];
    move [label="移动完整 prefix 到独立路径\n不只移动 share/nexus/src"];
    consumer [label="独立 consumer source / build\nfind_package(Nexus EXACT CONFIG REQUIRED)\n外部 NEXUS_ASSEMBLY_FILE"];
    verify [label="SDK.cmake / resolver 边界 verify\n实际文件 hash / source / 依赖 / closure"];
    target [label="nexus_add_firmware()\n公共 Nexus targets；SDK/provider headers 不泄漏"];
    native [label="Native consumer\n实际 configure / build / run\n验证返回码与生产接口合同", fillcolor="#f0fdf4"];
    arm [label="ARM consumer\n真实 startup/system/linker + ELF/BIN/map\n检查选定模式、资源、kernel linkage", fillcolor="#f0fdf4"];
    reject [label="陈旧身份 / 改字节 / 缺闭包 / 错 prefix\n拒绝生成或编译，不继续使用 stale 包", fillcolor="#fff7ed"];
    reports [label="verify_consumers 报告 + raw + 同产物身份\nARM 链接不是实板运行", fillcolor="#fefce8"];
    source -> package [label="实际打包"];
    package -> move [label="完整包"];
    move -> consumer [label="独立安装消费"];
    consumer -> verify [label="加载公共入口"];
    verify -> target [label="通过"];
    verify -> reject [label="失败"];
    target -> native [label="Native 配置"];
    target -> arm [label="精确 MCU 配置"];
    native -> reports [label="实际结果"];
    arm -> reports [label="实际结果"];
    { rank=same; native; arm; }
}
