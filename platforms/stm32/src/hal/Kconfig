endmenu  # HAL Drivers

#-----------------------------------------------------------------------------
# HAL Module Auto-Selection (Internal)
#-----------------------------------------------------------------------------
# These symbols are automatically selected by HAL drivers above.
# Users should not configure these directly.
#-----------------------------------------------------------------------------

menu "HAL Module Selection (Auto-configured)"
    visible if EXPERT_MODE

config HAL_UART_MODULE
    bool "HAL UART module"
    help
      STM32 HAL UART module support.
      Automatically selected when UART driver is enabled.

config HAL_USART_MODULE
    bool "HAL USART module"
    help
      STM32 HAL USART module support.
      Automatically selected when UART driver is enabled.

config HAL_SPI_MODULE
    bool "HAL SPI module"
    help
      STM32 HAL SPI module support.
      Automatically selected when SPI driver is enabled.

config HAL_I2C_MODULE
    bool "HAL I2C module"
    help
      STM32 HAL I2C module support.
      Automatically selected when I2C driver is enabled.

config HAL_TIM_MODULE
    bool "HAL Timer module"
    help
      STM32 HAL Timer module support.
      Automatically selected when Timer driver is enabled.

config HAL_ADC_MODULE
    bool "HAL ADC module"
    help
      STM32 HAL ADC module support.
      Automatically selected when ADC driver is enabled.

config HAL_DAC_MODULE
    bool "HAL DAC module"
    help
      STM32 HAL DAC module support.
      Automatically selected when DAC driver is enabled.

config HAL_DMA_MODULE
    bool "HAL DMA module"
    default y if STM32_UART_USE_DMA
    help
      STM32 HAL DMA module support.
      Automatically selected when DMA is used by any driver.

config HAL_GPIO_MODULE
    bool "HAL GPIO module"
    default y
    help
      STM32 HAL GPIO module support.
      Required by most peripheral drivers for pin configuration.

config HAL_RCC_MODULE
    bool "HAL RCC module"
    default y
    help
      STM32 HAL RCC (Reset and Clock Control) module support.
      Required for peripheral clock configuration.

config HAL_CORTEX_MODULE
    bool "HAL Cortex module"
    default y
    help
      STM32 HAL Cortex module support.
      Required for NVIC and SysTick configuration.

endmenu  # HAL Module Selection

#-----------------------------------------------------------------------------
# HAL Callback Configuration
#-----------------------------------------------------------------------------
# Configure which HAL callbacks are enabled.
# Disabling unused callbacks can reduce code size.
#-----------------------------------------------------------------------------

menu "HAL Callback Configuration"
    visible if EXPERT_MODE

config HAL_UART_TX_COMPLETE_CALLBACK
    bool "UART TX complete callback"
    default y if STM32_UART_ENABLE
    help
      Enable HAL_UART_TxCpltCallback support.
      Required for asynchronous UART transmission.

config HAL_UART_RX_COMPLETE_CALLBACK
    bool "UART RX complete callback"
    default y if STM32_UART_ENABLE
    help
      Enable HAL_UART_RxCpltCallback support.
      Required for asynchronous UART reception.

config HAL_UART_ERROR_CALLBACK
    bool "UART error callback"
    default y if STM32_UART_ENABLE
    help
      Enable HAL_UART_ErrorCallback support.
      Required for UART error handling.

endmenu  # HAL Callback Configuration

