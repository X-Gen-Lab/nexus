#-----------------------------------------------------------------------------
# STM32 HAL Driver Configuration
#-----------------------------------------------------------------------------
# HAL (Hardware Abstraction Layer) drivers implement Nexus peripheral
# interfaces using STM32 HAL library as the underlying implementation.
#
# Architecture:
#   - Each HAL driver is a thin wrapper around STM32 HAL
#   - Maximum reuse of STM32 HAL capabilities
#   - Minimal code (<2000 lines per driver)
#   - Zero-copy data paths where possible
#
# Directory structure:
#   hal/uart/    - UART driver + Kconfig
#   hal/spi/     - SPI driver + Kconfig
#   hal/i2c/     - I2C driver + Kconfig
#   hal/timer/   - Timer driver + Kconfig
#   ...
#-----------------------------------------------------------------------------

menu "HAL Drivers"

#-----------------------------------------------------------------------------
# UART Driver
#-----------------------------------------------------------------------------

menuconfig STM32_UART_ENABLE
    bool "Enable UART driver"
    default y
    select HAL_UART_MODULE
    select HAL_USART_MODULE
    select HAL_GPIO_MODULE
    select HAL_RCC_MODULE
    select HAL_CORTEX_MODULE
    help
      Enable UART (Universal Asynchronous Receiver/Transmitter) driver.

      This driver implements Nexus HAL UART interface using STM32 HAL
      as the underlying implementation. It provides:
        - Synchronous and asynchronous TX/RX
        - DMA support for high-throughput transfers
        - Circular buffer management
        - Error handling and statistics
        - Multi-instance support

      Code size: ~1800 lines
      Architecture: Thin wrapper, maximum STM32 HAL reuse

if STM32_UART_ENABLE
source "platforms/stm32/src/hal/uart/Kconfig"
endif

#-----------------------------------------------------------------------------
# GPIO Driver
#-----------------------------------------------------------------------------

menuconfig STM32_GPIO_ENABLE
    bool "Enable GPIO driver"
    default y
    select HAL_GPIO_MODULE
    select HAL_RCC_MODULE
    help
      Enable GPIO (General Purpose Input/Output) driver.

      This driver implements Nexus HAL GPIO interface using STM32 HAL
      as the underlying implementation. It provides:
        - Digital input/output operations
        - Pin read/write/toggle
        - Configurable mode, pull, and speed
        - Lifecycle management
        - Power management support

      Code size: ~500 lines
      Architecture: Thin wrapper, maximum STM32 HAL reuse

if STM32_GPIO_ENABLE
source "platforms/stm32/src/hal/gpio/Kconfig"
endif

#-----------------------------------------------------------------------------
# SPI Driver
#-----------------------------------------------------------------------------

menuconfig STM32_SPI_ENABLE
    bool "Enable SPI driver"
    default n
    select HAL_SPI_MODULE
    select HAL_GPIO_MODULE
    select HAL_RCC_MODULE
    help
      Enable SPI (Serial Peripheral Interface) driver.

      This driver implements Nexus HAL SPI interface using STM32 HAL
      as the underlying implementation. It provides:
        - Synchronous and asynchronous TX/RX
        - DMA support for high-throughput transfers
        - Multi-device support with Handle acquisition
        - Error handling and statistics
        - Multi-instance support

      Code size: ~1500 lines
      Architecture: Thin wrapper, maximum STM32 HAL reuse

if STM32_SPI_ENABLE
source "platforms/stm32/src/hal/spi/Kconfig"
endif

