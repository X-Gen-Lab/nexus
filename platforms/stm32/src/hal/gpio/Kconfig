# STM32 GPIO Driver Configuration
# This file is sourced from platforms/stm32/src/hal/Kconfig
# when STM32_GPIO_ENABLE is selected
# Author: Nexus Team

#-----------------------------------------------------------------------------
# GPIO Driver Features
#-----------------------------------------------------------------------------

config STM32_GPIO_USE_EXTI
    bool "Enable external interrupt support"
    default n
    help
      Enable external interrupt (EXTI) support for GPIO pins.

      When enabled, GPIO pins can be configured to trigger interrupts
      on rising edge, falling edge, or both edges.

#-----------------------------------------------------------------------------
# GPIO Pin Configuration
#-----------------------------------------------------------------------------
# GPIO instances are configured using the format:
#   INSTANCE_STM32_GPIO<PORT>_PIN<NUM>
#
# For example: INSTANCE_STM32_GPIOA_PIN5 for PA5
#
# The generate_config.py script will generate traversal macros in nexus_config.h:
#   NX_DEFINE_INSTANCE_STM32_GPIO(fn) -> fn(A, 5) fn(B, 0) ...
#
# Each GPIO pin can be configured with mode, pull, speed, and alternate function.
#-----------------------------------------------------------------------------

menu "GPIO Pin Configuration"

# Source chip-specific GPIO configuration based on selected chip series
# Each chip series has different GPIO port availability and pin counts

if STM32F1
rsource "Kconfig_gpio_stm32f1"
endif

if STM32F4
rsource "Kconfig_gpio_stm32f4"
endif

