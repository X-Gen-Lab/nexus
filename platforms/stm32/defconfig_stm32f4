# STM32F4 Default Configuration

# Platform Selection
CONFIG_PLATFORM_STM32=y
CONFIG_PLATFORM_NAME="stm32f4"

# STM32 Series Selection
CONFIG_STM32F4=y

# STM32F4 Chip Selection (STM32F407VG as default)
CONFIG_STM32F407=y

# Clock Configuration
CONFIG_STM32_HSE_VALUE=8000000
CONFIG_STM32_SYSCLK_FREQ=168000000
CONFIG_STM32_HCLK_FREQ=168000000
CONFIG_STM32_PCLK1_FREQ=42000000
CONFIG_STM32_PCLK2_FREQ=84000000

# FPU Configuration
CONFIG_STM32_ENABLE_FPU=y

# Memory Configuration
CONFIG_STM32_STACK_SIZE=0x400
CONFIG_STM32_HEAP_SIZE=0x200

# HAL Modules
CONFIG_STM32_UART_ENABLE=y
CONFIG_STM32_GPIO_ENABLE=y
CONFIG_STM32_SPI_ENABLE=y
CONFIG_STM32_I2C_ENABLE=y
CONFIG_STM32_TIMER_ENABLE=y

# OSAL Configuration
CONFIG_OSAL_BAREMETAL=y
CONFIG_OSAL_BACKEND_NAME="baremetal"
CONFIG_OSAL_TICK_RATE_HZ=1000
CONFIG_OSAL_HEAP_SIZE=16384
CONFIG_OSAL_MAIN_STACK_SIZE=4096

# HAL Configuration
CONFIG_HAL_ENABLE=y
CONFIG_HAL_ASSERT_ENABLE=y
CONFIG_HAL_STATISTICS_ENABLE=y
CONFIG_HAL_DEFAULT_TIMEOUT_MS=1000
