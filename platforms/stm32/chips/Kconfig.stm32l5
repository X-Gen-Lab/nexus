#-----------------------------------------------------------------------------
# STM32L5 Series Chip Variant Selection
#-----------------------------------------------------------------------------
# This file defines chip variants for STM32L5 series.
# TODO: Add specific chip variants (L552, L562)
#-----------------------------------------------------------------------------

if STM32L5

# Placeholder for STM32L5 chip variant selection
# Add choice block and chip variants here

config STM32_CHIP_NAME
    string
    default "STM32L5xx"
    help
      STM32 chip name for HAL driver selection and conditional compilation.

config STM32_FLASH_SIZE
    hex "Flash size (bytes)"
    default 0x80000
    help
      Flash memory size in bytes.

config STM32_SRAM_SIZE
    hex "SRAM size (bytes)"
    default 0x40000
    help
      SRAM memory size in bytes.

endif # STM32L5
