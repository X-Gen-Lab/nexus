#-----------------------------------------------------------------------------
# STM32F2 Series Chip Variant Selection
#-----------------------------------------------------------------------------
# This file defines chip variants for STM32F2 series.
# TODO: Add specific chip variants (F205, F207, F215, F217)
#-----------------------------------------------------------------------------

if STM32F2

# Placeholder for STM32F2 chip variant selection
# Add choice block and chip variants here

config STM32_CHIP_NAME
    string
    default "STM32F2xx"
    help
      STM32 chip name for HAL driver selection and conditional compilation.

config STM32_FLASH_SIZE
    hex "Flash size (bytes)"
    default 0x100000
    help
      Flash memory size in bytes.

config STM32_SRAM_SIZE
    hex "SRAM size (bytes)"
    default 0x20000
    help
      SRAM memory size in bytes.

endif # STM32F2
