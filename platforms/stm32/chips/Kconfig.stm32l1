#-----------------------------------------------------------------------------
# STM32L1 Series Chip Variant Selection
#-----------------------------------------------------------------------------
# This file defines chip variants for STM32L1 series.
# TODO: Add specific chip variants (L100, L151, L152, L162)
#-----------------------------------------------------------------------------

if STM32L1

# Placeholder for STM32L1 chip variant selection
# Add choice block and chip variants here

config STM32_CHIP_NAME
    string
    default "STM32L1xx"
    help
      STM32 chip name for HAL driver selection and conditional compilation.

config STM32_FLASH_SIZE
    hex "Flash size (bytes)"
    default 0x20000
    help
      Flash memory size in bytes.

config STM32_SRAM_SIZE
    hex "SRAM size (bytes)"
    default 0x4000
    help
      SRAM memory size in bytes.

endif # STM32L1
