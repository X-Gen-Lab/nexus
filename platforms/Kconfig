# Maintained platform assembly. Hardware capabilities are defined by each SoC.
menu "Platform Configuration"

choice
    prompt "Target Platform"
    default PLATFORM_NATIVE

config PLATFORM_NATIVE
    bool "Native host model"
    help
      Host execution for software tests; it does not qualify MCU hardware.

config PLATFORM_STM32
    bool "STM32F407 platform"
    help
      Maintained STM32F407 VE, VG and ZG Cortex-M4 configurations only.

config PLATFORM_GD32F470
    bool "GD32F470ZG platform"
    help
      Maintained GD32F470ZGT6 Cortex-M4 configuration.

endchoice

config PLATFORM_NAME
    string
    default "native" if PLATFORM_NATIVE
    default "stm32" if PLATFORM_STM32
    default "gd32f470" if PLATFORM_GD32F470

if PLATFORM_NATIVE
rsource "native/Kconfig"
endif
if PLATFORM_STM32
rsource "stm32/Kconfig"
endif
if PLATFORM_GD32F470
rsource "gd32f470/Kconfig"
endif

endmenu
