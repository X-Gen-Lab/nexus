"""One-time catalogue authoring; never runs provider tests or infers passing."""
import copy
import json
from pathlib import Path
import re
from scripts.ci.io_lifecycle_matrix import test_body, catalogue_inputs

root = Path('/workspace/nexus')
path = root / 'tools/testing/io_lifecycle_matrix.json'
data = json.loads(path.read_text())
original = copy.deepcopy(data['properties'])
assert len(original) == 80
rows = []
limits = ('Reviewed bounded production C execution with explicit external '
          'MMIO/clock/CPU leaves and the target selected compile branch; '
          'no physical bus/waveform/safe-output/IRQ WCET, exhaustive '
          'interleaving or complete configuration proof.')

def predicates(body):
    result = []
    for match in re.finditer(r'\b(?:ASSERT|EXPECT)_(?:EQ|NE|TRUE|FALSE|GT|GE|LT|LE)\(', body):
        start = match.start()
        depth = 1
        for index in range(match.end(), len(body)):
            if body[index] == '(':
                depth += 1
            elif body[index] == ')':
                depth -= 1
                if depth == 0:
                    result.append(body[start:index + 1])
                    break
    return list(dict.fromkeys(result))

def append(family, peripheral, mode, target, suite, filename, production,
           models, choices):
    text = (root / filename).read_text()
    for name, invariant in choices:
        body = test_body(text, suite + '.' + name)
        assertions = predicates(body)
        assert len(assertions) >= 2, (name, assertions)
        calls = sorted(set(re.findall(r'\bnx_[A-Za-z0-9_]+\(', body)))
        if not calls:
            calls = [token + "(" for token in ("Initialize", "CAP_INIT",
                     "CAP_RELEASE", "ADV_INIT", "ADV_RELEASE")
                     if token + "(" in body]
        assert calls, name
        rows.append({
            'id': family + '.' + peripheral + '.' + mode + '.' + name,
            'family': family, 'peripheral': peripheral, 'mode': mode,
            'target': target, 'case': suite + '.' + name,
            'test_source': filename, 'production_sources': production,
            'model_sources': models, 'assertions': assertions, 'calls': calls,
            'invariant': invariant, 'limitations': limits,
        })

append('native', 'can', 'classic-irq', 'nexus_can_controller_test', 'ClassicCan',
       'tests/google/can_controller_test.cpp',
       ['io/src/can_controller.c', 'io/native/can.c', 'core/src/request.c'],
       ['io/native/can_access.h'], [
    ('ThreeMailboxesAndFourthRejectionHaveExactBorrowBoundaries', 'A fourth mailbox admission retains no request and preserves READY while the three accepted slots remain pending.'),
    ('TxokAndCompletionDetachBeforeSettlement', 'Wire completion detaches the mailbox request before settlement and exposes only the confirmed transferred bytes.'),
    ('CancellationWaitsForActualAbortAcknowledgement', 'Abort failure retains the accepted request through quarantine; only actual hardware acknowledgement allows settlement.'),
    ('TimeoutUsesAbsoluteDeadlineAndRetainsAbortResponsibility', 'Absolute timeout starts drain without reclaiming the request; an acknowledged abort settles TIMEOUT.'),
    ('DeadlineExpiredRejectsWithNoMailboxEffect', 'Expired admission preserves READY and performs no mailbox write.'),
    ('FullRingPlacesLossAfterOlderFactsAndBeforeLaterFrames', 'Bounded ring loss follows prior frames and precedes later frames without reordering or invention.'),
    ('HardwareOverrunReportsLowerBoundWithoutInventedExactCount', 'Hardware overrun reports an explicit lower bound, not an invented exact dropped-frame count.'),
    ('BusOffRemainsAuthoritativeWhenTheRingIsFull', 'Latched bus-off closes admission and recovery retains active abort responsibility despite a full event ring.'),
])
for short, family in [('stm32', 'stm32f407'), ('gd32', 'gd32f470')]:
    common = ['soc/' + family + '/drivers/can.c', 'io/src/can_controller.c',
              'core/src/request.c']
    append(family, 'can', 'classic-irq', 'nexus_' + short + '_can_test', 'CanSoc',
           'tests/google/can_soc_test.cpp', common,
           ['tests/google/can_soc_model.h', 'io/native/can_access.h'], [
        ('UnacknowledgedAbortRetainsRequestUntilActualSdkCompletion', 'The actual SDK controller retains an unacknowledged abort through quarantine until stop obtains hardware completion.'),
        ('FailedExitAcknowledgementRetainsDomainResponsibility', 'Failed controller startup exit retains its shared filter/clock domain until successful drain.'),
        ('ForeignPrimaryFilterDomainRejectsWithoutControllerEffects', 'A foreign filter-domain identity is rejected without mutating controller mode or starting it.'),
    ])
    append(family, 'can', 'classic-irq-factory', 'nexus_' + short + '_can_factory_test',
           'CanFactory', 'tests/google/can_factory_test.cpp', common,
           ['tests/google/can_soc_model.h'], [
        ('BothInstancesUseOneDomainAndDistinctRingsAndMailboxes', 'Generated instances share exactly one filter domain and use separate selected rings, addresses and mailbox ownership.'),
        ('StuckSecondControllerRetainsPinsAndSharedDomainUntilDrain', 'Failed secondary IRQ withdrawal retains both controllers and all pin/domain leases until retry succeeds.'),
        ('FailedSecondStartupIsIncludedInReverseCleanup', 'A failed secondary startup is included in reverse cleanup and cannot drop retained effects from the remaining-effects result.'),
        ('FirstPinFailureHasNoDomainOrUncapturedPinRelease', 'Failure before pin capture has no filter-domain effects and no uncaptured lease release.'),
    ])

append('native', 'usb_device', 'device-fs', 'nexus_usb_device_test', 'UsbDevice',
       'tests/google/usb_device_test.cpp',
       ['io/src/usb_device_controller.c', 'io/native/usb_device.c', 'core/src/request.c'],
       ['io/native/usb_device_access.h'], [
    ('FifoWriteDoesNotCompleteHostAcknowledgement', 'PIO FIFO writes retain the request until host transfer-complete facts; settlement detaches the endpoint request.'),
    ('OutOverflowCannotWriteBeyondCallerCapacity', 'Oversized OUT packets settle overflow without overwriting the capacity guard byte.'),
    ('FailedDisableKeepsRequestBorrowedThroughDrainDeadline', 'Failed endpoint disable retains the request and controller clock through the drain deadline and quarantine.'),
    ('FifoFlushFailureCannotSettleDisabledEndpoint', 'Endpoint disable alone does not settle a request when FIFO withdrawal remains unproved.'),
    ('StopCannotReleaseWakeOrClockWithAnEnabledIrq', 'An enabled IRQ prevents wake and clock release at stop.'),
    ('NewSetupInvalidatesOldControlBeforeReusingStorage', 'New SETUP advances control epoch and drains an old accepted request without premature reuse.'),
    ('ResetDoesNotRevokeAnUnprovedEndpointLoan', 'USB reset cannot revoke an endpoint loan while FIFO drain proof is missing.'),
    ('StaleCompletionCannotFinishANewRequestEpoch', 'Uncleared prior completion blocks a new admission and preserves the new request as READY.'),
])
for short, family in [('stm32', 'stm32f407'), ('gd32', 'gd32f470')]:
    production = ['soc/' + family + '/drivers/usb_device.c',
                  'soc/' + family + '/usb_clock.c',
                  'io/src/usb_device_controller.c', 'core/src/request.c']
    append(family, 'usb_device', 'device-fs', 'nexus_' + family + '_usb_device_test',
           'UsbSoc', 'tests/google/usb_device_soc_test.cpp', production,
           ['tests/google/usb_device_soc_model.h'], [
        ('FalseCpuFactsRejectBeforeBorrowingTheClock', 'False selected CPU priority facts reject the actual SDK binding without retaining a clock consumer.'),
        ('FailedCoreResetKeepsClockAndOwnerStorage', 'Failed core reset retains the clock consumer and closing controller state until cleanup proof.'),
    ])
    append(family, 'usb_device', 'device-fs-factory',
           'nexus_' + short + '_usb_factory_test', 'UsbFactory',
           'tests/google/usb_factory_test.cpp', production,
           ['tests/google/usb_device_soc_model.h', 'tests/google/usb_factory_model.h'], [
        ('PureFactoryDoesNotStartAndControllerIsNotAnEndpoint', 'Typed factory lookup is pure and preserves distinct controller and endpoint identities.'),
        ('FailedColdDcdIsCountedAndRetainsClockAndPinsUntilProof', 'Failed generated cold construction retains its clock and pins and reports the unproved cleanup effects.'),
        ('BusyPioLoanRetainsTheSameRequestUntilDetachAndSettlement', 'Platform stop preserves the accepted PIO request and its pins until actual endpoint detach and settlement.'),
        ('SuccessfulDrainAllowsTheSameStaticIdentityToRestart', 'Proved drain allows restart with the same static controller/endpoint identities.'),
        ('RestartCannotReuseAStaleSetupEpochForSetAddress', 'Restart preserves lifetime epoch monotonicity so old SETUP tokens cannot change the address.'),
        ('ExhaustedLifetimeEpochCannotBeReopenedByColdReconstruction', 'Cold reconstruction cannot reset a saturated lifetime epoch or successfully reopen admission.'),
    ])

for short, family in [('stm32', 'stm32f407'), ('gd32', 'gd32f470')]:
    production = ['soc/' + family + '/drivers/ethernet.c', 'io/src/eth_mac.c',
                  'core/src/request.c']
    append(family, 'eth', 'raw-rmii', 'nexus_' + short + '_ethernet_test',
           'EthernetMac', 'tests/google/ethernet_mac_test.cpp', production,
           ['tests/google/ethernet_model.h'], [
        ('OwnHandoffRetainsBorrowUntilRealTransmitStatus', 'Descriptor OWN handoff and interrupt hints retain TX until actual returned completion status and detached request.'),
        ('HeldReceiveLoanIsNeverOverwrittenAtRingWrap', 'An acquired RX loan cannot be rearmed or overwritten at wrap; release validates its token.'),
        ('CancellationWaitsForActualEngineAndFifoDrain', 'Cancellation retains TX through engine/FIFO drain failure and quarantine until hardware proof allows settlement.'),
        ('InitializationCannotResetForeignDescriptorEngine', 'Cold initialization rejects a foreign descriptor engine before reset or RX ownership effects.'),
        ('FatalBusErrorCannotTurnMissingStatusIntoSuccess', 'Fatal bus error remains authoritative and cannot synthesize a successful transmit completion.'),
        ('ReturnedDescriptorWithoutFrameStatusCannotInventWireSuccess', 'Returned OWN without successful frame status settles IO with no invented transferred bytes.'),
        ('StopRechecksCapturedPublisherAfterNvicDisableBoundary', 'Stop rechecks an in-flight wake publisher after IRQ withdrawal and retains wake/storage until publisher join.'),
        ('StopClosesNewReceiveLoansBeforeDrainCompletes', 'Closing stop prevents new RX loans before the existing hardware drain completes.'),
    ])
    append(family, 'eth', 'raw-rmii-factory', 'nexus_' + short + '_eth_factory_test',
           'EthernetFactory', 'tests/google/ethernet_factory_test.cpp', production,
           ['tests/google/ethernet_model.h', 'tests/google/ethernet_factory_model.h'], [
        ('RefusedMacClockWithdrawalRetainsPlatformUntilReadback', 'Failed owned MAC clock withdrawal retains the platform and blocks restart until actual clock readback.'),
        ('FailedPinRestoreKeepsClocksAndStorageUntilRetry', 'Failed restoration of captured pads keeps provider storage and clocks until successful retry.'),
        ('HeldReceiveLoanPreventsDestructiveStopAndStaleRestartToken', 'An acquired RX loan prevents destructive platform stop and stale tokens cannot release a restarted loan.'),
        ('RejectedDmaDomainDoesNotResetMacOrRetainPayload', 'Rejected DMA memory domain has no MAC reset/payload retention and cleanup restores the owned clock.'),
        ('ExhaustedReceiveEpochCannotBeResetByReconstruction', 'Cold reconstruction cannot reuse a saturated receive epoch.'),
        ('StuckTxEngineRetainsBorrowedStorageUntilRealDrain', 'A stuck TX engine preserves quarantined request storage and rejects restart until actual engine drain.'),
    ])
append('native', 'eth', 'raw-rmii', 'nexus_ethernet_native_test', 'EthernetNative',
       'tests/google/ethernet_native_test.cpp',
       ['io/src/eth_mac.c', 'io/native/ethernet.c', 'core/src/request.c'], [], [
    ('ExplicitIngressCannotOverwriteAnAcquiredLoan', 'Explicit Native ingress cannot overwrite a borrowed RX buffer and exposes subsequent payload only after release.'),
    ('EpochSurvivesStopAndPreventsReleaseOfReusedStorage', 'Native restart preserves epoch identity, preventing a stale token from releasing reused storage.'),
])

append('stm32g474', 'uart', 'irq-byte-event', 'nexus_g474_provider_test', 'G474Provider',
       'tests/google/g474_provider_test.cpp',
       ['soc/stm32g474/drivers/uart.c', 'soc/stm32g474/system.c', 'core/src/request.c'],
       ['tests/contracts/g474_model.c', 'tests/contracts/g474_model.h'], [
    ('TxSettlesOnlyAfterFinalWireTc', 'TXE writes do not settle; actual final wire TC detaches the accepted request before successful settlement.'),
    ('CancelKeepsBorrowQuarantinedUntilRealTc', 'Cancellation preserves the request through quarantine until final wire TC, retaining the confirmed prefix count.'),
    ('CompletedWireFactWinsLaterDeadlineAndCancel', 'Previously confirmed wire completion wins a later timeout/cancel without changing successful settlement.'),
    ('CorruptByteIsDiscardedWithObservableAggregateLoss', 'Corrupt received bytes are discarded with observable loss and cannot alter caller output as valid bytes.'),
    ('ReadOutputCannotOverwriteRingOrActiveRequest', 'Output aliases cannot overwrite selected RX storage or an accepted request.'),
    ('FailedSourceWithdrawalRetainsAllStorage', 'Failed IRQ withdrawal retains provider storage until actual successful retry.'),
])
append('stm32g474', 'platform', 'irq-byte-event-factory', 'nexus_g474_factory_test',
       'G474Factory', 'tests/google/g474_factory_test.cpp',
       ['soc/stm32g474/system.c', 'soc/stm32g474/drivers/gpio.c',
        'soc/stm32g474/drivers/uart.c', 'core/src/request.c'],
       ['tests/contracts/g474_model.c', 'tests/contracts/g474_model.h',
        'tests/google/g474_factory_model.h'], [
    ('LookupIsPureStaticIdentityBeforeAnyHardwareAccess', 'Static lookup preserves typed identities and performs no hardware read/write before start.'),
    ('ForeignLiveUartRejectsBeforeAnyClockOrPinMutation', 'A foreign active UART causes cold platform rejection with no clock or pin effects.'),
    ('ForeignDmaControlRejectsBeforeAnyClockOrPinMutation', 'Foreign UART DMA control is rejected before clock, pins or system ownership mutation.'),
    ('FailedPeripheralRollbackRetainsClockPinsAndResponsibility', 'Failed cold rollback exposes remaining effects and retains clock/pin responsibility until explicit cleanup.'),
    ('StopFailurePreservesIdentityUntilActualIrqWithdrawal', 'Failed source withdrawal preserves static identity and its resources until actual IRQ detach.'),
])

for short, family in [('stm32', 'stm32f407'), ('gd32', 'gd32f470')]:
    production = ['soc/' + family + '/drivers/timer_capture.c',
                  'soc/' + family + '/drivers/advanced_pwm.c',
                  'io/src/timer_capture.c', 'io/src/advanced_pwm.c']
    append(family, 'timer', 'capture-and-advanced',
           'nexus_' + family + '_timer_advanced_test', 'TimerHardware',
           'tests/google/timer_advanced_test.cpp', production,
           ['tests/google/timer_advanced_model.h'], [
        ('CaptureOverflowIsObservableWithoutOverwritingConsumer', 'Ring overflow preserves older captured edges and reports overcapture/software loss incidents without overwriting the consumer.'),
        ('CaptureStopRetainsQueuedRingUntilTaskDrain', 'Stop keeps the caller ring borrowed while queued capture facts remain and releases it only after drain.'),
        ('CaptureFailedDetachRetainsRingAndIncomingMask', 'Failed capture source withdrawal retains its ring and incoming interrupt mask through retry.'),
        ('CaptureRejectsRingControlOutputAndOverflowAliases', 'Ring/control/output overlap and impossible capacity reject without consuming a queued capture.'),
        ('AdvancedHardwareBreakLatchesAndNeverAutorestarts', 'A hardware break latches fault and disables output; clearing requires inactive hardware and explicit rearm.'),
        ('AdvancedFailedMoeDetachKeepsOwnerResponsibility', 'Failed output disable retains advanced-timer owner responsibility until actual MOE withdrawal.'),
        ('AdvancedPendingBreakBeforeMoeIsNeverExplicitlyReenabled', 'A pending break at enable prevents any explicit output-enable write.'),
        ('UntouchedReleaseNeverWithdrawsForeignActiveTimer', 'Rejected cold acquisition and untouched release cannot disable a foreign timer, IRQ source or output.'),
    ])
    append(family, 'timer', 'capture-and-advanced-factory',
           'nexus_' + short + '_timer_factory_test', 'TimerFactory',
           'tests/google/timer_factory_test.cpp', production,
           ['tests/google/timer_factory_model.h'], [
        ('UnprivilegedOwnerRejectsBeforeAnyColdSystemEffects', 'Unprivileged platform start rejects before system, clock, pin or provider mutation.'),
        ('ForeignSharedTimerRefusalLeavesItsSourceAndPriorityIntact', 'Cold rejection of a foreign shared timer preserves its source bits and vector priority.'),
        ('RefusedIrqDisableRetainsPinsGatesAndProviderStorage', 'Failed IRQ withdrawal retains selected pins, gates, configuration and blocks restart until retry succeeds.'),
        ('RefusedPendingClearRetainsExactProviderBeforeReuse', 'Uncleared owned pending IRQ prevents reuse of exact provider storage and clocks.'),
        ('ActivePublisherPreventsStorageReuseEvenAfterDisable', 'An in-flight publisher prevents provider reuse even after vector disable.'),
        ('QueuedCaptureLoanBlocksPlatformClockAndPinRelease', 'A queued capture ring loan prevents platform pin/clock release until caller drains its event.'),
        ('RefusedSafeOutputLatchDoesNotReleasePinOrClock', 'Failed inactive GPIO latch readback retains the output group and its clock rather than inventing a safe shutdown.'),
        ('AllInactiveOutputProofsPrecedeAnyPinRelease', 'Every selected advanced-output inactive proof precedes release of any pin in that output group.'),
        ('RefusedOwnedClockReleaseRetainsStopAndPreventsRestart', 'Failed owned clock withdrawal retains stop responsibility and rejects restart until readback.'),
        ('StopAndColdRestartReuseOnlyAProvedQuiescentSession', 'Only proved source, queue, output and publisher quiescence permits cold static-session reuse.'),
    ])

data['scope'] = ('Explicit reviewed bounded UART/SPI/I2C/ADC/CAN/USB/raw Ethernet/'
                 'timer provider and generated-factory lifecycle fault sequences '
                 'for STM32F407/GD32F470, selected STM32G474 software-reference '
                 'providers and Native models. This is bounded source-bound '
                 'coverage, never universal semantic or physical proof.')
data['properties'].extend(rows)
assert data['properties'][:80] == original
for item in data['unproven']:
    if item['scope'] == 'non-streaming IO':
        item['reason'] = ('GPIO/EXTI/basic PWM/watchdog/Flash have independent '
                          'maintained suites. The selected CAN/USB/Ethernet/'
                          'timer rows here do not claim every lifecycle, '
                          'controller, packet type or alternative mode.')
data['unproven'].append({'scope':'external product outputs', 'reason':'Advanced-output readback is a modeled platform mechanism. No tested GPIO value establishes real product safety, transceiver/PHY wiring, a physical break path, a reset policy or a safety certification.'})
contracts = ['io/include/nexus/io/can.h', 'io/include/nexus/io/ethernet.h',
             'io/include/nexus/io/usb_device.h', 'io/include/nexus/io/timer_capture.h',
             'io/include/nexus/io/advanced_pwm.h',
             'tools/configure/configure.py', 'tools/configure/ir.py']
for family in ['stm32f407', 'gd32f470', 'stm32g474']:
    for name in ['bindings.py', 'emission.py']:
        candidate='tools/configure/providers/' + family + '/' + name
        if (root/candidate).is_file(): contracts.append(candidate)
for name in ['can_runtime','can_factory','usb_device','usb_factory','ethernet',
             'ethernet_factory','timer_advanced','timer_factory','g474_factory','g474']:
    contracts.append('tests/google/' + name + '.cmake')
for folder in ['can_assembly','usb_assembly','ethernet_assembly','timer_assembly','g474_assembly']:
    contracts.extend(p.relative_to(root).as_posix() for p in sorted((root/'tests/contracts'/folder).glob('*.toml')))
for name in contracts:
    assert (root/name).is_file(), name
    if name not in data['contract_sources']: data['contract_sources'].append(name)
path.write_text(json.dumps(data,indent=2)+'\n')
_, sources, compiled = catalogue_inputs(root,path)
print(json.dumps({'original_properties':len(original),'new_properties':len(rows),
                  'total_properties':len(data['properties']),
                  'targets':len({row['target'] for row in data['properties']}),
                  'sources':len(sources),'compiled_TUs':len(compiled)},indent=2))
