#include "nexus_bindings.h"
#include "nexus_factory.h"
#include "nexus_config.h"
#include "nexus/arch/arch.h"
#include "stm32f407_provider.h"
#include "stm32f407_stream.h"
void _init(void);
void _fini(void);
/** \brief C runtime hooks; constructors use .init_array. */
void _init(void) {}
void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static uint32_t s_nx_platform_dma_clocks_added;
static uint32_t s_nx_platform_gpio_clocks_added;
static nx_stm32_adc_continuous_state_t s_nx_port_samples;
static const nx_adc_port_t s_nx_face_samples = {
    &nx_stm32_adc_continuous_ops, &s_nx_port_samples
};
const nx_adc_port_t* const nx_binding_samples = &s_nx_face_samples;
static const uint8_t s_nx_adc_channels_samples[] = { 0u, 1u };
static const uint8_t s_nx_adc_samples_samples[] = { 0u, 7u };
static const nx_dma_memory_region_t s_nx_dma_regions_samples[] = {
    { (uintptr_t)0x20000000u, 131072u, NX_DMA_MEMORY_READ | NX_DMA_MEMORY_WRITE },
};
void DMA2_Stream4_IRQHandler(void);
/** \brief Exact ADC DMA block terminal observation. */
void DMA2_Stream4_IRQHandler(void) { nx_stm32_adc_continuous_irq(&s_nx_port_samples); }
static nx_result_t stop_samples(void) {
    nx_result_t stopped = nx_adc_port_stream_stop(&s_nx_face_samples);
    if (stopped != NX_SUCCESS) { return stopped; }
    NVIC_DisableIRQ(DMA2_Stream4_IRQn);
    NVIC_ClearPendingIRQ(DMA2_Stream4_IRQn);
    if (s_nx_port_samples.base.adc.active) { return NX_ERROR_BUSY; }
    ADC1->CR2 = 0u;
    s_nx_port_samples.base.adc.initialized = false;
    RCC->APB1ENR &= ~(uint32_t)RCC_APB1ENR_TIM3EN;
    (void)nx_stm32_pin_configure(GPIOA, 0u, 0u, 0u, 0u, false);
    (void)nx_stm32_pin_configure(GPIOA, 1u, 0u, 0u, 0u, false);
    RCC->APB2ENR &= ~(uint32_t)RCC_APB2ENR_ADC1EN;
    nx_arch_dsb();
    return NX_SUCCESS;
}
static nx_result_t prepare_samples(void) {
    nx_result_t status = NX_SUCCESS;
    uint32_t saved_ahb1 = RCC->AHB1ENR & 1u;
    uint32_t saved_apb1 = RCC->APB1ENR & RCC_APB1ENR_TIM3EN;
    uint32_t saved_apb2 = RCC->APB2ENR & RCC_APB2ENR_ADC1EN;
    uint16_t saved_PA0 = 0u;
    bool captured_PA0 = false;
    uint16_t saved_PA1 = 0u;
    bool captured_PA1 = false;
    RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;
    nx_arch_dsb();
    if ((ADC1->CR2 & ADC_CR2_ADON) != 0u) {
        status = NX_ERROR_BUSY; goto rollback;
    }
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) {
        goto rollback;
    }
    saved_PA0 = nx_stm32_pin_capture(GPIOA, 0u);
    captured_PA0 = true;
    status = nx_stm32_pin_configure(GPIOA, 0u, 3u, 0u, 0u, false);
    if (status != NX_SUCCESS) {
        goto rollback;
    }
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) {
        goto rollback;
    }
    saved_PA1 = nx_stm32_pin_capture(GPIOA, 1u);
    captured_PA1 = true;
    status = nx_stm32_pin_configure(GPIOA, 1u, 3u, 0u, 0u, false);
    if (status != NX_SUCCESS) {
        goto rollback;
    }
    s_nx_port_samples.base.adc.registers = ADC1;
    s_nx_port_samples.base.adc.common = ADC;
    s_nx_port_samples.base.adc.channels = s_nx_adc_channels_samples;
    s_nx_port_samples.base.adc.sample_times = s_nx_adc_samples_samples;
    s_nx_port_samples.base.adc.channel_count = 2u;
    s_nx_port_samples.base.adc.reference_mv = 3300u;
    RCC->APB1ENR |= RCC_APB1ENR_TIM3EN;
    nx_arch_dsb();
    s_nx_port_samples.base.timer = TIM3;
    s_nx_port_samples.base.dma = DMA2;
    s_nx_port_samples.base.memory = DMA2_Stream4;
    s_nx_port_samples.base.regions = s_nx_dma_regions_samples;
    s_nx_port_samples.base.region_count = 1u;
    s_nx_port_samples.base.timer_clock_hz = 84000000u;
    s_nx_port_samples.base.adc_clock_hz = 21000000u;
    status = nx_stm32_adc_continuous_initialize(&s_nx_port_samples);
    if (status != NX_SUCCESS) {
        goto rollback;
    }
    NVIC_SetPriority(DMA2_Stream4_IRQn, 5u);
    return status;
rollback:
    if (captured_PA1) {
        nx_stm32_pin_restore(GPIOA, 1u, saved_PA1);
    }
    if (captured_PA0) {
        nx_stm32_pin_restore(GPIOA, 0u, saved_PA0);
    }
    RCC->APB1ENR = (RCC->APB1ENR & ~(uint32_t)(RCC_APB1ENR_TIM3EN)) | saved_apb1;
    RCC->APB2ENR = (RCC->APB2ENR & ~(uint32_t)(RCC_APB2ENR_ADC1EN)) | saved_apb2;
    RCC->AHB1ENR = (RCC->AHB1ENR & ~1u) | saved_ahb1;
    nx_arch_dsb();
    return status;
}
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = stop_samples();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started) { RCC->AHB1ENR &= ~s_nx_platform_gpio_clocks_added; }
    if (s_nx_platform_started) { RCC->AHB1ENR &= ~s_nx_platform_dma_clocks_added; }
    nx_arch_dsb();
    if (s_nx_platform_started && nx_stm32_system_stop(&g_nx_stm32_system, 1000000u) != 0) {
        return NX_ERROR_IO;
    }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    s_nx_platform_dma_clocks_added = 0u;
    s_nx_platform_gpio_clocks_added = 0u;
    result.primary = nx_stm32_validate_identity(524288u);
    if (result.primary != NX_SUCCESS) { return result; }
    nx_stm32_start_result_t system = nx_stm32_system_start(&g_nx_stm32_system, 1000000u);
    if (system.primary != 0) {
        result.primary = NX_ERROR_IO;
        result.cleanup = system.cleanup == 0 ? NX_SUCCESS : NX_ERROR_IO;
        result.remaining_effects = system.remaining_effects;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    s_nx_platform_dma_clocks_added = ~RCC->AHB1ENR & (RCC_AHB1ENR_DMA2EN);
    RCC->AHB1ENR |= (RCC_AHB1ENR_DMA2EN);
    (void)RCC->AHB1ENR;
    nx_arch_dsb();
    s_nx_platform_gpio_clocks_added = ~RCC->AHB1ENR & 1u;
    result.primary = prepare_samples();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    return result;
}

