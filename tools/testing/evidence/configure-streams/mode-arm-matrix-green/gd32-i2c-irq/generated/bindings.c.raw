#include "nexus_bindings.h"
#include "nexus_factory.h"
#include "nexus_config.h"
#include "nexus/arch/arch.h"
#include "gd32f470_provider.h"
#include "gd32f4xx.h"
#include "gd32f470_i2c_async.h"
void _init(void);
void _fini(void);
/** \brief C runtime hooks; constructors use .init_array. */
void _init(void) {}
void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static nx_gd32_i2c_async_state_t s_nx_port_bus;
static const nx_i2c_port_t s_nx_face_bus = {
    &nx_i2c_v1_async_ops, &s_nx_port_bus
};
const nx_i2c_port_t* const nx_binding_bus = &s_nx_face_bus;
static nx_gd32_i2c_async_endpoint_state_t s_nx_endpoint_bus;
static const nx_i2c_endpoint_t s_nx_device_face_sensor = {
    &nx_i2c_v1_async_endpoint_ops, &s_nx_endpoint_bus
};
const nx_i2c_endpoint_t* const nx_device_sensor = &s_nx_device_face_sensor;
static nx_result_t prepare_bus(void) {
    nx_result_t status = NX_SUCCESS;
    uint32_t saved_clocks = RCU_AHB1EN & 2u;
    uint16_t saved_PB6 = 0u;
    bool captured_PB6 = false;
    uint16_t saved_PB7 = 0u;
    bool captured_PB7 = false;
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { goto rollback; }
    saved_PB6 = nx_gd32_pin_capture(GPIOB, 6u);
    captured_PB6 = true;
    status = nx_gd32_pin_configure(GPIOB, 6u, 2u, 4u, 1u, true);
    if (status != NX_SUCCESS) { goto rollback; }
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { goto rollback; }
    saved_PB7 = nx_gd32_pin_capture(GPIOB, 7u);
    captured_PB7 = true;
    status = nx_gd32_pin_configure(GPIOB, 7u, 2u, 4u, 1u, true);
    if (status != NX_SUCCESS) { goto rollback; }
    s_nx_port_bus.registers = (volatile uint32_t*)I2C0;
    s_nx_port_bus.line_inputs = &GPIO_ISTAT(GPIOB);
    s_nx_port_bus.line_mask = 192u;
    s_nx_port_bus.peripheral_mhz = 50u;
    s_nx_port_bus.dma = NULL;
    s_nx_endpoint_bus.port = &s_nx_port_bus;
    s_nx_endpoint_bus.address = 80u;
    status = nx_gd32_i2c_async_initialize(&s_nx_port_bus, 5u);
    if (status != NX_SUCCESS) { goto rollback; }
    return NX_SUCCESS;
rollback:
    if (captured_PB7) { nx_gd32_pin_restore(GPIOB, 7u, saved_PB7); }
    if (captured_PB6) { nx_gd32_pin_restore(GPIOB, 6u, saved_PB6); }
    RCU_AHB1EN = (RCU_AHB1EN & ~2u) | saved_clocks;
    nx_arch_dsb();
    return status;
}
static nx_result_t stop_bus(void) {
    nx_result_t status = nx_i2c_port_stop(&s_nx_face_bus);
    if (status != NX_SUCCESS) { return status; }
    (void)nx_gd32_pin_configure(GPIOB, 6u, 0u, 0u, 0u, false);
    (void)nx_gd32_pin_configure(GPIOB, 7u, 0u, 0u, 0u, false);
    return NX_SUCCESS;
}
void I2C0_EV_IRQHandler(void);
/** \brief Selected finite I2C message publisher. */
void I2C0_EV_IRQHandler(void) { nx_i2c_v1_irq(&s_nx_port_bus); }
void I2C0_ER_IRQHandler(void);
/** \brief Selected finite I2C message publisher. */
void I2C0_ER_IRQHandler(void) { nx_i2c_v1_irq(&s_nx_port_bus); }
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = stop_bus();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started && nx_gd32_soc_stop() != 0) { return NX_ERROR_IO; }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    if (nx_gd32_soc_start() != 0) {
        result.primary = NX_ERROR_IO;
        result.cleanup = nx_gd32_soc_stop() == 0 ? NX_SUCCESS : NX_ERROR_IO;
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    result.primary = prepare_bus();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    return result;
}

