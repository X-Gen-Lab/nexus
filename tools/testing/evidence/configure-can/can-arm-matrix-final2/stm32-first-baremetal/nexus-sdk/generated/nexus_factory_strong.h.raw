#ifndef NEXUS_FACTORY_STRONG_H
#define NEXUS_FACTORY_STRONG_H
#include "nexus_factory.h"
#ifdef __cplusplus
#define NX_FACTORY_REF_VALUE(type, value)                                      \
    type {                                                                     \
        value                                                                  \
    }
extern "C" {
#else
#define NX_FACTORY_REF_VALUE(type, value) ((type){value})
#endif
/** \brief Explicit assembly-local ID; not a wire ABI. */
typedef struct {
    uint16_t value;
} nx_gpio_ref_t;
#define NX_GPIO_REF_COUNT NX_FACTORY_REF_VALUE(nx_gpio_ref_t, NX_GPIO_ID_COUNT)
/** \brief Pure getter; lifecycle remains explicit. */
static inline const nx_gpio_port_t* nx_factory_gpio_ref(nx_gpio_ref_t id) {
    return nx_factory_gpio(id.value);
}
