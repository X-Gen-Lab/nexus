void _init(void);
void _fini(void);
/** \brief C runtime hooks; constructors use .init_array. */
void _init(void) {}
void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static uint32_t s_nx_platform_gpio_clocks_added;
static const nx_can_filter_t s_nx_can_filters[] = {
    { 291u, 2047u, 0u, 0u, 0u, NX_CAN_STANDARD, false, true },
    { 801u, 2047u, 14u, 1u, 1u, NX_CAN_STANDARD, false, true },
};
static nx_can_filter_domain_t s_nx_can_domain = {
    .filters = s_nx_can_filters,
    .filter_count = 2u, .split = 14u
};
static nx_can_controller_t s_nx_port_bus0;
static const nx_can_port_t s_nx_face_bus0 = {
    &nx_classic_can_ops, &s_nx_port_bus0
};
const nx_can_port_t* const nx_binding_bus0 = &s_nx_face_bus0;
static nx_can_event_t s_nx_can_events_bus0[8];
static uint16_t s_nx_can_pin_snapshots_bus0[2];
static uint8_t s_nx_can_pin_leases_bus0;
static nx_result_t stop_bus0(void) {
    nx_result_t status = nx_can_port_stop(&s_nx_face_bus0);
    if (status != NX_SUCCESS) { return status; }
    if ((s_nx_can_pin_leases_bus0 & 2u) != 0u) {
        nx_stm32_pin_restore(GPIOA, 12u, s_nx_can_pin_snapshots_bus0[1]);
        s_nx_can_pin_leases_bus0 &= (uint8_t)~2u;
    }
    if ((s_nx_can_pin_leases_bus0 & 1u) != 0u) {
        nx_stm32_pin_restore(GPIOA, 11u, s_nx_can_pin_snapshots_bus0[0]);
        s_nx_can_pin_leases_bus0 &= (uint8_t)~1u;
    }
    return NX_SUCCESS;
}
static nx_result_t prepare_bus0(void) {
    nx_result_t status;
    s_nx_port_bus0 = (nx_can_controller_t){
        .domain = &s_nx_can_domain,
        .events = s_nx_can_events_bus0, .capacity = 8u,
        .timing = { 500000u, 6u, 11u, 2u, 2u },
        .drain_timeout_us = 1000u, .poll_limit = 128u,
        .mode = NX_CAN_LOOPBACK, .index = 0u,
        .fifo_order = true,
        .irq_policy = { NX_IRQ_KERNEL_NONE, 82u, 4u, 0u },
        .sources = { { .priority = 5u }, { .priority = 5u }, { .priority = 5u }, { .priority = 5u } }
    };
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_can_pin_snapshots_bus0[0] = nx_stm32_pin_capture(GPIOA, 11u);
    s_nx_can_pin_leases_bus0 |= 1u;
    status = nx_stm32_pin_configure(GPIOA, 11u, 2u, 9u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_can_pin_snapshots_bus0[1] = nx_stm32_pin_capture(GPIOA, 12u);
    s_nx_can_pin_leases_bus0 |= 2u;
    status = nx_stm32_pin_configure(GPIOA, 12u, 2u, 9u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    if (!s_nx_can_domain.configured) {
        status = nx_stm32_can_domain_initialize(&s_nx_can_domain);
        if (status != NX_SUCCESS) { return status; }
    }
    return nx_stm32_can_initialize(&s_nx_port_bus0);
}
