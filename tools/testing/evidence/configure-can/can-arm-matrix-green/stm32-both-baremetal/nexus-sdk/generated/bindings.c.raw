void CAN1_SCE_IRQHandler(void) { nx_can_controller_irq(&s_nx_port_bus0); }
static nx_can_controller_t s_nx_port_bus1;
static const nx_can_port_t s_nx_face_bus1 = {
    &nx_classic_can_ops, &s_nx_port_bus1
};
const nx_can_port_t* const nx_binding_bus1 = &s_nx_face_bus1;
static nx_can_event_t s_nx_can_events_bus1[8];
static uint16_t s_nx_can_pin_snapshots_bus1[2];
static uint8_t s_nx_can_pin_leases_bus1;
static nx_result_t stop_bus1(void) {
    nx_result_t status = nx_can_port_stop(&s_nx_face_bus1);
    if (status != NX_SUCCESS) { return status; }
    if ((s_nx_can_pin_leases_bus1 & 2u) != 0u) {
        nx_stm32_pin_restore(GPIOB, 13u, s_nx_can_pin_snapshots_bus1[1]);
        s_nx_can_pin_leases_bus1 &= (uint8_t)~2u;
    }
    if ((s_nx_can_pin_leases_bus1 & 1u) != 0u) {
        nx_stm32_pin_restore(GPIOB, 12u, s_nx_can_pin_snapshots_bus1[0]);
        s_nx_can_pin_leases_bus1 &= (uint8_t)~1u;
    }
    return NX_SUCCESS;
}
static nx_result_t prepare_bus1(void) {
    nx_result_t status;
    s_nx_port_bus1 = (nx_can_controller_t){
        .domain = &s_nx_can_domain,
        .events = s_nx_can_events_bus1, .capacity = 8u,
        .timing = { 500000u, 6u, 11u, 2u, 2u },
        .drain_timeout_us = 1000u, .poll_limit = 128u,
        .mode = NX_CAN_LOOPBACK, .index = 1u,
        .fifo_order = true,
        .irq_policy = { NX_IRQ_KERNEL_NONE, 82u, 4u, 0u },
        .sources = { { .priority = 5u }, { .priority = 5u }, { .priority = 5u }, { .priority = 5u } }
    };
    status = nx_stm32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_can_pin_snapshots_bus1[0] = nx_stm32_pin_capture(GPIOB, 12u);
    s_nx_can_pin_leases_bus1 |= 1u;
    status = nx_stm32_pin_configure(GPIOB, 12u, 2u, 9u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_can_pin_snapshots_bus1[1] = nx_stm32_pin_capture(GPIOB, 13u);
    s_nx_can_pin_leases_bus1 |= 2u;
    status = nx_stm32_pin_configure(GPIOB, 13u, 2u, 9u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    if (!s_nx_can_domain.configured) {
        status = nx_stm32_can_domain_initialize(&s_nx_can_domain);
        if (status != NX_SUCCESS) { return status; }
    }
    return nx_stm32_can_initialize(&s_nx_port_bus1);
}
