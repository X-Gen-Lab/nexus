#include "nexus_bindings.h"
#include "nexus_factory.h"
#include "nexus_config.h"
#include "nexus/arch/arch.h"
#include "gd32f470_provider.h"
#include "gd32f4xx.h"
void _init(void);
void _fini(void);
/** \brief C runtime hooks; constructors use .init_array. */
void _init(void) {}
void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static nx_gd32_gpio_state_t s_nx_port_led0;
static const nx_gpio_port_t s_nx_face_led0 = {
    &nx_gd32_gpio_ops, &s_nx_port_led0
};
const nx_gpio_port_t* const nx_binding_led0 = &s_nx_face_led0;
static nx_gd32_uart_state_t s_nx_port_uart0;
static const nx_uart_port_t s_nx_face_uart0 = {
    &nx_gd32_uart_ops, &s_nx_port_uart0
};
const nx_uart_port_t* const nx_binding_uart0 = &s_nx_face_uart0;
static nx_uart_rx_event_t s_nx_rx_uart0[32];
static nx_result_t prepare_uart0(void) {
    nx_result_t status = NX_SUCCESS;
    uint32_t saved_clocks = RCU_AHB1EN & 1u;
    uint16_t saved_PA9 = 0u;
    bool captured_PA9 = false;
    uint16_t saved_PA10 = 0u;
    bool captured_PA10 = false;
    status = nx_gd32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { goto rollback; }
    saved_PA9 = nx_gd32_pin_capture(GPIOA, 9u);
    captured_PA9 = true;
    status = nx_gd32_pin_configure(GPIOA, 9u, 2u, 7u, 1u, false);
    if (status != NX_SUCCESS) { goto rollback; }
    status = nx_gd32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { goto rollback; }
    saved_PA10 = nx_gd32_pin_capture(GPIOA, 10u);
    captured_PA10 = true;
    status = nx_gd32_pin_configure(GPIOA, 10u, 2u, 7u, 1u, false);
    if (status != NX_SUCCESS) { goto rollback; }
    status = nx_gd32_uart_initialize_at(&s_nx_port_uart0, &nx_gd32_usart0_controller, 115200u, NX_UART_RX_EVENTS, s_nx_rx_uart0, 32u, 5u);
    if (status != NX_SUCCESS) { goto rollback; }
    return NX_SUCCESS;
rollback:
    if (captured_PA10) { nx_gd32_pin_restore(GPIOA, 10u, saved_PA10); }
    if (captured_PA9) { nx_gd32_pin_restore(GPIOA, 9u, saved_PA9); }
    RCU_AHB1EN = (RCU_AHB1EN & ~1u) | saved_clocks;
    nx_arch_dsb();
    return status;
}
static nx_result_t stop_uart0(void) {
    nx_result_t status = nx_uart_port_stop(&s_nx_face_uart0);
    if (status != NX_SUCCESS) { return status; }
    (void)nx_gd32_pin_configure(GPIOA, 9u, 0u, 0u, 0u, false);
    (void)nx_gd32_pin_configure(GPIOA, 10u, 0u, 0u, 0u, false);
    return NX_SUCCESS;
}
void USART0_IRQHandler(void);
/** \brief Fixed generated UART controller dispatch. */
void USART0_IRQHandler(void) { nx_gd32_uart_irq(&s_nx_port_uart0); }
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 2u) {
        nx_result_t status_0 = stop_uart0();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 1u;
    }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = nx_gd32_gpio_stop(&s_nx_port_led0, 0u);
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started && nx_gd32_soc_stop() != 0) { return NX_ERROR_IO; }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    if (nx_gd32_soc_start() != 0) {
        result.primary = NX_ERROR_IO;
        result.cleanup = nx_gd32_soc_stop() == 0 ? NX_SUCCESS : NX_ERROR_IO;
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    result.primary = nx_gd32_gpio_initialize(&s_nx_port_led0, 3u, 128u, 0u, true);
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    result.primary = prepare_uart0();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 2u;
    return result;
}

/** \brief Pure typed lookup; lifecycle remains explicit. */
const nx_gpio_port_t* nx_factory_gpio(nx_gpio_id_t id) {
    switch (id) {
        case NX_GPIO_ID_LED0:
            return nx_binding_led0;
        default:
            return NULL;
    }
}
/** \brief Pure typed lookup; lifecycle remains explicit. */
const nx_uart_port_t* nx_factory_uart(nx_uart_id_t id) {
    switch (id) {
        case NX_UART_ID_UART0:
            return nx_binding_uart0;
        default:
            return NULL;
    }
}
