void _init(void);
void _fini(void);
/** \brief C runtime hooks; constructors use .init_array. */
void _init(void) {}
void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static uint32_t s_nx_platform_gpio_clocks_added;
static nx_usb_controller_t s_nx_port_fs;
static const nx_usb_device_port_t s_nx_face_fs = {
    &nx_usb_fs_device_ops, &s_nx_port_fs
};
const nx_usb_device_port_t* const nx_binding_fs = &s_nx_face_fs;
static nx_stm32_usb_clock_state_t s_nx_usb_clock_fs;
static nx_usb_endpoint_t s_nx_usb_endpoints_fs[4];
static nx_usb_event_t s_nx_usb_events_fs[8];
static uint16_t s_nx_usb_pin_snapshots_fs[2];
static uint8_t s_nx_usb_pin_leases_fs;
static const nx_usb_endpoint_port_t s_nx_device_face_control_in = {
    &nx_usb_fs_endpoint_ops, &s_nx_usb_endpoints_fs[0]
};
const nx_usb_endpoint_port_t* const nx_device_control_in = &s_nx_device_face_control_in;
static const nx_usb_endpoint_port_t s_nx_device_face_control_out = {
    &nx_usb_fs_endpoint_ops, &s_nx_usb_endpoints_fs[1]
};
const nx_usb_endpoint_port_t* const nx_device_control_out = &s_nx_device_face_control_out;
static const nx_usb_endpoint_port_t s_nx_device_face_bulk_in = {
    &nx_usb_fs_endpoint_ops, &s_nx_usb_endpoints_fs[2]
};
const nx_usb_endpoint_port_t* const nx_device_bulk_in = &s_nx_device_face_bulk_in;
static const nx_usb_endpoint_port_t s_nx_device_face_bulk_out = {
    &nx_usb_fs_endpoint_ops, &s_nx_usb_endpoints_fs[3]
};
const nx_usb_endpoint_port_t* const nx_device_bulk_out = &s_nx_device_face_bulk_out;
static nx_result_t stop_fs(void) {
    nx_result_t status = nx_usb_device_stop(&s_nx_face_fs);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_usb_clock_stop(&s_nx_usb_clock_fs,
        nx_deadline_after(nx_time_now_us(), 5000u));
    if (status != NX_SUCCESS) { return status; }
    if ((s_nx_usb_pin_leases_fs & 2u) != 0u) {
        nx_stm32_pin_restore(GPIOA, 12u, s_nx_usb_pin_snapshots_fs[1]);
        if (nx_stm32_pin_capture(GPIOA, 12u) != s_nx_usb_pin_snapshots_fs[1]) {
            return NX_ERROR_IO;
        }
        s_nx_usb_pin_leases_fs &= (uint8_t)~2u;
    }
    if ((s_nx_usb_pin_leases_fs & 1u) != 0u) {
        nx_stm32_pin_restore(GPIOA, 11u, s_nx_usb_pin_snapshots_fs[0]);
        if (nx_stm32_pin_capture(GPIOA, 11u) != s_nx_usb_pin_snapshots_fs[0]) {
            return NX_ERROR_IO;
        }
        s_nx_usb_pin_leases_fs &= (uint8_t)~1u;
    }
    return NX_SUCCESS;
}
static nx_result_t prepare_fs(void) {
    nx_result_t status;
    s_nx_usb_endpoints_fs[0] = (nx_usb_endpoint_t){
        .number = 0u, .in = true,
        .bulk = false, .max_packet = 64u,
        .fifo_start = 96u, .fifo_words = 32u
    };
    s_nx_usb_endpoints_fs[1] = (nx_usb_endpoint_t){
        .number = 0u, .in = false,
        .bulk = false, .max_packet = 64u,
        .fifo_start = 0u, .fifo_words = 0u
    };
    s_nx_usb_endpoints_fs[2] = (nx_usb_endpoint_t){
        .number = 1u, .in = true,
        .bulk = true, .max_packet = 64u,
        .fifo_start = 128u, .fifo_words = 32u
    };
    s_nx_usb_endpoints_fs[3] = (nx_usb_endpoint_t){
        .number = 1u, .in = false,
        .bulk = true, .max_packet = 64u,
        .fifo_start = 0u, .fifo_words = 0u
    };
    s_nx_port_fs = (nx_usb_controller_t){
        .endpoints = s_nx_usb_endpoints_fs, .endpoint_count = 4u,
        .events = s_nx_usb_events_fs, .capacity = 8u,
        .irq_policy = { NX_IRQ_KERNEL_NONE, 82u, 4u, 0u },
        .irq = { .priority = 5u },
        .poll_limit = 128u, .drain_timeout_us = 1000u,
        .rx_fifo_words = 96u, .vbus_sensing = false
    };
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_usb_pin_snapshots_fs[0] = nx_stm32_pin_capture(GPIOA, 11u);
    s_nx_usb_pin_leases_fs |= 1u;
    status = nx_stm32_pin_configure(GPIOA, 11u, 2u, 10u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_usb_pin_snapshots_fs[1] = nx_stm32_pin_capture(GPIOA, 12u);
    s_nx_usb_pin_leases_fs |= 2u;
    status = nx_stm32_pin_configure(GPIOA, 12u, 2u, 10u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_usb_clock_start(&s_nx_usb_clock_fs, true,
        nx_deadline_after(nx_time_now_us(), 5000u));
    if (status != NX_SUCCESS) { return status; }
    return nx_stm32_usb_device_initialize(&s_nx_port_fs, &s_nx_usb_clock_fs);
}
void OTG_FS_IRQHandler(void);
/** \brief Dispatch the selected internal-PHY FS PIO controller. */
void OTG_FS_IRQHandler(void) { nx_usb_controller_irq(&s_nx_port_fs); }
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = stop_fs();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started) { RCC->AHB1ENR &= ~s_nx_platform_gpio_clocks_added; }
    nx_arch_dsb();
    if (s_nx_platform_started && nx_stm32_system_stop(&g_nx_stm32_system, 1000000u) != 0) {
        return NX_ERROR_IO;
    }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    s_nx_platform_gpio_clocks_added = 0u;
    result.primary = nx_stm32_validate_identity(1048576u);
    if (result.primary != NX_SUCCESS) { return result; }
    nx_stm32_start_result_t system = nx_stm32_system_start(&g_nx_stm32_system, 1000000u);
    if (system.primary != 0) {
        result.primary = NX_ERROR_IO;
        result.cleanup = system.cleanup == 0 ? NX_SUCCESS : NX_ERROR_IO;
        result.remaining_effects = system.remaining_effects;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    s_nx_platform_gpio_clocks_added = ~RCC->AHB1ENR & 1u;
    s_nx_platform_initialized = 1u;
    result.primary = prepare_fs();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    return result;
}

