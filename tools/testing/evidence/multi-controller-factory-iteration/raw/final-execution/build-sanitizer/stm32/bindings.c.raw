    NX_PLATFORM_REGISTER_WRITE(RCC->APB1ENR, RCC->APB1ENR | RCC_APB1ENR_USART2EN);
    nx_arch_dsb();
    if ((RCC->APB1ENR & RCC_APB1ENR_USART2EN) == 0u) { return NX_ERROR_IO; }
    if ((USART2->CR1 & 8192u) != 0u) { return NX_ERROR_BUSY; }
    s_nx_pair_priorities_secondary_uart[0] = NVIC->IP[38];
    s_nx_pair_priorities_secondary_uart[1] = NVIC->IP[17];
    s_nx_pair_vectors_secondary_uart = true;
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_secondary_uart[0] = nx_stm32_pin_capture(GPIOA, 2u);
    s_nx_pair_pin_leases_secondary_uart |= 1u;
    NX_PLATFORM_REGISTER_WRITE(GPIOA->BSRR, 4u);
    nx_arch_dsb();
    if ((GPIOA->ODR & 4u) == 0u) { return NX_ERROR_IO; }
    status = nx_stm32_pin_configure(GPIOA, 2u, 2u, 7u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_stm32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_secondary_uart[1] = nx_stm32_pin_capture(GPIOA, 3u);
    s_nx_pair_pin_leases_secondary_uart |= 2u;
    status = nx_stm32_pin_configure(GPIOA, 3u, 2u, 7u, 1u, false);
    if (status != NX_SUCCESS) { return status; }
    s_nx_port_secondary_uart.regions = s_nx_dma_regions_secondary_uart;
    s_nx_port_secondary_uart.region_count = 2u;
    s_nx_port_secondary_uart.uart.registers = USART2;
    s_nx_port_secondary_uart.uart.baud = 115200u;
    s_nx_port_secondary_uart.uart.profile = NX_UART_RX_BYTES;
    s_nx_port_secondary_uart.uart.rx_storage = s_nx_rx_secondary_uart;
    s_nx_port_secondary_uart.uart.rx_capacity = 32u;
    s_nx_port_secondary_uart.uart.irq = USART2_IRQn;
    s_nx_port_secondary_uart.dma = DMA1;
    s_nx_port_secondary_uart.tx = DMA1_Stream6;
    s_nx_port_secondary_uart.dma_irq = DMA1_Stream6_IRQn;
    s_nx_port_secondary_uart.stream = 6u;
    s_nx_port_secondary_uart.channel = 4u;
    status = nx_stm32_uart_dma_initialize(&s_nx_port_secondary_uart, 42000000u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_constructed_secondary_uart = true;
    if ((RCC->APB1ENR & RCC_APB1ENR_USART2EN) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[38], 80u);
    nx_arch_dsb();
    if (NVIC->IP[38] != 80u || (NVIC->ISER[1] & 64u) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[17], 80u);
    nx_arch_dsb();
    if (NVIC->IP[17] != 80u || (NVIC->ISER[0] & 131072u) == 0u) { return NX_ERROR_IO; }
    return NX_SUCCESS;
}
void USART2_IRQHandler(void);
/** \brief Dispatch the exact independently owned controller. */
void USART2_IRQHandler(void) { nx_stm32_uart_dma_uart_irq(&s_nx_port_secondary_uart); }
void DMA1_Stream6_IRQHandler(void);
/** \brief Dispatch the exact independently owned controller. */
void DMA1_Stream6_IRQHandler(void) { nx_stm32_uart_dma_irq(&s_nx_port_secondary_uart); }
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked() || !nx_arch_is_privileged()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 5u) {
        nx_result_t status_0 = stop_secondary_uart();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 4u;
    }
    if (s_nx_platform_initialized >= 4u) {
        nx_result_t status_0 = stop_primary_uart();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 3u;
    }
    if (s_nx_platform_initialized >= 3u) {
        nx_result_t status_0 = stop_secondary_spi();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 2u;
    }
    if (s_nx_platform_initialized >= 2u) {
        nx_result_t status_0 = stop_primary_spi();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 1u;
    }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = stop_secondary_i2c();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started) {
        NX_PLATFORM_REGISTER_WRITE(RCC->AHB1ENR,
            RCC->AHB1ENR & ~s_nx_platform_gpio_clocks_added);
        nx_arch_dsb();
        if ((RCC->AHB1ENR & s_nx_platform_gpio_clocks_added) != 0u) {
            return NX_ERROR_IO;
        }
        s_nx_platform_gpio_clocks_added = 0u;
    }
    if (s_nx_platform_started) {
        NX_PLATFORM_REGISTER_WRITE(RCC->AHB1ENR,
            RCC->AHB1ENR & ~s_nx_platform_dma_clocks_added);
        nx_arch_dsb();
        if ((RCC->AHB1ENR & s_nx_platform_dma_clocks_added) != 0u) {
            return NX_ERROR_IO;
        }
        s_nx_platform_dma_clocks_added = 0u;
    }
    nx_arch_dsb();
    if (s_nx_platform_started && nx_stm32_system_stop(&g_nx_stm32_system, 1000000u) != 0) {
        return NX_ERROR_IO;
    }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked() || !nx_arch_is_privileged()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    s_nx_platform_dma_clocks_added = 0u;
    s_nx_platform_gpio_clocks_added = 0u;
    result.primary = nx_stm32_validate_identity(1048576u);
    if (result.primary != NX_SUCCESS) { return result; }
    nx_stm32_start_result_t system = nx_stm32_system_start(&g_nx_stm32_system, 1000000u);
    if (system.primary != 0) {
        result.primary = NX_ERROR_IO;
        result.cleanup = system.cleanup == 0 ? NX_SUCCESS : NX_ERROR_IO;
        result.remaining_effects = system.remaining_effects;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    s_nx_platform_dma_clocks_added = ~RCC->AHB1ENR & (RCC_AHB1ENR_DMA1EN | RCC_AHB1ENR_DMA2EN);
    RCC->AHB1ENR |= (RCC_AHB1ENR_DMA1EN | RCC_AHB1ENR_DMA2EN);
    (void)RCC->AHB1ENR;
    nx_arch_dsb();
    s_nx_platform_gpio_clocks_added = ~RCC->AHB1ENR & 19u;
    s_nx_platform_initialized = 1u;
    result.primary = prepare_secondary_i2c();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    s_nx_platform_initialized = 2u;
    result.primary = prepare_primary_spi();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 2u;
    s_nx_platform_initialized = 3u;
    result.primary = prepare_secondary_spi();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 3u;
    s_nx_platform_initialized = 4u;
    result.primary = prepare_primary_uart();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 4u;
    s_nx_platform_initialized = 5u;
    result.primary = prepare_secondary_uart();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 5u;
    return result;
}

