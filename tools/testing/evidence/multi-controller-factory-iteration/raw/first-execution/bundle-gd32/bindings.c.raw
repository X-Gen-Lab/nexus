    s_nx_port_secondary_i2c.line_inputs = &GPIO_ISTAT(GPIOB);
    s_nx_port_secondary_i2c.line_mask = 3072u;
    s_nx_port_secondary_i2c.peripheral_mhz = 50u;
    s_nx_port_secondary_i2c.dma = &s_nx_pair_dma_secondary_i2c;
    status = nx_gd32_i2c_async_initialize(&s_nx_port_secondary_i2c, 5u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_constructed_secondary_i2c = true;
    s_nx_endpoint_secondary_i2c.port = &s_nx_port_secondary_i2c;
    s_nx_endpoint_secondary_i2c.address = 80u;
    if ((RCU_APB1EN & RCU_APB1EN_I2C1EN) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[33], 80u);
    nx_arch_dsb();
    if (NVIC->IP[33] != 80u || (NVIC->ISER[1] & 2u) == 0u) { return NX_ERROR_IO; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[34], 80u);
    nx_arch_dsb();
