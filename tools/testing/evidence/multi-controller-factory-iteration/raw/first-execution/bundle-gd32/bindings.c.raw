    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[47], 80u);
    nx_arch_dsb();
    if (NVIC->IP[47] != 80u || (NVIC->ISER[1] & 32768u) == 0u) { return NX_ERROR_IO; }
