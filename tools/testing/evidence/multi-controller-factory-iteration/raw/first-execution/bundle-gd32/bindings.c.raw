    status = nx_gd32_spi_endpoint_initialize(&s_nx_port_primary_spi.spi, &s_nx_endpoint_primary_spi.endpoint, GPIOF, 64u, 1000000u, 0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_endpoint_primary_spi.dma = &s_nx_port_primary_spi;
    if ((RCU_APB2EN & RCU_APB2EN_SPI4EN) == 0u) { return NX_ERROR_IO; }
