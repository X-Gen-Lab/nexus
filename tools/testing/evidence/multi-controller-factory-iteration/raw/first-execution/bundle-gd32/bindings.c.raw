    NX_PLATFORM_REGISTER_WRITE(RCU_APB1EN, RCU_APB1EN | RCU_APB1EN_I2C1EN);
    nx_arch_dsb();
    if ((RCU_APB1EN & RCU_APB1EN_I2C1EN) == 0u) { return NX_ERROR_IO; }
    if ((I2C_CTL0(I2C1) & 1u) != 0u) { return NX_ERROR_BUSY; }
    s_nx_pair_priorities_secondary_i2c[0] = NVIC->IP[33];
    s_nx_pair_priorities_secondary_i2c[1] = NVIC->IP[34];
    s_nx_pair_priorities_secondary_i2c[2] = NVIC->IP[13];
    s_nx_pair_priorities_secondary_i2c[3] = NVIC->IP[47];
    s_nx_pair_vectors_secondary_i2c = true;
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_secondary_i2c[0] = nx_gd32_pin_capture(GPIOB, 10u);
    s_nx_pair_pin_leases_secondary_i2c |= 1u;
    status = nx_gd32_pin_configure(GPIOB, 10u, 2u, 4u, 0u, true);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_secondary_i2c[1] = nx_gd32_pin_capture(GPIOB, 11u);
    s_nx_pair_pin_leases_secondary_i2c |= 2u;
    status = nx_gd32_pin_configure(GPIOB, 11u, 2u, 4u, 0u, true);
    if (status != NX_SUCCESS) { return status; }
