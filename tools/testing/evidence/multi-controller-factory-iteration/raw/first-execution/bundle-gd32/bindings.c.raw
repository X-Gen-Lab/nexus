    s_nx_pair_pin_saved_primary_spi[0] = nx_gd32_pin_capture(GPIOF, 6u);
    s_nx_pair_pin_leases_primary_spi |= 1u;
    NX_PLATFORM_REGISTER_WRITE(GPIO_BOP(GPIOF), 64u);
    nx_arch_dsb();
    if ((GPIO_OCTL(GPIOF) & 64u) == 0u) { return NX_ERROR_IO; }
    status = nx_gd32_pin_configure(GPIOF, 6u, 1u, 0u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_gpio_clock_enable(5u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_primary_spi[1] = nx_gd32_pin_capture(GPIOF, 7u);
    s_nx_pair_pin_leases_primary_spi |= 2u;
    status = nx_gd32_pin_configure(GPIOF, 7u, 2u, 5u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_gpio_clock_enable(5u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_primary_spi[2] = nx_gd32_pin_capture(GPIOF, 8u);
    s_nx_pair_pin_leases_primary_spi |= 4u;
    status = nx_gd32_pin_configure(GPIOF, 8u, 2u, 5u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_gpio_clock_enable(5u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_pair_pin_saved_primary_spi[3] = nx_gd32_pin_capture(GPIOF, 9u);
    s_nx_pair_pin_leases_primary_spi |= 8u;
    status = nx_gd32_pin_configure(GPIOF, 9u, 2u, 5u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    s_nx_port_primary_spi.regions = s_nx_dma_regions_primary_spi;
    s_nx_port_primary_spi.region_count = 3u;
    status = nx_gd32_spi_dma_initialize_at(&s_nx_port_primary_spi, &s_nx_endpoint_primary_spi, &nx_gd32_spi4_controller, GPIOF, 64u, 1000000u, 0u, 5u);
