#include "stm32g474_provider.h"
#include "nexus/core/time.h"
#include "nexus/arch/arch.h"
#ifndef NX_G474_WORKLOAD
#define NX_G474_WORKLOAD 0
#endif
void _init(void);
void _fini(void);
/* Freestanding C newlib CRT hooks; no constructors or finalizers are selected. */
void _init(void) {}
void _fini(void) {}
#if NX_G474_WORKLOAD == 1 || NX_G474_WORKLOAD == 3
static nx_stm32g474_gpio_state_t led = {.registers=GPIOA,.mask=1U<<5U,.output=true};
static const nx_gpio_port_t led_face = {&nx_stm32g474_gpio_ops,&led};
#endif
#if NX_G474_WORKLOAD >= 2
static uint8_t receive[64];
static const uint8_t payload[] = "Nexus G474 baseline\r\n";
static nx_uart_tx_request_t request;
static nx_stm32g474_uart_state_t console = {.registers=LPUART1,.rx_storage=receive,.rx_capacity=sizeof(receive),.baud=115200,.irq=LPUART1_IRQn,.profile=NX_UART_RX_BYTES,.irq_policy={NX_IRQ_KERNEL_NONE,102,4,0}};
static const nx_uart_port_t console_face = {&nx_stm32g474_uart_ops,&console};
void LPUART1_IRQHandler(void);
void LPUART1_IRQHandler(void) {nx_stm32g474_uart_irq(&console);}
#endif
int main(void) {
 nx_stm32g474_start_result_t startup = nx_stm32g474_system_start(&g_nx_stm32g474_system,1000000U);
 if(startup.primary!=NX_SUCCESS) for(;;) __WFI();
#if NX_G474_WORKLOAD == 1 || NX_G474_WORKLOAD == 3
 if(nx_stm32g474_gpio_clock_enable(0U)!=NX_SUCCESS || nx_stm32g474_gpio_initialize(&led,0U)!=NX_SUCCESS) for(;;) __WFI();
#endif
#if NX_G474_WORKLOAD >= 2
 if(nx_stm32g474_lpuart1_pins_prepare()!=NX_SUCCESS || nx_stm32g474_uart_initialize(&console,170000000U,1000000U)!=NX_SUCCESS) for(;;) __WFI();
 nx_request_initialize(&request.base);
 if(nx_uart_tx_prepare(&request,payload,sizeof(payload)-1U,nx_time_now_us()+2000000U)!=NX_SUCCESS || nx_uart_port_submit(&console_face,&request)!=NX_SUCCESS) for(;;) __WFI();
#endif
 for(;;) {
#if NX_G474_WORKLOAD == 1 || NX_G474_WORKLOAD == 3
  (void)nx_gpio_port_toggle(&led_face,1U<<5U);
#endif
#if NX_G474_WORKLOAD >= 2
  uint8_t bytes[8];size_t count;
  (void)nx_uart_port_service(&console_face);
  (void)nx_uart_port_read_bytes(&console_face,bytes,sizeof(bytes),&count);
#endif
  __WFI();
 }
}
