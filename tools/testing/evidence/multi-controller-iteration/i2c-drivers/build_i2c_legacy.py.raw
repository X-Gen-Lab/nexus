"""Freshly compile the three maintained legacy provider suites."""
from pathlib import Path
import subprocess
import sys

root = Path('/workspace/nexus')
out = Path('/workspace/nexus-multi-controller-iteration')
mode, label = sys.argv[1:]
family = {'generic': None, 'stm': 'stm32f407', 'gd': 'gd32f470'}[mode]
flags = ['-D_POSIX_C_SOURCE=200809L', '-Wall', '-Wextra', '-Werror', '-Wpedantic', '-Wconversion', '-Wshadow',
         '-include', 'tests/google/i2c_async_register_model.h']
inc = ['-Icore/include', '-Iarch/include', '-Iio/include', '-Iio/private',
       '-Isoc/common', '-I' + str(out / ('config-gd' if mode == 'gd' else 'config-stm'))]
if family:
    inc += ['-Isoc/' + family + '/private']
if mode == 'stm':
    flags += ['-DSTM32F407xx', '-DNX_I2C_TEST_STM32', '-DNEXUS_STM32_MODEL']
    inc += ['-isystem', 'vendors/st/cmsis_device_f4/Include', '-isystem',
            'vendors/arm/CMSIS_5/CMSIS/Core/Include']
elif mode == 'gd':
    flags += ['-DGD32F470', '-DHXTAL_VALUE=25000000', '-DNX_I2C_TEST_GD32',
              '-Wno-int-to-pointer-cast']
    inc += ['-Itests/contracts/gd32_model', '-isystem',
            'vendors/gigadevice/gd32f4xx/Firmware/CMSIS/GD/GD32F4xx/Include',
            '-isystem',
            'vendors/gigadevice/gd32f4xx/Firmware/GD32F4xx_standard_peripheral/Include']
google = ['-isystem',
          'build/adc-iteration/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googlemock/include',
          '-isystem',
          'build/adc-iteration/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googletest/include']
sources = ['soc/common/i2c_v1_async.c', 'core/src/request.c', 'core/src/time.c',
           'io/src/i2c.c', 'io/src/dma.c', 'io/src/wake.c',
           'arch/native/nx_arch_native.c']
if family:
    sources += ['soc/' + family + '/drivers/i2c_async.c']
objects = []
for source in ['tests/google/i2c_async_register_test.cpp', *sources]:
    cpp = source.endswith('.cpp')
    compiler = 'g++' if cpp else 'gcc'
    lang = ['-std=c++17', *google] if cpp else [
        '-std=c11', '-Wstrict-prototypes', '-Wmissing-prototypes']
    obj = out / (mode + '-legacy-' + source.replace('/', '-') + '.o')
    subprocess.run([sys.executable, str(out / 'run.py'),
                    label + '-' + source.replace('/', '-'),
                    compiler, *flags, *inc, *lang, '-c', source, '-o', str(obj)],
                   cwd=root, check=True)
    objects.append(str(obj))
libs = ['build/adc-iteration/lib/libgmock_main.a',
        'build/adc-iteration/lib/libgmock.a', 'build/adc-iteration/lib/libgtest.a']
subprocess.run([sys.executable, str(out / 'run.py'), label + '-link', 'g++',
                *objects, *libs, '-pthread', '-o',
                str(out / (mode + '-i2c-legacy-test'))], cwd=root, check=True)
