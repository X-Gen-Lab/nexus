"""Strict SDK objects and actual current/baseline mutable layouts; no silicon claim."""
from pathlib import Path
import hashlib
import json
import subprocess
import sys
root = Path('/workspace/nexus')
external = Path('/workspace/nexus-multi-controller-iteration')
evidence = root / 'tools/testing/evidence/multi-controller-iteration'
label = sys.argv[1]
out = evidence / label
out.mkdir(exist_ok=False)
tool = Path('/workspace/nexus-tools-arm/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gcc')
def identity(path):
    b = path.read_bytes()
    return {'path': str(path), 'bytes': len(b), 'sha256': hashlib.sha256(b).hexdigest()}
def run(name, *argv):
    subprocess.run([sys.executable, str(external / 'run.py'), label + '-' + name, *map(str, argv)], cwd=root, check=True)
flags = ['-std=c11', '-mcpu=cortex-m4', '-mthumb', '-mfpu=fpv4-sp-d16', '-mfloat-abi=hard', '-Os', '-ffunction-sections', '-fdata-sections', '-Wall', '-Wextra', '-Werror', '-Wpedantic', '-Wconversion', '-Wshadow', '-Wstrict-prototypes', '-Wmissing-prototypes']
inc = ['-Icore/include', '-Iarch/include', '-Iio/include', '-Iio/private']
head = subprocess.check_output(['git', '-C', str(root), 'rev-parse', 'HEAD'], text=True).strip()
report = {'schema_version': 1, 'kind': 'finite_dma_secondary_sdk_objects_and_layout', 'status': 'running', 'scope': 'Development snapshot actual Cortex-M4F SDK compilation and object/layout costs; not selected whole-image, cycles or physical qualification.', 'comparison_head': head, 'compiler': identity(tool), 'physical_status': 'not_executed', 'cycles_status': 'not_measured', 'families': [], 'source_inputs': []}
allinputs = {}
for family, define, config in [('stm32f407', 'STM32F407xx', Path('/workspace/nexus-config-iteration-evidence/can-arm-matrix-final/stm32-first-freertos/nexus-sdk/generated')), ('gd32f470', 'GD32F470', Path('/workspace/nexus-config-iteration-evidence/can-arm-matrix-final/gd32-both-freertos/nexus-sdk/generated'))]:
    extra = ['-D' + define, '-Isoc/' + family, '-Isoc/' + family + '/private', '-I' + str(config)]
    if family == 'stm32f407':
        extra += ['-isystem', 'vendors/st/cmsis_device_f4/Include', '-isystem', 'vendors/arm/CMSIS_5/CMSIS/Core/Include']
        headers = ['soc/' + family + '/private/' + family + '_dma.h']
    else:
        extra += ['-DHXTAL_VALUE=25000000', '-isystem', 'vendors/gigadevice/gd32f4xx/Firmware/CMSIS', '-isystem', 'vendors/gigadevice/gd32f4xx/Firmware/CMSIS/GD/GD32F4xx/Include', '-isystem', 'vendors/gigadevice/gd32f4xx/Firmware/GD32F4xx_standard_peripheral/Include']
        headers = ['soc/' + family + '/private/' + family + '_dma.h', 'soc/' + family + '/private/' + family + '_spi_dma.h']
    rows = []
    def compile_one(source, name):
        obj = out / (name + '.o')
        deps = out / (name + '.d.raw')
        run(name, tool, *flags, *inc, *extra, '-MD', '-MF', deps, '-x', 'c', '-c', source, '-o', obj)
        dependency_text = deps.read_text().replace(chr(92) + chr(10), ' ')
        for rel in dependency_text.split(': ', 1)[1].split():
            path = Path(rel)
            if not path.is_absolute(): path = root / path
            if path.is_file(): allinputs[str(path)] = identity(path)
        raw = out / (name + '.size.raw')
        raw.write_bytes(subprocess.check_output([str(tool.with_name('arm-none-eabi-size')), '-A', str(obj)]))
        sections = [line.split() for line in raw.read_text().splitlines() if line.startswith(('.text', '.rodata', '.data', '.bss'))]
        return {'source': identity(Path(source)), 'object': identity(obj), 'dependencies': identity(deps), 'size': identity(raw), 'text_rodata_bytes': sum(int(r[1]) for r in sections if r[0].startswith(('.text', '.rodata'))), 'global_data_bss_bytes': sum(int(r[1]) for r in sections if r[0].startswith(('.data', '.bss')))}
    for driver in ['uart.c', 'uart_dma.c', 'spi.c', 'spi_dma.c']:
        path = root / 'soc' / family / 'drivers' / driver
        current = compile_one(path, family + '-current-' + driver)
        baseline_path = out / (family + '-baseline-' + driver + '.raw')
        baseline_path.write_bytes(subprocess.check_output(['git', '-C', str(root), 'show', head + ':' + str(path.relative_to(root))]))
        baseline = compile_one(baseline_path, family + '-baseline-' + driver)
        assert current['global_data_bss_bytes'] == baseline['global_data_bss_bytes']
        rows.append({'driver': driver, 'current': current, 'baseline': baseline, 'object_flash_delta_bytes': current['text_rodata_bytes'] - baseline['text_rodata_bytes']})
    layouts = []
    for version in ['current', 'baseline']:
        fixture = out / (family + '-' + version + '-types.c.raw')
        includes = []
        for header in headers:
            if version == 'baseline':
                path = out / (family + '-baseline-' + Path(header).name + '.raw')
                path.write_bytes(subprocess.check_output(['git', '-C', str(root), 'show', head + ':' + header]))
            else: path = root / header
            includes.append('#include "' + str(path) + '"')
        prefix = 'nx_stm32_' if family == 'stm32f407' else 'nx_gd32_'
        fixture.write_text('\n'.join(includes) + '\n' + '\n'.join('unsigned char ' + kind + '_size[sizeof(' + prefix + kind + '_t)];' for kind in ['uart_state', 'uart_dma_state', 'spi_state', 'spi_dma_state', 'spi_dma_endpoint_state']) + '\n')
        row = compile_one(fixture, family + '-' + version + '-types')
        raw = out / (family + '-' + version + '-types.nm.raw')
        raw.write_bytes(subprocess.check_output([str(tool.with_name('arm-none-eabi-nm')), '-S', '--radix=d', row['object']['path']]))
        layout = {parts[-1]: int(parts[1]) for line in raw.read_text().splitlines() if len(parts := line.split()) == 4}
        layouts.append({'version': version, 'fixture': identity(fixture), 'object': row['object'], 'nm': identity(raw), 'layout': layout})
    assert layouts[0]['layout'] == layouts[1]['layout']
    report['families'].append({'family': family, 'objects': rows, 'layouts': layouts, 'mutable_layout_equal': True, 'generated_cpu_config': identity(config / 'nexus_config.h')})
report['source_inputs'] = list(allinputs.values())
for item in report['source_inputs']: assert identity(Path(item['path'])) == item
report['source_inputs_stable'] = True
report['status'] = 'passed'
(out / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
print(json.dumps({'status': 'passed', 'families': [{'family': row['family'], 'layout': row['layouts'][0]['layout'], 'object_deltas': {p['driver']: p['object_flash_delta_bytes'] for p in row['objects']}} for row in report['families']]}, indent=2))
