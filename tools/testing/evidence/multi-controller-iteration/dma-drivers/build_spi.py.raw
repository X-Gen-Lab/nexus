"""Fresh actual finite SPI DMA provider test build, with external MMIO model."""
from pathlib import Path
import subprocess
import sys

root = Path('/workspace/nexus')
out = Path('/workspace/nexus-multi-controller-iteration')
mode, label, *options = sys.argv[1:]
san = options == ['san']
family = 'stm32f407' if mode == 'stm' else 'gd32f470'
flags = (['-fsanitize=address,undefined', '-fno-omit-frame-pointer', '-g'] if san else []) + ['-Wall', '-Wextra', '-Werror', '-Wpedantic', '-Wconversion', '-Wshadow', '-include', 'tests/google/spi_multi_controller_model.h']
inc = ['-Icore/include', '-Iarch/include', '-Iio/include', '-Iio/private', '-Isoc/' + family + '/private', '-Isoc/gd32f470', '-Isoc/gd32f470/private', '-Itests/contracts/gd32_model', '-Itests/contracts/dma_multi_controller', '-isystem', 'vendors/gigadevice/gd32f4xx/Firmware/CMSIS/GD/GD32F4xx/Include', '-isystem', 'vendors/gigadevice/gd32f4xx/Firmware/GD32F4xx_standard_peripheral/Include']
flags += ['-DGD32F470', '-DHXTAL_VALUE=25000000']
if mode == 'stm':
    flags += ['-DSTM32F407xx', '-DNX_DMA_MULTI_STM32']
    inc += ['-isystem', 'vendors/st/cmsis_device_f4/Include']
google = ['-isystem', 'build/adc-iteration/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googlemock/include', '-isystem', 'build/adc-iteration/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googletest/include']
sources = ['tests/google/spi_multi_controller_test.cpp', 'soc/' + family + '/drivers/spi.c', 'soc/' + family + '/drivers/spi_dma.c', 'tests/contracts/gd32_model/model.c', 'core/src/request.c', 'core/src/time.c', 'io/src/spi.c', 'io/src/dma.c', 'io/src/wake.c']
sources += ['soc/' + family + '/drivers/gpio.c'] if mode == 'stm' else []
objects = []
for source in sources:
    cpp = source.endswith('.cpp')
    lang = ['-std=c++17', *google] if cpp else ['-std=c11', '-Wstrict-prototypes', '-Wmissing-prototypes', '-Wno-int-to-pointer-cast']
    obj = out / (mode + '-spi-' + ('san-' if san else '') + source.replace('/', '-') + '.o')
    subprocess.run([sys.executable, str(out / 'run.py'), label + '-' + source.replace('/', '-'), 'g++' if cpp else 'gcc', *flags, *inc, *lang, '-c', source, '-o', str(obj)], cwd=root, check=True)
    objects.append(str(obj))
libs = ['build/adc-iteration/lib/libgmock_main.a', 'build/adc-iteration/lib/libgmock.a', 'build/adc-iteration/lib/libgtest.a']
subprocess.run([sys.executable, str(out / 'run.py'), label + '-link', 'g++', *(['-fsanitize=address,undefined'] if san else []), *objects, *libs, '-pthread', '-o', str(out / (mode + '-spi-' + ('san-' if san else '') + 'test'))], cwd=root, check=True)
