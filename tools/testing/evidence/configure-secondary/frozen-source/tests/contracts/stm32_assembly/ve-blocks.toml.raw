schema = 2
board_package = "ve_board"
backend = "baremetal"
clock = "hse8-pll168"
optimization = "Os"

[memory]
main_stack_bytes = 2048
flash_load_limit_bytes = 65536
static_ram_limit_bytes = 16384
libc_heap_bytes = 0

[spi.spi0]
binding = "spi0"
mode = "dma"
max_hz = 1000000

[spi.spi0.irq]
priority = 5

[spi_device.sensor0]
controller = "spi0"
driver = "spi-endpoint"
cs_binding = "cs0"
mode = 0
max_hz = 1000000

[uart.uart1]
binding = "uart1"
mode = "irq-blocks"
baud = 115200
[uart.uart1.rx]
format = "blocks"
[uart.uart1.irq]
priority = 5

[adc.adc0]
binding = "adc_scan"
mode = "trigger-dma"
channels = [0, 1]
sample_times = [7, 7]
reference_mv = 3300
[adc.adc0.irq]
priority = 5
