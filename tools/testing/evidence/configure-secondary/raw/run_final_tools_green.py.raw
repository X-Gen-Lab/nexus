"""Bind fresh configuration tests to their current tool and input closure."""
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path('/workspace/nexus')
OUTPUT = Path(__file__).parent / 'final-tools-green'
OUTPUT.mkdir(exist_ok=False)


def identities():
    paths = set((ROOT / 'tools/configure').rglob('*.py'))
    paths.update((ROOT / 'tools/configure').glob('*.json'))
    paths.update((ROOT / 'tools/configure/assemblies').glob('*.toml'))
    paths.update((ROOT / 'soc').glob('*/soc.json'))
    paths.update((ROOT / 'soc').glob('*/routes.json'))
    paths.update((ROOT / 'boards').glob('*/board.json'))
    paths.update((ROOT / 'tests/contracts').rglob('*.toml'))
    paths.update((ROOT / 'tests/contracts').rglob('board.json'))
    paths.update((ROOT / 'io/include').rglob('*.h'))
    paths.update((ROOT / 'soc').rglob('*.c'))
    paths.update((ROOT / 'io').rglob('*.c'))
    paths.update(ROOT / item for item in (
        'tools/maintenance/capabilities.py', 'tools/measurement/retention.py',
        'dependencies/platform-compatibility.json', 'dependencies/stm32g4.lock.json',
        'tests/contracts/stm32_model/generate_constructors.py'))
    return [{'path': path.relative_to(ROOT).as_posix(),
             'size': path.stat().st_size,
             'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
            for path in sorted(paths)]


command = [str(ROOT / '.venv/bin/python'), '-m', 'unittest',
           'discover', '-s', 'tools/configure', '-p', 'test_*.py', '-v']
before = identities()
started = datetime.now(timezone.utc).isoformat()
environment = dict(os.environ)
environment['PATH'] = str(ROOT / '.venv/bin') + ':' + environment['PATH']
with (OUTPUT / 'configure.log').open('wb') as stream:
    result = subprocess.run(command, cwd=ROOT, env=environment,
                            stdout=stream, stderr=subprocess.STDOUT)
after = identities()
record = {'schema_version': 1, 'scope': 'dirty-development configuration tool execution',
          'command': command, 'cwd': str(ROOT), 'started_utc': started,
          'finished_utc': datetime.now(timezone.utc).isoformat(),
          'exit_code': result.returncode, 'source_before': before,
          'source_after': after, 'source_unchanged': before == after,
          'log': 'configure.log',
          'log_sha256': hashlib.sha256((OUTPUT / 'configure.log').read_bytes()).hexdigest(),
          'limits': ['No clean-source candidate, installed SDK, reproducibility or physical qualification is established.',
                     'This current source capture does not bind unavailable source hashes to prior raw RED or intermediate logs.']}
(OUTPUT / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
print((OUTPUT / 'configure.log').read_text().splitlines()[-5:])
print(json.dumps({'exit_code': result.returncode,
                  'source_unchanged': before == after,
                  'manifest': str(OUTPUT / 'manifest.json')}))
sys.exit(result.returncode if before == after else 2)
