"""Preserve fresh tool evidence and explicitly scoped historical raw bytes."""
import ast
import hashlib
import json
from pathlib import Path
import shutil

ROOT = Path("/workspace/nexus")
EXTERNAL = Path(__file__).parent / "secondary-config"
DESTINATION = ROOT / "tools/testing/evidence/configure-secondary"
previous = Path(__file__).with_name("archive_timer_g474.py").read_text()
tree = ast.parse(previous)
owned = next(ast.literal_eval(node.value) for node in tree.body
             if isinstance(node, ast.Assign) and any(
                 isinstance(target, ast.Name) and target.id == "OWNED"
                 for target in node.targets))
owned += ["tools/configure/providers/native/emission.py",
          "tools/configure/secondary_controllers.py",
          "tools/configure/test_secondary_controllers.py",
          "tools/configure/test_toml.py",
          "tests/contracts/stm32_model/generate_constructors.py"]
owned += [path.relative_to(ROOT).as_posix() for path in sorted(
    (ROOT / "tests/contracts/multi_controller_assembly").rglob("*"))
          if path.is_file()]
assert len(owned) == len(set(owned))
fresh = json.loads((EXTERNAL / "final-tools-green/manifest.json").read_text())
assert fresh["exit_code"] == 0 and fresh["source_unchanged"]
assert fresh["source_before"] == fresh["source_after"]
DESTINATION.mkdir(parents=True, exist_ok=False)


def identity(path, relative):
    contents = path.read_bytes()
    return {"path": relative, "size": len(contents),
            "sha256": hashlib.sha256(contents).hexdigest()}


def retain(original, target):
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(original, target)
    return {**identity(target, target.relative_to(ROOT).as_posix()),
            "original_path": str(original), "original_name": original.name}


closure = []
for item in fresh["source_before"]:
    original = ROOT / item["path"]
    assert identity(original, item["path"]) == item, item["path"]
    target = DESTINATION / "frozen-source" / (item["path"] + ".raw")
    retain(original, target)
    closure.append({**item, "retained_path": target.relative_to(ROOT).as_posix()})
closure_map = {item["path"]: item for item in closure}
sources = []
for path in owned:
    if path in closure_map:
        item = closure_map[path]
    else:
        target = DESTINATION / "frozen-source" / (path + ".raw")
        retain(ROOT / path, target)
        item = {**identity(ROOT / path, path),
                "retained_path": target.relative_to(ROOT).as_posix()}
    sources.append(item)

raw = []
for original in sorted(EXTERNAL.rglob("*")):
    if not original.is_file():
        continue
    relative = original.relative_to(EXTERNAL)
    if original.suffix in {".py", ".c", ".h"}:
        relative = Path(str(relative) + ".raw")
    raw.append(retain(original, DESTINATION / "raw" / relative))
raw.append(retain(Path(__file__), DESTINATION / "raw/archive_secondary.py.raw"))

manifest = {
    "schema_version": 1,
    "scope": "dirty-development secondary controller configuration and uniform physical cold-owner contracts",
    "sources": sources,
    "executed_source_closure": closure,
    "raw_artifacts": raw,
    "executed_final_configuration": {
        "manifest": "tools/testing/evidence/configure-secondary/raw/final-tools-green/manifest.json",
        "command": fresh["command"], "cwd": fresh["cwd"],
        "exit_code": fresh["exit_code"], "source_unchanged": fresh["source_unchanged"],
        "discovered_tests": 351,
    },
    "historical_scope": {
        "original_feature_red": "raw/red.log",
        "typed_boundary_red_green": ["raw/model-boundary-red.log", "raw/model-boundary-green.log"],
        "nonqualifying_attempts": {
            "raw/whole-green-attempt1.log": "Stale direct-stop assertion for a fixture now selecting the formal secondary cold lease.",
            "raw/final-tools/manifest.json": "The stale optional-timer test asserted no privilege guard; the approved physical platform owner contract requires one independently of selected I/O kinds.",
        },
        "generated_runtime_evidence_owners": {
            "five_controllers": "Arch owner retains genuine refused DMA clock and repeated-stop RED, then 22 tests per family regular and sanitizer execution.",
            "i2c_identity": "Delivery owner retains actual four generated pre-start identity failures and Native identity RED; current combined 83 tests passed regular and sanitizer execution.",
            "physical_owner": "Delivery retains G4 failed-cleanup unprivileged retry RED; Arch retains STM/GD empty and GPIO-only entry RED followed by 24 regular and sanitizer tests.",
        },
    },
    "contracts": [
        "Each selected controller reuses its actual typed readonly operations table and existing private provider layout; no dynamic registry or forwarding layer is introduced.",
        "Constructor effects participate in retained reverse cleanup; successful source drain clears only the live-provider marker, and failed NVIC, pin or gate withdrawal keeps independent lease markers.",
        "I2C child port and address are statically bound before hardware startup; existing mutable endpoint storage moves from BSS to DATA without increasing RAM, but ROM initialization cost must be measured in the maintained ARM graph.",
        "Every physical platform cold start and stop rejects ISR, incoming mask and unprivileged owners before system, clock, pin or vector effects; Native retains its host contract.",
        "Eighteen literal maintained TOMLs cover three exact parts, two authored backends, finite five-controller DMA and paired I2C IRQ/DMA graphs; software Board fixtures do not establish PCB or electrical wiring.",
    ],
    "limits": [
        "Final source hashes bind the fresh final 351-test execution and retained byte capsules, not retroactively earlier raw-only logs.",
        "Historical commands, raw logs and independently owned GoogleTest source capsules preserve their original scope; no unavailable invocation or pre-execution identity is invented.",
        "Actual generated GoogleTest and sanitizer results are archived by independent owners; their historical closure is not silently replaced with this later final tool closure.",
        "Installed SDK and full maintained ARM graph execution remain separate qualification tasks; this archive establishes no clean Git candidate, reproducibility, physical HIL, safety certification or product release.",
    ],
}
target = DESTINATION / "development.json"
target.write_text(json.dumps(manifest, indent=2) + "\n")
print(json.dumps({"owned_sources": len(sources), "executed_source_closure": len(closure),
                  "raw_artifacts": len(raw), "manifest": str(target),
                  "manifest_sha256": hashlib.sha256(target.read_bytes()).hexdigest()}))
