from pathlib import Path
root = Path('/workspace/nexus')
base = root / 'tests/contracts/multi_controller_assembly'
for label in ('stm32-zg', 'stm32-ve', 'gd32'):
    for backend in ('', '-freertos'):
        source = base / (label + '-i2c-pair' + backend + '.toml')
        destination = base / (label + '-i2c-pair-irq' + backend + '.toml')
        destination.write_text(source.read_text().replace('mode = "dma-messages"', 'mode = "irq-messages"'))
(base / 'CMakeLists.txt').write_text('''cmake_minimum_required(VERSION 3.31)
project(multi_controller_provider_link_fixture LANGUAGES C ASM)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
if(NOT NEXUS_SOURCE_ROOT OR NOT NEXUS_ASSEMBLY_FILE)
    message(FATAL_ERROR "Controller fixture needs source root and one explicit assembly")
endif()
set(NEXUS_BUILD_TESTS OFF CACHE BOOL "No host tests in ARM fixture")
set(NEXUS_BUILD_WORKLOAD OFF CACHE BOOL "External explicit fixture main")
add_subdirectory("${NEXUS_SOURCE_ROOT}" nexus-sdk)
nexus_add_firmware(multi_controller_fixture SOURCES controller_main.c)
find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
get_target_property(fixture_config Nexus::Platform NEXUS_CONFIG_DIR)
add_custom_command(TARGET multi_controller_fixture POST_BUILD
    COMMAND "${Python3_EXECUTABLE}" -B
        "${NEXUS_SOURCE_ROOT}/tools/measurement/retention.py"
        --elf "$<TARGET_FILE:multi_controller_fixture>"
        --bindings "${fixture_config}/bindings.c"
        --output "${CMAKE_CURRENT_BINARY_DIR}/bin/provider-retention.json"
    VERBATIM)
''')
(base / 'controller_main.c').write_text(r'''/**
 * \file            controller_main.c
 * \brief           Link-only selected controller and endpoint identities
 * \author          Nexus Team
 * \version         1.0.0
 * \date            2026-10-11
 * \copyright       Copyright (c) 2026 Nexus Team
 */
#include "nexus_bindings.h"
#include "nexus_factory.h"

static const void* volatile s_observed_identity;
static volatile uint16_t s_identity_count;

int main(void) {
    s_identity_count = NX_UART_ID_COUNT;
    for (uint16_t id = 0U; id < s_identity_count; ++id) {
        s_observed_identity = nx_factory_uart(id);
    }
    s_identity_count = NX_SPI_ID_COUNT;
    for (uint16_t id = 0U; id < s_identity_count; ++id) {
        s_observed_identity = nx_factory_spi(id);
    }
    s_identity_count = NX_I2C_ID_COUNT;
    for (uint16_t id = 0U; id < s_identity_count; ++id) {
        s_observed_identity = nx_factory_i2c(id);
    }
    s_identity_count = NX_SPI_DEVICE_ID_COUNT;
    for (uint16_t id = 0U; id < s_identity_count; ++id) {
        s_observed_identity = nx_factory_spi_device(id);
    }
    s_identity_count = NX_I2C_DEVICE_ID_COUNT;
    for (uint16_t id = 0U; id < s_identity_count; ++id) {
        s_observed_identity = nx_factory_i2c_device(id);
    }
    /* These source-reviewed pad fixtures establish software assembly only.
     * No bytes are sent and no PCB wiring or observed device is claimed.
     */
    (void)nx_platform_start();
    (void)nx_platform_stop();
    for (;;) {
    }
}
''')
