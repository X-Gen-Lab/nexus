schema = 2
board_package = "gd32-board"
backend = "baremetal"
clock = "hxtal25-pll200"
optimization = "Os"

[factory]
capabilities = true

[memory]
main_stack_bytes = 2048
libc_heap_bytes = 0
static_ram_limit_bytes = 16384
flash_load_limit_bytes = 65536

[gpio.output]
binding = "output"
mode = "output"
