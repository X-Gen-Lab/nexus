import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path('/workspace/nexus')
BASE = Path('/workspace/nexus-ci-boundaries')


def identity(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data),
            'sha256': hashlib.sha256(data).hexdigest()}


def execute(name, argv, timeout=900, extra=None):
    output = BASE / name
    output.mkdir(exist_ok=False)
    env = os.environ.copy()
    for key in list(env):
        if key.startswith(('GIT_', 'GTEST_', 'CTEST_')):
            env.pop(key)
    env['PATH'] = str(ROOT / '.venv/bin') + os.pathsep + env['PATH']
    if extra:
        env.update(extra)
    started = time.time_ns()
    with (output / 'stdout.txt').open('xb') as stdout, \
            (output / 'stderr.txt').open('xb') as stderr:
        run = subprocess.run(argv, cwd=ROOT, env=env, stdout=stdout,
                             stderr=stderr, timeout=timeout)
    record = {'argv': argv, 'cwd': str(ROOT), 'exit_code': run.returncode,
              'started_ns': started, 'ended_ns': time.time_ns(),
              'timeout_seconds': timeout,
              'stdout': identity(output / 'stdout.txt'),
              'stderr': identity(output / 'stderr.txt')}
    (output / 'command.json').write_text(json.dumps(record, indent=2) + '\n')
    print(json.dumps(record), flush=True)
    return run.returncode


if __name__ == '__main__':
    mode = sys.argv[1]
    if mode == 'runtime':
        raise SystemExit(execute('runtime-suite-run1', [
            str(ROOT / '.venv/bin/python'), '-B',
            str(ROOT / 'tests/contracts/test_runtime_sdk.py'), '-v'],
            extra={'NEXUS_RUNTIME_TEST_EVIDENCE':
                   str(BASE / 'runtime-suite-run1/children')}))
    raise SystemExit(execute(mode, sys.argv[2:]))
