"""Fresh whole eight-case validation of the bounded parent fixture only."""
from pathlib import Path
import hashlib
import json
import os
import subprocess
import time

ROOT = Path('/workspace/nexus')
RAW = Path('/workspace/nexus-freertos-failstop-fortify-iteration')
OUT = Path('/tmp/nexus-freertos-failstop-fortify-validation')
RUNNER = Path('/workspace/nexus-freertos-failstop-iteration/run_google.py')
PYTHON = '/workspace/nexus/.venv/bin/python'
CMAKE = '/workspace/nexus/.venv/bin/cmake'
FIXTURE = ROOT / 'tests/google/freertos_failstop_test.cpp'


def identity(path):
    path = Path(path)
    return {'path': str(path), 'bytes': path.stat().st_size,
            'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


def write(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')


def main():
    if OUT.exists() or OUT.is_symlink():
        raise ValueError('Validation output must be new')
    OUT.mkdir()
    env = os.environ.copy()
    env.pop('PYTHONPATH', None)
    env.pop('PYTHONHOME', None)
    env['PATH'] = '/workspace/nexus/.venv/bin:/usr/local/bin:/usr/bin:/bin'
    env['PYTHONDONTWRITEBYTECODE'] = '1'
    env['CMAKE_BUILD_PARALLEL_LEVEL'] = '2'
    controls = [ROOT / name for name in (
        'os/freertos/hooks.c', 'core/src/fault.c', 'core/src/request.c',
        'core/include/nexus/core/fault.h', 'arch/include/nexus/arch/arch.h',
        'tests/google/failstop.cmake', 'CMakePresets.json')]
    before = {str(path): identity(path) for path in controls}
    source = identity(FIXTURE)
    summary = {'schema': 1, 'status': 'running', 'scope': 'Fresh whole bounded fail-stop Google fixture only',
               'source_before': source, 'production_and_graph_before': before,
               'runner': identity(RUNNER), 'commands': [], 'configurations': [],
               'physical_status': 'not_executed', 'source_matrix_execution_count': 0,
               'filters': None, 'timeout_bumps': False, 'sanitizer_suppression': False,
               'Git_mutations': 0, 'environment': {key: env[key] for key in
                   ('PATH', 'PYTHONDONTWRITEBYTECODE', 'CMAKE_BUILD_PARALLEL_LEVEL')}}
    report = RAW / 'guarded-validation.json'
    write(report, summary)

    def execute(argv, label):
        stdout, stderr = RAW / (label + '.stdout.log'), RAW / (label + '.stderr.log')
        started = time.monotonic()
        with stdout.open('wb') as out, stderr.open('wb') as err:
            result = subprocess.run(argv, cwd=ROOT, env=env, stdout=out, stderr=err)
        record = {'argv': argv, 'cwd': str(ROOT), 'returncode': result.returncode,
                  'duration_seconds': time.monotonic() - started,
                  'stdout': identity(stdout), 'stderr': identity(stderr)}
        command = RAW / (label + '.command.json')
        write(command, record)
        summary['commands'].append({**record, 'record': identity(command)})
        write(report, summary)
        if result.returncode:
            raise ValueError('Actual command failed: ' + label)

    try:
        for name in ('native-debug', 'native-asan', 'native-tsan'):
            build = OUT / name
            execute([CMAKE, '--preset', name, '-B', str(build),
                     '-DPython3_EXECUTABLE=' + PYTHON], name + '-configure')
            execute([CMAKE, '--build', str(build), '--target',
                     'nexus_freertos_failstop_test', '--parallel', '2'], name + '-build')
            cases = RAW / (name + '-execution')
            execute([PYTHON, '-B', str(RUNNER), '--build', str(build),
                     '--output', str(cases)], name + '-google')
            actual = json.loads((cases / 'manifest.json').read_text())
            if actual['status'] != 'passed' or actual['validation']['passed'] != 8:
                raise ValueError('All eight cases were not qualified: ' + name)
            summary['configurations'].append({'preset': name, 'status': 'passed',
                'actual_cases': 8, 'execution': identity(cases / 'manifest.json'),
                'compile_database': identity(build / 'compile_commands.json'),
                'binary': identity(build / 'bin/nexus_freertos_failstop_test')})
            print(json.dumps({'preset': name, 'status': 'passed', 'cases': 8}), flush=True)
        summary['source_after'] = identity(FIXTURE)
        summary['production_and_graph_after'] = {str(path): identity(path) for path in controls}
        summary['production_unchanged'] = summary['production_and_graph_after'] == before
        summary['source_unchanged'] = summary['source_after'] == source
        if not summary['production_unchanged'] or not summary['source_unchanged']:
            raise ValueError('Fixture source or production/graph changed during execution')
        summary['status'] = 'passed'
    except (OSError, ValueError, KeyError) as error:
        summary['status'], summary['error'] = 'failed', str(error)
        raise
    finally:
        write(report, summary)
    print(json.dumps({'status': summary['status'], 'report': identity(report)}), flush=True)


if __name__ == '__main__':
    main()
