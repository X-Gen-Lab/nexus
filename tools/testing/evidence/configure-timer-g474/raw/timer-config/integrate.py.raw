from pathlib import Path
import json
root=Path('/workspace/nexus')
def edit(name,old,new):
 p=root/name;s=p.read_text();assert old in s,(name,old);p.write_text(s.replace(old,new))
edit('tools/configure/authored.py','INSTANCE_FIELDS = {','''INSTANCE_FIELDS = {
    "timer_capture": {"binding", "mode", "tick_hz", "edge", "filter", "exclusive", "irq"},
    "advanced_pwm": {"binding", "mode", "tick_hz", "period_ticks", "deadtime_ticks",
                     "break_active_high", "idle_high", "idle_complement_high", "exclusive", "irq"},''')
edit('tools/configure/authored.py','"can", "usb_device", "eth"} and "irq"','"can", "usb_device", "eth", "timer_capture", "advanced_pwm"} and "irq"')
edit('tools/configure/authored.py','"tx_count", "rx_count", "rx_storage_bytes", "init_timeout_us"}','"tx_count", "rx_count", "rx_storage_bytes", "init_timeout_us",\n                   "filter", "deadtime_ticks"}')
edit('tools/configure/authored.py','{"fifo_order", "remote", "match_remote", "vbus_sensing"}','{"fifo_order", "remote", "match_remote", "vbus_sensing",\n                             "break_active_high", "idle_high", "idle_complement_high", "exclusive"}')
edit('tools/configure/ir.py','@dataclass(frozen=True)\nclass EthernetOptions:','''@dataclass(frozen=True)
class TimerCaptureOptions:
    tick_hz: int
    edge: str
    filter: int
    exclusive: bool
    irq: IrqOptions


@dataclass(frozen=True)
class AdvancedPwmOptions:
    tick_hz: int
    period_ticks: int
    deadtime_ticks: int
    break_active_high: bool
    idle_high: bool
    idle_complement_high: bool
    exclusive: bool
    irq: IrqOptions


@dataclass(frozen=True)
class EthernetOptions:''')
edit('tools/configure/ir.py','UsbDeviceOptions | EthernetOptions | NoOptions)','UsbDeviceOptions | EthernetOptions | TimerCaptureOptions |\n                     AdvancedPwmOptions | NoOptions)')
edit('tools/configure/ir.py','    if kind == "eth":\n        return EthernetOptions','''    if kind == "timer_capture":
        return TimerCaptureOptions(*(values[key] for key in (
            "tick_hz", "edge", "filter", "exclusive")), irq)
    if kind == "advanced_pwm":
        return AdvancedPwmOptions(*(values[key] for key in (
            "tick_hz", "period_ticks", "deadtime_ticks", "break_active_high",
            "idle_high", "idle_complement_high", "exclusive")), irq)
    if kind == "eth":
        return EthernetOptions''')
