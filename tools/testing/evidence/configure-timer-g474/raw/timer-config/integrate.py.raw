edit('tools/configure/bindings.py','selections[index].kind in {"can", "usb_device", "eth"}','selections[index].kind in {"can", "usb_device", "eth", "timer_capture", "advanced_pwm"}')
for family,prefix in [('stm32f407','stm32'),('gd32f470','gd32')]:
 base=f'tools/configure/providers/{family}/'
 edit(base+'__init__.py','_MODE_IMPLEMENTATIONS = MappingProxyType({','''_MODE_IMPLEMENTATIONS = MappingProxyType({
    ('timer_capture', 'edge-capture'): 'timer_capture',
    ('advanced_pwm', 'complementary-pwm'): 'advanced_pwm',''')
 edit(base+'bindings.py','from ... import can, usb_device, ethernet','from ... import can, usb_device, ethernet, timer_advanced')
 edit(base+'bindings.py','    import ethernet\n','    import ethernet\n    import timer_advanced\n')
 edit(base+'bindings.py','    if item.kind == "can":','''    if item.kind in timer_advanced.KINDS:
        return timer_advanced.constructor(item, result, "'''+prefix+'''")
    if item.kind == "can":''')
 edit(base+'emission.py','from ... import can, usb_device, ethernet','from ... import can, usb_device, ethernet, timer_advanced')
 edit(base+'emission.py','    import ethernet\n','    import ethernet\n    import timer_advanced\n')
 edit(base+'emission.py','    if any(item.kind == "eth" for item in selections):','''    if any(item.kind in timer_advanced.KINDS for item in selections):
        source.append('#include "'''+family+'''_timer_advanced.h"')
'''+('        source.append(\'#include "gd32f4xx_timer.h"\')\n        source.append(\'#include "gd32f4xx_gpio.h"\')\n' if prefix=='gd32' else '')+'''    if any(item.kind == "eth" for item in selections):''')
 edit(base+'emission.py',f'    source.extend(ethernet.state_declarations(result, "{prefix}"))',f'    source.extend(ethernet.state_declarations(result, "{prefix}"))\n    source.extend(timer_advanced.state_declarations(result, "{prefix}"))')
 edit(base+'emission.py',f'    source.extend(ethernet.stop_system(result, "{prefix}"))',f'    source.extend(ethernet.stop_system(result, "{prefix}"))\n    source.extend(timer_advanced.stop_system(result, "{prefix}"))')
 if prefix=='stm32':
  edit(base+'emission.py','    source = ethernet.start_resources(result, "stm32")','    source = ethernet.start_resources(result, "stm32")\n    source.extend(timer_advanced.start_resources(result, "stm32"))')
 else:
  edit(base+'emission.py','    source.extend(ethernet.start_resources(result, "gd32"))','    source.extend(ethernet.start_resources(result, "gd32"))\n    source.extend(timer_advanced.start_resources(result, "gd32"))')
