schema=2
board_package="stm32-zg-board"
backend="freertos"
clock="hse8-pll168"
optimization="Os"
[factory]
capabilities=true
[memory]
main_stack_bytes=2048
libc_heap_bytes=0
static_ram_limit_bytes=16384
flash_load_limit_bytes=65536
[eth.mac]
binding="rmii"
mode="raw-rmii"
tx_count=2
rx_count=2
rx_storage_bytes=1536
address=[2,0,0,0,0,1]
init_timeout_us=5000
drain_timeout_us=1000
[eth.mac.irq]
priority=5
calls_os=false
