"""Record actual maintained SDK regressions on the root-owned isolated checkout."""
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

SOURCE = Path("/tmp/nexus-sdk-selector-tdd/source")
OUTPUT = Path(__file__).parent / "full-green2"
OUTPUT.mkdir(exist_ok=False)
TEMPORARY = Path("/tmp/nexus-sdk-selector-tdd/temporary-boundary-tests-green2")
TEMPORARY.mkdir(exist_ok=False)
ENVIRONMENT = dict(os.environ)
ENVIRONMENT["PATH"] = ("/workspace/nexus/.venv/bin:"
                       "/workspace/nexus-tools-arm/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin:"
                       "/usr/bin:/bin")
ENVIRONMENT["PYTHONDONTWRITEBYTECODE"] = "1"
ENVIRONMENT["TMPDIR"] = str(TEMPORARY)
for key in ("PYTHONPATH", "CPATH", "C_INCLUDE_PATH", "CPLUS_INCLUDE_PATH",
            "OBJC_INCLUDE_PATH", "CMAKE_INCLUDE_PATH", "CMAKE_LIBRARY_PATH",
            "LIBRARY_PATH"):
    ENVIRONMENT.pop(key, None)


def identity(path):
    data = path.read_bytes()
    return {"path": str(path), "size": len(data),
            "sha256": hashlib.sha256(data).hexdigest()}


def git(*arguments):
    return subprocess.run(["git", "-C", str(SOURCE), *arguments],
                          capture_output=True, env=ENVIRONMENT,
                          check=True).stdout


def capture():
    names = git("ls-files", "-z").decode().split("\0")
    files = [identity(SOURCE / name) for name in sorted(names)
             if name and (SOURCE / name).is_file()]
    dependencies = []
    for line in git("submodule", "status", "--recursive").decode().splitlines():
        commit, name = line.strip().split()[:2]
        origin = subprocess.run(["git", "-C", str(SOURCE / name),
                                 "remote", "get-url", "origin"],
                                capture_output=True, env=ENVIRONMENT,
                                check=True, text=True).stdout.strip()
        dependencies.append({"path": name, "commit": commit,
                             "origin": origin})
    return {"head": git("rev-parse", "HEAD").decode().strip(),
            "tree": git("rev-parse", "HEAD^{tree}").decode().strip(),
            "status": git("status", "--porcelain").decode(),
            "files": files, "dependencies": dependencies}


before = capture()
assert before["head"] == "aac03ce2721608656b291b0d33d8bc5689dec11e"
(OUTPUT / "source-before.json").write_text(json.dumps(before, indent=2) + "\n")
command = ["/workspace/nexus/.venv/bin/python", "-B",
           "tests/contracts/test_source_sdk.py", "-v"]
started = datetime.now(timezone.utc).isoformat()
with (OUTPUT / "unittest.log").open("wb") as stream:
    result = subprocess.run(command, cwd=SOURCE, env=ENVIRONMENT,
                            stdout=stream, stderr=subprocess.STDOUT)
after = capture()
(OUTPUT / "source-after.json").write_text(json.dumps(after, indent=2) + "\n")
manifest = {
    "schema_version": 1,
    "scope": "isolated dirty-development actual full SDK regression after archive exclusion",
    "command": command, "cwd": str(SOURCE),
    "environment": {key: ENVIRONMENT[key] for key in
                    ("PATH", "PYTHONDONTWRITEBYTECODE", "TMPDIR")},
    "started_utc": started, "finished_utc": datetime.now(timezone.utc).isoformat(),
    "exit_code": result.returncode, "source_unchanged": before == after,
    "source_before": identity(OUTPUT / "source-before.json"),
    "source_after": identity(OUTPUT / "source-after.json"),
    "raw": identity(OUTPUT / "unittest.log"),
    "driver": identity(Path(__file__)),
    "limits": [
        "The fixed aac03 commit has exactly two authored source overlays; this is not final canonical qualification.",
        "Maintained SDK boundary tests use their existing explicit development-fixture protocol and real child tools/ARM builds.",
        "No custom consumer, alternate package verifier or copied test runner is introduced.",
    ],
}
(OUTPUT / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
print((OUTPUT / "unittest.log").read_text().splitlines()[-8:])
print(json.dumps({"exit_code": result.returncode, "source_unchanged": before == after,
                  "manifest": str(OUTPUT / "manifest.json")}))
sys.exit(result.returncode if before == after else 2)
