/**
 * \file            main.c
 * \brief           Link-only fixed-profile sleep selection and omission fixture
 * \author          Nexus Team
 * \version         1.0.0
 * \date            2026-10-11
 * \copyright       Copyright (c) 2026 Nexus Team
 */
#include "nexus_bindings.h"
#if defined(SLEEP_SELECTED)
#include "clock_domain_impl.h"
#if defined(SLEEP_stm32f407)
#include "stm32f407_sleep.h"
#define FIXTURE_SLEEP nx_stm32f407_sleep
#else
#include "gd32f470_sleep.h"
#define FIXTURE_SLEEP nx_gd32f470_sleep
#endif
static nx_clock_domain_t domain;
static uint32_t wake_sequence = 1U;
#endif
int main(void) {
    nx_platform_start_result_t start = nx_platform_start();
    if (start.primary != NX_SUCCESS) {
        return (int)start.primary;
    }
#if defined(SLEEP_SELECTED)
    nx_result_t status = nx_clock_domain_construct(&domain, 1U);
    nx_clock_barrier_t barrier = {0};
    bool slept = false;
    if (status == NX_SUCCESS) {
        status = nx_clock_domain_close(&domain, &barrier);
    }
    if (status == NX_SUCCESS) {
        status = nx_clock_domain_quiescent(barrier);
    }
    if (status == NX_SUCCESS) {
        /* Changed sequence avoids WFI if executed. This fixture establishes
         * linking/resource graph only, never a real wake IRQ or HIL proof. */
        status = FIXTURE_SLEEP(barrier, NX_CLOCK_SHALLOW_SLEEP,
                               &wake_sequence, 0U, &slept);
    }
    if (status != NX_SUCCESS) {
        return (int)status;
    }
#endif
    return (int)nx_platform_stop();
}
