cmake_minimum_required(VERSION 3.31)
project(timer_factory_contract LANGUAGES C CXX)
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 17)
set(ROOT /workspace/nexus)
set(NEXUS_SOURCE_DIR ${ROOT})
find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
add_library(timer_api STATIC ${ROOT}/io/src/timer_capture.c ${ROOT}/io/src/advanced_pwm.c)
target_include_directories(timer_api PUBLIC ${ROOT}/io/include ${ROOT}/core/include)
add_library(Nexus::IO ALIAS timer_api)
add_library(timer_arch STATIC ${ROOT}/arch/native/nx_arch_native.c)
target_include_directories(timer_arch PUBLIC ${ROOT}/arch/include)
add_library(Nexus::Arch ALIAS timer_arch)
function(nexus_google_test name)
 cmake_parse_arguments(ARG "" "" "SOURCES;LIBRARIES;INCLUDES" ${ARGN})
 set(sources)
 foreach(source IN LISTS ARG_SOURCES)
  if(IS_ABSOLUTE "${source}")
   list(APPEND sources "${source}")
  else()
   list(APPEND sources "${ROOT}/tests/google/${source}")
  endif()
 endforeach()
 add_executable(${name} ${sources})
 target_include_directories(${name} PRIVATE ${ARG_INCLUDES})
 target_include_directories(${name} SYSTEM PRIVATE
  ${ROOT}/build/native-debug/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googletest/include
  ${ROOT}/build/native-debug/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googlemock/include)
 target_compile_options(${name} PRIVATE -Wall -Wextra -Werror -Wconversion -Wshadow)
 target_link_libraries(${name} PRIVATE ${ARG_LIBRARIES}
  ${ROOT}/build/native-debug/lib/libgmock_main.a
  ${ROOT}/build/native-debug/lib/libgmock.a
  ${ROOT}/build/native-debug/lib/libgtest.a pthread)
endfunction()


foreach(stage inactive-proof privilege)
 foreach(family stm32 gd32)
  set(snapshot "${CMAKE_CURRENT_SOURCE_DIR}/../${stage}-red-source")
  if(stage STREQUAL "inactive-proof")
   set(testfile "${snapshot}/tests/google/timer_factory_test-final.cpp")
  else()
   set(testfile "${snapshot}/tests/google/timer_factory_test.cpp")
  endif()
  set(target "replay_${stage}_${family}")
  set(soc "stm32f407")
  if(family STREQUAL "gd32")
   set(soc "gd32f470")
  endif()
  nexus_google_test(${target} SOURCES "${testfile}" "${snapshot}/${family}-bindings.c"
   "${ROOT}/soc/${soc}/drivers/timer_capture.c" "${ROOT}/soc/${soc}/drivers/advanced_pwm.c"
   LIBRARIES Nexus::IO Nexus::Arch
   INCLUDES "${CMAKE_CURRENT_SOURCE_DIR}/../build/test-import/timer-factory-${family}"
    "${ROOT}/io/private" "${ROOT}/soc/${soc}/private")
  target_compile_options(${target} PRIVATE "-include${snapshot}/tests/google/timer_factory_model.h")
  target_compile_definitions(${target} PRIVATE _init=nx_timer_fixture_init _fini=nx_timer_fixture_fini)
  if(family STREQUAL "stm32")
   target_include_directories(${target} SYSTEM PRIVATE "${ROOT}/vendors/st/cmsis_device_f4/Include" "${ROOT}/vendors/arm/CMSIS_5/CMSIS/Core/Include")
   target_compile_definitions(${target} PRIVATE STM32F407xx NX_TIMER_FACTORY_STM32)
  else()
   set(gd "${ROOT}/vendors/gigadevice/gd32f4xx/Firmware")
   target_include_directories(${target} PRIVATE "${ROOT}/tests/contracts/gd32_model")
   target_include_directories(${target} SYSTEM PRIVATE "${gd}/CMSIS/GD/GD32F4xx/Include" "${gd}/GD32F4xx_standard_peripheral/Include")
   target_compile_definitions(${target} PRIVATE GD32F470 HXTAL_VALUE=25000000 NX_TIMER_FACTORY_GD32)
   target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:C>:-Wno-int-to-pointer-cast>")
  endif()
 endforeach()
endforeach()
