void _fini(void) {}
static bool s_nx_platform_started;
static size_t s_nx_platform_initialized;
static uint32_t s_nx_timer_gpio_clocks_added;
static nx_advanced_pwm_controller_t s_nx_port_power;
static const nx_advanced_pwm_t s_nx_face_power = {
    &nx_gd32_advanced_pwm_ops, &s_nx_port_power
};
const nx_advanced_pwm_t* const nx_binding_power = &s_nx_face_power;
static uint32_t s_nx_timer_clock_added_power;
static uint16_t s_nx_timer_pin_saved_power[3];
static uint8_t s_nx_timer_pin_leases_power;
static uint8_t s_nx_timer_priority_saved_power;
static bool s_nx_timer_irq_leased_power;
static const nx_advanced_pwm_config_t s_nx_timer_config_power = {
    .timer_hz = 200000000u, .tick_hz = 1000000u, .exclusive = true,
    .break_input = &GPIO_ISTAT(GPIOB), .break_mask = 4096u,
    .period_ticks = 1000u, .deadtime_ticks = 128u,
    .break_active_high = true,
    .idle_high = false, .idle_complement_high = false
};
static nx_result_t stop_power(void) {
    nx_result_t status;
    if (s_nx_port_power.config != NULL) {
        status = nx_advanced_pwm_stop(&s_nx_face_power);
        if (status != NX_SUCCESS) { return status; }
    }
    if (s_nx_timer_irq_leased_power) {
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICER[0], 16777216u);
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 16777216u);
        nx_arch_dsb();
        if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 16777216u) != 0u) { return NX_ERROR_BUSY; }
        NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[24], s_nx_timer_priority_saved_power);
        nx_arch_dsb();
        if (NVIC->IP[24] != s_nx_timer_priority_saved_power) { return NX_ERROR_IO; }
        s_nx_timer_irq_leased_power = false;
    }
    status = nx_gd32_advanced_pwm_release(&s_nx_port_power);
    if (status != NX_SUCCESS) { return status; }
    if ((s_nx_timer_pin_leases_power & 1u) != 0u) {
        NX_PLATFORM_REGISTER_WRITE(GPIO_BOP(GPIOA), 16777216u);
        nx_arch_dsb();
        if ((GPIO_OCTL(GPIOA) & 256u) != 0u) { return NX_ERROR_IO; }
        status = nx_gd32_pin_configure(GPIOA, 8u, 1u, 0u, 0u, false);
        if (status != NX_SUCCESS) { return status; }
        if ((GPIO_OCTL(GPIOA) & 256u) != 0u) { return NX_ERROR_IO; }
    }
    if ((s_nx_timer_pin_leases_power & 2u) != 0u) {
        NX_PLATFORM_REGISTER_WRITE(GPIO_BOP(GPIOB), 536870912u);
        nx_arch_dsb();
        if ((GPIO_OCTL(GPIOB) & 8192u) != 0u) { return NX_ERROR_IO; }
        status = nx_gd32_pin_configure(GPIOB, 13u, 1u, 0u, 0u, false);
        if (status != NX_SUCCESS) { return status; }
        if ((GPIO_OCTL(GPIOB) & 8192u) != 0u) { return NX_ERROR_IO; }
    }
    if ((s_nx_timer_pin_leases_power & 4u) != 0u) {
        nx_gd32_pin_restore(GPIOB, 12u, s_nx_timer_pin_saved_power[2]);
        if (nx_gd32_pin_capture(GPIOB, 12u) != s_nx_timer_pin_saved_power[2]) { return NX_ERROR_IO; }
        s_nx_timer_pin_leases_power &= (uint8_t)~4u;
    }
    if ((s_nx_timer_pin_leases_power & 2u) != 0u) {
        nx_gd32_pin_restore(GPIOB, 13u, s_nx_timer_pin_saved_power[1]);
        if (nx_gd32_pin_capture(GPIOB, 13u) != s_nx_timer_pin_saved_power[1]) { return NX_ERROR_IO; }
        s_nx_timer_pin_leases_power &= (uint8_t)~2u;
    }
    if ((s_nx_timer_pin_leases_power & 1u) != 0u) {
        nx_gd32_pin_restore(GPIOA, 8u, s_nx_timer_pin_saved_power[0]);
        if (nx_gd32_pin_capture(GPIOA, 8u) != s_nx_timer_pin_saved_power[0]) { return NX_ERROR_IO; }
        s_nx_timer_pin_leases_power &= (uint8_t)~1u;
    }
    if (s_nx_timer_clock_added_power != 0u) {
        NX_PLATFORM_REGISTER_WRITE(RCU_APB2EN, RCU_APB2EN & ~s_nx_timer_clock_added_power);
        nx_arch_dsb();
        if ((RCU_APB2EN & s_nx_timer_clock_added_power) != 0u) { return NX_ERROR_IO; }
        s_nx_timer_clock_added_power = 0u;
    }
    return NX_SUCCESS;
}
static nx_result_t prepare_power(void) {
    nx_result_t status;
    if (s_nx_port_power.config != NULL) { return NX_ERROR_BUSY; }
    if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 16777216u) != 0u) { return NX_ERROR_BUSY; }
    if (((SCB->AIRCR >> 8u) & 7u) > 3u) { return NX_ERROR_PERMISSION; }
    s_nx_timer_clock_added_power = ~RCU_APB2EN & RCU_APB2EN_TIMER0EN;
    NX_PLATFORM_REGISTER_WRITE(RCU_APB2EN, RCU_APB2EN | RCU_APB2EN_TIMER0EN);
    nx_arch_dsb();
    if ((RCU_APB2EN & RCU_APB2EN_TIMER0EN) == 0u) { return NX_ERROR_IO; }
    if ((TIMER_CTL0(TIMER0) & 1u) != 0u || TIMER_CHCTL2(TIMER0) != 0u || TIMER_DMAINTEN(TIMER0) != 0u || (TIMER_CCHP(TIMER0) & 33536u) != 0u) { return NX_ERROR_BUSY; }
    if (TIMER_DMAINTEN(TIMER8) != 0u) { return NX_ERROR_BUSY; }
    s_nx_timer_priority_saved_power = NVIC->IP[24];
    s_nx_timer_irq_leased_power = true;
    status = nx_gd32_gpio_clock_enable(0u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_timer_pin_saved_power[0] = nx_gd32_pin_capture(GPIOA, 8u);
    s_nx_timer_pin_leases_power |= 1u;
    status = nx_gd32_pin_configure(GPIOA, 8u, 2u, 1u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_timer_pin_saved_power[1] = nx_gd32_pin_capture(GPIOB, 13u);
    s_nx_timer_pin_leases_power |= 2u;
    status = nx_gd32_pin_configure(GPIOB, 13u, 2u, 1u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_timer_pin_saved_power[2] = nx_gd32_pin_capture(GPIOB, 12u);
    s_nx_timer_pin_leases_power |= 4u;
    status = nx_gd32_pin_configure(GPIOB, 12u, 2u, 1u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_advanced_pwm_initialize(&s_nx_port_power, &s_nx_timer_config_power);
    if (status != NX_SUCCESS) { return status; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[24], 80u);
    NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 16777216u);
    NX_PLATFORM_REGISTER_WRITE(NVIC->ISER[0], 16777216u);
    nx_arch_dsb();
    if (NVIC->IP[24] != 80u || (NVIC->ISER[0] & 16777216u) == 0u || (NVIC->ISPR[0] & 16777216u) != 0u) { return NX_ERROR_IO; }
    return NX_SUCCESS;
}
void TIMER0_BRK_TIMER8_IRQHandler(void);
/** \brief Bounded dispatch from the exclusively leased vector. */
void TIMER0_BRK_TIMER8_IRQHandler(void) { nx_gd32_advanced_pwm_irq(&s_nx_port_power); }
static nx_timer_capture_controller_t s_nx_port_encoder;
static const nx_timer_capture_t s_nx_face_encoder = {
    &nx_gd32_timer_capture_ops, &s_nx_port_encoder
};
const nx_timer_capture_t* const nx_binding_encoder = &s_nx_face_encoder;
static uint32_t s_nx_timer_clock_added_encoder;
static uint16_t s_nx_timer_pin_saved_encoder[1];
static uint8_t s_nx_timer_pin_leases_encoder;
static uint8_t s_nx_timer_priority_saved_encoder;
static bool s_nx_timer_irq_leased_encoder;
static const nx_timer_capture_config_t s_nx_timer_config_encoder = {
    .timer_hz = 100000000u, .tick_hz = 1000000u, .exclusive = true,
    .edge = NX_TIMER_EDGE_BOTH, .filter = 3u
};
static nx_result_t stop_encoder(void) {
    nx_result_t status;
    if (s_nx_port_encoder.config != NULL) {
        status = nx_timer_capture_stop(&s_nx_face_encoder);
        if (status != NX_SUCCESS) { return status; }
    }
    if (s_nx_timer_irq_leased_encoder) {
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICER[0], 1073741824u);
        NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 1073741824u);
        nx_arch_dsb();
        if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 1073741824u) != 0u) { return NX_ERROR_BUSY; }
        NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[30], s_nx_timer_priority_saved_encoder);
        nx_arch_dsb();
        if (NVIC->IP[30] != s_nx_timer_priority_saved_encoder) { return NX_ERROR_IO; }
        s_nx_timer_irq_leased_encoder = false;
    }
    status = nx_gd32_timer_capture_release(&s_nx_port_encoder);
    if (status != NX_SUCCESS) { return status; }
    if ((s_nx_timer_pin_leases_encoder & 1u) != 0u) {
        nx_gd32_pin_restore(GPIOB, 6u, s_nx_timer_pin_saved_encoder[0]);
        if (nx_gd32_pin_capture(GPIOB, 6u) != s_nx_timer_pin_saved_encoder[0]) { return NX_ERROR_IO; }
        s_nx_timer_pin_leases_encoder &= (uint8_t)~1u;
    }
    if (s_nx_timer_clock_added_encoder != 0u) {
        NX_PLATFORM_REGISTER_WRITE(RCU_APB1EN, RCU_APB1EN & ~s_nx_timer_clock_added_encoder);
        nx_arch_dsb();
        if ((RCU_APB1EN & s_nx_timer_clock_added_encoder) != 0u) { return NX_ERROR_IO; }
        s_nx_timer_clock_added_encoder = 0u;
    }
    return NX_SUCCESS;
}
static nx_result_t prepare_encoder(void) {
    nx_result_t status;
    if (s_nx_port_encoder.config != NULL) { return NX_ERROR_BUSY; }
    if (((NVIC->ISER[0] | NVIC->ISPR[0] | NVIC->IABR[0]) & 1073741824u) != 0u) { return NX_ERROR_BUSY; }
    if (((SCB->AIRCR >> 8u) & 7u) > 3u) { return NX_ERROR_PERMISSION; }
    s_nx_timer_clock_added_encoder = ~RCU_APB1EN & RCU_APB1EN_TIMER3EN;
    NX_PLATFORM_REGISTER_WRITE(RCU_APB1EN, RCU_APB1EN | RCU_APB1EN_TIMER3EN);
    nx_arch_dsb();
    if ((RCU_APB1EN & RCU_APB1EN_TIMER3EN) == 0u) { return NX_ERROR_IO; }
    if ((TIMER_CTL0(TIMER3) & 1u) != 0u || TIMER_CHCTL2(TIMER3) != 0u || TIMER_DMAINTEN(TIMER3) != 0u) { return NX_ERROR_BUSY; }
    s_nx_timer_priority_saved_encoder = NVIC->IP[30];
    s_nx_timer_irq_leased_encoder = true;
    status = nx_gd32_gpio_clock_enable(1u);
    if (status != NX_SUCCESS) { return status; }
    s_nx_timer_pin_saved_encoder[0] = nx_gd32_pin_capture(GPIOB, 6u);
    s_nx_timer_pin_leases_encoder |= 1u;
    status = nx_gd32_pin_configure(GPIOB, 6u, 2u, 2u, 0u, false);
    if (status != NX_SUCCESS) { return status; }
    status = nx_gd32_timer_capture_initialize(&s_nx_port_encoder, &s_nx_timer_config_encoder);
    if (status != NX_SUCCESS) { return status; }
    NX_PLATFORM_PRIORITY_WRITE(NVIC->IP[30], 80u);
    NX_PLATFORM_REGISTER_WRITE(NVIC->ICPR[0], 1073741824u);
    NX_PLATFORM_REGISTER_WRITE(NVIC->ISER[0], 1073741824u);
    nx_arch_dsb();
    if (NVIC->IP[30] != 80u || (NVIC->ISER[0] & 1073741824u) == 0u || (NVIC->ISPR[0] & 1073741824u) != 0u) { return NX_ERROR_IO; }
    return NX_SUCCESS;
}
void TIMER3_IRQHandler(void);
/** \brief Bounded dispatch from the exclusively leased vector. */
void TIMER3_IRQHandler(void) { nx_gd32_timer_capture_irq(&s_nx_port_encoder); }
/** \brief Stop only the initialized selected interfaces. */
nx_result_t nx_platform_stop(void) {
    if (nx_arch_in_isr() || nx_arch_irq_is_masked() || !nx_arch_is_privileged()) { return NX_ERROR_CONTEXT; }
    if (s_nx_platform_initialized >= 2u) {
        nx_result_t status_0 = stop_encoder();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 1u;
    }
    if (s_nx_platform_initialized >= 1u) {
        nx_result_t status_0 = stop_power();
        if (status_0 != NX_SUCCESS) { return status_0; }
        s_nx_platform_initialized = 0u;
    }
    if (s_nx_platform_started && s_nx_timer_gpio_clocks_added != 0u) {
        NX_PLATFORM_REGISTER_WRITE(RCU_AHB1EN, RCU_AHB1EN & ~s_nx_timer_gpio_clocks_added);
        nx_arch_dsb();
        if ((RCU_AHB1EN & s_nx_timer_gpio_clocks_added) != 0u) { return NX_ERROR_IO; }
        s_nx_timer_gpio_clocks_added = 0u;
    }
    if (s_nx_platform_started && nx_gd32_soc_stop() != 0) { return NX_ERROR_IO; }
    s_nx_platform_started = false;
    s_nx_platform_initialized = 0u;
    return NX_SUCCESS;
}
/** \brief Start explicit hardware only; rollback retains error facts. */
nx_platform_start_result_t nx_platform_start(void) {
    nx_platform_start_result_t result = { NX_SUCCESS, NX_SUCCESS, 0u };
    if (nx_arch_in_isr() || nx_arch_irq_is_masked() || !nx_arch_is_privileged()) {
        result.primary = NX_ERROR_CONTEXT; return result; }
    if (s_nx_platform_started) { result.primary = NX_ERROR_STATE; return result; }
    if (nx_gd32_soc_start() != 0) {
        result.primary = NX_ERROR_IO;
        result.cleanup = nx_gd32_soc_stop() == 0 ? NX_SUCCESS : NX_ERROR_IO;
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        s_nx_platform_started = result.remaining_effects != 0u;
        return result;
    }
    s_nx_platform_started = true;
    s_nx_timer_gpio_clocks_added = ~RCU_AHB1EN & 3u;
    s_nx_platform_initialized = 1u;
    result.primary = prepare_power();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 1u;
    s_nx_platform_initialized = 2u;
    result.primary = prepare_encoder();
    if (result.primary != NX_SUCCESS) {
        result.cleanup = nx_platform_stop();
        result.remaining_effects = result.cleanup == NX_SUCCESS ? 0u : 1u;
        return result;
    }
    s_nx_platform_initialized = 2u;
    return result;
}

