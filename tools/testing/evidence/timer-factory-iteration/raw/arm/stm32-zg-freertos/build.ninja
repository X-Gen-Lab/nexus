# =============================================================================
# Link build statements for STATIC_LIBRARY target nexus_arch


#############################################
# Link the static library nexus-sdk/lib/libnexus_arch.a

build nexus-sdk/lib/libnexus_arch.a: C_STATIC_LIBRARY_LINKER__nexus_arch_ nexus-sdk/arch/CMakeFiles/nexus_arch.dir/cortex_m/nx_arch_cortex_m.c.obj nexus-sdk/arch/CMakeFiles/nexus_arch.dir/cortex_m/nx_arch_cache.c.obj nexus-sdk/arch/CMakeFiles/nexus_arch.dir/cortex_m/nx_arch_mpu.c.obj nexus-sdk/arch/CMakeFiles/nexus_arch.dir/cortex_m/nx_arch_security.c.obj nexus-sdk/arch/CMakeFiles/nexus_arch.dir/cortex_m/nx_arch_sleep.c.obj
  OBJECT_DIR = nexus-sdk/arch/CMakeFiles/nexus_arch.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = nexus-sdk/arch/CMakeFiles/nexus_arch.dir/nexus_arch.pdb
  TARGET_FILE = nexus-sdk/lib/libnexus_arch.a
  TARGET_PDB = nexus-sdk/lib/libnexus_arch.pdb


#############################################
# Utility command for edit_cache

build nexus-sdk/arch/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/nexus-industrial-design/timer-arm/stm32-zg-freertos/nexus-sdk/arch && /workspace/nexus/.venv/lib/python3.12/site-packages/cmake/data/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build nexus-sdk/arch/edit_cache: phony nexus-sdk/arch/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build nexus-sdk/arch/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/nexus-industrial-design/timer-arm/stm32-zg-freertos/nexus-sdk/arch && /workspace/nexus/.venv/lib/python3.12/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/workspace/nexus/tests/contracts/timer_assembly -B/workspace/nexus-industrial-design/timer-arm/stm32-zg-freertos
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build nexus-sdk/arch/rebuild_cache: phony nexus-sdk/arch/CMakeFiles/rebuild_cache.util

