/**
 * \file            freertos_owner_endurance_test.cpp
 * \brief           Real kernel owners retain loans through repeated shutdown
 * \author          Nexus Team
 * \version         1.0.0
 * \date            2026-10-11
 * \copyright       Copyright (c) 2026 Nexus Team
 */

#include "nexus/components/uart_owner.h"
#include "nexus/os/freertos.h"
#include "provider.h"
#include <cstdlib>
#include <cstdio>
#include <gtest/gtest.h>
#include <memory>

namespace {
constexpr size_t words = 8192U;
struct Round;

/** \brief Each real producer retains its own request and bytes until join. */
struct Producer {
    Round* round;
    nx_freertos_notify_t completion{};
    nx_wait_port_t wake{};
    nx_freertos_task_t task{};
    alignas(8) StackType_t stack[words]{};
    nx_request_t request{};
    nx_uart_owner_operation_t operation{};
    nx_owner_ticket_t ticket{};
    uint8_t payload[4]{1U, 2U, 3U, 4U};
    nx_result_t result{NX_ERROR_STATE};
};

/** \brief Explicit test-owned kernel tasks, slots and all callback lifetimes. */
struct Round {
    nx_native_uart_state_t state{};
    const nx_uart_port_t uart{&nx_native_uart_ops, &state};
    nx_bus_owner_t owner{};
    nx_owner_slot_t slots[2]{};
    nx_uart_owner_executor_t executor{};
    nx_freertos_notify_t owner_event{};
    nx_freertos_notify_t coordinator_event{};
    nx_wait_port_t owner_wake{};
    nx_wait_port_t coordinator_wake{};
    nx_freertos_task_t owner_task{};
    alignas(8) StackType_t owner_stack[words]{};
    Producer producer[2]{};
    uint8_t rx[2]{};
    uint8_t tx[8]{};
    uint32_t go{};
    uint32_t progress{};
    uint32_t hold{};
    uint32_t stop{};
    uint32_t hints{};
    const nx_irq_wake_t hint{this, irq_hint, false};

    /** \brief Single-kernel task guard; resume preserves outer suspend nesting. */
    static uintptr_t enter(void*) {
        vTaskSuspendAll();
        return 0U;
    }
    static void leave(void*, uintptr_t) {
        (void)xTaskResumeAll();
    }
    static nx_time_us_t now(void*) { return nx_time_now_us(); }
    static nx_result_t irq_hint(void* context) {
        auto* round = static_cast<Round*>(context);
        __atomic_add_fetch(&round->hints, 1U, __ATOMIC_RELAXED);
        return NX_SUCCESS;
    }
    static bool settled(void* context) {
        auto* producer = static_cast<Producer*>(context);
        return nx_request_state(&producer->request) == NX_REQUEST_SETTLED;
    }
    static bool active(void* context) {
        auto* round = static_cast<Round*>(context);
        return nx_request_state(&round->producer[0].request) == NX_REQUEST_ACTIVE;
    }
    static bool quarantined(void* context) {
        auto* round = static_cast<Round*>(context);
        return nx_request_state(&round->producer[0].request) == NX_REQUEST_QUARANTINED;
    }
    static bool all_settled(void* context) {
        auto* round = static_cast<Round*>(context);
        return settled(&round->producer[0]) && settled(&round->producer[1]);
    }

    /** \brief Real task submits once, then waits only on its latched predicate. */
    static void produce(void* context) {
        auto* producer = static_cast<Producer*>(context);
        producer->result = nx_bus_owner_submit(
            &producer->round->owner, &producer->request, &producer->operation,
            &producer->wake, &producer->ticket);
        if (producer->result == NX_SUCCESS) {
            producer->result = nx_wait_until(&producer->wake, settled, producer,
                                             NX_DEADLINE_NEVER);
        }
    }

    /** \brief One executor services actual owner/provider while kernel runs. */
    static void execute(void* context) {
        auto* round = static_cast<Round*>(context);
        for (;;) {
            if (__atomic_load_n(&round->go, __ATOMIC_ACQUIRE) != 0U) {
                /* The Native Arch mutex models an ordinary host CPU. Suppress
                 * POSIX-kernel task switching over this bounded model step so
                 * a signal cannot park its mutex holder and run another user.
                 * This guard is fixture composition, not a new platform path. */
                vTaskSuspendAll();
                nx_native_uart_fault_instance(
                    &round->state, false,
                    __atomic_load_n(&round->hold, __ATOMIC_ACQUIRE) != 0U);
                if (__atomic_load_n(&round->progress, __ATOMIC_ACQUIRE) != 0U) {
                    nx_native_uart_irq_step_instance(&round->state);
                }
                (void)nx_bus_owner_service(&round->owner);
                (void)xTaskResumeAll();
            }
            (void)round->coordinator_wake.wake(round->coordinator_wake.context);
            const uint32_t sequence = round->owner_wake.arm(round->owner_wake.context);
            if (__atomic_load_n(&round->stop, __ATOMIC_ACQUIRE) != 0U &&
                nx_bus_owner_idle(&round->owner)) {
                return;
            }
            (void)round->owner_wake.wait(
                round->owner_wake.context, sequence,
                nx_deadline_after(nx_time_now_us(), 1000U));
        }
    }

    void close() {
        nx_bus_owner_stop(&owner);
        __atomic_store_n(&hold, 0U, __ATOMIC_RELEASE);
        __atomic_store_n(&go, 1U, __ATOMIC_RELEASE);
        __atomic_store_n(&stop, 1U, __ATOMIC_RELEASE);
        if (owner_event.handle != nullptr) {
            (void)owner_wake.wake(owner_wake.context);
        }
    }
    bool join(nx_freertos_task_t* task) {
        return task->handle == nullptr ||
               nx_freertos_task_join(
                   task, nx_deadline_after(nx_time_now_us(), 2000000U)) == NX_SUCCESS;
    }

    /** \brief Failed assertions also retain storage until all publishers exit. */
    ~Round() {
        if (owner.capacity != 0U) {
            close();
        }
        for (auto& item : producer) {
            if (!join(&item.task)) {
                std::abort();
            }
        }
        if (!join(&owner_task)) {
            std::abort();
        }
        if (state.opened) {
            if (nx_uart_port_attach_wake(&uart, nullptr, 0U) != NX_SUCCESS ||
                nx_uart_port_stop(&uart) != NX_SUCCESS) {
                std::abort();
            }
        }
        for (auto& item : producer) {
            if (item.completion.handle != nullptr &&
                nx_freertos_notify_destroy(&item.completion) != NX_SUCCESS) {
                std::abort();
            }
        }
        if (owner_event.handle != nullptr &&
            nx_freertos_notify_destroy(&owner_event) != NX_SUCCESS) {
            std::abort();
        }
        if (coordinator_event.handle != nullptr &&
            nx_freertos_notify_destroy(&coordinator_event) != NX_SUCCESS) {
            std::abort();
        }
    }
};

/** \brief Real kernel create/submit/stop/drain/join/detach/destroy each round. */
void run_rounds(unsigned rounds) {
    const UBaseType_t baseline = uxTaskGetNumberOfTasks();
    for (unsigned iteration = 0U; iteration < rounds; ++iteration) {
        SCOPED_TRACE(iteration);
        {
            /* Host fixture storage contains three large explicit task stacks.
             * Keep it outside the coordinator's independent POSIX stack; this
             * allocation is test-owned and never enters the kernel allocator. */
            auto storage = std::make_unique<Round>();
            auto& round = *storage;
            std::fprintf(stderr, "round %u begin\n", iteration);
            nx_native_uart_config_t config{NX_UART_RX_BYTES, round.rx,
                sizeof round.rx, round.tx, sizeof round.tx, false};
            ASSERT_EQ(nx_native_uart_configure_instance(&round.state, &config), NX_SUCCESS);
            ASSERT_EQ(nx_uart_port_attach_wake(&round.uart, &round.hint, 0U), NX_SUCCESS);
            ASSERT_EQ(nx_freertos_notify_init(&round.owner_event), NX_SUCCESS);
            ASSERT_EQ(nx_freertos_notify_init(&round.coordinator_event), NX_SUCCESS);
            round.owner_wake = nx_freertos_notify_port(&round.owner_event);
            round.coordinator_wake = nx_freertos_notify_port(&round.coordinator_event);
            ASSERT_EQ(nx_bus_owner_init(&round.owner, round.slots, 2U,
                {nullptr, Round::enter, Round::leave},
                nx_uart_owner_executor_port(&round.executor, &round.uart),
                {Round::now, nullptr}, &round.owner_wake), NX_SUCCESS);
            for (auto& producer : round.producer) {
                producer.round = &round;
                nx_request_initialize(&producer.request);
                ASSERT_EQ(nx_request_prepare(&producer.request, NX_DEADLINE_NEVER), NX_SUCCESS);
                producer.operation = {producer.payload, sizeof producer.payload};
                ASSERT_EQ(nx_freertos_notify_init(&producer.completion), NX_SUCCESS);
                producer.wake = nx_freertos_notify_port(&producer.completion);
            }
            ASSERT_EQ(nx_freertos_task_start(&round.owner_task, "owner-loop",
                round.owner_stack, words, 3U, Round::execute, &round), NX_SUCCESS);
            for (auto& producer : round.producer) {
                ASSERT_EQ(nx_freertos_task_start(&producer.task, "producer-loop",
                    producer.stack, words, 4U, Round::produce, &producer), NX_SUCCESS);
            }
            std::fprintf(stderr, "round %u tasks started\n", iteration);
            const bool complete = iteration % 3U == 0U;
            const bool quarantine = iteration % 3U == 2U;
            __atomic_store_n(&round.hold, quarantine ? 1U : 0U, __ATOMIC_RELEASE);
            __atomic_store_n(&round.go, 1U, __ATOMIC_RELEASE);
            ASSERT_EQ(round.owner_wake.wake(round.owner_wake.context), NX_SUCCESS);
            ASSERT_EQ(nx_wait_until(&round.coordinator_wake, Round::active, &round,
                nx_deadline_after(nx_time_now_us(), 2000000U)), NX_SUCCESS);
            std::fprintf(stderr, "round %u active\n", iteration);
            if (complete) {
                __atomic_store_n(&round.progress, 1U, __ATOMIC_RELEASE);
                ASSERT_EQ(round.owner_wake.wake(round.owner_wake.context), NX_SUCCESS);
                ASSERT_EQ(nx_wait_until(&round.coordinator_wake, Round::all_settled,
                    &round, nx_deadline_after(nx_time_now_us(), 2000000U)), NX_SUCCESS);
            } else {
                nx_bus_owner_stop(&round.owner);
                ASSERT_EQ(round.owner_wake.wake(round.owner_wake.context), NX_SUCCESS);
                if (quarantine) {
                    ASSERT_EQ(nx_wait_until(&round.coordinator_wake, Round::quarantined,
                        &round, nx_deadline_after(nx_time_now_us(), 2000000U)), NX_SUCCESS);
                    EXPECT_EQ(nx_request_prepare(&round.producer[0].request, 0U), NX_ERROR_STATE);
                    EXPECT_FALSE(nx_bus_owner_idle(&round.owner));
                    EXPECT_TRUE(round.executor.pending);
                    EXPECT_NE(round.state.active, nullptr);
                    vTaskSuspendAll();
                    const nx_result_t stop_result = nx_uart_port_stop(&round.uart);
                    (void)xTaskResumeAll();
                    EXPECT_EQ(stop_result, NX_ERROR_BUSY);
                }
            }
            std::fprintf(stderr, "round %u closing\n", iteration);
            round.close();
            for (auto& producer : round.producer) {
                std::fprintf(stderr, "round %u producer join\n", iteration);
                ASSERT_TRUE(round.join(&producer.task));
                EXPECT_EQ(producer.task.handle, nullptr);
                EXPECT_EQ(producer.result, NX_SUCCESS);
                nx_result_t result{};
                size_t transferred{};
                ASSERT_EQ(nx_request_result(&producer.request, &result, &transferred), NX_SUCCESS);
                EXPECT_EQ(result, complete ? NX_SUCCESS : NX_ERROR_CANCELLED);
                EXPECT_LE(transferred, sizeof producer.payload);
            }
            std::fprintf(stderr, "round %u owner join\n", iteration);
            ASSERT_TRUE(round.join(&round.owner_task));
            EXPECT_TRUE(nx_bus_owner_idle(&round.owner));
            EXPECT_FALSE(round.executor.pending);
            EXPECT_EQ(round.executor.inner.data, nullptr);
            EXPECT_EQ(round.state.active, nullptr);
            std::fprintf(stderr, "round %u joined\n", iteration);
            const uint32_t hints = __atomic_load_n(&round.hints, __ATOMIC_ACQUIRE);
            const nx_result_t receive =
                nx_native_uart_receive_instance(&round.state, 0x42U, 0U);
            std::fprintf(stderr, "round %u receive done\n", iteration);
            EXPECT_EQ(receive, quarantine ? NX_ERROR_STATE : NX_SUCCESS);
            EXPECT_EQ(__atomic_load_n(&round.hints, __ATOMIC_ACQUIRE),
                      hints + (quarantine ? 0U : 1U));
            std::fprintf(stderr, "round %u before detach\n", iteration);
            ASSERT_EQ(nx_uart_port_attach_wake(&round.uart, nullptr, 0U), NX_SUCCESS);
            std::fprintf(stderr, "round %u detached\n", iteration);
            const uint32_t detached = __atomic_load_n(&round.hints, __ATOMIC_ACQUIRE);
            EXPECT_EQ(nx_native_uart_receive_instance(&round.state, 0x43U, 0U),
                      quarantine ? NX_ERROR_STATE : NX_SUCCESS);
            EXPECT_EQ(__atomic_load_n(&round.hints, __ATOMIC_ACQUIRE), detached);
            std::fprintf(stderr, "round %u before stop\n", iteration);
            ASSERT_EQ(nx_uart_port_stop(&round.uart), NX_SUCCESS);
            EXPECT_EQ(round.state.wake, nullptr);
            EXPECT_FALSE(round.state.opened);
            std::fprintf(stderr, "round %u stopped\n", iteration);
            for (auto& producer : round.producer) {
                ASSERT_EQ(nx_freertos_notify_destroy(&producer.completion), NX_SUCCESS);
                EXPECT_EQ(producer.completion.handle, nullptr);
            }
            ASSERT_EQ(nx_freertos_notify_destroy(&round.owner_event), NX_SUCCESS);
            ASSERT_EQ(nx_freertos_notify_destroy(&round.coordinator_event), NX_SUCCESS);
        }
        std::fprintf(stderr, "round %u destroyed\n", iteration);
        EXPECT_EQ(uxTaskGetNumberOfTasks(), baseline);
    }
}

TEST(FreeRTOSOwnerEndurance, ThirtyTwoCompleteCancelQuarantineLifecycleRounds) {
    run_rounds(32U);
}

TEST(FreeRTOSOwnerEndurance, TwoHundredFiftySixLifecycleRoundsReturnToBaseline) {
    run_rounds(256U);
}
} /* namespace */
