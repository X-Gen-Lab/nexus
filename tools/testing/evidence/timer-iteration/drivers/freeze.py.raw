from pathlib import Path
from datetime import datetime,timezone
import hashlib,json,shutil,subprocess,xml.etree.ElementTree as ET
root=Path('/workspace/nexus'); external=Path('/workspace/nexus-timer-iteration'); evidence=root/'tools/testing/evidence/timer-iteration'
def ident(path):
 b=path.read_bytes()
 try: name=str(path.relative_to(root))
 except ValueError: name=str(path)
 return {'path':name,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
out=evidence/'development.json'
if out.exists(): raise SystemExit('Refuse overwriting frozen evidence')
files=json.loads((external/'owned.json').read_text())+['tests/google/timer_advanced.cmake','docs/design/timer-advanced.md']
sources=[ident(root/p) for p in files]
drivers=evidence/'drivers'; drivers.mkdir(exist_ok=False)
for name in ['run.py','build.py','build_san.py','arm.py','arm_final.py','arm_freeze.py','arm_final_irq.py','arm_final_capture.py','freeze.py']:
 (drivers/(name+'.raw')).write_bytes((external/name).read_bytes())
frozen=external/'frozen-bin'; frozen.mkdir(exist_ok=False)
binaries=[]
for mode in ['stm','gd']:
 for kind in ['test','san-test']:
  p=frozen/(mode+'-'+kind); shutil.copyfile(external/p.name,p);p.chmod(0o755);binaries.append(ident(p))
google=[]
for mode in ['stm','gd']:
 for label,kind in [('capture-read-green','regular'),('sanitizer-capture-final','asan_ubsan')]:
  xml=evidence/(mode+'-'+label+'.xml'); record=evidence/('timer-'+mode+'-'+label+'.command.json')
  tree=ET.parse(xml).getroot();a=tree.attrib
  assert int(a['tests'])==46 and int(a['failures'])==0 and int(a['errors'])==0 and int(a['disabled'])==0
  assert all(n.attrib.get('result')=='completed' for n in tree.iter('testcase'))
  cmd=json.loads(record.read_text());assert cmd['exit_code']==0
  google.append({'family':mode,'kind':kind,'cases':46,'failures':0,'errors':0,'skipped':0,'xml':ident(xml),'command':ident(record),'log':ident(Path(cmd['log']))})
red=[]
for mode in ['stm','gd']:
 for label,expected in [('boundary-red',7),('base-red',2),('irq-window-red',2),('capture-read-red',2)]:
  p=evidence/(mode+'-'+label+'.xml');a=ET.parse(p).getroot().attrib;assert int(a['failures'])==expected
  red.append({'family':mode,'stage':label,'failures':expected,'xml':ident(p)})
armfile=evidence/'arm-final-capture/report.json';arm=json.loads(armfile.read_text());assert arm['status']=='passed' and arm['source_inputs_stable'] is True
armcommands=list(evidence.glob('arm-final-capture-*.command.json'));assert len(armcommands)==10
for p in armcommands: assert json.loads(p.read_text())['exit_code']==0
for entry in arm['source_inputs']:
 p=Path(entry['path']);now=ident(p);assert now['bytes']==entry['bytes'] and now['sha256']==entry['sha256']
report={'schema_version':1,'kind':'timer_advanced_development_evidence','status':'passed','created_at':datetime.now(timezone.utc).isoformat(),'scope':'Owned optional timer production-provider tests and actual SDK ARM object compilation. Development snapshot; not full source closure/clean-HEAD/whole-firmware qualification.','physical_status':'not_executed','full_firmware_link_status':'not_executed','default_image_gc_status':'not_executed','cycles_status':'not_measured','source_inputs':sources,'google':google,'behavior_red_history':red,'arm':{'report':ident(armfile),'actual_commands':10,'families':arm['families']},'external_preserved_host_executables':binaries,'independent_source_review':ident(evidence/'independent-review.md'),'style':{'format_command':ident(evidence/'timer-format-freeze.command.json'),'comment_command':ident(evidence/'timer-comment-freeze.command.json'),'full_staged_gate_status':'pending_root_normal_hooks','prior_unstaged_gate_failure_retained':ident(evidence/'timer-style-final.command.json')},'ownership_boundary':'Provider source withdrawal only; cold Board assembly proves declared inactive GPIO and publisher quiescence before outer clock/pin/vector release.','retained_history_scope':'Earlier reports bind their original executions; no old report is promoted to current source. API-missing compilation and behavior RED retained unchanged.','raw_artifacts':[ident(p) for p in sorted(evidence.rglob('*')) if p.is_file() and p!=out]}
for p in files: assert ident(root/p)==sources[files.index(p)]
out.write_text(json.dumps(report,indent=2)+'\n')
for entry in report['raw_artifacts']+sources+binaries:
 p=Path(entry['path']);p=p if p.is_absolute() else root/p
 assert ident(p)==entry
print(json.dumps(ident(out)))
print('Bound sources',len(sources),'raw artifacts',len(report['raw_artifacts']),'Google cases',sum(x['cases'] for x in google),'ARM commands',len(armcommands))
