from pathlib import Path
import subprocess
import sys
root = Path('/workspace/nexus')
mode, label = sys.argv[1:]
out = Path('/workspace/nexus-timer-iteration')
inc = ['-Icore/include','-Iarch/include','-Iio/include','-Iio/private','-Itests/google','-Isoc/' + ('gd32f470' if mode == 'gd' else 'stm32f407') + '/private']
flags = ['-fsanitize=address,undefined','-fno-omit-frame-pointer','-Wall','-Wextra','-Werror','-Wpedantic','-Wconversion','-Wshadow','-include','tests/google/timer_advanced_model.h']
if mode == 'gd':
    flags += ['-DGD32F470','-DHXTAL_VALUE=25000000','-DNX_TIMER_GD_MODEL','-Wno-int-to-pointer-cast']
    inc += ['-Itests/contracts/gd32_model','-isystem','vendors/gigadevice/gd32f4xx/Firmware/CMSIS/GD/GD32F4xx/Include','-isystem','vendors/gigadevice/gd32f4xx/Firmware/GD32F4xx_standard_peripheral/Include']
else:
    flags += ['-DSTM32F407xx']
    inc += ['-isystem','vendors/st/cmsis_device_f4/Include','-isystem','vendors/arm/CMSIS_5/CMSIS/Core/Include']
google = ['-isystem','build/adc-iteration/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googlemock/include','-isystem','build/adc-iteration/_deps/googletest-6910c9d9165801d8827d628cb72eb7ea9dd538c5/googletest/include']
objects = []
for source, compiler, extra in [(source, 'gcc', ['-std=c11','-Wstrict-prototypes','-Wmissing-prototypes']) for source in ['soc/' + ('gd32f470' if mode == 'gd' else 'stm32f407') + '/drivers/timer_capture.c','soc/' + ('gd32f470' if mode == 'gd' else 'stm32f407') + '/drivers/advanced_pwm.c','io/src/timer_capture.c','io/src/advanced_pwm.c']] + [('tests/google/timer_advanced_test.cpp','g++',['-std=c++17',*google])]:
    obj = out / (mode + '-' + source.replace('/', '-') + '.san.o')
    cmd = [compiler,*flags,*inc,*extra,'-c',source,'-o',str(obj)]
    subprocess.run([sys.executable,str(out / 'run.py'),label + '-' + source.replace('/', '-'),*cmd],cwd=root,check=True)
    objects.append(str(obj))
cmd = ['g++','-fsanitize=address,undefined',*objects,'build/adc-iteration/lib/libgmock_main.a','build/adc-iteration/lib/libgmock.a','build/adc-iteration/lib/libgtest.a','-pthread','-o',str(out / (mode + '-san-test'))]
subprocess.run([sys.executable,str(out / 'run.py'),label + '-link',*cmd],cwd=root,check=True)
