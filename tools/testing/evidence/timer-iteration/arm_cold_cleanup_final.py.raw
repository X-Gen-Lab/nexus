from pathlib import Path
import hashlib,json,subprocess,sys
root=Path('/workspace/nexus');evidence=root/'tools/testing/evidence/timer-iteration';out=evidence/'arm-cold-cleanup-final';out.mkdir(exist_ok=False)
tool=Path('/workspace/nexus-tools-arm/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gcc');run=Path('/workspace/nexus-timer-iteration/run.py')
def identity(p):
 b=p.read_bytes();return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
flags=['-std=c11','-mcpu=cortex-m4','-mthumb','-mfpu=fpv4-sp-d16','-mfloat-abi=hard','-Os','-ffunction-sections','-fdata-sections','-Wall','-Wextra','-Werror','-Wpedantic','-Wconversion','-Wshadow','-Wstrict-prototypes','-Wmissing-prototypes']
inc=['-Icore/include','-Iarch/include','-Iio/include','-Iio/private']
sources=[root/'io/src/timer_capture.c',root/'io/src/advanced_pwm.c']+list(root.glob('soc/*/drivers/timer_capture.c'))+list(root.glob('soc/*/drivers/advanced_pwm.c'))+list(root.glob('soc/*/private/*_timer_advanced.h'))+[root/'io/private/timer_advanced_controller.h',root/'io/private/timer_capture_impl.h',root/'io/private/advanced_pwm_impl.h',root/'io/include/nexus/io/timer_capture.h',root/'io/include/nexus/io/advanced_pwm.h']
report={'schema_version':1,'kind':'timer_sdk_arm_object_cost','status':'running','scope':'Actual strict ARM SDK compilation and selected object/type costs; not full firmware linkage or physical qualification.','source_inputs':[identity(p) for p in sources],'compiler':identity(tool),'physical_status':'not_executed','cycles_status':'not_measured','families':[]}
for family,define in [('stm32f407','STM32F407xx'),('gd32f470','GD32F470')]:
 extra=['-D'+define,'-Isoc/'+family+'/private']
 if family=='stm32f407':extra+=['-isystem','vendors/st/cmsis_device_f4/Include','-isystem','vendors/arm/CMSIS_5/CMSIS/Core/Include']
 else:extra+=['-DHXTAL_VALUE=25000000','-isystem','vendors/gigadevice/gd32f4xx/Firmware/CMSIS','-isystem','vendors/gigadevice/gd32f4xx/Firmware/CMSIS/GD/GD32F4xx/Include','-isystem','vendors/gigadevice/gd32f4xx/Firmware/GD32F4xx_standard_peripheral/Include']
 objects=[]
 for source in ['soc/'+family+'/drivers/timer_capture.c','soc/'+family+'/drivers/advanced_pwm.c','io/src/timer_capture.c','io/src/advanced_pwm.c']:
  obj=out/(family+'-'+source.replace('/','-')+'.o')
  argv=[str(tool),*flags,*inc,*extra,'-c',source,'-o',str(obj)]
  subprocess.run([sys.executable,str(run),'arm-cold-cleanup-final-'+family+'-'+source.replace('/','-'),*argv],cwd=root,check=True)
  size_tool=tool.with_name('arm-none-eabi-size');raw=subprocess.check_output([str(size_tool),'-A',str(obj)],text=True)
  text=sum(int(row.split()[1]) for row in raw.splitlines() if row.startswith(('.text','.rodata')))
  ram=sum(int(row.split()[1]) for row in raw.splitlines() if row.startswith(('.data','.bss')))
  (out/(obj.stem+'.size.raw')).write_text(raw)
  objects.append({'source':source,'object':identity(obj),'text_rodata_bytes':text,'global_data_bss_bytes':ram})
 fixture=out/(family+'-types.c.raw');fixture.write_text('#include "'+family+'_timer_advanced.h"\n#include "nexus/io/timer.h"\nunsigned char capture_state_size[sizeof(nx_timer_capture_controller_t)];\nunsigned char advanced_state_size[sizeof(nx_advanced_pwm_controller_t)];\nunsigned char capture_config_size[sizeof(nx_timer_capture_config_t)];\nunsigned char advanced_config_size[sizeof(nx_advanced_pwm_config_t)];\nunsigned char capture_face_size[sizeof(nx_timer_capture_t)];\nunsigned char advanced_face_size[sizeof(nx_advanced_pwm_t)];\nunsigned char event_size[sizeof(nx_timer_capture_event_t)];\nunsigned char capture_ops_size[sizeof(nx_timer_capture_ops_t)];\nunsigned char advanced_ops_size[sizeof(nx_advanced_pwm_ops_t)];\nunsigned char existing_pwm_ops_size[sizeof(nx_pwm_ops_t)];\n')
 obj=out/(family+'-types.o');subprocess.run([sys.executable,str(run),'arm-cold-cleanup-final-'+family+'-types',str(tool),*flags,*inc,*extra,'-x','c','-c',str(fixture),'-o',str(obj)],cwd=root,check=True)
 raw=subprocess.check_output([str(tool.with_name('arm-none-eabi-nm')),'-S','--radix=d',str(obj)],text=True);(out/(family+'-types.nm.raw')).write_text(raw)
 layout={row.split()[-1]:int(row.split()[1]) for row in raw.splitlines() if len(row.split())==4}
 report['families'].append({'family':family,'objects':objects,'layout':layout,'types_object':identity(obj),'fixture':identity(fixture),'nm':identity(out/(family+'-types.nm.raw'))})
for entry in report['source_inputs']:
 assert identity(Path(entry['path']))==entry,entry['path']
report['status']='passed';report['source_inputs_stable']=True
(out/'report.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report['families'],indent=2))
