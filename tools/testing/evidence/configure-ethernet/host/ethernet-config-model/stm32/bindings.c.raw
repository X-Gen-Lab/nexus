static const nx_factory_io_capability_t s_nx_capability_mdio_mac = {
    NX_FACTORY_CAP_POLLING, 1U, 2U, 1U, 1U
};
/** \brief Pure selected-only capability lookup. */
const nx_factory_io_capability_t* nx_factory_mdio_capability(
    nx_mdio_id_t id) {
    switch (id) {
        case NX_MDIO_ID_MAC:
            return &s_nx_capability_mdio_mac;
        default:
            return NULL;
    }
}
