"""Run one complete failstop Google binary with actual unfiltered identities."""
from pathlib import Path
import argparse
import hashlib
import json
import os
import signal
import subprocess
import sys
import time

ROOT = Path('/workspace/nexus')
sys.path.insert(0, str(ROOT))
from scripts.ci.tdd_gate import environment, discovered_count, validate_google_report
from scripts.validation.junit import prepare_report


def identity(p):
    p = Path(p)
    b = p.read_bytes()
    return {'path': str(p), 'sha256': hashlib.sha256(b).hexdigest(), 'bytes': len(b)}


def run(argv, label, out, env):
    start = time.monotonic()
    child = subprocess.Popen(argv, cwd=ROOT, env=env, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, start_new_session=True)
    timed_out = False
    try:
        stdout, stderr = child.communicate(timeout=30)
    except subprocess.TimeoutExpired:
        timed_out = True
        os.killpg(child.pid, signal.SIGKILL)
        stdout, stderr = child.communicate()
    (out / (label + '.stdout')).write_bytes(stdout)
    (out / (label + '.stderr')).write_bytes(stderr)
    record = {'argv': argv, 'cwd': str(ROOT), 'returncode': child.returncode,
              'timeout': timed_out, 'outer_bound_seconds': 30,
              'duration_seconds': time.monotonic() - start,
              'stdout': identity(out / (label + '.stdout')),
              'stderr': identity(out / (label + '.stderr'))}
    (out / (label + '.command.json')).write_text(json.dumps(record, indent=2) + '\n')
    if timed_out or child.returncode != 0:
        raise ValueError(json.dumps(record))
    return stdout.decode()


def cases(output):
    values = []
    suite = None
    for line in output.splitlines():
        text = line.split('#', 1)[0].rstrip()
        if text and not text[0].isspace() and text.endswith('.'):
            suite = text[:-1]
        elif suite is not None and text.startswith('  ') and text.strip():
            values.append((suite, text.strip()))
    return values


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--build', type=Path, required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    out = args.output
    out.mkdir(exist_ok=False)
    binary = args.build / 'bin/nexus_freertos_failstop_test'
    fixture = ROOT / 'tests/google/freertos_failstop_test.cpp'
    source = identity(fixture)
    doc = {'status': 'running', 'scope': 'whole actual failstop Google fixture',
           'source': source, 'binary': identity(binary), 'tests_filtered': False,
           'sanitizers_suppressed': False, 'physical_status': 'not_executed'}
    env = environment()
    env['PATH'] = '/workspace/nexus/.venv/bin:/usr/local/bin:/usr/bin:/bin'
    report = out / 'results.xml'
    try:
        listing = run([str(binary), '--gtest_list_tests'], 'discovery', out, env)
        count = discovered_count(listing)
        expected = cases(listing)
        if count != 8 or len(expected) != 8 or len(set(expected)) != 8:
            raise ValueError('Framework did not discover eight unique actual cases')
        start = prepare_report(report)
        run([str(binary), '--gtest_repeat=1', '--gtest_also_run_disabled_tests',
             '--gtest_output=xml:' + str(report)], 'execution', out, env)
        checked = validate_google_report(report, not_before_ns=start, expected_cases=count)
        if sorted(expected) != sorted((c['classname'], c['name']) for c in checked['cases']):
            raise ValueError('Executed cases differ from unfiltered discovery')
        if identity(fixture) != source or identity(binary) != doc['binary']:
            raise ValueError('Source or executable changed during execution')
        doc['validation'] = checked
        doc['framework_cases'] = expected
        doc['report'] = identity(report)
        doc['status'] = 'passed'
    except Exception as error:
        doc['status'] = 'failed'
        doc['error'] = str(error)
        raise
    finally:
        (out / 'manifest.json').write_text(json.dumps(doc, indent=2, sort_keys=True) + '\n')
    print(json.dumps({'status': doc['status'], 'passed': checked['passed'],
                      'report': identity(out / 'manifest.json')}, indent=2))


if __name__ == '__main__':
    main()
