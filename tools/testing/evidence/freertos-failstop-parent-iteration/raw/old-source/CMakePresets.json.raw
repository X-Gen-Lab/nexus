{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 6
    },
    "configurePresets": [
        {
            "name": "native-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/native.toml",
                "NEXUS_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "native-release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/native.toml",
                "NEXUS_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "native-asan",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/native.toml",
                "NEXUS_BUILD_TESTS": "ON",
                "NEXUS_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "native-tsan",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/native.toml",
                "NEXUS_BUILD_TESTS": "ON",
                "NEXUS_ENABLE_THREAD_SANITIZER": "ON"
            }
        },
        {
            "name": "stm32-qiming-baremetal",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-qiming-baremetal",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/qiming-baremetal.toml",
                "NEXUS_BUILD_TESTS": "OFF"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "stm32-qiming-freertos",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-qiming-freertos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/qiming-freertos.toml",
                "NEXUS_BUILD_TESTS": "OFF"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "stm32-sky-baremetal",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-sky-baremetal",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/sky-baremetal.toml",
                "NEXUS_BUILD_TESTS": "OFF"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "stm32-sky-freertos",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/stm32-sky-freertos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/sky-freertos.toml",
                "NEXUS_BUILD_TESTS": "OFF"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "gd32-liangshan-baremetal",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gd32-liangshan-baremetal",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/liangshan-baremetal.toml",
                "NEXUS_BUILD_TESTS": "OFF"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake"
        },
        {
            "name": "gd32-liangshan-freertos",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gd32-liangshan-freertos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEXUS_ASSEMBLY_FILE": "${sourceDir}/tools/configure/assemblies/liangshan-freertos.toml",
                "NEXUS_BUILD_TESTS": "OFF"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc.cmake"
        }
    ],
    "buildPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug"
        },
        {
            "name": "native-release",
            "configurePreset": "native-release"
        },
        {
            "name": "native-asan",
            "configurePreset": "native-asan"
        },
        {
            "name": "native-tsan",
            "configurePreset": "native-tsan"
        },
        {
            "name": "stm32-qiming-baremetal",
            "configurePreset": "stm32-qiming-baremetal"
        },
        {
            "name": "stm32-qiming-freertos",
            "configurePreset": "stm32-qiming-freertos"
        },
        {
            "name": "stm32-sky-baremetal",
            "configurePreset": "stm32-sky-baremetal"
        },
        {
            "name": "stm32-sky-freertos",
            "configurePreset": "stm32-sky-freertos"
        },
        {
            "name": "gd32-liangshan-baremetal",
            "configurePreset": "gd32-liangshan-baremetal"
        },
        {
            "name": "gd32-liangshan-freertos",
            "configurePreset": "gd32-liangshan-freertos"
        }
    ],
    "testPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "native-release",
            "configurePreset": "native-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "native-asan",
            "configurePreset": "native-asan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "native-tsan",
            "configurePreset": "native-tsan",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ]
}
