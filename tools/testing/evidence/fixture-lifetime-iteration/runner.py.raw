#!/usr/bin/env python3
"""Execute complete existing fixture executables without source filtering."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys

ROOT = Path('/workspace/nexus')
EVIDENCE = Path('/workspace/nexus-fixture-lifetime-iteration')
OWNED = ('tests/google/can_controller_test.cpp',
         'tests/google/gd32_flash_fault_test.cpp',
         'tests/google/gd32_adc_stream_test.cpp')
TARGETS = ('nexus_can_controller_test', 'nexus_gd32_flash_fault_test',
           'nexus_gd32_adc_stream_test')


def identity(path):
    path = Path(path)
    data = path.read_bytes()
    return {'path': str(path), 'sha256': hashlib.sha256(data).hexdigest(),
            'size': len(data)}


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')


def inputs(build, phase):
    records = []
    listed = subprocess.check_output(['/workspace/nexus/.venv/bin/ninja',
             '-C', str(build), '-t', 'deps'], text=True)
    (phase / 'ninja-dependencies.txt').write_text(listed)
    paths = set()
    for line in listed.splitlines():
        if not line.startswith('    '):
            continue
        p = Path(line.strip())
        if not p.is_absolute():
            p = build / p
        if not p.is_file():
            raise ValueError('Missing actual compiler input: ' + str(p))
        paths.add(p.resolve())
    for path in sorted(paths):
        observed = identity(path)
        namespace = 'source' if path.is_relative_to(ROOT) else 'build' if path.is_relative_to(build) else 'system'
        relative = path.relative_to(ROOT) if namespace == 'source' else path.relative_to(build) if namespace == 'build' else path.relative_to('/')
        copied = phase / 'compiled-inputs' / namespace / relative
        copied.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(path, copied)
        if identity(path) != observed or identity(copied)['sha256'] != observed['sha256']:
            raise ValueError('Compiler input changed during capture')
        records.append({'original': observed, 'capsule': identity(copied)})
    write(phase / 'compiled-inputs.json', records)
    return records


def main():
    p = argparse.ArgumentParser()
    p.add_argument('phase', choices=('baseline', 'fixed'))
    p.add_argument('profile', choices=('regular', 'asan'))
    a = p.parse_args()
    phase = EVIDENCE / (a.phase + '-' + a.profile)
    if phase.exists():
        raise ValueError('Fresh evidence destination required')
    phase.mkdir(parents=True)
    os.environ.update({'PATH': '/workspace/nexus/.venv/bin:/workspace/nexus-tools-arm/arm-gnu-toolchain-14.3.rel1-x86_64-arm-none-eabi/bin:/usr/bin:/bin',
                       'CC': '/usr/bin/cc', 'CXX': '/usr/bin/c++',
                       'CMAKE_BUILD_PARALLEL_LEVEL': '2', 'PYTHONDONTWRITEBYTECODE': '1',
                       'ASAN_OPTIONS': 'detect_leaks=1:halt_on_error=1',
                       'UBSAN_OPTIONS': 'print_stacktrace=1:halt_on_error=1'})
    for key in list(os.environ):
        if key.startswith('GTEST_'):
            del os.environ[key]
    sys.path.insert(0, str(ROOT))
    from tools.evidence.reproduce import run_logged
    from scripts.ci.native_contracts import discovered_cases
    from scripts.ci.tdd_gate import validate_google_report
    from scripts.validation.junit import prepare_report
    build = Path('/tmp/nexus-fixture-lifetime-builds') / a.profile
    source_before = [identity(ROOT / name) for name in OWNED]
    for name in OWNED:
        target = phase / 'owned-source' / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(ROOT / name, target)
    tools = []
    for name in ('/usr/bin/cc', '/usr/bin/c++', '/workspace/nexus/.venv/bin/python',
                 '/workspace/nexus/.venv/bin/cmake', '/workspace/nexus/.venv/bin/ninja'):
        path = Path(name).resolve()
        version = subprocess.run([str(path), '--version'], capture_output=True, text=True,
                                 check=True, timeout=30)
        tools.append({**identity(path), 'version': version.stdout + version.stderr})
    checks = []
    def execute(argv, name):
        r = run_logged(argv, phase / (name + '.log'), cwd=ROOT, timeout_s=900)
        r['name'] = name
        checks.append(r)
        write(phase / 'commands.json', checks)
        print(json.dumps({'phase': a.phase, 'profile': a.profile, 'step': name,
                          'exit_code': r['exit_code'], 'seconds': r['elapsed_s']}), flush=True)
        if r['exit_code']:
            raise ValueError('Actual whole executable command failed: ' + name)
        return r
    if a.phase == 'baseline':
        preset = 'native-debug' if a.profile == 'regular' else 'native-asan'
        execute([sys.executable, '-B', 'tools/dev/dev.py', 'configure', '--preset',
                 preset, '-B', str(build)], 'configure')
    execute(['/workspace/nexus/.venv/bin/cmake', '--build', str(build), '--parallel', '2',
             '--target', *TARGETS], 'build')
    source_capsule = inputs(build, phase)
    results = []
    for target in TARGETS:
        binary = build / 'bin' / target
        before = identity(binary)
        discovery = execute([str(binary), '--gtest_filter=*', '--gtest_list_tests'], target + '-discovery')
        cases = discovered_cases(Path(discovery['raw']['path']).read_text())
        report = phase / (target + '.xml')
        start = prepare_report(report)
        execute([str(binary), '--gtest_filter=*', '--gtest_repeat=1',
                 '--gtest_also_run_disabled_tests', '--gtest_output=xml:' + str(report)],
                target + '-execution')
        observed = validate_google_report(report, not_before_ns=start, expected_cases=len(cases))
        if {(c['classname'], c['name']) for c in observed['cases']} != cases:
            raise ValueError('Actual Google case identities differ')
        if identity(binary) != before:
            raise ValueError('Running executable bytes changed')
        results.append({'binary': before, 'report': identity(report), **observed})
    if [identity(ROOT / name) for name in OWNED] != source_before:
        raise ValueError('Owned source changed during execution')
    for item in source_capsule:
        if identity(item['original']['path']) != item['original']:
            raise ValueError('Actual compiler input changed during execution')
    write(phase / 'development.json', {'schema_version': 1, 'kind': 'fixture_lifetime_existing_contract_execution',
          'status': 'passed', 'phase': a.phase, 'profile': a.profile,
          'executions': checks, 'results': results, 'google_cases': sum(r['passed'] for r in results),
          'source_before': source_before, 'source_unchanged': True, 'tools': tools,
          'compiled_inputs': identity(phase / 'compiled-inputs.json'),
          'physical_status': 'not_executed', 'behavioral_red': 'not_claimed',
          'scope': 'Complete three existing executables; fixture storage lifetime only, no production change, no full Native/final qualification'})
    print(json.dumps({'status': 'passed', 'phase': a.phase, 'profile': a.profile,
                      'cases': sum(r['passed'] for r in results), 'report': str(phase / 'development.json')}), flush=True)


if __name__ == '__main__':
    main()
