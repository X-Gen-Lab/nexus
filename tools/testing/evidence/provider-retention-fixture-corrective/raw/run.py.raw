"""Record actual narrow fixture corrective test commands once."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path('/workspace/nexus')
BASE = Path(__file__).parent


def digest(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data),
            'sha256': hashlib.sha256(data).hexdigest()}


name, *argv = sys.argv[1:]
output = BASE / name
output.mkdir()
source = ROOT / 'tools/testing/test_provider_retention.py'
before = digest(source)
started = time.time_ns()
with (output / 'stdout.txt').open('xb') as out, (output / 'stderr.txt').open('xb') as err:
    process = subprocess.run(argv, cwd=ROOT, stdout=out, stderr=err, timeout=180)
record = {'argv': argv, 'cwd': str(ROOT), 'exit_code': process.returncode,
          'started_ns': started, 'ended_ns': time.time_ns(),
          'source_before': before, 'source_after': digest(source),
          'stdout': digest(output / 'stdout.txt'), 'stderr': digest(output / 'stderr.txt')}
with (output / 'command.json').open('x') as out:
    json.dump(record, out, indent=2)
    out.write('\n')
print(json.dumps(record, indent=2))
