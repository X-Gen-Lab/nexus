"""Archive actual fixture RED/GREEN streams once without rewriting bytes."""
import hashlib
import json
from pathlib import Path

ROOT = Path('/workspace/nexus')
BASE = Path(__file__).parent
DEST = ROOT / 'tools/testing/evidence/provider-retention-fixture-corrective'


def identity(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data),
            'sha256': hashlib.sha256(data).hexdigest()}


def load(path):
    return json.loads(path.read_text())


def new_json(path, value):
    with path.open('x') as out:
        json.dump(value, out, indent=2)
        out.write('\n')


assert not DEST.exists()
source = ROOT / 'tools/testing/test_provider_retention.py'
source_identity = identity(source)
assert source_identity['sha256'] == '75dc5dc7f9de0d18d58ca918285edf27335debd70294d086c23690073ed75992'
red = load(BASE / 'existing-red/command.json')
green = load(BASE / 'fixture-final-green/command.json')
whole = load(BASE / 'tools-final-green/command.json')
assert red['exit_code'] == 1 and green['exit_code'] == whole['exit_code'] == 0
assert green['source_before'] == green['source_after'] == source_identity
assert whole['source_before'] == whole['source_after'] == source_identity
assert 'Ran 38 tests' in Path(red['stderr']['path']).read_text()
assert 'FAILED (errors=7)' in Path(red['stderr']['path']).read_text()
assert 'Ran 41 tests' in Path(green['stderr']['path']).read_text()
suite = load(BASE / 'tools-testing-final-green.json')
assert suite == {'suite': 'testing', 'discovered': 433, 'executed': 433,
                 'skipped': 0, 'failures': 0, 'errors': 0,
                 'expected_failures': 0, 'unexpected_successes': 0,
                 'status': 'passed'}
for path in BASE.rglob('command.json'):
    command = load(path)
    for key in ('stdout', 'stderr'):
        assert identity(Path(command[key]['path'])) == command[key]
original = BASE / 'original-root-stage-tools-testing-red.txt'
assert 'Ran 430 tests' in original.read_text()
assert 'FAILED (errors=7)' in original.read_text()
DEST.mkdir()
index = []


def archive(path, target):
    target = DEST / target
    target.parent.mkdir(parents=True, exist_ok=True)
    before = identity(path)
    with target.open('xb') as out:
        out.write(path.read_bytes())
    after = identity(target)
    assert before['sha256'] == after['sha256'] and before['bytes'] == after['bytes']
    index.append({'original': before, 'stored_path': str(target.relative_to(ROOT)),
                  'bytes': after['bytes'], 'sha256': after['sha256']})


for path in sorted(BASE.rglob('*')):
    if path.is_file():
        relative = path.relative_to(BASE)
        name = relative.name + '.raw' if path.suffix == '.py' else relative.name
        archive(path, Path('raw') / relative.parent / name)
source_inputs = [source, ROOT / 'tools/measurement/retention.py',
                 ROOT / 'soc/gd32f470/drivers/i2c.c',
                 ROOT / 'io/include/nexus/io/i2c.h']
for path in source_inputs:
    relative = path.relative_to(ROOT)
    archive(path, Path('sources') / relative.parent / (relative.name + '.raw'))
new_json(DEST / 'archive-index.json', {'schema_version': 1, 'entries': index})
report = {
    'schema_version': 1, 'kind': 'provider_retention_external_elf_fixture_corrective',
    'status': 'passed_for_development_test_scope',
    'owned_sources': [source_identity],
    'context_source_inputs': [identity(path) for path in source_inputs[1:]],
    'production_algorithm_changed': False,
    'red': red, 'final_fixture_green': green, 'final_whole_tools_green': whole,
    'whole_tool_execution': suite,
    'distinct_retention_contracts': 41,
    'correction': 'External synthetic ELF now retains the actual polling endpoint on_port slot and local i2c.c method; complete method counts include that identity method.',
    'negative_contracts': ['Original missing, weak global, wrong method, Thumb, LOAD and local-file provenance assertions preserved.',
                           'Additional missing on_port and wrong local source tests assert rejection.'],
    'retained_environment_failure': {'path': 'raw/tools-green/command.json',
                                     'reason': 'Initial whole-suite child environment omitted .venv/bin PATH, so CMake-dependent tests failed; same full suite later executed with correct tools PATH and no skips.'},
    'final_execution_environment': {'path_prefix': '/workspace/nexus/.venv/bin'},
    'original_root_stage_red': identity(original),
    'archive_index': identity(DEST / 'archive-index.json'),
    'source_status': 'working_tree_development_not_clean_candidate',
    'physical_status': 'not_executed',
    'limits': ['Synthetic ELF bytes test the real inspector, not executable MCU firmware.',
               'No production inspector relaxation, filtering, hook bypass or remote CI inference.',
               'Whole tools testing is 433 actual cases; it does not imply Google/full firmware qualification.'],
}
new_json(DEST / 'development.json', report)
for entry in index:
    actual = identity(ROOT / entry['stored_path'])
    assert actual['sha256'] == entry['sha256'] and actual['bytes'] == entry['bytes']
assert identity(source) == source_identity
print(json.dumps({'manifest': identity(DEST / 'development.json'),
                  'archive_index': identity(DEST / 'archive-index.json'),
                  'raw_files': len(index)}, indent=2))
