"""Finish metadata over verified retained OS-resource bytes without rerunning."""

from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path


ROOT = Path('/workspace/nexus')
EXTERNAL = Path('/workspace/nexus-os-resource-iteration')
RUN = EXTERNAL / 'run1'
ARCHIVE = ROOT / 'tools/testing/evidence/os-resource-refresh'


def identity(path):
    data = path.read_bytes()
    return {'path': str(path), 'bytes': len(data),
            'sha256': hashlib.sha256(data).hexdigest()}


report_path = RUN / 'report.json'
execution_path = EXTERNAL / 'run1-execution.json'
report = json.loads(report_path.read_text())
execution = json.loads(execution_path.read_text())
assert report['status'] == 'passed'
assert report['expected_variants'] == len(report['variants']) == 8
assert len(report['commands']) == 56
assert all(row['returncode'] == 0 for row in report['commands'])
assert report['source_inputs_stable'] and report['tools_stable']
assert execution['returncode'] == 0
identities, references = {}, 0


def visit(value):
    global references
    if isinstance(value, dict):
        if {'path', 'bytes', 'sha256'} <= value.keys():
            references += 1
            previous = identities.get(value['path'])
            if previous is not None and previous != value:
                raise ValueError('Conflicting identity: ' + value['path'])
            identities[value['path']] = value
        for item in value.values():
            visit(item)
    elif isinstance(value, list):
        for item in value:
            visit(item)


visit(report)
visit(execution)
for path in (report_path, execution_path,
             EXTERNAL / 'archive-attempt1-failure.json', Path(__file__)):
    visit(identity(path))
tools = {item['path'] for item in report['tools'].values()}
rows = []
for original, expected in sorted(identities.items()):
    path = Path(original)
    if original in tools:
        if identity(path) != expected:
            raise ValueError('Tool changed after actual execution')
        continue
    if path.is_relative_to(ROOT):
        relative = Path('source-inputs') / path.relative_to(ROOT)
        relative = relative.with_name(relative.name + '.raw')
    elif path.is_relative_to(RUN):
        relative = Path('run1') / path.relative_to(RUN)
        if (path.suffix in {'.c', '.h', '.S', '.s', '.cmake', '.ld', '.toml'}
                or path.name == 'compile_commands.json'):
            relative = relative.with_name(relative.name + '.raw')
    elif path.is_relative_to(EXTERNAL):
        relative = Path('execution') / path.relative_to(EXTERNAL)
        if path.suffix == '.py':
            relative = relative.with_name(relative.name + '.raw')
    else:
        raise ValueError('Unknown historical artifact scope')
    destination = ARCHIVE / 'raw' / relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    if not destination.exists():
        if identity(path) != expected:
            raise ValueError('Missing retained historical bytes')
        with destination.open('xb') as stream:
            stream.write(path.read_bytes())
    stored = identity(destination)
    if (stored['bytes'], stored['sha256']) != (
            expected['bytes'], expected['sha256']):
        raise ValueError('Retained raw bytes changed')
    rows.append({'original': expected, 'stored': stored,
                 'original_output_name': path.name,
                 'classification': 'historical_bytes_not_maintained_source'})

index = {'schema_version': 1, 'kind': 'actual_os_resource_artifact_archive',
         'scope': 'raw_original_paths_and_bytes_preserved',
         'identity_references': references,
         'unique_original_identities': len(identities),
         'stored_files': len(rows), 'rows': rows,
         'external_tool_identities': report['tools'],
         'raw_report': identity(ARCHIVE / 'raw/run1/report.json'),
         'raw_execution': identity(
             ARCHIVE / 'raw/execution/run1-execution.json')}
with (ARCHIVE / 'archive-index.json').open('x') as stream:
    json.dump(index, stream, indent=2)
    stream.write('\n')
variants = []
for variant in report['variants']:
    data = variant['resources']
    variants.append({key: variant[key] for key in (
        'name', 'cpu', 'profile', 'optimization', 'kernel_port')} | {
            'sizes': data['sizes'], 'actual_storage': data['storage'],
            'actual_idle': data['idle'], 'accounting': data['accounting'],
            'fixture_image': data['image'],
            'retained_hot_path_count': len(variant['hot_paths']),
            'compiled_object_count': len(variant['compiled_objects']),
            'physical_status': 'not_executed', 'cycles_status': 'not_measured'})
manifest = {
    'schema_version': 1, 'kind': 'os_resource_exact_development_refresh',
    'status': 'passed',
    'scope': 'actual_m0_m4f_objects_and_instruction_shape_not_board_or_cycles',
    'source_before': execution['source_before'],
    'source_after': execution['source_after'], 'source_inputs_stable': True,
    'tools_stable': True, 'outer_returncode': execution['returncode'],
    'actual_command_count': len(report['commands']),
    'actual_variant_count': len(report['variants']),
    'identity_reference_checks': references,
    'unique_identity_checks': len(identities),
    'all_raw_identities_verified': True,
    'archive_index': identity(ARCHIVE / 'archive-index.json'),
    'actual_report': index['raw_report'],
    'actual_execution': index['raw_execution'],
    'metadata_failure_retained': identity(
        ARCHIVE / 'raw/execution/archive-attempt1-failure.json'),
    'metadata_completion_driver': identity(
        ARCHIVE / 'raw/execution/archive_run1_completion.py.raw'),
    'variants': variants, 'profile_comparisons': report['comparisons'],
    'candidate_qualification': 'not_qualified_dirty_development_source',
    'physical_status': 'not_executed', 'cycles_status': 'not_measured',
    'runtime_instruction_counts': 'static_shapes_only_no_cycle_measurement',
    'created_at': datetime.now(timezone.utc).isoformat()}
with (ARCHIVE / 'development.json').open('x') as stream:
    json.dump(manifest, stream, indent=2)
    stream.write('\n')
print(json.dumps({'manifest': identity(ARCHIVE / 'development.json'),
                  'archive_index': identity(ARCHIVE / 'archive-index.json'),
                  'stored_files': len(rows),
                  'stored_bytes': sum(row['stored']['bytes'] for row in rows),
                  'identity_references': references,
                  'unique_identities': len(identities)}, indent=2))
