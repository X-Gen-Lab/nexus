{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus declarative SoC package manifest",
  "description": "Static package data. Filesystem containment, source identities and selected software contracts require configuration validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_version",
    "id",
    "family",
    "vendor",
    "source_directory",
    "facts",
    "dependencies",
    "cmake",
    "exports"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "interface_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "family": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "vendor": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "source_directory": {
      "anyOf": [
        {
          "const": "."
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        }
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc",
        "routes"
      ],
      "properties": {
        "soc": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        },
        "routes": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        },
        "bindings": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        },
        "references": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        },
        "device_catalog": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        },
        "review_profiles": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
          "not": {
            "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "cmake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "target"
      ],
      "properties": {
        "entry": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
              "not": {
                "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
              }
            },
            {
              "pattern": "(^|/)CMakeLists\\.txt$"
            }
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "exclude"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "const": "."
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
                "not": {
                  "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
                }
              }
            ]
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
            "not": {
              "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
            }
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "production",
        "reference"
      ]
    },
    "binding_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*[\\\\;\"$\\r\\n])[^/]+(?:/[^/]+)*$",
        "not": {
          "pattern": "(^|/)(\\.|\\.\\.)(/|$)"
        }
      }
    }
  }
}
