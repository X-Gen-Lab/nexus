{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit Nexus SoC/provider package manifest",
  "description": "Editing hints only; static file and input identity validation is required before trusted code loading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_version",
    "id",
    "version",
    "family",
    "vendor",
    "source_directory",
    "configuration_directory",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "interface_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "family": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "vendor": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "source_directory": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\;\"$\\r\\n/]+(?:/[^\\\\;\"$\\r\\n/]+)*$"
    },
    "configuration_directory": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\;\"$\\r\\n/]+(?:/[^\\\\;\"$\\r\\n/]+)*$"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\;\"$\\r\\n/]+(?:/[^\\\\;\"$\\r\\n/]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
