{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus reproduction-input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "source": {
      "type": "object"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "files",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assembly": {
      "type": "string",
      "minLength": 1
    },
    "resolved": {
      "type": "string",
      "minLength": 1
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "project", "snapshot"],
      "properties": {
        "source": {"type": "object"},
        "project": {"type": "string", "minLength": 1},
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "files", "bytes"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "files": {"type": "integer", "minimum": 1},
            "bytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "elf",
        "bin"
      ],
      "additionalProperties": false,
      "properties": {
        "elf": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "bin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "source_sdk": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["consumer", "resolved"]},
      "else": {"not": {"anyOf": [{"required": ["consumer"]}, {"required": ["resolved"]}]}}
    }
  ],
  "required": [
    "schema_version",
    "source",
    "environment",
    "toolchain",
    "assembly",
    "commands",
    "artifacts",
    "source_date_epoch",
    "source_sdk"
  ]
}
