{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexus hil-fixture",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "hil_fixture"
    },
    "board": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "part": {
      "enum": [
        "STM32F407ZGT6",
        "STM32F407VET6",
        "GD32F470ZGT6",
        "STM32G474RET6",
        "STM32H743ZIT6",
        "STM32U575ZIT6Q"
      ]
    },
    "transport": {
      "const": "swd"
    },
    "probe_interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "serial": {
      "type": "object",
      "required": [
        "controller",
        "tx",
        "rx",
        "baudrate",
        "electrical_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "controller": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tx": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rx": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "baudrate": {
          "const": 115200
        },
        "electrical_mode": {
          "const": "ttl_3v3"
        }
      }
    },
    "required_tests": {
      "const": [
        "probe_identity",
        "flash_readback",
        "reset",
        "uart_echo"
      ]
    },
    "physical_status": {
      "const": "not_executed"
    },
    "pending_qualification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fixture",
          "budget",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "budget": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        }
      }
    },
    "scope": {
      "const": "software_reference"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "board",
    "part",
    "transport",
    "probe_interfaces",
    "serial",
    "required_tests",
    "physical_status",
    "pending_qualification"
  ],
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "board": {
                "enum": [
                  "stm32g474re-hse24-reference",
                  "stm32h743-nucleo-zi2",
                  "stm32h743zi-hsi-reference",
                  "stm32u575-nucleo-zi-q",
                  "stm32u575zi-lptim-reference"
                ]
              }
            },
            "required": [
              "board"
            ]
          },
          {
            "properties": {
              "part": {
                "enum": [
                  "STM32G474RET6",
                  "STM32H743ZIT6",
                  "STM32U575ZIT6Q"
                ]
              }
            },
            "required": [
              "part"
            ]
          }
        ]
      },
      "then": {
        "$ref": "#/$defs/software_reference_target",
        "required": [
          "scope"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "board": {
            "enum": [
              "stm32f407zg-qiming-core",
              "stm32f407zg-qiming-v41"
            ]
          }
        },
        "required": [
          "board"
        ]
      },
      "then": {
        "$ref": "#/$defs/software_reference_board_target",
        "properties": {
          "scope": {
            "const": "software_reference"
          }
        },
        "required": [
          "scope"
        ]
      }
    }
  ],
  "$defs": {
    "software_reference_target": {
      "oneOf": [
        {
          "properties": {
            "board": {
              "const": "stm32g474re-hse24-reference"
            },
            "part": {
              "const": "STM32G474RET6"
            }
          },
          "required": [
            "board",
            "part"
          ]
        },
        {
          "properties": {
            "board": {
              "const": "stm32h743-nucleo-zi2"
            },
            "part": {
              "const": "STM32H743ZIT6"
            }
          },
          "required": [
            "board",
            "part"
          ]
        },
        {
          "properties": {
            "board": {
              "const": "stm32h743zi-hsi-reference"
            },
            "part": {
              "const": "STM32H743ZIT6"
            }
          },
          "required": [
            "board",
            "part"
          ]
        },
        {
          "properties": {
            "board": {
              "const": "stm32u575-nucleo-zi-q"
            },
            "part": {
              "const": "STM32U575ZIT6Q"
            }
          },
          "required": [
            "board",
            "part"
          ]
        },
        {
          "properties": {
            "board": {
              "const": "stm32u575zi-lptim-reference"
            },
            "part": {
              "const": "STM32U575ZIT6Q"
            }
          },
          "required": [
            "board",
            "part"
          ]
        }
      ]
    },
    "software_reference_board_target": {
      "oneOf": [
        {
          "properties": {
            "board": {
              "const": "stm32f407zg-qiming-core"
            },
            "part": {
              "const": "STM32F407ZGT6"
            }
          },
          "required": [
            "board",
            "part"
          ]
        },
        {
          "properties": {
            "board": {
              "const": "stm32f407zg-qiming-v41"
            },
            "part": {
              "const": "STM32F407ZGT6"
            }
          },
          "required": [
            "board",
            "part"
          ]
        }
      ]
    }
  }
}
